import groovy.json.JsonSlurper

def jsonSlurper = new JsonSlurper()

def osName = System.properties['os.name']

osName = osName.toLowerCase()

def map = currentBuild.getEnvVars()

if ("${JSON_MAP_URL}" != "") {
	def jsonMapURL = "${JSON_MAP_URL}"

	jsonMapURL = jsonMapURL.replaceAll("\\(", "%28")
	jsonMapURL = jsonMapURL.replaceAll("\\)", "%29")

	def processText = ""

	if (osName.contains('windows')) {
		processText = [ "cmd.exe", "/c", "curl " + jsonMapURL ].execute().text
	}
	else {
		processText = [ "/bin/bash", "-c", "curl " + jsonMapURL ].execute().text
	}

	def i = 0

	while ((processText == "") && (i < 5)) {
		println("Retry in 10 seconds.")

		sleep(10000)

		if (osName.contains('windows')) {
			processText = [ "cmd.exe", "/c", "curl " + jsonMapURL ].execute().text
		}
		else {
			processText = [ "/bin/bash", "-c", "curl " + jsonMapURL ].execute().text
		}

		i++
	}

	if (processText == "") {
		println("Unable to get JSON map.")
	}

	def jsonObject = jsonSlurper.parseText(processText)

	def jsonArray = jsonObject.properties

	jsonArray.each{
		map[it.name] = it.value
	}
}

map["JENKINS_TEMP_BRANCH"] = "master-temp-" + System.currentTimeMillis()

if (currentJob instanceof hudson.matrix.MatrixProject) {
	def axisJobs = currentJob.getItems();

	for (axisJob in axisJobs) {
		println(axisJob);

		axisJob.disabled = false;
	}
}

println(map)

return map

