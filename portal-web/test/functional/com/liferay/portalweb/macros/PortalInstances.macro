<definition>
	<command name="addCP">
		<execute function="Portal.Click" locator1="Button#PLUS" />

		<execute function="Portal.Type" locator1="TextInput#WEB_ID" value1="${webId}" />
		<execute function="Portal.Type" locator1="TextInput#VIRTUAL_HOST" value1="${virtualHost}" />
		<execute function="Portal.Type" locator1="TextInput#MAIL_DOMAIN" value1="${mailDomain}" />

		<if>
			<equals arg1="${maxUsers}" arg2="true" />
			<then>
				<execute function="Portal.Type" locator1="TextInput#MAX_USERS" value1="${maxUserNumber}" />
			</then>
		</if>

		<if>
			<equals arg1="${portalInstanceActive}" arg2="false" />
			<then>
				<execute function="Portal.Uncheck" locator1="Checkbox#ACTIVE" />
			</then>
		</if>

		<execute macro="PortletEntry#save" />
	</command>

	<command name="deactivatePortalInstance">
		<var name="key_virtualHost" value="${virtualHost}" />

		<execute function="Portal.Click" locator1="PortalInstances#INSTANCE_TABLE_ACTIONS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#EDIT" value1="Edit" />

		<execute function="Portal.Uncheck#uncheckToggleSwitch" locator1="Checkbox#ACTIVE" />

		<execute macro="Button#clickSave" />

		<execute function="Portal.AssertTextEquals" locator1="PortalInstances#INSTANCE_TABLE_ACTIVE" value1="No" />
	</command>

	<command name="deleteCP">
		<var name="key_virtualHost" value="${virtualHost}" />

		<execute function="Portal.AssertTextEquals" locator1="PortalInstances#INSTANCE_TABLE_VIRTUAL_HOST" value1="${virtualHost}" />

		<execute function="Portal.Click" locator1="PortalInstances#INSTANCE_TABLE_ACTIONS" />

		<execute function="Portal.AssertClickNoError" locator1="MenuItem#DELETE" value1="Delete" />

		<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="Alert#viewSuccessMessage" />
		<execute function="Portal.AssertTextNotPresent" locator1="PortalInstances#INSTANCE_TABLE_VIRTUAL_HOST" value1="${virtualHost}" />
	</command>

	<command name="editCP">
		<var name="key_virtualHost" value="${virtualHost}" />

		<execute function="Portal.AssertTextEquals" locator1="PortalInstances#INSTANCE_TABLE_VIRTUAL_HOST" value1="${virtualHost}" />

		<execute macro="PortletEntry#clickEditFromEllipsis" />

		<execute function="Portal.Type" locator1="TextInput#MAIL_DOMAIN" value1="${mailDomain}" />

		<execute function="Portal.AssertClick" locator1="Button#SAVE" value1="Save" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="tearDownCP">
		<execute macro="SignOut#signOutOfSpecificURL">
			<var name="url" value="http://localhost:8080/" />
		</execute>

		<execute macro="SignIn#signInSpecificURL">
			<var name="url" value="http://localhost:8080/" />
		</execute>

		<execute macro="ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="Virtual Instances" />
		</execute>

		<while>
			<condition function="Portal.IsElementPresent" locator1="PortalInstances#INSTANCE_TABLE_ACTIONS_GENERIC_2" />
			<then>
				<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="PortalInstances#INSTANCE_TABLE_ACTIONS_GENERIC_2" />

				<execute function="Portal.AssertClickNoError" locator1="MenuItem#DELETE" value1="Delete" />

				<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

				<execute macro="Alert#viewSuccessMessage" />
			</then>
		</while>
	</command>

	<command name="viewCP">
		<var name="key_virtualHost" value="${virtualHost}" />

		<execute function="Portal.AssertTextEquals" locator1="PortalInstances#INSTANCE_TABLE_WEB_ID" value1="${virtualHost}" />
		<execute function="Portal.AssertTextEquals" locator1="PortalInstances#INSTANCE_TABLE_VIRTUAL_HOST" value1="${virtualHost}" />
		<execute function="Portal.AssertTextEquals" locator1="PortalInstances#INSTANCE_TABLE_MAIL_DOMAIN" value1="${virtualHost}" />
	</command>
</definition>