<definition>
	<command name="viewAsGuestPG">
		<execute function="Portal.AssertElementNotPresent" locator1="IFrame#MARVEL" />

		<execute macro="Navigator#openSpecificURL">
			<var name="url" value="http://localhost:5601/o/portal-search-elasticsearch-marvel-web/marvel-proxy/app/kibana" />
		</execute>

		<execute function="Portal.AssertTextPresent" locator1="Marvel#DIRECT_URL" value1="{&quot;statusCode&quot;:404,&quot;error&quot;:&quot;Not Found&quot;}" />
	</command>

	<command name="viewPG">
		<execute function="Portal.SelectFrame" locator1="IFrame#MARVEL" />

		<execute function="Portal.AssertElementPresent" locator1="Marvel#HOME_HEADER" />
		<execute function="Portal.AssertElementPresent" locator1="Marvel#WELCOME_MESSAGE" />

		<execute function="Portal.AssertClick" locator1="Marvel#CLUSTER_NAME" value1="LiferayElasticsearchCluster" />

		<execute function="Portal.AssertElementPresent" locator1="Marvel#CLUSTERS" />
		<execute function="Portal.AssertElementPresent" locator1="Marvel#INDICES" />
		<execute function="Portal.AssertElementPresent" locator1="Marvel#NODES" />
		<execute function="Portal.AssertElementPresent" locator1="Marvel#OVERVIEW" />
		<execute function="Portal.AssertElementPresent" locator1="Marvel#STATUS_CLUSTER_NAME" value1="LiferayElasticsearchCluster" />
		<execute function="Portal.AssertElementPresent" locator1="Marvel#STATUS_CONTAINER" />
		<execute function="Portal.AssertElementPresent" locator1="Marvel#INDEXING_LATENCY" />
		<execute function="Portal.AssertElementPresent" locator1="Marvel#INDEXING_RATE" />
		<execute function="Portal.AssertElementPresent" locator1="Marvel#SEARCH_LATENCY" />
		<execute function="Portal.AssertElementPresent" locator1="Marvel#SEARCH_RATE" />
		<execute function="Portal.AssertElementPresent" locator1="Marvel#SHARD_ACTIVITY_HEADER" />
	</command>
</definition>