<definition>
	<command name="convertPG">
		<execute function="Portal.Type" locator1="UnitConverter#FROM_FIELD" value1="${initialValue}" />
		<execute function="Portal.Select" locator1="UnitConverter#UNIT_FROM_SELECT" value1="${initialUnit}" />
		<execute function="Portal.Select" locator1="UnitConverter#UNIT_TYPE_SELECT" value1="${unitType}" />
		<execute function="Portal.Select" locator1="UnitConverter#UNIT_TO_SELECT" value1="${targetUnit}" />
		<execute function="Portal.AssertClick" locator1="Button#CONVERT" value1="Convert" />
		<execute function="Portal.AssertTextEquals" locator1="UnitConverter#TO_FIELD" value1="${targetValue}" />
	</command>
</definition>