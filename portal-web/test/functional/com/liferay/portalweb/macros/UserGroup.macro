<definition>
	<command name="addCP">
		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#PLUS" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${userGroupName}" />
		</execute>

		<if>
			<equals arg1="${selectSiteTemplate}" arg2="true" />
			<then>
				<execute function="Portal.Select" locator1="UserGroupsEditUserGroup#PUBLIC_PAGES_SELECT" value1="${siteTemplateName}" />
			</then>
		</if>

		<execute macro="Button#clickSave" />

		<if>
			<or>
				<equals arg1="${userGroupNameVariation}" arg2="Asterik" />
				<equals arg1="${userGroupNameVariation}" arg2="Comma" />
				<equals arg1="${userGroupNameVariation}" arg2="Number" />
			</or>
			<then>
				<execute macro="Alert#viewRequestFailedToComplete" />

				<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="The User Group Name cannot be blank, numeric or a reserved word such as null." />
				<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="The User Group Name cannot contain the following invalid characters: , *." />
			</then>
			<elseif>
				<equals arg1="${userGroupNameVariation}" arg2="Duplicate" />
				<then>
					<execute macro="Alert#viewRequestFailedToComplete" />

					<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="Please enter a unique name." />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${userGroupNameVariation}" arg2="Null" />
				<then>
					<execute function="Portal.AssertTextEquals" locator1="UserGroupsEditUserGroup#NAME_FIELD_ALERT" value1="This field is required." />
				</then>
			</elseif>
			<else>
				<execute macro="Alert#viewSuccessMessage" />

				<execute function="Portal.AssertTextEquals" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />
			</else>
		</if>
	</command>

	<command name="addPageCP">
		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#MANAGE_PAGES" value1="Manage Pages" />

		<execute function="Portal.Pause" locator1="5000" />

		<execute macro="Page#add">
			<var name="pageName" value="${pageName}" />
			<var name="sitePagePrivacy" value="${sitePagePrivacy}" />
		</execute>
	</command>

	<command name="addSiteCP">
		<execute macro="UserGroup#gotoActionsCmd">
			<var name="userGroupName" value="${userGroupName}" />
		</execute>

		<execute function="Portal.AssertClick" locator1="MenuItem#EDIT" value1="Edit" />

		<if>
			<or>
				<equals arg1="${userGroupSite}" arg2="Community Site" />
				<equals arg1="${userGroupSite}" arg2="Intranet Site" />
			</or>
			<then>
				<execute function="Portal.Select" locator1="UserGroupsEditUserGroup#PUBLIC_PAGES_SELECT" value1="${userGroupSite}" />

				<if>
					<equals arg1="${checkEnablePropagationCheckbox}" arg2="true" />
					<then>
						<execute function="Portal.AssertChecked" locator1="UserGroupsEditUserGroup#ENABLE_PROPAGATION_PUBLIC_PAGE_CHECKBOX" />
					</then>
					<else>
						<execute function="Portal.Uncheck" locator1="UserGroupsEditUserGroup#ENABLE_PROPAGATION_PUBLIC_PAGE_CHECKBOX" />
					</else>
				</if>
			</then>
		</if>

		<execute macro="PortletEntry#save" />
	</command>

	<command name="assignAllMembersCP">
		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<execute function="Portal.AssertTextEquals" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />

		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#ASSIGN_MEMBERS" value1="Assign Members" />

		<execute function="Portal.Click" locator1="Button#PLUS" />

		<execute function="Portal.SelectFrame" locator1="IFrame#DIALOG" />

		<execute function="Portal.Check#checkAll" locator1="Checkbox#SELECT_ALL" />

		<execute function="Portal.SelectFrameTop" />

		<execute function="Portal.AssertClick" locator1="Button#ADD" value1="Add" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="assignMemberCP">
		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<execute function="Portal.Pause" locator1="5000" />

		<var name="key_rowEntry" value="${userGroupName}" />

		<execute function="Portal.AssertElementPresent" locator1="Icon#ROW_VERTICAL_ELLIPSIS" />

		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#ROW_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#ASSIGN_MEMBERS" value1="Assign Members" />

		<execute function="Portal.AssertVisible" locator1="NavBar#USERS" />

		<execute function="Portal.Click" locator1="Button#PLUS" />

		<execute function="Portal.AssertElementPresent#assertVisible" locator1="Button#ADD" />

		<execute function="Portal.SelectFrame" locator1="IFrame#DIALOG" />

		<execute macro="User#searchCP">
			<var name="searchTerm" value="${userScreenName}" />
		</execute>

		<var name="key_userScreenName" value="${userScreenName}" />

		<execute function="Portal.Check" locator1="UserGroupsAssignUsers#USER_TABLE_CHECKBOX" />

		<execute function="Portal.Pause" locator1="5000" />

		<execute function="Portal.SelectFrameTop" />

		<execute function="Portal.AssertClick#assertTextClickAtWaitForLastScript" locator1="Button#ADD" value1="Add" />

		<execute macro="Alert#viewSuccessMessage" />

		<execute function="Portal.AssertTextEquals" locator1="UserGroupsAssignUsers#USER_TABLE_SCREEN_NAME" value1="${userScreenName}" />
	</command>

	<command name="deleteCP">
		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<execute function="Portal.Pause" locator1="5000" />

		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.AssertTextEquals" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />

		<var name="key_rowEntry" value="${userGroupName}" />

		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#ROW_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClickNoError" locator1="MenuItem#DELETE" value1="Delete" />

		<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="Alert#viewSuccessMessage" />

		<execute function="Portal.AssertElementNotPresent" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />
	</command>

	<command name="deleteUserCP">
		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<execute function="Portal.Pause" locator1="5000" />

		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.AssertTextEquals" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />

		<var name="key_rowEntry" value="${userGroupName}" />

		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#ROW_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClickNoError" locator1="MenuItem#DELETE" value1="Delete" />

		<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="Alert#viewRequestFailedToComplete" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="You cannot delete user groups that have users." />
	</command>

	<command name="editCP">
		<execute function="Portal.Pause" locator1="5000" />

		<var name="key_userGroupName" value="${userGroupName}" />

		<execute macro="PortletEntry#clickEditFromEllipsis" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${userGroupNameEdit}" />
		</execute>

		<execute macro="PortletEntry#save" />
	</command>

	<command name="expandRootCP">
		<execute function="Portal.Click" locator1="SitePages#PAGE_TREE_ROOT_ARROW" />

		<execute function="Portal.AssertElementPresent#assertElementPresent" locator1="SitePages#PAGE_TREE_PAGE_EDIT_COG" />

		<if>
			<condition function="Portal.IsElementNotPresent#isNotVisible" locator1="Sitepages#PAGE_TREE_PAGE_EDIT_COG" />
			<then>
				<execute function="Portal.Click" locator1="SitePages#PAGE_TREE_ROOT_ARROW" />
			</then>
		</if>
	</command>

	<command name="gotoActionsCmd">
		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<execute function="Portal.Pause" locator1="5000" />

		<execute function="Portal.AssertTextEquals" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />

		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />
	</command>

	<command name="gotoManagePages">
		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#MANAGE_PAGES" value1="Manage Pages" />
	</command>

	<command name="removeMemberCP">
		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<execute function="Portal.Pause" locator1="5000" />

		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.AssertTextEquals" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />

		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#ASSIGN_MEMBERS" value1="Assign Members" />

		<var name="key_userScreenName" value="${userScreenName}" />

		<execute function="Portal.Check" locator1="UserGroupsAssignUsers#USER_TABLE_CHECKBOX" />

		<execute function="Portal.Click" locator1="Toolbar#MANAGEMENT_BAR_TRASH_ICON_BUTTON" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="searchCP">
		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<execute function="Portal.AssertTextEquals" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />

		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="UG1 UserGroup1 Name1" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<execute function="Portal.AssertTextNotPresent" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />
	</command>

	<command name="searchMembersInUserGroupCP">
		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${searchTerm}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />
	</command>

	<command name="tearDownCP">
		<execute macro="ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="User Groups" />
		</execute>

		<if>
			<condition function="Portal.IsElementNotPresent" locator1="Message#EMPTY_INFO" />
			<then>
				<execute function="Portal.Check#checkAll" locator1="Checkbox#SELECT_ALL" />

				<execute function="Portal.ClickNoError" locator1="Icon#DELETE" />

				<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

				<execute macro="Alert#viewSuccessMessage" />
				<execute function="Portal.AssertTextEquals" locator1="Message#INFO" value1="No user groups were found." />
			</then>
		</if>
	</command>

	<command name="viewAssignMemberCP">
		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.AssertTextEquals" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />

		<var name="key_rowEntry" value="${userGroupName}" />

		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#ROW_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#ASSIGN_MEMBERS" value1="Assign Members" />

		<var name="key_userScreenName" value="${userScreenName}" />

		<execute function="Portal.AssertTextEquals" locator1="UserGroupsAssignUsers#USER_TABLE_SCREEN_NAME" value1="${userScreenName}" />
	</command>

	<command name="viewCP">
		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<execute function="Portal.Pause" locator1="5000" />

		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.AssertTextEquals" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />
		<execute function="Portal.AssertElementPresent" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />
		<execute function="Portal.AssertElementPresent" locator1="Checkbox#SELECT_ALL" />
		<execute function="Portal.AssertElementPresent" locator1="UserGroups#USER_GROUP_TABLE_CHECKBOX" />
		<execute function="Portal.AssertElementPresent" locator1="Button#PLUS" />
		<execute function="Portal.AssertElementPresent" locator1="TextInput#SEARCH" />
		<execute function="Portal.AssertElementPresent" locator1="Button#SUBMIT" />
	</command>

	<command name="viewDefault">
		<execute function="Portal.AssertTextEquals" locator1="Message#EMPTY_INFO" value1="No user groups were found." />
	</command>

	<command name="viewPG">
		<execute function="Portal.Pause" locator1="5000" />

		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#EDIT" value1="Edit" />

		<execute function="Portal.AssertClick#assertPartialTextClickAt" locator1="UserGroupsEditUserGroup#PUBLIC_PAGES_OPEN_PAGES" value1="Open Pages" />

		<execute function="Portal.SelectWindow" locator1="home - ${userGroupName} - ${siteName}" />

		<execute function="Portal.AssertTextEquals" locator1="Home#SITE_NAME" value1="${userGroupName}" />

		<var name="key_portletName" value="${portletName}" />

		<execute function="Portal.AssertTextEquals" locator1="Portlet#TITLE" value1="${portletName}" />

		<execute function="Portal.Close" locator1="home - ${userGroupName} - ${siteName}" />
	</command>

	<command name="viewPortletCP">
		<execute function="Portal.AssertElementPresent" locator1="Button#PLUS" />
		<execute function="Portal.AssertElementPresent" locator1="TextInput#SEARCH" />
		<execute function="Portal.AssertElementPresent" locator1="Button#SUBMIT" value1="Search" />
		<execute function="Portal.AssertElementPresent" locator1="Icon#HEADER_VERTICAL_ELLIPSIS" />
		<execute function="Portal.AssertElementPresent" locator1="Message#EMPTY_INFO" value1="No user groups were found." />
	</command>

	<command name="viewRemoveMemberCP">
		<var name="key_userGroupName" value="${userGroupName}" />

		<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${userGroupName}" />

		<execute function="Portal.Click" locator1="Button#SUBMIT" />

		<execute function="Portal.AssertTextEquals" locator1="UserGroups#USER_GROUP_TABLE_NAME" value1="${userGroupName}" />

		<execute function="Portal.AssertClick" locator1="UserGroups#USER_GROUP_TABLE_NAME_LINK" value1="${userGroupName}" />

		<execute function="Portal.AssertTextNotPresent" value1="${userFirstName}" />
	</command>
</definition>