<definition>
	<command name="clickRemoveIcon">
		<if>
			<condition function="Portal.IsVisible#waitForVisible" locator1="Icon#REMOVE" />
			<then>
				<execute function="Portal.Click" locator1="Icon#REMOVE" />
			</then>
		</if>
	</command>

	<command name="clickReorderButton">
		<if>
			<condition function="Portal.IsVisible" locator1="Icon#REMOVE" />
			<then>
				<execute function="Portal.Click" locator1="Icon#REMOVE" />
			</then>
		</if>

		<execute function="Portal.Click" locator1="Button#REORDER" />
	</command>

	<command name="clickReorderIcon">
		<if>
			<condition function="Portal.IsVisible" locator1="Icon#REMOVE" />
			<then>
				<execute function="Portal.Click" locator1="Icon#REMOVE" />
			</then>
		</if>

		<execute function="Portal.Click" locator1="Icon#REORDER" />
	</command>
</definition>