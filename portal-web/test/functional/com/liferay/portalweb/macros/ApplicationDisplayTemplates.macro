<definition>
	<command name="addCP">
		<var name="key_adtType" value="${adtType}" />

		<execute macro="Portlet#viewEmptyMessage">
			<var name="message" value="There are no results." />
		</execute>

		<execute function="Portal.Click" locator1="Button#PLUS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#ADT_TEMPLATE" value1="${adtType} Template" />

		<execute macro="SiteAdmin#viewPortletTitle">
			<var name="portletTitle" value="New ${adtType} Template" />
		</execute>

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${adtType} Test ADT" />
		</execute>

		<execute function="Portal.UploadCommonFile" locator1="DDMEditTemplate#SCRIPT_FILE_FIELD" value1="${adtFile}" />

		<execute macro="PortletEntry#save" />

		<execute function="Portal.AssertTextEquals" locator1="ApplicationDisplayTemplates#ADT_TABLE_NAME_1" value1="${adtType} Test ADT" />
	</command>

	<command name="addManualViaRSS">
		<execute function="Portal.SelectFrame" locator1="IFrame#DIALOG" />

		<execute function="Portal.Pause" locator1="5000" />

		<if>
			<condition function="Portal.IsElementPresent" locator1="Configuration#SETUP_DISPLAY_SETTINGS" />
			<then>
				<execute function="Portal.AssertClick" locator1="Configuration#SETUP_DISPLAY_SETTINGS" value1="Display Settings" />
			</then>
		</if>

		<execute function="Portal.AssertClick" locator1="ApplicationDisplayTemplatesConfiguration#MANAGE_DISPLAY_TEMPLATES_LINK" value1="Manage Display Templates for ${siteName}" />

		<var name="key_adtType" value="RSS" />

		<execute function="Portal.SelectFrameTop" value1="relative=top" />

		<execute function="Portal.SelectFrame" locator1="ApplicationDisplayTemplates#ADT_IFRAME" />

		<execute function="Portal.Click" locator1="Button#PLUS" />

		<execute function="Portal.AssertVisible" locator1="ApplicationDisplayTemplates#RSS_FEEDS" />
		<execute function="Portal.AssertElementPresent" locator1="ApplicationDisplayTemplates#RSS_FEEDS" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="RSS Test ADT" />
		</execute>

		<execute function="Portal.Click" locator1="ApplicationDisplayTemplates#RSS_FEEDS" />

		<execute macro="PortletEntry#save" />
	</command>

	<command name="addPG">
		<execute macro="Portlet#gotoPortletOptions">
			<var name="portletName" value="${portletName}" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

		<execute function="Portal.Pause" locator1="5000" />

		<if>
			<condition function="Portal.IsElementPresent" locator1="Configuration#SETUP_DISPLAY_SETTINGS" />
			<then>
				<execute function="Portal.AssertClick" locator1="Configuration#SETUP_DISPLAY_SETTINGS" value1="Display Settings" />
			</then>
			<elseif>
				<condition function="Portal.IsElementPresent" locator1="Configuration#SETUP_DISPLAY_SETTINGS_PANEL" />
				<then>
					<execute macro="Panel#expandPanel">
						<var name="panelHeading" value="Display Settings" />
					</execute>
				</then>
			</elseif>
		</if>

		<execute function="Portal.AssertClick" locator1="ApplicationDisplayTemplatesConfiguration#MANAGE_DISPLAY_TEMPLATES_LINK" value1="Manage Display Templates for ${siteName}" />

		<var name="key_adtType" value="${adtType}" />

		<execute function="Portal.SelectFrameTop" />

		<execute function="Portal.SelectFrame" locator1="ApplicationDisplayTemplates#ADT_IFRAME" />

		<execute function="Portal.Click" locator1="Button#PLUS" />

		<var name="key_adtType" value="${adtType}" />

		<execute function="Portal.AssertVisible" locator1="ApplicationDisplayTemplates#PORTLET_PREFERENCES" />
		<execute function="Portal.AssertElementPresent" locator1="ApplicationDisplayTemplates#PORTLET_PREFERENCES" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${adtType} Test ADT" />
		</execute>

		<execute function="Portal.UploadCommonFile" locator1="DDMEditTemplate#SCRIPT_FILE_FIELD" value1="${adtFile}" />

		<execute macro="PortletEntry#save" />

		<execute function="Portal.AssertTextEquals" locator1="ApplicationDisplayTemplates#ADT_TABLE_NAME_1" value1="${adtType} Test ADT" />

		<execute function="Portal.SelectFrameTop" value1="relative=top" />
	</command>

	<command name="addPortletADTWithFieldEntry">
		<execute macro="Portlet#gotoPortletOptions">
			<var name="portletName" value="${portletName}" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

		<execute function="Portal.Pause" locator1="3000" />

		<execute function="Portal.AssertClick#assertPartialTextClickAt" locator1="ApplicationDisplayTemplatesConfiguration#MANAGE_DISPLAY_TEMPLATES_LINK" value1="Manage Display Templates" />

		<execute function="Portal.SelectFrameTop" />

		<execute function="Portal.SelectFrame" locator1="ApplicationDisplayTemplates#ADT_IFRAME" />

		<execute macro="LexiconEntry#gotoAdd" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${portletName} Test ADT" />
		</execute>

		<execute function="Portal.Click" locator1="DDMEditTemplate#SCRIPT_FIELD">
			<var name="key_fieldName" value="${fieldName}" />
		</execute>

		<execute macro="PortletEntry#save" />

		<execute function="Portal.SelectFrameTop" value1="relative=top" />
	</command>

	<command name="selectPortletADT">
		<execute macro="Portlet#gotoPortletOptions">
			<var name="portletName" value="${portletName}" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

		<var name="key_tab" value="Display Settings" />

		<if>
			<condition function="Portal.IsElementPresent" locator1="NavTab#TAB_LINK" />
			<then>
				<execute macro="Navigator#gotoNavTab">
					<var name="navTab" value="Display Settings" />
				</execute>
			</then>
		</if>

		<execute function="Portal.Select" locator1="Select#DISPLAY_TEMPLATE" value1="${adtType} Test ADT" />

		<execute macro="Button#clickSave" />

		<execute macro="Alert#viewSuccessMessage" />

		<execute function="Portal.SelectFrameTop" />
	</command>

	<command name="tearDownADTviaPortletPG">
		<if>
			<condition function="Portal.IsElementPresent" locator1="Portlet#OPTIONS_ICON" />
			<then>
				<execute macro="Portlet#gotoPortletOptions">
					<var name="portletName" value="${portletName}" />
					<var name="portletOption" value="Configuration" />
				</execute>

				<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

				<if>
					<condition function="Portal.IsElementPresent" locator1="Configuration#SETUP_DISPLAY_SETTINGS" />
					<then>
						<execute function="Portal.AssertClick" locator1="Configuration#SETUP_DISPLAY_SETTINGS" value1="Display Settings" />
					</then>
				</if>

				<execute function="Portal.Select" locator1="ApplicationDisplayTemplatesConfiguration#DISPLAY_TEMPLATE_SELECT" value1="${defaultADT}" />

				<execute macro="Button#clickSave" />

				<execute macro="Alert#viewSuccessMessage" />

				<execute function="Portal.SelectFrameTop" locator1="IFrame#DIALOG" value1="relative=top" />
			</then>
		</if>
	</command>

	<command name="tearDownPG">
		<execute macro="Portlet#gotoPortletOptions">
			<var name="portletName" value="${portletName}" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

		<if>
			<condition function="Portal.IsElementPresent" locator1="Configuration#SETUP_DISPLAY_SETTINGS" />
			<then>
				<execute function="Portal.AssertClick" locator1="Configuration#SETUP_DISPLAY_SETTINGS" value1="Display Settings" />
			</then>
		</if>

		<execute function="Portal.Click" locator1="ApplicationDisplayTemplatesConfiguration#MANAGE_DISPLAY_TEMPLATES_LINK" />

		<execute function="Portal.SelectFrameTop" value1="relative=top" />

		<execute function="Portal.SelectFrame" locator1="ApplicationDisplayTemplates#ADT_IFRAME" />

		<if>
			<condition function="Portal.IsElementPresent#isVisible" locator1="ApplicationDisplayTemplates#ADT_TABLE_ALL_CHECKBOX" />
			<then>
				<execute function="Portal.Click" locator1="ApplicationDisplayTemplates#ADT_TABLE_ALL_CHECKBOX" />

				<execute function="Portal.AssertClickNoError" locator1="Button#DELETE" value1="Delete" />

				<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

				<execute macro="Alert#viewSuccessMessage" />
			</then>
		</if>

		<execute macro="Portlet#viewEmptyMessage">
			<var name="message" value="There are no results." />
		</execute>
	</command>

	<command name="viewADTviaPortletPG">
		<if>
			<condition function="Portal.IsElementPresent" locator1="Portlet#OPTIONS_ICON" />
			<then>
				<execute macro="Portlet#gotoPortletOptions">
					<var name="portletName" value="${portletName}" />
					<var name="portletOption" value="Configuration" />
				</execute>

				<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

				<if>
					<condition function="Portal.IsElementPresent" locator1="Configuration#SETUP_DISPLAY_SETTINGS" />
					<then>
						<execute function="Portal.AssertClick" locator1="Configuration#SETUP_DISPLAY_SETTINGS" value1="Display Settings" />
					</then>
				</if>

				<execute function="Portal.Select" locator1="ApplicationDisplayTemplatesConfiguration#DISPLAY_TEMPLATE_SELECT" value1="${adtType} Test ADT" />

				<execute function="Portal.AssertSelectedLabel" locator1="ApplicationDisplayTemplatesConfiguration#DISPLAY_TEMPLATE_SELECT" value1="${adtType} Test ADT" />

				<execute function="Portal.SelectFrameTop" locator1="IFrame#DIALOG" value1="relative=top" />
			</then>
		</if>
	</command>
</definition>