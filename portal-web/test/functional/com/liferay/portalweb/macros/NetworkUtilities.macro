<definition>
	<command name="searchPG">
		<var name="key_networkDomain" value="${networkDomain}" />

		<execute function="Portal.Type#typeAceEditor" locator1="NetworkUtilities#DNS_LOOKUP_FIELD" value1="${dnsDomain}" />

		<execute function="Portal.AssertClick" locator1="Button#SUBMIT" value1="Search" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="NetworkUtilities#NETWORK_DOMAIN" value1="${networkDomain}" />
	</command>
</definition>