<definition>
	<command name="gotoAdd">
		<execute function="Portal.AssertVisible" locator1="Button#PLUS" />

		<execute function="Portal.Pause" locator1="3000" />

		<execute function="Portal.Click" locator1="Button#PLUS" />

		<execute function="Portal.AssertVisible" locator1="TextInput#TITLE" />
	</command>
</definition>