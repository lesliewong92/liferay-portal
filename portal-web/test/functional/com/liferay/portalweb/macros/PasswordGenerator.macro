<definition>
	<command name="generatePasswordWithAllOptions">
		<execute function="Portal.AssertElementPresent" locator1="PasswordGenerator#BLANK_NEW_PASSWORD" />
		<execute function="Portal.Check" locator1="Checkbox#NUMBERS" />
		<execute function="Portal.Check" locator1="Checkbox#LOWER_CASE_LETTERS" />
		<execute function="Portal.Check" locator1="Checkbox#UPPER_CASE_LETTERS" />

		<execute function="Portal.Select" locator1="Select#LENGTH" value1="${passwordLength}" />

		<execute function="Portal.AssertClick" locator1="Button#GENERATE" value1="Generate" />

		<execute function="Portal.AssertElementNotPresent" locator1="PasswordGenerator#BLANK_NEW_PASSWORD" />
	</command>
</definition>