<definition>
	<command name="addCP">
		<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

		<execute function="Portal.Type" locator1="TextInput#SOURCE_URL" value1="${sourceURL}" />

		<execute macro="Button#clickSave" />

		<execute macro="Alert#viewSuccessMessage" />

		<execute function="Portal.SelectFrame" value1="relative=top" />
	</command>

	<command name="closeFrame">
		<execute function="Portal.SelectFrame" value1="relative=top" />

		<execute function="Portal.Click" locator1="Icon#CLOSE" />
	</command>

	<command name="saveConfiguration">
		<execute macro="PortletEntry#save" />
		<execute function="Portal.SelectFrame" value1="relative=top" />
	</command>

	<command name="selectCategoryFrame">
		<execute function="Portal.SelectFrame" locator1="IFrame#SELECT_CATEGORY" />
	</command>

	<command name="selectConfigurationFrame">
		<execute function="Portal.SelectFrame" locator1="IFrame#DIALOG" />
	</command>

	<command name="selectEditAssetFrame">
		<execute function="Portal.SelectFrame" locator1="IFrame#EDIT_ASSET" />
	</command>

	<command name="selectModalFrame">
		<execute function="Portal.SelectFrame" locator1="IFrame#MODAL_IFRAME" />
	</command>

	<command name="selectPermissionsFrame">
		<var name="key_iframeTitle" value="Permissions" />

		<execute function="Portal.AssertElementPresent" locator1="IFrame#IFRAME_TITLE" value1="Permissions" />

		<execute function="Portal.SelectFrame" locator1="IFrame#DIALOG" />
	</command>

	<command name="selectTopFrame">
		<execute function="Portal.SelectFrame" value1="relative=top" />
	</command>
</definition>