<definition>
	<command name="_selectUser">
		<var name="key_inviteUserFullName" value="${inviteUserFullName}" />

		<execute function="Portal.AssertClick" locator1="InviteMembers#INVITE_USER_FULL_NAME" value1="${inviteUserFullName}" />
	</command>

	<command name="inviteMembers">
		<execute function="Portal.AssertClick" locator1="Button#INVITE_MEMBERS" value1="Invite members to this site." />

		<execute function="Portal.SelectFrame" locator1="IFrame#INVITE_MEMBERS" />

		<execute macro="InviteMembers#_selectUser">
			<var name="inviteUserFullName" value="${inviteUserFullName}" />
		</execute>

		<execute function="Portal.AssertClick" locator1="Button#SEND_INVITATIONS" value1="Send Invitations" />
	</command>
</definition>