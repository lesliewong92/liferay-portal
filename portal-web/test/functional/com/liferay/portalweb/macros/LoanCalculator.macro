<definition>
	<command name="calculatePG">
		<execute function="Portal.Type" locator1="TextInput#LOAN_AMOUNT" value1="${loanAmount}" />
		<execute function="Portal.Type" locator1="TextInput#INTEREST_RATE" value1="${loanInterestRate}" />
		<execute function="Portal.Type" locator1="TextInput#YEARS" value1="${loanYears}" />

		<execute function="Portal.AssertClick" locator1="Button#CALCULATE" value1="Calculate" />

		<execute function="Portal.AssertTextEquals" locator1="TextInput#MONTHLY_PAYMENT" value1="${loanMonthlyPayment}" />
		<execute function="Portal.AssertTextEquals" locator1="TextInput#INTEREST_PAID" value1="${loanInterestPaid}" />
		<execute function="Portal.AssertTextEquals" locator1="TextInput#TOTAL_PAID" value1="${loanTotalPaid}" />
	</command>
</definition>