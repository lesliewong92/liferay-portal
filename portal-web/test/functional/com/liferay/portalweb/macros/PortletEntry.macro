<definition>
	<command name="clickEditFromEllipsis">
		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#EDIT" value1="Edit" />
	</command>

	<command name="clickMoveToRecycleBin">
		<execute function="Portal.AssertClick" locator1="MenuItem#MOVE_TO_THE_RECYCLE_BIN" value1="Move to the Recycle Bin" />
	</command>

	<command name="deleteViaMenuItem">
		<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#ROW_VERTICAL_ELLIPSIS">
			<var name="key_rowEntry" value="${rowEntry}" />
		</execute>

		<execute function="Portal.AssertClickNoError" locator1="MenuItem#ANY_MENU_ITEM" value1="Delete">
			<var name="key_menuItem" value="Delete" />
		</execute>

		<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />
	</command>

	<command name="deleteViaToolbar">
		<for list="${rowEntries}" param="rowEntry">
			<execute macro="LexiconEntry#selectEntry">
				<var name="key_rowEntry" value="${rowEntry}" />
			</execute>
		</for>

		<execute function="Portal.ClickNoError" locator1="Icon#DELETE" />

		<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />
	</command>

	<command name="inputDescription">
		<execute function="Portal.Type" locator1="TextArea#DESCRIPTION" value1="${description}" />
	</command>

	<command name="inputLocalizedName">
		<execute function="Portal.Click" locator1="Language#SITE_NAME_TRANSLATION">
			<var name="key_language" value="${language}" />
		</execute>

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${localizedName}" />
		</execute>
	</command>

	<command name="inputName">
		<execute function="Portal.Type" locator1="TextInput#NAME" value1="${name}" />
	</command>

	<command name="inputTitle">
		<execute function="Portal.Type" locator1="TextInput#TITLE" value1="${title}" />
	</command>

	<command name="publish">
		<execute macro="Button#clickPublish" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="publishAndWait">
		<execute macro="Button#clickPublish" />

		<execute function="Portal.Pause" locator1="3000" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="save">
		<execute macro="Button#clickSave" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>
</definition>