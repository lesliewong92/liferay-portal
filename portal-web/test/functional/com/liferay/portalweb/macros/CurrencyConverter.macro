<definition>
	<command name="convertPG">
		<execute function="Portal.Type" locator1="CurrencyConverter#NUMBER_FIELD" value1="${currencyValue}" />

		<execute function="Portal.Select" locator1="CurrencyConverter#FROM_SELECT" value1="${currencyFrom}" />

		<execute function="Portal.Select" locator1="CurrencyConverter#TO_SELECT" value1="${currencyTo}" />

		<execute function="Portal.AssertClick" locator1="Button#CONVERT" value1="Convert" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="CurrencyConverter#DATA_TABLE_FROM" value1="${currencyDataFrom}" />
		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="CurrencyConverter#DATA_TABLE_TO" value1="${currencyDataTo}" />
		<execute function="Portal.AssertElementPresent" locator1="CurrencyConverter#DATA_GRAPH" />
	</command>
</definition>