<definition>
	<command name="changePagination">
		<execute function="Portal.Click" locator1="Pagination#ITEMS_PER_PAGE_SELECT" />

		<var name="key_itemsPerPage" value="${itemsPerPage}" />

		<execute function="Portal.AssertClick" locator1="MenuItem#ITEMS_PER_PAGE" value1="${itemsPerPage}" />

		<execute function="Portal.AssertTextEquals" locator1="Pagination#ITEMS_PER_PAGE_SELECT" value1="${itemsPerPage} Entries" />
	</command>

	<command name="viewResults">
		<execute function="Portal.AssertTextEquals" locator1="Pagination#RESULTS" value1="${results}" />
	</command>
</definition>