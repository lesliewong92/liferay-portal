<definition>
	<var name="passwordPolicyName" value="Default Password Policy" />

	<command name="enableDefaultPasswordPolicyLockout">
		<var name="key_panelHeading" value="Lockout" />

		<if>
			<condition function="Portal.IsElementPresent#isElementPresentAfterWait" locator1="Panel#PANEL_HEADING_COLLAPSED" />
			<then>
				<execute macro="Panel#expandPanel">
					<var name="panelHeading" value="Lockout" />
				</execute>
			</then>
		</if>

		<execute function="Portal.Check#checkToggleSwitch" locator1="Checkbox#ENABLE_LOCKOUT" />

		<execute function="Portal.AssertTextEquals" locator1="TextInput#MAXIMUM_FAILURE" value1="3" />

		<execute macro="PortletEntry#save" />
	</command>

	<command name="tearDownCP">
		<execute macro="ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Password Policies" />
		</execute>

		<var name="key_passwordPolicyName" value="${passwordPolicyName}" />

		<execute function="Portal.Click" locator1="PasswordPolicies#PASSWORD_POLICY_TABLE_ACTIONS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#EDIT" value1="Edit" />

		<execute function="Portal.Uncheck" locator1="Checkbox#ENABLE_LOCKOUT" />

		<execute macro="PortletEntry#save" />
	</command>

	<command name="viewAssignMemberCP">
		<var name="key_passwordPolicyName" value="${passwordPolicyName}" />

		<execute function="Portal.AssertTextEquals" locator1="PasswordPolicies#PASSWORD_POLICY_TABLE_NAME" value1="${passwordPolicyName}" />

		<execute function="Portal.Click" locator1="PasswordPolicies#PASSWORD_POLICY_TABLE_ACTIONS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#ASSIGN_MEMBERS" value1="Assign Members" />

		<var name="key_userScreenName" value="${userScreenName}" />

		<execute function="Portal.AssertChecked" locator1="UsersAndOrganizationsAssignUsers#USER_TABLE_CHECKBOX" />
		<execute function="Portal.AssertTextEquals" locator1="UsersAndOrganizationsAssignUsers#USER_TABLE_SCREEN_NAME" value1="${userScreenName}" />
	</command>

	<command name="viewDefaultPasswordPolicyLockout">
		<var name="key_panelHeading" value="Lockout" />

		<if>
			<condition function="Portal.IsElementPresent#isElementPresentAfterWait" locator1="Panel#PANEL_HEADING_COLLAPSED" />
			<then>
				<execute macro="Panel#expandPanel">
					<var name="panelHeading" value="Lockout" />
				</execute>
			</then>
		</if>

		<execute function="Portal.AssertChecked#assertCheckedToggleSwitch" locator1="Checkbox#ENABLE_LOCKOUT" />

		<execute function="Portal.AssertTextEquals" locator1="TextInput#MAXIMUM_FAILURE" value1="3" />
	</command>
</definition>