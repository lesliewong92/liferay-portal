<definition>
	<var name="assetType" value="Documents Folder" />

	<command name="addCP">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Portal.Click" locator1="Button#PLUS" />

		<execute function="Portal.AssertClick#assertTextClickAt" locator1="MenuItem#FOLDER" value1="Folder" />

		<execute function="Portal.Pause" locator1="1000" />

		<execute function="Portal.Type" locator1="DocumentsAndMediaEditFolder#NAME_FIELD" value1="${dmFolderName}" />

		<if>
			<isset var="dmFolderDescription" />
			<then>
				<execute function="Portal.Type" locator1="DocumentsAndMediaEditFolder#DESCRIPTION_FIELD" value1="${dmFolderDescription}" />
			</then>
		</if>

		<execute macro="PortletEntry#save" />
		<execute function="Portal.AssertElementPresent" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" />

		<execute function="Portal.MakeVisible" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL_GENERIC" />

		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMedia#ICON_FOLDER_TITLE" value1="${dmFolderName}" />
	</command>

	<command name="addPG">
		<execute macro="Portlet#clickPortletPlusIconPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute function="Portal.AssertClick#assertTextClickAt" locator1="MenuItem#FOLDER" value1="Folder" />

		<execute function="Portal.Pause" locator1="1000" />

		<execute function="Portal.Type" locator1="DocumentsAndMediaEditFolder#NAME_FIELD" value1="${dmFolderName}" />
		<execute function="Portal.Type" locator1="DocumentsAndMediaEditFolder#DESCRIPTION_FIELD" value1="${dmFolderDescription}" />

		<if>
			<isset var="viewableBy" />
			<then>
				<execute macro="Panel#expandPanel">
					<var name="panelHeading" value="Permissions" />
				</execute>

				<execute function="Portal.Select" locator1="DocumentsAndMediaEditFolder#PERMISSIONS_SELECT" value1="${viewableBy}" />
			</then>
		</if>

		<execute macro="Button#clickSave" />

		<if>
			<equals arg1="${dmFolder}" arg2="Duplicate" />
			<then>
				<execute macro="Alert#viewRequestFailedToComplete" />

				<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="Please enter a unique folder name." />
			</then>
			<elseif>
				<equals arg1="${dmFolder}" arg2="Invalid" />
				<then>
					<execute macro="Alert#viewRequestFailedToComplete" />

					<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="The Folder Name cannot contain the following invalid characters: \ // : * ? &quot; &lt; &gt; | ../ /..." />
				</then>
			</elseif>
			<else>
				<execute macro="Alert#viewSuccessMessage" />
			</else>
		</if>
	</command>

	<command name="addPGViaMG">
		<execute macro="Portlet#clickPortletPlusIconPG">
			<var name="portletName" value="Media Gallery" />
		</execute>

		<execute function="Portal.AssertClick#assertTextClickAt" locator1="MenuItem#ADD_FOLDER" value1="Folder" />

		<execute function="Portal.Pause" locator1="1000" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${mgFolderName}" />
		</execute>

		<execute macro="PortletEntry#inputDescription">
			<var name="description" value="${mgFolderDescription}" />
		</execute>

		<execute macro="PortletEntry#save" />

		<var name="key_mgFolderName" value="${mgFolderName}" />

		<execute function="Portal.AssertTextEquals" locator1="MediaGallery#FOLDER_NAME" value1="${mgFolderName}" />
	</command>

	<command name="addSubfolderCP">
		<execute function="Portal.Click#makeVisibleClickAt" locator1="Button#PLUS" />

		<execute function="Portal.AssertClick#assertTextClickAt" locator1="MenuItem#SUBFOLDER" value1="Subfolder" />

		<execute function="Portal.Pause" locator1="1000" />

		<execute function="Portal.Type" locator1="DocumentsAndMediaEditFolder#NAME_FIELD" value1="${dmSubFolderName}" />

		<if>
			<isset var="dmSubFolderDescription" />
			<then>
				<execute function="Portal.Type" locator1="DocumentsAndMediaEditFolder#DESCRIPTION_FIELD" value1="${dmSubFolderDescription}" />
			</then>
		</if>

		<execute macro="Button#clickSave" />

		<if>
			<equals arg1="${dmSubFolder}" arg2="Duplicate" />
			<then>
				<execute macro="Alert#viewRequestFailedToComplete" />

				<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="Please enter a unique folder name." />
			</then>
			<elseif>
				<equals arg1="${dmSubFolder}" arg2="Invalid" />
				<then>
					<execute macro="Alert#viewRequestFailedToComplete" />

					<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="Please enter a valid name." />
				</then>
			</elseif>
			<else>
				<execute macro="Alert#viewSuccessMessage" />
			</else>
		</if>
	</command>

	<command name="addSubfolderPG">
		<execute macro="Portlet#clickPortletPlusIconPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute function="Portal.AssertClick#assertTextClickAt" locator1="MenuItem#SUBFOLDER" value1="Subfolder" />

		<execute function="Portal.Pause" locator1="1000" />

		<execute function="Portal.Type" locator1="DocumentsAndMediaEditFolder#NAME_FIELD" value1="${dmSubFolderName}" />

		<if>
			<isset var="dmSubFolderDescription" />
			<then>
				<execute function="Portal.Type" locator1="DocumentsAndMediaEditFolder#DESCRIPTION_FIELD" value1="${dmSubFolderDescription}" />
			</then>
		</if>

		<execute macro="Button#clickSave" />

		<if>
			<equals arg1="${dmSubFolder}" arg2="Duplicate" />
			<then>
				<execute macro="Alert#viewRequestFailedToComplete" />

				<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="Please enter a unique folder name." />
			</then>
			<elseif>
				<equals arg1="${dmSubFolder}" arg2="Invalid" />
				<then>
					<execute macro="Alert#viewRequestFailedToComplete" />

					<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="Please enter a valid name." />
				</then>
			</elseif>
			<else>
				<execute macro="Alert#viewSuccessMessage" />
			</else>
		</if>
	</command>

	<command name="addSubfolderPGViaMG">
		<execute macro="Portlet#clickPortletPlusIconPG">
			<var name="portletName" value="Media Gallery" />
		</execute>

		<execute function="Portal.AssertClick#assertTextClickAt" locator1="MenuItem#ADD_SUBFOLDER" value1="Subfolder" />

		<execute function="Portal.Pause" locator1="1000" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${mgSubfolderName}" />
		</execute>

		<execute macro="PortletEntry#inputDescription">
			<var name="description" value="${mgSubfolderDescription}" />
		</execute>

		<execute macro="PortletEntry#save" />
	</command>

	<command name="cannotViewCP">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Portal.AssertElementNotPresent" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" />
	</command>

	<command name="configureWorkflowCP">
		<execute macro="DMFolder#gotoEditCP">
			<var name="folderName" value="${dmFolderName}" />
		</execute>

		<if>
			<condition function="Portal.IsElementNotPresent#isNotVisible" locator1="DocumentsAndMediaEditFolder#WORKFLOW_PARENT_FOLDER_RADIO" />
			<then>
				<execute function="Portal.Click" locator1="DocumentsAndMediaEditFolder#WORKFLOW_DOCUMENT_TYPE_RESTRICTIONS_TOGGLE" />
			</then>
		</if>

		<if>
			<equals arg1="${workflowRestriction}" arg2="Parent Folder" />
			<then>
				<execute function="Portal.Click" locator1="DocumentsAndMediaEditFolder#WORKFLOW_PARENT_FOLDER_RADIO" />

				<execute macro="Button#clickSave" />
			</then>
			<elseif>
				<equals arg1="${workflowRestriction}" arg2="Specific Restrictions" />
				<then>
					<execute function="Portal.Click" locator1="DocumentsAndMediaEditFolder#WORKFLOW_SPECIFIC_RESTRICTIONS_RADIO" />

					<execute function="Portal.AssertClick" locator1="DocumentsAndMediaEditFolder#WORKFLOW_SPECIFIC_RESTRICTIONS_SELECT_DOCUMENT_TYPE_BUTTON" value1="Select Document Type" />

					<execute function="Portal.SelectFrame" value1="relative=top" />

					<execute function="Portal.SelectFrame" locator1="DocumentsAndMediaSelectDocument#SELECT_DOCUMENT_IFRAME" />

					<var name="key_dmDocumentTypeName" value="${dmDocumentTypeName}" />

					<execute function="Portal.AssertClick" locator1="DocumentsAndMediaSelectDocument#DOCUMENTS_TABLE_CHOOSE" value1="Choose" />

					<execute function="Portal.SelectFrameTop" value1="relative=top" />

					<execute function="Portal.Select" locator1="DocumentsAndMediaEditFolder#WORKFLOW_SPECIFIC_RESTRICTIONS_TYPE_WORKFLOW_SELECT" value1="${workflowDefinition}" />

					<execute function="Portal.AssertClickNoError" locator1="Button#SAVE" value1="Save" />

					<execute function="Portal.Confirm" value1="You are making changes to the document types. If a document in this folder or its subfolders is currently in draft or pending workflow states, you may lose some or all of its metadata. A new version will be created for all other documents. Are you sure you wish to continue?" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${workflowRestriction}" arg2="Default Workflow" />
				<then>
					<execute function="Portal.Click" locator1="DocumentsAndMediaEditFolder#WORKFLOW_DEFAULT_WORKFLOW_RADIO" />

					<execute function="Portal.Select" locator1="DocumentsAndMediaEditFolder#WORKFLOW_DEFAULT_WORKFLOW_WORKFLOW_SELECT" value1="${workflowDefinition}" />

					<execute macro="Button#clickSave" />
				</then>
			</elseif>
		</if>

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="deleteCP">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Portal.Click" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_VERTICAL_ELLIPSIS" />

		<if>
			<isset var="recycleBinDisabled" />
			<then>
				<execute function="Portal.AssertClickNoError" locator1="MenuItem#DELETE" value1="Delete" />

				<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

				<execute macro="Alert#viewSuccessMessage" />
			</then>
			<else>
				<execute macro="PortletEntry#clickMoveToRecycleBin" />

				<execute function="Portal.AssertElementPresent" locator1="Message#SUCCESS" />
			</else>
		</if>
	</command>

	<command name="deletePG">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="${dmFolderName}" />

		<execute function="Portal.Check" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_CHECKBOX" />

		<execute function="Portal.Click" locator1="Icon#MOVE_TO_RECYCLE_BIN" />

		<execute function="Portal.AssertElementPresent" locator1="Message#SUCCESS" />
		<execute function="Portal.AssertElementNotPresent" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_ICON" />
	</command>

	<command name="editCP">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Portal.AssertElementPresent" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" />
		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" value1="${dmFolderName}" />

		<execute function="Portal.MouseOver" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" />

		<execute function="Portal.AssertElementPresent" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_VERTICAL_ELLIPSIS" />

		<execute function="Portal.Click" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertElementPresent" locator1="MenuItem#EDIT" />

		<execute function="Portal.AssertClick" locator1="MenuItem#EDIT" value1="Edit" />

		<execute function="Portal.Type" locator1="DocumentsAndMediaEditFolder#NAME_FIELD" value1="${dmFolderNameEdit}" />
		<execute function="Portal.Type" locator1="DocumentsAndMediaEditFolder#DESCRIPTION_FIELD" value1="${dmFolderDescriptionEdit}" />

		<execute macro="PortletEntry#save" />

		<execute function="Portal.AssertElementPresent" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" />
		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" value1="${dmFolderNameEdit}" />
	</command>

	<command name="editPG">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="${dmFolderName}" />

		<execute function="Portal.Click" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#EDIT" value1="Edit" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${dmFolderNameEdit}" />
		</execute>

		<execute macro="PortletEntry#inputDescription">
			<var name="description" value="${dmFolderDescriptionEdit}" />
		</execute>

		<execute macro="Button#clickSave" />

		<var name="key_dmFolderNameEdit" value="${dmFolderNameEdit}" />

		<execute macro="Alert#viewSuccessMessage" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_EDITED_TITLE" value1="${dmFolderNameEdit}" />
	</command>

	<command name="editPGViaMG">
		<execute macro="PortletEntry#clickEditFromEllipsis" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${mgFolderNameEdit}" />
		</execute>

		<execute macro="PortletEntry#inputDescription">
			<var name="description" value="${mgFolderDescriptionEdit}" />
		</execute>

		<execute macro="PortletEntry#save" />

		<var name="key_mgFolderName" value="${mgFolderName}" />

		<execute function="Portal.AssertTextEquals" locator1="MediaGallery#FOLDER_NAME" value1="${mgFolderNameEdit}" />
	</command>

	<command name="gotoCP">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Portal.MakeVisible" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL_GENERIC" />

		<execute function="Portal.AssertClick#assertTextClickAt" locator1="DocumentsAndMedia#ICON_FOLDER_TITLE" value1="${dmFolderName}" />

		<execute function="Portal.AssertVisible" locator1="DocumentsAndMedia#BREADCRUMB_FOLDER_NAME" />
	</command>

	<command name="gotoEditCP">
		<var name="key_dmFolderName" value="${folderName}" />

		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" value1="${folderName}" />

		<execute function="Portal.Click" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#EDIT" value1="Edit" />
	</command>

	<command name="gotoPGViaMG">
		<execute function="Portal.MakeVisible" locator1="MediaGallery#FOLDER_GENERIC" />

		<var name="key_mgFolderName" value="${mgFolderName}" />

		<execute function="Portal.Click" locator1="MediaGallery#FOLDER_NAME" />

		<execute function="Portal.AssertTextEquals" locator1="MediaGallery#BREADCRUMB" value1="${mgFolderName}" />
	</command>

	<command name="moveToFolderCP">
		<execute function="Portal.Click" locator1="Icon#DISPLAY_STYLE_DESCRIPTIVE" />

		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Portal.AssertElementPresent" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="${dmFolderName1}" />
		<execute function="Portal.AssertElementPresent" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="${dmFolderName2}" />

		<execute function="Portal.Click" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_VERTICAL_ELLIPSIS" value1="${dmFolderName2}" />

		<execute function="Portal.AssertElementPresent" locator1="MenuItem#MOVE" />

		<execute function="Portal.AssertClick" locator1="MenuItem#MOVE" value1="Move" />

		<execute function="Portal.AssertClick" locator1="Button#SELECT" value1="Select" />

		<execute function="Portal.SelectFrame" locator1="DocumentsAndMediaSelectFolder#SELECT_FOLDER_IFRAME" />

		<var name="key_dmFolderName" value="${dmFolderName1}" />

		<execute function="Portal.AssertClick" locator1="DocumentsAndMediaSelectFolder#CHOOSE_BUTTON" value1="Choose" />

		<execute function="Portal.SelectFrame" locator1="relative=top" />

		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMediaEditDocument#FOLDER" value1="${dmFolderName1}" />

		<execute function="Portal.AssertClick" locator1="Button#MOVE" value1="Move" />

		<var name="key_dmFolderName" value="${dmFolderName2}" />

		<execute macro="Alert#viewSuccessMessage" />
		<execute function="Portal.AssertElementNotPresent" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="${dmFolderName2}" />

		<var name="key_dmFolderName" value="${dmFolderName1}" />

		<execute function="Portal.Click" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="${dmFolderName1}" />

		<var name="key_dmFolderName" value="${dmFolderName2}" />

		<execute function="Portal.AssertElementPresent" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="${dmFolderName2}" />
	</command>

	<command name="moveToRecycleBinCP">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Portal.AssertElementPresent" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" />
		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" value1="${dmFolderName}" />

		<execute function="Portal.Click" locator1="DocumentsAndMedia#ICON_FOLDER_CHECKBOX" />

		<execute function="Portal.Click" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_VERTICAL_ELLIPSIS" />

		<execute macro="PortletEntry#clickMoveToRecycleBin" />

		<execute function="Portal.AssertElementPresent" locator1="Message#SUCCESS" />
		<execute function="Portal.AssertTextEquals" locator1="Message#EMPTY_INFO" value1="There are no documents or media files in this folder." />
	</command>

	<command name="removeFolderViewPermissionsPG">
		<var name="key_dmFolderName" value="${dmFolderName}" />
		<var method="StringUtil#lowerCase('${key_roleTitle}')" name="key_roleTitle" />

		<execute function="Portal.Check" locator1="DocumentsAndMedia#ICON_FOLDER_CHECKBOX" />

		<execute function="Portal.Click" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#PERMISSIONS" value1="Permissions" />

		<execute macro="IFrame#selectPermissionsFrame" />

		<execute function="Portal.Uncheck" locator1="Permissions#CONFIGURATION_PERMISSIONS_VIEW_CHECKBOX" />

		<execute macro="Button#clickSave" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Permissions#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute function="Portal.SelectFrame" value1="relative=top" />
	</command>

	<command name="subscribePG">
		<execute function="Portal.Click" locator1="Icon#INFO" />

		<execute function="Portal.Click" locator1="Icon#SUBSCRIBE" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="tearDownCP">
		<execute macro="Navigator#openURL" />

		<execute macro="ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<if>
			<condition function="Portal.IsElementNotPresent" locator1="Message#EMPTY_INFO" />
			<then>
				<execute function="Portal.Check" locator1="DocumentsAndMedia#TOOLBAR_SELECT_ALL_CHECKBOX" />

				<execute function="Portal.AssertClick#waitForDMHomeAssertTextEqualsClick" locator1="DocumentsAndMedia#TOOLBAR_ACTIONS" value1="Actions" />

				<execute function="Portal.AssertElementPresent" locator1="MenuItem#MOVE_TO_THE_RECYCLE_BIN" />

				<execute macro="PortletEntry#clickMoveToRecycleBin" />
			</then>
		</if>

		<execute macro="Navigator#openURL" />

		<execute macro="ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="RecycleBin#emptyCP" />
	</command>

	<command name="tearDownPGViaMG" >
		<execute macro="Navigator#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<while>
			<condition function="Portal.IsElementPresent" locator1="MediaGallery#ENTRIES_FOLDER" />
			<then>
				<execute function="Portal.Click" locator1="MediaGallery#ENTRIES_FOLDER" />

				<execute function="Portal.AssertClick" locator1="MediaGallery#ENTRY_RECYCLE_BIN_ICON" value1="Move to the Recycle Bin" />

				<execute function="Portal.AssertElementPresent" locator1="Message#SUCCESS" />
			</then>
		</while>

		<execute macro="Navigator#openURL" />

		<execute macro="ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="RecycleBin#emptyCP" />
	</command>

	<command name="viewCP">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<if>
			<condition function="Portal.IsElementPresent" locator1="Icon#DISPLAY_STYLE_DESCRIPTIVE_ACTIVE" />
			<then>
				<execute function="Portal.AssertElementPresent" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_ICON" />
				<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="${dmFolderName}" />

				<execute function="Portal.AssertClick" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="${dmFolderName}" />
			</then>
			<else>
				<execute function="Portal.AssertElementPresent" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" />
				<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" value1="${dmFolderName}" />

				<execute function="Portal.AssertClick" locator1="DocumentsAndMedia#ICON_FOLDER_TITLE" value1="${dmFolderName}" />
			</else>
		</if>

		<var method="StringUtil#upperCase('${dmFolderName}')" name="dmFolderNameUpperCase" />

		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMedia#BREADCRUMB_LAST" value1="${dmFolderNameUpperCase}" />
	</command>

	<command name="viewDefaultCP">
		<execute function="Portal.AssertElementNotPresent" locator1="DocumentsAndMedia#ICON_DOCUMENT_GENERIC" />
		<execute function="Portal.AssertTextEquals" locator1="Message#EMPTY_INFO" value1="There are no documents or media files in this folder." />
	</command>

	<command name="viewEditCP">
		<var name="key_dmFolderName" value="${dmFolderNameEdit}" />

		<execute function="Portal.AssertElementPresent" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL" />

		<execute function="Portal.MakeVisible" locator1="DocumentsAndMedia#ICON_FOLDER_THUMBNAIL_GENERIC" />

		<execute function="Portal.AssertClick" locator1="DocumentsAndMedia#ICON_FOLDER_TITLE" value1="${dmFolderNameEdit}" />

		<var method="StringUtil#upperCase('${dmFolderNameEdit}')" name="dmFolderNameEditUpperCase" />

		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMedia#BREADCRUMB_LAST" value1="${dmFolderNameEditUpperCase}" />
	</command>

	<command name="viewFolderViewPermissionsPG">
		<var name="key_dmFolderName" value="${dmFolder}" />
		<var method="StringUtil#lowerCase('${key_roleTitle}')" name="key_roleTitle" />

		<execute function="Portal.Check" locator1="DocumentsAndMedia#ICON_FOLDER_CHECKBOX" />

		<execute function="Portal.Click" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#PERMISSIONS" value1="Permissions" />

		<execute macro="IFrame#selectPermissionsFrame" />

		<if>
			<equals arg1="${viewPermissionValue}" arg2="checked" />
			<then>
				<execute function="Portal.AssertChecked" locator1="Permissions#CONTENT_PERMISSIONS_VIEW_CHECKBOX" value1="${roleTitle}" />
			</then>
			<elseif>
				<equals arg1="${viewPermissionValue}" arg2="unchecked" />
				<then>
					<execute function="Portal.AssertNotChecked" locator1="Permissions#CONTENT_PERMISSIONS_VIEW_CHECKBOX" value1="${roleTitle}" />
				</then>
			</elseif>
			<else>
				<execute function="Portal.AssertChecked" locator1="Permissions#CONTENT_PERMISSIONS_VIEW_CHECKBOX" value1="${roleTitle}" />
			</else>
		</if>

		<execute function="Portal.SelectFrame" value1="relative=top" />
	</command>

	<command name="viewPG">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<var method="StringUtil#upperCase('${dmFolderName}')" name="dmFolderNameUpperCase" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="DocumentsAndMedia#BREADCRUMB_FOLDER_NAME" value1="${dmFolderNameUpperCase}" />
	</command>

	<command name="viewPGViaMG">
		<execute function="Portal.MakeVisible" locator1="MediaGallery#FOLDER_GENERIC" />

		<var name="key_mgFolderName" value="${mgFolderName}" />

		<execute function="Portal.Click" locator1="MediaGallery#FOLDER_NAME" />

		<execute function="Portal.AssertTextEquals" locator1="MediaGallery#FOLDER_HEADER_TITLE" value1="${mgFolderName}" />
	</command>
</definition>