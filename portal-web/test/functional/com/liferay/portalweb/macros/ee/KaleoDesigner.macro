<definition>
	<command name="addConnectorAndNodeViaViewTab">
		<var method="StringUtil#replace('${nodeType}', '-', '_')" name="key_nodeType" />

		<if>
			<equals arg1="${down}" arg2="true" />
			<then>
				<execute function="Portal.SikuliDragAndDrop" locator1="KaleoDesignerEditWorkflow#NODE_CORNER" value1="50,100" />
			</then>
			<elseif>
				<equals arg1="${up}" arg2="true" />
				<then>
					<execute function="Portal.SikuliDragAndDrop" locator1="KaleoDesignerEditWorkflow#NODE_CORNER" value1="150,-250" />
				</then>
			</elseif>
			<else>
				<execute function="Portal.SikuliDragAndDrop" locator1="KaleoDesignerEditWorkflow#NODE_CORNER" value1="100,0" />
			</else>
		</if>

		<var name="key_newNode" value="${newNode}" />

		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_ADD_NEW_NODE" value1="${newNode}" />
		<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_CONNECTOR_DEFAULT" />

		<execute macro="KaleoDesigner#editConnectorName">
			<var name="connectorName" value="${connectorName}" />
		</execute>

		<var name="key_nodeType" value="${newNodeType}" />

		<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_NODE_DEFAULT" />

		<execute macro="KaleoDesigner#editNodeName">
			<var name="nodeName" value="${newNodeName}" />
		</execute>

		<execute macro="KaleoDesigner#editNodeDescription">
			<var name="nodeDescription" value="${newNodeDescription}" />
		</execute>
	</command>

	<command name="addConnectorViaViewTab">
		<var method="StringUtil#replace('${nodeType}', '-', '_')" name="key_nodeType" />

		<execute function="Portal.SikuliMouseMove" locator1="KaleoDesignerEditWorkflow#NODE_CORNER" />
		<execute function="Portal.SikuliLeftMouseDown" />

		<var method="StringUtil#replace('${nodeTypeDestination}', '-', '_')" name="key_nodeType" />

		<execute function="Portal.SikuliMouseMove" locator1="KaleoDesignerEditWorkflow#NODE_CORNER" />
		<execute function="Portal.SikuliLeftMouseUp" />
		<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_CONNECTOR_DEFAULT" />

		<execute macro="KaleoDesigner#editConnectorName">
			<var name="connectorName" value="${connectorName}" />
		</execute>
	</command>

	<command name="addNewDefinitionViaKDCP">
		<execute function="Portal.Click" locator1="Button#PLUS" />

		<execute macro="PortletEntry#inputTitle">
			<var name="title" value="${workflowDefinitionTitle}" />
		</execute>
	</command>

	<command name="addNewDefinitionViaWorkflowCP">
		<execute function="Portal.Click" locator1="Button#PLUS" />

		<execute macro="PortletEntry#inputTitle">
			<var name="title" value="${workflowDefinitionTitle}" />
		</execute>
	</command>

	<command name="addNodeSettingsSection">
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_ADD_SECTION" value1="Add Section" />
	</command>

	<command name="addNodeViaSourceXML">
		<if>
			<equals arg1="${nodeType}" arg2="task" />
			<then>
				<var name="sourceXML" >
<![CDATA[
<?xml version="1.0"?>
<workflow-definition xmlns="urn:liferay.com:liferay-workflow_6.2.0"${line.separator} xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"${line.separator} xsi:schemaLocation="urn:liferay.com:liferay-workflow_6.2.0 http://www.liferay.com/dtd/liferay-workflow-definition_6_2_0.xsd">${line.separator}
	<name>Task</name>${line.separator}
	<description>${line.separator}
	</description>${line.separator}
	<version>1</version>${line.separator}
	<task>${line.separator}
		<name>Task</name>${line.separator}
		<metadata>${line.separator}
		</metadata>${line.separator}
		<assignments>${line.separator}
			<user/>${line.separator}
		</assignments>${line.separator}
	</task>${line.separator}
</workflow-definition>${line.separator}
]]>
				</var>
			</then>
		</if>

		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_TAB" value1="Source (Kaleo XML)" />
		<execute function="Portal.Pause" locator1="1000" />
		<execute function="Portal.Type#typeAceEditorNoMouseOver" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_CONTENT" value1="${sourceXML}" />
		<execute function="Portal.Pause" locator1="1000" />
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#VIEW_TAB" value1="View" />
		<execute function="Portal.Pause" locator1="1000" />
	</command>

	<command name="addNodeViaViewTab">
		<execute function="Portal.AssertClick#pauseAssertTextClickAt" locator1="KaleoDesignerEditWorkflow#NODES_TAB" value1="Nodes" />

		<var method="StringUtil#replace('${nodeType}', '-', '_')" name="key_nodeType" />

		<execute function="Portal.SikuliDragAndDrop" locator1="KaleoDesignerEditWorkflow#NODE_PNG" value1="250,0" />

		<var name="key_nodeType" value="${nodeType}" />

		<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_NODE_DEFAULT" />

		<execute macro="KaleoDesigner#editNodeName">
			<var name="nodeName" value="${nodeName}" />
		</execute>

		<execute macro="KaleoDesigner#editNodeDescription">
			<var name="nodeDescription" value="${nodeDescription}" />
		</execute>
	</command>

	<command name="addSourceXMLBasicDefinition">
		<var name="sourceXML" >
<![CDATA[
<?xml version="1.0"?>
<workflow-definition${line.separator} xmlns="urn:liferay.com:liferay-workflow_6.2.0"${line.separator} xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"${line.separator} xsi:schemaLocation="urn:liferay.com:liferay-workflow_6.2.0 http://www.liferay.com/dtd/liferay-workflow-definition_6_2_0.xsd">${line.separator}
<name>Workflow Definition Name</name>${line.separator}${line.separator}

<description>${line.separator}
</description>${line.separator}${line.separator}

<version>1</version>${line.separator}${line.separator}

<state>${line.separator}
<name>TestStartNode</name>${line.separator}${line.separator}

<metadata>${line.separator}
</metadata>${line.separator}${line.separator}

<initial>true</initial>${line.separator}${line.separator}

<transitions>${line.separator}
<transition>${line.separator}
<name>connector1443</name>${line.separator}${line.separator}

<target>EndNode</target>${line.separator}${line.separator}

<default>true</default>${line.separator}
</transition>${line.separator}
</transitions>${line.separator}
</state>${line.separator}${line.separator}

<state>${line.separator}
<name>EndNode</name>${line.separator}${line.separator}

<metadata>${line.separator}
</metadata>${line.separator}${line.separator}

<actions>${line.separator}
<action>${line.separator}
<name>Approve</name>${line.separator}${line.separator}

<description>Approve</description>${line.separator}${line.separator}

<script>${line.separator}
</script>${line.separator}${line.separator}

<script-language>javascript</script-language>${line.separator}${line.separator}

<execution-type>onEntry</execution-type>${line.separator}
</action>${line.separator}
</actions>${line.separator}
</state>${line.separator}
</workflow-definition>
]]>
		</var>
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_TAB" value1="Source (Kaleo XML)" />
		<execute function="Portal.Pause" locator1="1000" />
		<execute function="Portal.Type#typeAceEditorNoMouseOver" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_CONTENT" value1="${sourceXML}" />
		<execute function="Portal.Pause" locator1="1000" />
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#VIEW_TAB" value1="View" />
		<execute function="Portal.Pause" locator1="1000" />
	</command>

	<command name="deleteConnector">
		<var name="key_connectorLabel" value="${connectorLabel}" />

		<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_CONNECTOR" />
		<execute function="Portal.KeyPress#keyPressNoError" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_CONNECTOR" value1="\DELETE" />
		<execute function="Portal.Confirm" value1="Are you sure you want to delete the selected connector(s)?" />
		<execute function="Portal.Pause" locator1="1000" />

		<execute macro="KaleoDesigner#viewConnectorNotPresent">
			<var name="connectorLabel" value="${connectorLabel}" />
		<var name="nodeNodeLabel" value="${nodeNodeLabel}" />
</execute>
	</command>

	<command name="deleteNode">
		<var name="key_nodeNodeLabel" value="${nodeNodeLabel}" />

		<execute function="Portal.ClickNoError" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_NODE_DELETE_ICON" />
		<execute function="Portal.Confirm" value1="Are you sure you want to delete the selected node(s)?" />
		<execute function="Portal.Pause" locator1="1000" />

		<execute macro="KaleoDesigner#viewNodeNotPresent">
			<var name="nodeNodeLabel" value="${nodeNodeLabel}" />
		</execute>
	</command>

	<command name="deleteTableDefinitionDraftViaKDCP">
		<var name="key_rowEntry" value="${workflowDefinitionTitle}" />

		<execute function="Portal.Click" locator1="Icon#ROW_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClickNoError" locator1="MenuItem#DELETE" value1="Delete" />

		<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="editConnectorName">
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_NAME" />
		<execute function="Portal.Type" locator1="KaleoDesignerEditWorkflow#SETTINGS_NAME_FIELD" value1="${connectorName}" />
		<execute function="Portal.AssertClick" locator1="Button#SAVE" value1="Save" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_NAME" value1="${connectorName}" />
	</command>

	<command name="editExecutionType">
		<execute function="Portal.Select" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_EXECUTION_TYPE_SELECT" value1="${nodeExecutionType}" />
	</command>

	<command name="editNodeActions">
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_ACTIONS" />
		<execute function="Portal.Type" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NAME" value1="${nodeActionsName}" />
		<execute function="Portal.Type" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_DESCRIPTION" value1="${nodeActionsDescription}" />

		<if>
			<isset var="nodeActionsScript" />
			<then>
				<execute function="Portal.Type" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_SCRIPT" value1="${nodeActionsScript}" />
			</then>
		</if>

		<if>
			<isset var="nodeActionsScriptLanguage" />
			<then>
				<execute function="Portal.Select" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_SCRIPT_LANGUAGE_SELECT" value1="${nodeActionsScriptLanguage}" />
			</then>
		</if>

		<if>
			<isset var="nodeActionsExecutionType" />
			<then>
				<execute macro="KaleoDesigner#editExecutionType">
					<var name="nodeExecutionType" value="${nodeActionsExecutionType}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="nodeActionsPriority" />
			<then>
				<execute function="Portal.Type" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_PRIORITY" value1="${nodeActionsPriority}" />
			</then>
		</if>

		<execute function="Portal.AssertClick" locator1="Button#SAVE" value1="Save" />
	</command>

	<command name="editNodeAssignments">
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_ASSIGNMENTS" />
		<execute function="Portal.Select" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_ASSIGNMENT_TYPE_SELECT" value1="${nodeAssignmentType}" />

		<if>
			<equals arg1="${nodeAssignmentType}" arg2="Role" />
			<then>
				<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_ROLE_SEARCH" />

				<var name="key_roleTitle" value="${roleTitle}" />

				<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_SEARCH_LIST_RESULT" />
			</then>
		</if>

		<execute function="Portal.AssertClick" locator1="Button#SAVE" value1="Save" />

		<if>
			<equals arg1="${nodeAssignmentType}" arg2="Role" />
			<then>
				<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_ASSIGNMENTS" value1="Role ID" />
			</then>
		</if>
	</command>

	<command name="editNodeDescription">
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_DESCRIPTION" />
		<execute function="Portal.Type" locator1="KaleoDesignerEditWorkflow#SETTINGS_DESCRIPTION_FIELD" value1="${nodeDescription}" />
		<execute function="Portal.AssertClick" locator1="Button#SAVE" value1="Save" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_DESCRIPTION" value1="${nodeDescription}" />
	</command>

	<command name="editNodeName">
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_NAME" />
		<execute function="Portal.Type" locator1="KaleoDesignerEditWorkflow#SETTINGS_NAME_FIELD" value1="${nodeName}" />
		<execute function="Portal.AssertClick" locator1="Button#SAVE" value1="Save" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_NAME" value1="${nodeName}" />
	</command>

	<command name="editNodeNotifications">
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_NOTIFICATIONS" />
		<execute function="Portal.Type" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NAME" value1="${nodeNotificationsName}" />
		<execute function="Portal.Type" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_DESCRIPTION" value1="${nodeNotificationsDescription}" />

		<if>
			<isset var="nodeNotificationsTemplateLanguage" />
			<then>
				<execute function="Portal.Select" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_TEMPLATE_LANGUAGE_SELECT" value1="${nodeNotificationsTemplateLanguage}" />
			</then>
		</if>

		<if>
			<isset var="nodeNotificationsTemplate" />
			<then>
				<execute function="Portal.Type" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_TEMPLATE" value1="${nodeNotificationsTemplate}" />
			</then>
		</if>

		<if>
			<isset var="nodeNotificationsType" />
			<then>
				<execute function="Portal.Select" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATION_TYPE_SELECT" value1="${nodeNotificationsType}" />
			</then>
		</if>

		<if>
			<isset var="nodeNotificationsExecutionType" />
			<then>
				<execute macro="KaleoDesigner#editExecutionType">
					<var name="nodeExecutionType" value="${nodeNotificationsExecutionType}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="nodeNotificationsRecipientType" />
			<then>
				<execute function="Portal.Select" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_TYPE_SELECT" value1="${nodeNotificationsRecipientType}" />

				<if>
					<equals arg1="${nodeNotificationsRecipientType}" arg2="Role" />
					<then>
						<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_ROLE_SEARCH" />

						<var name="key_roleTitle" value="${roleTitle}" />

						<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_SEARCH_LIST_RESULT" />
					</then>
				</if>

				<if>
					<equals arg1="${nodeNotificationsRecipientType}" arg2="Role Type" />
					<then>
						<execute function="Portal.Select" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_ROLE_TYPE_SELECT" value1="${roleType}" />
						<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_ROLE_NAME_SEARCH" />

						<var name="key_roleTitle" value="${roleTitle}" />

						<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_SEARCH_LIST_RESULT" />
					</then>
				</if>
			</then>
		</if>

		<execute function="Portal.Pause" locator1="1000" />
		<execute function="Portal.AssertClick" locator1="Button#SAVE" value1="Save" />
	</command>

	<command name="editNodeScript">
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_SCRIPT" />
		<execute function="Portal.Type#typeAceEditorNoMouseOver" locator1="KaleoDesignerEditWorkflow#SETTINGS_SCRIPT_CONTENT" value1="${nodeScript}" />
		<execute function="Portal.AssertClick" locator1="Button#SAVE" value1="Save" />
	</command>

	<command name="editNodeScriptLanguage">
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_SCRIPT_LANGUAGE" />
		<execute function="Portal.Select" locator1="KaleoDesignerEditWorkflow#SETTINGS_SCRIPT_LANGUAGE" value1="${nodeScriptLanguage}" />
		<execute function="Portal.AssertClick" locator1="Button#SAVE" value1="Save" />
	</command>

	<command name="editNodeSettings">
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_NAME" />
		<execute function="Portal.Type" locator1="KaleoDesignerEditWorkflow#SETTINGS_NAME_FIELD" value1="${nodeName}" />
		<execute function="Portal.AssertClick" locator1="Button#SAVE" value1="Save" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_NAME" value1="${nodeName}" />
	</command>

	<command name="editSourceXML">
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_TAB" value1="Source (Kaleo XML)" />

		<var name="key_line" value="${line}" />

		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_CONTENT_SPECIFIC_LINE" />
		<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_CONTENT_SPECIFIC_LINE" />
		<execute function="Portal.TypeScreen" locator1="${kdSourceXML}" />
	</command>

	<command name="editWorkflowDefinitionTitleViaWorkflowCP">
		<execute macro="PortletEntry#inputTitle">
			<var name="title" value="${workflowDefinitionTitle}" />
		</execute>
	</command>

	<command name="editWorkflowDefinitionViaKDCP">
		<var name="key_rowEntry" value="${workflowDefinitionTitle}" />

		<execute function="Portal.Click" locator1="Icon#ROW_VERTICAL_ELLIPSIS" />
		<execute function="Portal.AssertClick" locator1="MenuItem#EDIT" value1="Edit" />
	</command>

	<command name="editWorkflowDefinitionViaWorkflowCP">
		<var name="key_workflowDefinitionTitle" value="${workflowDefinitionTitle}" />

		<execute function="Portal.Click" locator1="WorkflowDefinition#DEFINITION_TABLE_SPECIFIC_DEFINITION_ELLIPSIS" />
		<execute function="Portal.AssertClick" locator1="MenuItem#EDIT" value1="Edit" />
	</command>

	<command name="eraseDefinitionViaSourceXML">
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_TAB" value1="Source (Kaleo XML)" />
		<execute function="Portal.Pause" locator1="1000" />
		<execute function="Portal.Type#typeAceEditorNoMouseOver" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_CONTENT" value1="" />
		<execute function="Portal.Pause" locator1="1000" />
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#VIEW_TAB" value1="View" />
		<execute function="Portal.Pause" locator1="1000" />
	</command>

	<command name="latestVersionDraft">
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#DRAFT_HISTORY_LATEST_VERSION_BUTTON" value1="Latest Version" />
	</command>

	<command name="publishInvalidWorkflowDefinitionViaWorkflowCP">
		<execute function="Portal.AssertClickNoError" locator1="Button#PUBLISH" value1="Publish" />

		<execute macro="Alert#viewRequestFailedToComplete" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="Please enter valid content." />
	</command>

	<command name="publishWorkflowDefinitionViaKDCP">
		<execute function="Portal.AssertClick" locator1="Button#PUBLISH" value1="Publish" />
		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="publishWorkflowDefinitionViaWorkflowCP">
		<execute function="Portal.AssertClick" locator1="Button#PUBLISH" value1="Publish" />
		<execute macro="Alert#viewSuccessMessage" />
		<execute function="Portal.SelectFrameTop" locator1="IFrame#DIALOG" value1="relative=top" />
	</command>

	<command name="redoDraft">
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#DRAFT_HISTORY_REDO_BUTTON" value1="Redo" />
	</command>

	<command name="removeNodeSettingsSection">
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_REMOVE_SECTION" value1="Remove" />
	</command>

	<command name="saveAsDraftWorkflowDefinitionViaKDCP">
		<execute function="Portal.AssertClick" locator1="Button#SAVE_AS_DRAFT" value1="Save as Draft" />
		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="selectNode">
		<var name="key_nodeNodeLabel" value="${nodeNodeLabel}" />

		<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_NODE" />
		<execute function="Portal.ScrollWebElementIntoView" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_NODE" />
	</command>

	<command name="showDetails">
		<if>
			<condition function="Portal.IsElementNotPresent#isNotVisible" locator1="KaleoDesignerEditWorkflow#DRAFT_VERSION_HEADER" />
			<then>
				<execute function="Portal.Click" locator1="KaleoDesignerEditWorkflow#DETAILS_TOGGLE" />
			</then>
		</if>

		<execute function="Portal.AssertVisible" locator1="KaleoDesignerEditWorkflow#DRAFT_VERSION_HEADER" />
	</command>

	<command name="undoDraft">
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#DRAFT_HISTORY_UNDO_BUTTON" value1="Undo" />
	</command>

	<command name="viewButtons">
		<execute function="Portal.AssertTextEquals" locator1="Button#PUBLISH" value1="Publish" />

		<execute function="Portal.AssertTextEquals" locator1="Button#SAVE_AS_DRAFT" value1="Save as Draft" />

		<if>
			<equals arg1="${cancelButton}" arg2="true" />
			<then>
				<execute function="Portal.AssertTextEquals" locator1="Button#CANCEL" value1="Cancel" />

				<execute function="Portal.AssertClick" locator1="Button#CANCEL" value1="Cancel" />
			</then>
		</if>
	</command>

	<command name="viewConnectorNotPresent">
		<var name="key_connectorLabel" value="${connectorLabel}" />

		<execute function="Portal.AssertElementNotPresent" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_CONNECTOR" />
	</command>

	<command name="viewConnectorPresent">
		<var name="key_connectorLabel" value="${connectorLabel}" />

		<execute function="Portal.AssertElementPresent" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_CONNECTOR" />
	</command>

	<command name="viewDraftVersion">
		<var name="key_draftVersion" value="${draftVersion}" />

		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#DRAFT_VERSION" value1="${draftVersion}" />
	</command>

	<command name="viewExecutionType">
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_EXECUTION_TYPE_SELECT" value1="${nodeExecutionType}" />
	</command>

	<command name="viewNodeActions">
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_ACTIONS" value1="${nodeActionsName}" />
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_ACTIONS" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NAME" value1="${nodeActionsName}" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_DESCRIPTION" value1="${nodeActionsDescription}" />

		<if>
			<isset var="nodeActionsScript" />
			<then>
				<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_SCRIPT" value1="${nodeActionsScript}" />
			</then>
		</if>

		<if>
			<isset var="nodeActionsScriptLanguage" />
			<then>
				<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_SCRIPT_LANGUAGE_SELECT" value1="${nodeActionsScriptLanguage}" />
			</then>
		</if>

		<if>
			<isset var="nodeActionsExecutionType" />
			<then>
				<execute macro="KaleoDesigner#viewExecutionType">
					<var name="nodeExecutionType" value="${nodeActionsExecutionType}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="nodeActionsPriority" />
			<then>
				<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_PRIORITY" value1="${nodeActionsPriority}" />
			</then>
		</if>
	</command>

	<command name="viewNodeAssignments">
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_ASSIGNMENTS" value1="${nodeAssignmentType}" />
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_ASSIGNMENTS" />
		<execute function="Portal.AssertElementPresent" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_ASSIGNMENT_TYPE_SELECT" />
	</command>

	<command name="viewNodeNotifications">
		<execute function="Portal.DoubleClick" locator1="KaleoDesignerEditWorkflow#SETTINGS_NOTIFICATIONS" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NAME" value1="${nodeNotificationsName}" />

		<if>
			<isset var="nodeNotificationsDescription" />
			<then>
				<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_DESCRIPTION" value1="${nodeNotificationsDescription}" />
			</then>
		</if>

		<if>
			<isset var="nodeNotificationsTemplateLanguage" />
			<then>
				<execute function="Portal.AssertSelectedLabel" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_TEMPLATE_LANGUAGE_SELECT" value1="${nodeNotificationsTemplateLanguage}" />
			</then>
		</if>

		<if>
			<isset var="nodeNotificationsTemplate" />
			<then>
				<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_TEMPLATE" value1="${nodeNotificationsTemplate}" />
			</then>
		</if>

		<if>
			<isset var="nodeNotificationsType" />
			<then>
				<if>
					<equals arg1="${nodeNotificationsType}" arg2="User Notification" />
					<then>
						<execute function="Portal.AssertSelectedLabel" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATION_TYPE_SELECT" value1="User Notification" />
					</then>
				</if>
			</then>
		</if>

		<if>
			<isset var="nodeNotificationsExecutionType" />
			<then>
				<execute macro="KaleoDesigner#viewExecutionType">
					<var name="nodeExecutionType" value="${nodeNotificationsExecutionType}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="nodeNotificationsRecipientType" />
			<then>
				<if>
					<equals arg1="${nodeNotificationsRecipientType}" arg2="Role" />
					<then>
						<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_TYPE_SELECT" value1="${nodeNotificationsRecipientType}" />
						<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_ROLE_SEARCH" value1="${nodeNotificationsRecipientRole}" />
					</then>
				</if>

				<if>
					<equals arg1="${nodeNotificationsRecipientType}" arg2="Role Type" />
					<then>
						<execute function="Portal.AssertSelectedLabel" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_TYPE_SELECT" value1="Role Type" />

						<if>
							<equals arg1="${nodeNotificationsRecipientType}" arg2="Role" />
							<then>
								<execute function="Portal.AssertSelectedLabel" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_ROLE_SEARCH" value1="Regular" />
							</then>
						</if>

						<if>
							<equals arg1="${roleTitle}" arg2="Administrator" />
							<then>
								<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_CELL_EDITOR_NOTIFICATIONS_RECIPIENT_EDITOR_ROLE_NAME_SEARCH" value1="Administrator" />
							</then>
						</if>
					</then>
				</if>
			</then>
		</if>
	</command>

	<command name="viewNodeNotPresent">
		<var name="key_nodeNodeLabel" value="${nodeNodeLabel}" />

		<execute function="Portal.AssertElementNotPresent" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_NODE" />
	</command>

	<command name="viewNodePresent">
		<var name="key_nodeNodeLabel" value="${nodeNodeLabel}" />

		<execute function="Portal.AssertElementPresent" locator1="KaleoDesignerEditWorkflow#VIEW_FORM_NODE" />
	</command>

	<command name="viewNodeType">
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesignerEditWorkflow#SETTINGS_TYPE" value1="${nodeType}" />
	</command>

	<command name="viewNoWorkflowDefinitionsViaKDCP">
		<var name="key_workflowDefinitionTitle" value="Single Approver" />

		<if>
			<condition function="Portal.IsElementPresent" locator1="KaleoDesigner#DEFINITION_TABLE_TITLE" />
			<then>
				<execute macro="KaleoDesigner#viewTableDefinitionPublishedViaKDCP">
					<var name="workflowDefinitionTitle" value="Single Approver" />
				</execute>
			</then>
			<else>
				<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#INFO_MESSAGE" value1="No workflow definitions are defined." />
			</else>
		</if>
	</command>

	<command name="viewSourceXMLLine">
		<execute function="Portal.ScrollWebElementIntoView" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_TAB" />

		<var name="key_line" value="${line}" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_CONTENT_SPECIFIC_LINE_CONTENT" value1="${kdSourceXML}" />
		<execute function="Portal.Pause" locator1="1000" />
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#VIEW_TAB" value1="View" />
		<execute function="Portal.Pause" locator1="1000" />
	</command>

	<command name="viewSourceXMLTab">
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#SOURCE_KALEO_XML_TAB" value1="Source (Kaleo XML)" />
		<execute function="Portal.Pause" locator1="1000" />
	</command>

	<command name="viewTableDefinitionDraftViaKDCP">
		<var name="key_workflowDefinitionTitle" value="${workflowDefinitionTitle}" />

		<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_NAME" value1="${workflowDefinitionTitle}" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_TITLE" value1="${workflowDefinitionTitle}" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_VERSION" value1="0" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_DRAFT_VERSION" value1="1" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_PUBLISHED" value1="No" />
		<execute function="Portal.AssertElementPresent" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />
	</command>

	<command name="viewTableDefinitionPublishedViaKDCP">
		<if>
			<isset var="workflowDefinitionName" />
			<then>
				<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_NAME" value1="${workflowDefinitionName}" />
			</then>
			<else>
				<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_TITLE" value1="${workflowDefinitionTitle}" />
			</else>
		</if>

		<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_TITLE" value1="${workflowDefinitionTitle}" />

		<if>
			<isset var="workflowDefinitionVersionNumber" />
			<then>
				<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_VERSION" value1="${workflowDefinitionVersionNumber}" />
			</then>
			<else>
				<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_VERSION" value1="1" />
			</else>
		</if>

		<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_DRAFT_VERSION" value1="1" />
		<execute function="Portal.AssertTextEquals" locator1="KaleoDesigner#DEFINITION_TABLE_PUBLISHED" value1="Yes" />
		<execute function="Portal.AssertElementPresent" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />
	</command>

	<command name="viewViewTab">
		<execute function="Portal.AssertClick" locator1="KaleoDesignerEditWorkflow#VIEW_TAB" value1="View" />
		<execute function="Portal.Pause" locator1="1000" />
	</command>
</definition>