<definition>
	<command name="_closeMessage">
		<if>
			<and>
				<condition function="Portal.IsElementPresent" locator1="Message#${messageType}" />
				<condition function="Portal.IsVisible" locator1="Message#${messageType}" />
				<condition function="Portal.IsVisible" locator1="Icon#CLOSE" />
			</and>
			<then>
				<execute function="Portal.Click" locator1="Icon#CLOSE" />
			</then>
		</if>
	</command>

	<command name="closeMessageSpecific">
		<var name="key_messageSpecific" value="${messageSpecific}" />

		<execute function="Portal.Click" locator1="Icon#CLOSE_SPECIFIC" />
	</command>

	<command name="closePortalLocalizationWarning">
		<execute macro="Alert#_closeMessage">
			<var name="messageType" value="PORTAL_LOCALIZATION" />
		</execute>

		<execute function="Portal.Pause" locator1="2000" />
	</command>

	<command name="viewEmptyFieldMessage">
		<var name="key_fieldLabel" value="${fieldLabel}" />

		<execute function="Portal.AssertTextEquals" locator1="Message#ERROR_EMPTY_FIELD" value1="At least one option should be set for field ${fieldLabel}." />
	</command>

	<command name="viewErrorMessage">
		<execute function="Portal.AssertTextEquals" locator1="Message#ERROR" value1="${errorMessage}" />

		<execute macro="Alert#_closeMessage">
			<var name="messageType" value="ERROR" />
		</execute>
	</command>

	<command name="viewExpireContentFailedMessage">
		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="Please enter a valid expiration date." />
	</command>

	<command name="viewFailedSiteTemplateDeletionMessage">
		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="You cannot delete site templates that are used by a site." />
	</command>

	<command name="viewRequestFailedToComplete">
		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="Message#ERROR_REQUEST_FAILED_TO_COMPLETE" value1="Your request failed to complete." />
	</command>

	<command name="viewRequiredField">
		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="TextInput#REQUIRED_ALERT" value1="This field is required." />
	</command>

	<command name="viewSuccessMessage">
		<execute macro-mobile="MobileNavigator#clickRemoveIcon" />

		<execute function="Portal.AssertVisible" locator1="Message#SUCCESS" />

		<execute function="Portal.Pause" locator1="5000" />

		<execute macro="Alert#_closeMessage">
			<var name="messageType" value="SUCCESS" />
		</execute>
	</command>

	<command name="viewSuccessMessageText">
		<execute macro-mobile="MobileNavigator#clickRemoveIcon" />

		<execute macro="Button#clickPublish" />

		<execute function="Portal.AssertVisible" locator1="Message#SUCCESS" />
		<execute function="Portal.AssertElementPresent" locator1="Message#SUCCESS" />
		<execute function="Portal.AssertTextEquals" locator1="Message#SUCCESS" value1="${sucessMessage}" />
	</command>
</definition>