<definition>
	<command name="_expandDetailsPanel">
		<if>
			<condition function="Portal.IsElementPresent" locator1="CalendarEditResource#DETAILS_PANEL_COLLAPSED" />
			<then>
				<execute function="Portal.Click" locator1="CalendarEditResource#DETAILS_PANEL_COLLAPSED" />

				<execute function="Portal.AssertElementPresent" locator1="CalendarEditResource#DETAILS_PANEL_EXPANDED" />
			</then>
		</if>
	</command>

	<command name="activate">
		<execute macro="CalendarResource#_expandDetailsPanel" />

		<execute function="Portal.Check" locator1="CalendarEditResource#DETAILS_PANEL_ACTIVE_CHECKBOX" />
	</command>

	<command name="add">
		<execute macro="CalendarNavigator#gotoAddResource" />

		<execute macro="CalendarResource#editResourceName">
			<var name="calendarResourceName" value="${calendarResourceName}" />
		</execute>

		<execute macro="CalendarResource#save" />

		<execute macro="CalendarResource#view">
			<var name="calendarResourceName" value="${calendarResourceName}" />
		</execute>
	</command>

	<command name="deactivate">
		<execute macro="CalendarResource#_expandDetailsPanel" />

		<execute function="Portal.Uncheck" locator1="CalendarEditResource#DETAILS_PANEL_ACTIVE_CHECKBOX" />
	</command>

	<command name="delete">
		<execute macro="CalendarNavigator#gotoResources" />

		<var name="key_calendarResourceName" value="${calendarResourceName}" />

		<execute function="Portal.AssertTextEquals" locator1="CalendarResources#RESOURCE_TABLE_NAME" value1="${calendarResourceName}" />

		<execute function="Portal.Click" locator1="CalendarResources#RESOURCE_TABLE_ACTIONS" />

		<execute function="Portal.AssertClickNoError" locator1="CalendarResources#RESOURCE_MENULIST_DELETE" value1="Delete" />

		<execute function="Portal.Confirm#waitForConfirmation" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="Alert#viewSuccessMessage" />

		<execute function="Portal.AssertElementNotPresent" locator1="CalendarResources#RESOURCE_TABLE_NAME" value1="${calendarResourceName}" />
		<execute function="Portal.AssertTextNotPresent" value1="${calendarResourceName}" />
	</command>

	<command name="edit">
		<execute macro="CalendarNavigator#gotoResources" />

		<var name="key_calendarResourceName" value="${calendarResourceName}" />

		<execute function="Portal.AssertTextEquals" locator1="CalendarResources#RESOURCE_TABLE_NAME" value1="${calendarResourceName}" />

		<execute function="Portal.Click" locator1="CalendarResources#RESOURCE_TABLE_ACTIONS" />

		<execute function="Portal.AssertClick" locator1="CalendarResources#RESOURCE_MENULIST_EDIT" value1="Edit" />

		<execute function="Portal.AssertTextEquals" locator1="CalendarEditResource#HEADER_TITLE" value1="${calendarResourceName}" />
		<execute function="Portal.Type" locator1="CalendarEditResource#NAME_FIELD" value1="${calendarResourceNameEdit}" />

		<execute macro="CalendarResource#save" />

		<execute macro="CalendarResource#view">
			<var name="calendarResourceName" value="${calendarResourceNameEdit}" />
		</execute>
	</command>

	<command name="editResourceName">
		<execute macro="PortletEntry#inputName">
			<var name="name" value="${calendarResourceName}" />
		</execute>
	</command>

	<command name="save">
		<execute function="Portal.Click" locator1="Button#SAVE" />

		<var name="key_calendarResourceName" value="${calendarResourceName}" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="search">
		<execute function="Portal.Type" locator1="NavBar#BASIC_SEARCH_FIELD" value1="${calendarResourceName}" />

		<execute function="Portal.Click" locator1="Icon#BASIC_SEARCH" />
	</command>

	<command name="tearDown">
		<execute macro="CalendarNavigator#gotoResources" />

		<while>
			<condition function="Portal.IsElementPresent" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />
			<then>
				<execute function="Portal.Click#waitForMenuToggleJSClick" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />

				<execute function="Portal.AssertClickNoError" locator1="CalendarResources#RESOURCE_MENULIST_DELETE" value1="Delete" />

				<execute function="Portal.Confirm#waitForConfirmation" value1="Are you sure you want to delete this? It will be deleted immediately." />

				<execute macro="Alert#viewSuccessMessage" />
			</then>
		</while>

		<execute function="Portal.AssertTextEquals" locator1="Message#EMPTY_INFO" value1="No resources were found." />
		<execute function="Portal.AssertElementNotPresent" locator1="Icon#BODY_VERTICAL_ELLIPSIS" />
	</command>

	<command name="view">
		<execute macro="CalendarNavigator#gotoResources" />

		<var name="key_calendarResourceName" value="${calendarResourceName}" />

		<execute function="Portal.AssertTextEquals" locator1="CalendarResources#RESOURCE_TABLE_NAME" value1="${calendarResourceName}" />
		<execute function="Portal.AssertTextEquals" locator1="CalendarResources#RESOURCE_TABLE_DESCRIPTION" value1="" />
		<execute function="Portal.AssertTextEquals" locator1="CalendarResources#RESOURCE_TABLE_ACTIVE" value1="Yes" />
		<execute function="Portal.AssertElementPresent" locator1="CalendarResources#RESOURCE_TABLE_ACTIONS" />
	</command>

	<command name="viewDefault">
		<execute macro="CalendarNavigator#gotoResources" />

		<var name="key_calendarResourceName" value="${calendarResourceName}" />

		<execute function="Portal.AssertTextEquals" locator1="Message#EMPTY_INFO" value1="No resources were found." />
		<execute function="Portal.AssertElementNotPresent" locator1="CalendarResources#RESOURCE_TABLE_NAME" value1="${calendarResourceName}" />
	</command>

	<command name="viewResourceCalendars">
		<var name="key_calendarResourceName" value="${calendarResourceName}" />

		<execute function="Portal.AssertTextEquals" locator1="CalendarResources#RESOURCE_TABLE_NAME" value1="${calendarResourceName}" />
		<execute function="Portal.AssertTextEquals" locator1="CalendarEditResource#HEADER_TITLE" value1="${calendarResourceName}'s Calendars" />
	</command>

	<command name="viewResourceName">
		<var name="key_calendarResourceName" value="${calendarResourceName}" />

		<execute function="Portal.AssertTextEquals" locator1="CalendarResources#RESOURCE_TABLE_NAME" value1="${calendarResourceName}" />
	</command>

	<command name="viewResourceNameNotPresent">
		<var name="key_calendarResourceName" value="${calendarResourceName}" />

		<execute function="Portal.AssertElementNotPresent" locator1="CalendarResources#RESOURCE_TABLE_NAME" value1="${calendarResourceName}" />
		<execute function="Portal.AssertTextNotPresent" value1="${calendarResourceName}" />
	</command>
</definition>