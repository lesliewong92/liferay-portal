<definition>
	<command name="configureConfigurationAdminXSL">
		<var name="key_configurationAdminName" value="XSL Content Options" />

		<while>
			<condition function="Portal.IsElementNotPresent" locator1="ConfigurationAdmin#CONFIGURATION_ADMIN_NAME_LINK" />
			<then>
				<execute function="Portal.Click" locator1="Icon#CARET_RIGHT" />

				<execute function="Portal.Pause" value1="1000" />
			</then>
		</while>

		<execute function="Portal.Click" locator1="ConfigurationAdmin#CONFIGURATION_ADMIN_NAME_LINK" />

		<execute function="Portal.Type" locator1="TextArea#URL" value1="@portlet_context_url@,@portal_url@" />

		<execute function="Portal.Check" locator1="ConfigurationAdmin#XSL_CONTENT_CONFIGURATION_XML_DOCTYPE_DECLARATION_CHECKBOX" />

		<execute function="Portal.Click" locator1="Button#SAVE" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="configureXSLContentPortlet">
		<execute function="Portal.SelectFrame" locator1="IFrame#DIALOG" />

		<execute function="Portal.Type" locator1="TextInput#SETUP_XML_URL" value1="@portal_url@/${xmlURL}" />
		<execute function="Portal.Type" locator1="TextInput#SETUP_XSL_URL" value1="@portal_url@/${xslURL}" />

		<execute function="Portal.SelectFrameTop" value1="relative=top" />
	</command>

	<command name="gotoDocumentURL">
		<var name="key_dmDocumentTitle" value="${dmDocumentTitle}" />

		<execute function="Portal.AssertClick" locator1="DocumentsAndMedia#ICON_DOCUMENT_TITLE_LINK" value1="${dmDocumentTitle}" />

		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMediaDocument#DOCUMENT_INFO_UPLOADED_BY" value1="Test Test" />

		<execute function="Portal.Click" locator1="Icon#INFO" />

		<execute function="Portal.ClickNoError" locator1="Link#URL" />

		<execute function="Portal.Pause" locator1="5000" />
	</command>

	<command name="viewConfigurationXSLContent">
		<execute function="Portal.SelectFrame" locator1="IFrame#DIALOG" />

		<execute function="Portal.AssertTextEquals" locator1="TextInput#SETUP_XML_URL" value1="@portlet_context_url@/example.xml" />
		<execute function="Portal.AssertTextEquals" locator1="TextInput#SETUP_XSL_URL" value1="@portlet_context_url@/example.xsl" />

		<execute function="Portal.SelectFrameTop" value1="relative=top" />
	</command>

	<command name="viewConsoleError">
		<execute function="Portal.AssertConsoleTextPresent" value1="${consoleTextError}" />
	</command>

	<command name="viewErrorMessage">
		<execute function="Portal.AssertTextEquals" locator1="Message#ERROR" value1="An error occurred while processing your XML and XSL." />
	</command>

	<command name="viewXSLPortletHymnDisplay">
		<execute function="Portal.AssertTextEquals" locator1="XSLContentPortlet#TITLE" value1="My Hymn Collection" />

		<execute function="Portal.AssertTextEquals" locator1="XSLContentPortlet#TABLE_TITLE_HEADER" value1="Title" />
		<execute function="Portal.AssertTextEquals" locator1="XSLContentPortlet#TABLE_ARTIST_HEADER" value1="Artist" />
		<execute function="Portal.AssertTextEquals" locator1="XSLContentPortlet#TABLE_COUNTRY_HEADER" value1="Country" />
		<execute function="Portal.AssertTextEquals" locator1="XSLContentPortlet#TABLE_YEAR_HEADER" value1="Year" />

		<var name="key_titleEntry" value="${tableTitleEntry}" />

		<execute function="Portal.AssertTextEquals" locator1="XSLContentPortlet#TABLE_TITLE_ENTRY" value1="${tableTitleEntry}" />
		<execute function="Portal.AssertTextEquals" locator1="XSLContentPortlet#TABLE_ARTIST_ENTRY" value1="${tableArtistEntry}" />
		<execute function="Portal.AssertTextEquals" locator1="XSLContentPortlet#TABLE_COUNTRY_ENTRY" value1="${tableCountryEntry}" />
		<execute function="Portal.AssertTextEquals" locator1="XSLContentPortlet#TABLE_YEAR_ENTRY" value1="${tableYearEntry}" />
	</command>
</definition>