<definition>
	<command name="addConsumerCP">
		<execute function="Portal.AssertClick" locator1="NavTab#PRODUCERS" value1="Producers" />

		<var name="key_producerName" value="${producerName}" />

		<execute function="Portal.Copy" locator1="WSRPAdmin#PRODUCER_TABLE_URL" />
		<execute function="Portal.AssertClick" locator1="NavTab#CONSUMERS" value1="Consumers" />

		<execute function="Portal.AssertClick" locator1="Button#ADD_CONSUMER" value1="Add Consumer" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${consumerName}" />
		</execute>

		<execute function="Portal.Paste" locator1="TextInput#URL" />
		<execute macro="PortletEntry#save" />
	</command>

	<command name="addConsumerPortletCP">
		<var name="key_consumerName" value="${consumerName}" />

		<execute function="Portal.Click" locator1="WSRPAdmin#CONSUMER_TABLE_ACTIONS_BUTTON" />
		<execute function="Portal.AssertClick" locator1="MenuItem#MANAGE_PORTLETS" value1="Manage Portlets" />

		<execute function="Portal.AssertClick" locator1="Button#ADD_PORTLET" value1="Add Portlet" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${consumerPortletName}" />
		</execute>

		<execute function="Portal.Select" locator1="Select#REMOTE_PORTLET" value1="${consumerPortletType}" />
		<execute macro="PortletEntry#save" />
	</command>

	<command name="addProducerCP">
		<execute function="Portal.AssertClick" locator1="NavTab#PRODUCERS" value1="Producers" />

		<execute function="Portal.AssertClick" locator1="Button#ADD_PRODUCER" value1="Add Producer" />

		<execute macro="PortletEntry#inputName">
			<var name="name" value="${producerName}" />
		</execute>

		<execute function="Portal.Select" locator1="Select#VERSION" value1="2.0" />
		<execute function="Portal.Select" locator1="Select#AVAILABLE" value1="${portletsAvailableSelect}" />
		<execute function="Portal.Click" locator1="Button#MOVE_AVAILABLE_TO_CURRENT" />
		<execute macro="PortletEntry#save" />

		<var name="key_producerName" value="${producerName}" />

		<execute function="Portal.AssertTextEquals" locator1="WSRPAdmin#PRODUCER_TABLE_PRODUCER" value1="${producerName}" />
		<execute function="Portal.AssertElementPresent" locator1="WSRPAdmin#PRODUCER_TABLE_URL" />
	</command>

	<command name="tearDownCP">
		<execute macro="ProductMenu#gotoControlPanelApps">
			<var name="portlet" value="WSRP Admin" />
		</execute>

		<execute function="Portal.AssertClick" locator1="NavTab#PRODUCERS" value1="Producers" />

		<while>
			<condition function="Portal.IsElementPresent" locator1="WSRPAdmin#PRODUCER_TABLE_ACTIONS_BUTTON_GENERIC" />
			<then>
				<execute function="Portal.Click" locator1="WSRPAdmin#PRODUCER_TABLE_ACTIONS_BUTTON_GENERIC" />
				<execute function="Portal.AssertClickNoError" locator1="MenuItem#DELETE" value1="Delete" />
				<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />
			</then>
		</while>

		<execute function="Portal.AssertTextEquals" locator1="Message#INFO" value1="There are no producers." />
		<execute function="Portal.AssertClick" locator1="NavTab#CONSUMERS" value1="Consumers" />

		<while>
			<condition function="Portal.IsElementPresent" locator1="WSRPAdmin#CONSUMER_TABLE_ACTIONS_BUTTON_GENERIC" />
			<then>
				<execute function="Portal.Click" locator1="WSRPAdmin#CONSUMER_TABLE_ACTIONS_BUTTON_GENERIC" />
				<execute function="Portal.AssertClickNoError" locator1="MenuItem#DELETE" value1="Delete" />
				<execute function="Portal.Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />
			</then>
		</while>

		<execute function="Portal.AssertTextEquals" locator1="Message#INFO" value1="There are no consumers." />
	</command>

	<command name="wsrpUnitConverterConvertPG">
		<execute macro="UnitConverter#convertPG">
			<var name="initialUnit" value="${initialUnit}" />
			<var name="initialValue" value="${initialValue}" />
			<var name="targetUnit" value="${targetUnit}" />
			<var name="targetValue" value="${targetValue}" />
			<var name="unitType" value="${unitType}" />
		</execute>
	</command>
</definition>