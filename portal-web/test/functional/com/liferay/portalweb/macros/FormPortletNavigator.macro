<definition>
	<command name="clickFormContent">
		<execute function="Portal.Click" locator1="FormPortlet#FORM_CONTENT" />
	</command>

	<command name="gotoSelectForm">
		<execute function="Portal.AssertClick#pauseMakeVisibleAssertTextEqualsClickAt" locator1="FormPortlet#SELECT_FORM" value1="Select Form" />

		<execute function="Portal.SelectFrame" locator1="IFrame#DIALOG" />
	</command>
</definition>