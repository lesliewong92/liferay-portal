<definition>
	<command name="gotoOrganizations">
		<execute function="Portal.Pause" locator1="1000" />

		<if>
			<condition function="Portal.IsElementPresent" locator1="NavBar#ORGANIZATIONS" />
			<then>
				<execute function="Portal.AssertClick" locator1="NavBar#ORGANIZATIONS" value1="Organizations" />
			</then>
		</if>
	</command>

	<command name="gotoUsers">
		<execute function="Portal.Pause" locator1="1000" />

		<if>
			<condition function="Portal.IsElementPresent" locator1="NavBar#USERS" />
			<then>
				<execute function="Portal.AssertClick" locator1="NavBar#USERS" value1="Users" />
			</then>
		</if>

		<execute function="Portal.AssertVisible" locator1="UsersAndOrganizations#USER_TABLE_HEADER_FIRST_NAME" />
	</command>
</definition>