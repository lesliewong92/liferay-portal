<definition>
	<command name="addPG">
		<execute function="Portal.AssertTextEquals" locator1="QuickNote#NOTE_CONTENT" value1="Click to edit me..." />

		<execute function="Portal.MouseOver" locator1="QuickNote#NOTE_CONTENT" />

		<execute function="Portal.Click" locator1="QuickNote#NOTE_CONTENT_EDITABLE" />

		<execute function="Portal.Type" locator1="QuickNote#NOTE_CONTENT_TEXTAREA" value1="${noteContent}" />

		<execute function="Portal.Click" locator1="QuickNote#OK_BUTTON" />

		<execute function="Portal.AssertTextEquals" locator1="QuickNote#NOTE_CONTENT" value1="${noteContent}" />
	</command>
</definition>