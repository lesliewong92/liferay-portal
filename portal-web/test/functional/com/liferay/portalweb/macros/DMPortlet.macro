<definition>
	<command name="configureDisplaySettingsPG">
		<execute macro="Portlet#gotoPortletOptions">
			<var name="portletName" value="${portletName}" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

		<if>
			<condition function="Portal.IsElementPresent" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_DROPDOWN_COLLAPSED" />
			<then>
				<execute function="Portal.AssertClick" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_DROPDOWN" value1="Display Settings" />
			</then>
		</if>

		<if>
			<equals arg1="${enableDisplaySettingsShowSearch}" arg2="true" />
			<then>
				<execute function="Portal.Check" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_SHOW_SEARCH_CHECKBOX" />
			</then>
			<elseif>
				<equals arg1="${enableDisplaySettingsShowSearch}" arg2="false" />
				<then>
					<execute function="Portal.Uncheck" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_SHOW_SEARCH_CHECKBOX" />
				</then>
			</elseif>
		</if>

		<if>
			<isset var="entriesToDisplayCount" />
			<then>
				<execute function="Portal.Select" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_MAXIMUM_ENTRIES_TO_DISPLAY_SELECT" value1="${entriesToDisplayCount}" />
			</then>
		</if>

		<if>
			<equals arg1="${enableDisplaySettingsRelatedAssets}" arg2="true" />
			<then>
				<execute function="Portal.Check" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_ENABLE_RELATED_ASSETS_CHECKBOX" />
			</then>
			<elseif>
				<equals arg1="${enableDisplaySettingsRelatedAssets}" arg2="false" />
				<then>
					<execute function="Portal.Uncheck" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_ENABLE_RELATED_ASSETS_CHECKBOX" />
				</then>
			</elseif>
		</if>

		<if>
			<isset var="currentDisplayStyleViews" />
			<then>
				<while>
					<condition function="Portal.IsElementPresent" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_DISPLAY_STYLE_VIEW_CURRENT_PRESENT" />
					<then>
						<execute function="Portal.Click" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_DISPLAY_STYLE_VIEW_CURRENT_PRESENT" />

						<execute function="Portal.Click" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_MOVE_CURRENT_TO_AVAILABLE_BUTTON" />
					</then>
				</while>

				<if>
					<not>
						<equals arg1="${currentDisplayStyleViews}" arg2="" />
					</not>
					<then>
						<for list="${currentDisplayStyleViews}" param="currentDisplayStyleView">
							<execute function="Portal.Select" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_DISPLAY_STYLE_VIEWS_AVAILABLE_SELECT" value1="${currentDisplayStyleView}" />

							<execute function="Portal.Click" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_MOVE_AVAILABLE_TO_CURRENT_BUTTON" />

							<execute function="Portal.AssertTextEquals#assertPartialText" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_DISPLAY_STYLE_VIEWS_CURRENT_SELECT" value1="${currentDisplayStyleView}" />
						</for>
					</then>
				</if>
			</then>
		</if>

		<execute macro="Button#clickSave" />

		<if>
			<equals arg1="${currentDisplayStyleViews}" arg2="" />
			<then>
				<execute macro="Alert#viewRequestFailedToComplete" />

				<execute function="Portal.AssertClick#assertPartialTextClickAt" locator1="Message#ERROR_2" value1="Display style views cannot be empty." />
			</then>
			<else>
				<execute macro="Alert#viewSuccessMessage" />
			</else>
		</if>
	</command>

	<command name="configureRootFolderPG">
		<execute macro="Portlet#gotoPortletOptions">
			<var name="portletName" value="Documents and Media" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

		<execute function="Portal.AssertClick" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_ROOT_FOLDER_SELECT_BUTTON" value1="Select" />

		<execute function="Portal.SelectFrame" value1="relative=top" />

		<execute function="Portal.SelectFrame" locator1="IFrame#SELECT_FOLDER" />

		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMediaSelectDocument#FOLDER_TABLE_FOLDER" value1="${dmFolderName}" />

		<execute function="Portal.AssertClick" locator1="DocumentsAndMediaSelectDocument#FOLDER_TABLE_FOLDER_CHOOSE" value1="Choose" />

		<execute function="Portal.SelectFrame" value1="relative=top" />

		<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_ROOT_FOLDER_FIELD" value1="${dmFolderName}" />

		<execute macro="Button#clickSave" />

		<execute macro="Alert#viewSuccessMessage" />

		<execute function="Portal.SelectFrame" value1="relative=top" />
	</command>

	<command name="configureScopetoGlobalPG">
		<execute macro="Portlet#gotoPortletOptions">
			<var name="portletName" value="Documents and Media" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

		<execute macro="Navigator#gotoNavItem">
			<var name="navItem" value="Scope" />
		</execute>

		<execute function="Portal.Select" locator1="Select#SCOPE" value1="Global" />

		<execute function="Portal.AssertSelectedLabel" locator1="Select#SCOPE" value1="Global" />

		<execute function="Portal.Click" locator1="Button#SAVE" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="setDescriptiveView">
		<execute function="Portal.Click" locator1="Icon#DISPLAY_STYLE_DESCRIPTIVE" />

		<execute function="Portal.AssertElementPresent" locator1="Icon#DISPLAY_STYLE_DESCRIPTIVE_ACTIVE" />
	</command>

	<command name="setIconView">
		<execute function="Portal.Click" locator1="Icon#DISPLAY_STYLE_ICON" />

		<execute function="Portal.AssertElementPresent" locator1="Icon#DISPLAY_STYLE_ICON_ACTIVE" />
	</command>

	<command name="setListView">
		<execute function="Portal.Click" locator1="Icon#DISPLAY_STYLE_LIST" />

		<execute function="Portal.AssertElementPresent" locator1="Icon#DISPLAY_STYLE_LIST_ACTIVE" />
	</command>

	<command name="viewDefaultConfigurationDisplaySettingsPG">
		<execute macro="Portlet#gotoPortletOptions">
			<var name="portletName" value="${portletName}" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

		<if>
			<condition function="Portal.IsElementPresent" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_DROPDOWN_COLLAPSED" />
			<then>
				<execute function="Portal.AssertClick" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_DROPDOWN" value1="Display Settings" />
			</then>
		</if>

		<execute function="Portal.AssertChecked" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_SHOW_SEARCH_CHECKBOX" />
		<execute function="Portal.AssertTextEquals#assertValue" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_MAXIMUM_ENTRIES_TO_DISPLAY_SELECT" value1="20" />
		<execute function="Portal.AssertChecked" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_SHOW_SEARCH_CHECKBOX" />

		<execute function="Portal.SelectFrame" value1="relative=top" />
	</command>

	<command name="viewDefaultPG">
		<var name="key_portletName" value="Documents and Media" />

		<execute function="Portal.AssertTextEquals" locator1="Portlet#TITLE" value1="Documents and Media" />
		<execute function="Portal.AssertTextEquals" locator1="Message#EMPTY_INFO" value1="There are no documents or media files in this folder." />
	</command>

	<command name="viewNoPermissionCP">
		<var name="key_portletTitle" value="Documents and Media" />

		<execute function="Portal.AssertTextEquals" locator1="Home#SITE_ADMINISTRATION_PORTLET_TITLE" value1="Documents and Media" />
		<execute function="Portal.AssertTextEquals" locator1="Message#EMPTY_INFO" value1="There are no documents or media files in this folder." />
	</command>

	<command name="viewRootFolderPG">
		<execute macro="Portlet#gotoPortletOptions">
			<var name="portletName" value="${portletName}" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute function="Portal.SelectFrame" locator1="IFrame#CONFIGURATION" />

		<execute function="Portal.AssertTextEquals" locator1="DocumentsAndMediaConfiguration#DISPLAY_SETTINGS_ROOT_FOLDER_FIELD" value1="${dmFolderName}" />

		<execute function="Portal.SelectFrame" value1="relative=top" />
	</command>
</definition>