<definition>
	<command name="addContent">
		<execute function="Portal.SelectFrame" locator1="CKEditor#BODY_FIELD_IFRAME" />

		<execute function="Portal.KeyPress" locator1="CKEditor#BODY" value1="${content}" />

		<execute function="Portal.SelectFrame" value1="relative=top" />
	</command>

	<command name="assertEditorPresent">
		<execute function="Portal.AssertElementPresent" locator1="CKEditor#BODY_FIELD" />
	</command>

	<command name="selectHeading">
		<execute function="Portal.Click" locator1="CKEditor#TOOLBAR_FORMAT_BUTTON" />

		<execute function="Portal.SelectFrame" locator1="CKEditor#IFRAME" />

		<var name="key_format" value="${format}" />

		<execute function="Portal.Click" locator1="CKEditor#TOOLBAR_FORMAT_MENULIST" value1="${format}" />

		<execute function="Portal.SelectFrame" value1="relative=top" />
	</command>

	<command name="typeEnterKey">
		<execute function="Portal.SelectFrame" locator1="CKEditor#BODY_FIELD_IFRAME" />

		<execute function="Portal.KeyPress" locator1="CKEditor#BODY" value1="\RETURN" />

		<execute function="Portal.SelectFrame" value1="relative=top" />
	</command>

	<command name="viewEntryContent">
		<execute function="Portal.AssertTextEquals" locator1="CKEditor#BODY" value1="${content}" />
	</command>
</definition>