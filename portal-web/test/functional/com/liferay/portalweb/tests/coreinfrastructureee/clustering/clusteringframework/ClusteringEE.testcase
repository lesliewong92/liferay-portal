<definition component-name="portal-performance-and-fault-tolerance-ee">
	<property name="app.server.bundles.size" value="1" />
	<property name="cluster.enabled" value="true" />
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="remote.elasticsearch.enabled" value="true" />
	<property name="test.run.environment" value="EE" />
	<property name="testray.main.component.name" value="Clustering" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.BlogsEntry#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddAndDeleteBlogEntriesOnSeparateNodes" priority="4">
		<property name="test.name.skip.portal.instance" value="ClusteringEE#AddAndDeleteBlogEntriesOnSeparateNodes" />

		<execute macro="Portal.Clustering#viewClusterStatusInConsole" />

		<execute macro="Portal.Page#assertNodePortPG">
			<var name="nodePort" value="8080" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Page1" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Page1" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Page1" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry1 Content" />
			<var name="entryTitle" value="Blogs Entry1 Title" />
		</execute>

		<execute macro="Portal.User#logoutPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.User#loginPG">
			<var name="nodePort" value="9080" />
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Page#assertNodePortPG">
			<var name="nodePort" value="9080" />
		</execute>

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Test Page1" />
			<var name="url" value="http://localhost:9080" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Blogs Entry1 Content" />
			<var name="entryTitle" value="Blogs Entry1 Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntry">
			<var name="entryContent" value="Blogs Entry1 Content" />
			<var name="entryTitle" value="Blogs Entry1 Title" />
		</execute>

		<execute macro="Portal.Navigator#openNodePort">
			<var name="nodePort" value="9080" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Page2" />
		</execute>

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Test Page2" />
			<var name="url" value="http://localhost:9080" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Test Page2" />
			<var name="url" value="http://localhost:9080" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Blogs Entry1 Content" />
			<var name="entryTitle" value="Blogs Entry1 Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntry">
			<var name="entryContent" value="Blogs Entry1 Content" />
			<var name="entryTitle" value="Blogs Entry1 Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Test Page2" />
			<var name="url" value="http://localhost:9080" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry2 Content" />
			<var name="entryTitle" value="Blogs Entry2 Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Test Page2" />
			<var name="url" value="http://localhost:9080" />
		</execute>

		<execute macro="Portal.BlogsEntry#moveToRecycleBinPG">
			<var name="assetType" value="Blogs Entry" />
			<var name="entryContent" value="Blogs Entry1 Content" />
			<var name="entryTitle" value="Blogs Entry1 Title" />
			<var name="nodePort" value="9080" />
		</execute>

		<execute macro="Portal.Navigator#openSpecificURL">
			<var name="url" value="http://localhost:9080" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#emptyCP" />

		<execute macro="Portal.User#logoutPG">
			<var name="nodePort" value="9080" />
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.User#loginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Page2" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewNoPG">
			<var name="entryTitle" value="Blogs Entry1 Title" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Blogs Entry2 Content" />
			<var name="entryTitle" value="Blogs Entry2 Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntry">
			<var name="entryContent" value="Blogs Entry2 Content" />
			<var name="entryTitle" value="Blogs Entry2 Title" />
		</execute>

		<execute macro="Portal.Search#searchPG">
			<var name="searchTerm" value="Entry1" />
		</execute>

		<execute macro="Portal.Search#viewSearchNoPG">
			<var name="searchNoResults" value="true" />
			<var name="searchTerm" value="Entry1" />
		</execute>
	</command>

	<command name="ValidateDocumentOnSeparateNodes" priority="4">
		<property name="test.name.skip.portal.instance" value="ClusteringEE#ValidateDocumentOnSeparateNodes" />

		<execute macro="Portal.Clustering#viewClusterStatusInConsole" />

		<execute macro="Portal.Page#assertNodePortPG">
			<var name="nodePort" value="8080" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#enableActionsMenuOnPortlet" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.User#logoutPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.User#loginPG">
			<var name="nodePort" value="9080" />
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Page#assertNodePortPG">
			<var name="nodePort" value="9080" />
		</execute>

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Documents and Media Page" />
			<var name="url" value="http://localhost:9080" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.User#logoutPG">
			<var name="nodePort" value="9080" />
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.User#loginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>
	</command>

	<!-- LRQA-29556 -->

	<!--<command name="ValidateSchedulerOnSeparateNodes" priority="4">
