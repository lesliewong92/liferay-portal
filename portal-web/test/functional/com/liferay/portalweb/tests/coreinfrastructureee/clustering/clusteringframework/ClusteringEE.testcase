		<var name="pageName" value="Home" />

		<execute macro="Portal.Page#assertNodePortPG">
			<var name="nodePort" value="8080" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

