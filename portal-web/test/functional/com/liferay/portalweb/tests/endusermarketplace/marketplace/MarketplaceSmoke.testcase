<definition component-name="marketplace">
	<property name="marketplace.app.acceptance" value="true" />
	<property name="testray.main.component.name" value="Marketplace" />

	<set-up>
		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="portletName" value="Sites" />
		</execute>

		<execute macro="Portal.Site#tearDownCP" />

		<execute macro="Portal.BlogsEntry#tearDownCP" />

		<execute macro="Portal.BookmarksFolder#tearDownCP" />

		<execute macro="Portal.WikiPage#tearDownCP" />

		<execute macro="Portal.Page#tearDownPG" />

		<execute macro="Portal.DMFolder#tearDownCP" />

		<execute macro="Portal.DMDocument#tearDownCP" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Test Page" />
		</execute>

		<execute macro="Portal.CalendarEvent#tearDown" />

		<execute macro="Portal.Calendar#tearDown" />
	</tear-down>

	<command name="MarketplaceSmoke" priority="5">
		<execute macro="Portal.Marketplace#smoke" />
	</command>
</definition>