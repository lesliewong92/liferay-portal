<definition component-name="portal-plugins-deployment">
	<property name="testray.main.component.name" value="Plugin Installer" />

	<set-up>
		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Page" />
		</execute>
	</set-up>

	<tear-down>
		<execute macro="Portal.Page#tearDownPG" />
	</tear-down>

	<command name="OpenSocialPortletSmoke" priority="4">
		<property name="portlet.plugins.includes" value="opensocial-portlet" />

		<var name="appName" value="OpenSocial Gadget" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="OpenSocial Gadget" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="OpenSocial Gadget Editor" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelApps">
			<var name="portlet" value="OpenSocial Gadget Publisher" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelApps">
			<var name="portlet" value="App Manager" />
		</execute>

		<execute macro="Portal.AppManager#uninstallAppCP">
			<var name="appName" value="${appName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelApps">
			<var name="portlet" value="App Manager" />
		</execute>

		<execute macro="Portal.AppManager#viewUninstallAppCP">
			<var name="appName" value="${appName}" />
		</execute>
	</command>
</definition>