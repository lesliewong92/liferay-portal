<definition component-name="portal-permissions">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Permissions" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#firstLoginPG" />

				<execute macro="Portal.PortalSettings#tearDownCP" />

				<execute macro="Portal.User#tearDownCP" />

				<execute macro="Portal.Role#tearDownCP" />

				<execute macro="Portal.Organization#tearDownCP" />

				<execute macro="Portal.Site#tearDownCP" />

				<execute macro="Portal.BlogsEntry#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="ViewBlogsEntryRegRoleInline" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="test.name.skip.portal.instance" value="CPRolesCPBlogs#ViewBlogsEntryRegRoleInline" />

		<execute macro="Portal.Permissions#setUpRegRoleLoginUserCP">
			<var name="portletName" value="Blogs" />
			<var name="roleTitle" value="Regrole Name" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Permissions#definePermissionLoginUserCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_BLOGS_GENERAL_PERMISSIONS_ACCESS_IN_SITE_ADMINISTRATION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Access in Site Administration" />
			<var name="roleTitle" value="Regrole Name" />
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoBlogsEntryPermissionsCP">
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Role#removePermissionPG">
			<var name="permissionDefinitionKey" value="CONTENT_PERMISSIONS_VIEW_CHECKBOX" />
			<var name="roleTitle" value="Guest" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewDefaultCP">
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoBlogsEntryPermissionsCP">
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Role#definePermissionPG">
			<var name="permissionDefinitionKey" value="CONTENT_PERMISSIONS_VIEW_CHECKBOX" />
			<var name="roleTitle" value="Guest" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.Portlet#changeDisplayStyle">
			<var name="displayStyle" value="List" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntryTable">
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntryAuthorCP">
			<var name="entryAuthorFullName" value="Test Test" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<var name="key_entryTitle" value="Blogs Entry Title" />

		<execute function="AssertClick" locator1="Blogs#ENTRY_TABLE_TITLE" value1="Blogs Entry Title" />

		<execute macro="Portal.BlogsEntry#viewEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>
	</command>

	<command name="ViewBlogsPortletRegRole" priority="4">
		<execute macro="Portal.Permissions#setUpRegRoleLoginUserCP">
			<var name="portletName" value="Blogs" />
			<var name="roleTitle" value="Regrole Name" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Permissions#definePermissionLoginUserCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_BLOGS_GENERAL_PERMISSIONS_ACCESS_IN_SITE_ADMINISTRATION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Access in Site Administration" />
			<var name="roleTitle" value="Regrole Name" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsConfiguration#viewNoPermissionCP" />

		<execute macro="Portal.Permissions#removePermissionLoginUserCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_PAGES_SITE_PAGES_RESOURCE_PERMISSIONS_SITE_GO_TO_SITE_ADMINISTRATION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Go to Site Administration" />
			<var name="roleTitle" value="Regrole Name" />
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.Permissions#removePermissionLoginUserCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_BLOGS_GENERAL_PERMISSIONS_ACCESS_IN_SITE_ADMINISTRATION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Access in Site Administration" />
			<var name="roleTitle" value="Regrole Name" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>
	</command>

	<command name="ViewBlogsPortletSiteRole" priority="4">
		<execute macro="Portal.Permissions#setUpSiteRoleLoginUserCP">
			<var name="page" value="Public Pages" />
			<var name="pageName" value="Blogs Page" />
			<var name="portletName" value="Blogs" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
			<var name="siteName" value="Site Name" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Blogs Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Permissions#definePermissionLoginUserCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_BLOGS_GENERAL_PERMISSIONS_ACCESS_IN_SITE_ADMINISTRATION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Access in Site Administration" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsConfiguration#viewNoPermissionCP" />

		<execute macro="Portal.Permissions#removePermissionLoginUserCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_PAGES_SITE_PAGES_RESOURCE_PERMISSIONS_SITE_GO_TO_SITE_ADMINISTRATION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Go to Site Administration" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.Permissions#removePermissionLoginUserCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_BLOGS_GENERAL_PERMISSIONS_ACCESS_IN_SITE_ADMINISTRATION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Access in Site Administration" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>
	</command>
</definition>