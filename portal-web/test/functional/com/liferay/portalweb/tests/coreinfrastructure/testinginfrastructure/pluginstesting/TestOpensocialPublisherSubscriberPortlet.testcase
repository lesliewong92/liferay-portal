<definition component-name="portal-test-plugins">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Test Plugins" />
	<property name="portlet.plugins.includes" value="test-opensocial-pubsub-portlet" />

	<set-up>
		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<execute macro="Portal.Page#tearDownPG" />
	</tear-down>

	<command name="ViewPublisherSubscriber" priority="4">
		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Publisher Subscriber Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Publisher Portlet" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Publisher Subscriber Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Subscriber Portlet" />
		</execute>

		<execute function="Portal.Click" locator1="TestSubscriber#SUBSCRIBER_PORTLET_SUBSCRIBE_BUTTON" />
		<execute function="Portal.Click" locator1="TestPublisher#PUBLISHER_PORTLET_PUBLISH_BUTTON" />

	<!--<var name="randomNumber" path="TestPublisher" locator="PUBLISHER_PORTLET_MESSAGE" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="TestPublisher#PUBLISHER_PORTLET_MESSAGE" value1="${randomNumber}" />
		<execute function="Portal.AssertTextEquals#assertPartialText" locator1=" TestSubscriber#SUBSCRIBER_PORTLET_MESSAGE" value1="${randomNumber}" />-->
	</command>
</definition>