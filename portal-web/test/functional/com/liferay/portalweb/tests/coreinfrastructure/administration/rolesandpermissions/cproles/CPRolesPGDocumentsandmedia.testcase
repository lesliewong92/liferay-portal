<definition component-name="portal-permissions">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Permissions" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#firstLoginPG" />

				<execute macro="Portal.User#tearDownCP" />

				<execute macro="Portal.Role#tearDownCP" />

				<execute macro="Portal.Organization#tearDownCP" />

				<execute macro="Portal.Site#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.DMFolder#tearDownCP" />

				<execute macro="Portal.DMDocument#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddDMDocumentRegRoleDefaultPermissions" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Permissions#setUpRegRolePG">
			<var name="pageName" value="Documents and Media Page" />
			<var name="portletName" value="Documents and Media" />
			<var name="roleTitle" value="Regrole Name" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="Toolbar#ADD" value1="Add" />
	</command>

	<command name="AddDMDocumentRegRoleDefinePermissions" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Permissions#setUpRegRolePG">
			<var name="pageName" value="Documents and Media Page" />
			<var name="portletName" value="Documents and Media" />
			<var name="roleTitle" value="Regrole Name" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Permissions#definePermissionCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_DOCUMENTS_AND_MEDIA_RESOURCE_PERMISSIONS_DOCUMENTS_ADD_DOCUMENT_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Add Document" />
			<var name="roleTitle" value="Regrole Name" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.Permissions#removePermissionCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_DOCUMENTS_AND_MEDIA_RESOURCE_PERMISSIONS_DOCUMENTS_ADD_DOCUMENT_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Add Document" />
			<var name="roleTitle" value="Regrole Name" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="Toolbar#ADD" value1="Add" />
	</command>

	<command name="AddDMDocumentSiteMemberRoleInline" priority="4">
		<execute macro="Portal.Permissions#setUpSiteMemberRoleLoginUserPG">
			<var name="page" value="Public Pages" />
			<var name="pageName" value="Documents and Media Page" />
			<var name="portletName" value="Documents and Media" />
			<var name="siteName" value="Site Name" />
			<var name="siteURLTemp" value="true" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Documents and Media Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.DMDocument#tearDownCP">
			<var name="pageName" value="Documents and Media Page" />
			<var name="siteScopeName" value="Site Name" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoDocumentsAndMediaHomeFolderPG">
			<var name="pageName" value="Documents and Media Page" />
			<var name="siteName" value="Site Name" />
			<var name="siteURLTemp" value="true" />
		</execute>

		<execute macro="Portal.Role#removePermissionPG">
			<var name="permissionDefinitionKey" value="INLINE_PERMISSIONS_ADD_DOCUMENT_CHECKBOX" />
			<var name="roleTitle" value="Site Member" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Documents and Media Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#clickPortletPlusIconPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="MenuItem#ANY_MENU_ITEM" value1="Basic Document">
			<var name="key_menuItem" value="Basic Document" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoDocumentsAndMediaHomeFolderPG">
			<var name="pageName" value="Documents and Media Page" />
			<var name="siteName" value="Site Name" />
			<var name="siteURLTemp" value="true" />
		</execute>

		<execute macro="Portal.Role#definePermissionPG">
			<var name="permissionDefinitionKey" value="INLINE_PERMISSIONS_ADD_DOCUMENT_CHECKBOX" />
			<var name="roleTitle" value="Site Member" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Documents and Media Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="Document_2.doc" />
		</execute>
	</command>

	<command name="AddDMDocumentSiteRole" priority="4">
		<execute macro="Portal.Permissions#setUpSiteRoleLoginUserPG">
			<var name="page" value="Public Pages" />
			<var name="pageName" value="Documents and Media Page" />
			<var name="portletName" value="Documents and Media" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
			<var name="siteName" value="Site Name" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoDocumentsAndMediaHomeFolderPG">
			<var name="pageName" value="Documents and Media Page" />
			<var name="siteName" value="Site Name" />
			<var name="siteURLTemp" value="true" />
		</execute>

		<execute macro="Portal.Role#removePermissionPG">
			<var name="permissionDefinitionKey" value="INLINE_PERMISSIONS_ADD_DOCUMENT_CHECKBOX" />
			<var name="roleTitle" value="Site Member" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Documents and Media Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#clickPortletPlusIconPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="MenuItem#ANY_MENU_ITEM" value1="Basic Document">
			<var name="key_menuItem" value="Basic Document" />
		</execute>

		<execute macro="Portal.Permissions#definePermissionLoginUserCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_DOCUMENTS_AND_MEDIA_RESOURCE_PERMISSIONS_DOCUMENTS_ADD_DOCUMENT_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Add Document" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Documents and Media Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.Permissions#removePermissionLoginUserCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_DOCUMENTS_AND_MEDIA_RESOURCE_PERMISSIONS_DOCUMENTS_ADD_DOCUMENT_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Add Document" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Documents and Media Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#clickPortletPlusIconPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="MenuItem#ANY_MENU_ITEM" value1="Basic Document">
			<var name="key_menuItem" value="Basic Document" />
		</execute>
	</command>

	<command name="DeleteDMFolderRegRoleInline" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.Permissions#setUpRegRoleLoginUserPG">
			<var name="pageName" value="Documents and Media Page" />
			<var name="portletName" value="Documents and Media" />
			<var name="roleTitle" value="Regrole Name" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Permissions#addDMFolderLoginUserPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
			<var name="pageName" value="Documents and Media Page" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<var name="key_dmFolderName" value="DM Folder Name" />

		<execute function="Check" locator1="DocumentsAndMedia#ICON_FOLDER_CHECKBOX" />

		<execute macro="Portal.PermissionsInline#viewButtonInactive">
			<var name="buttonName" value="RECYCLE_BIN" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#enableActionsMenuOnPortlet" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolderPermissions">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.Role#definePermissionPG">
			<var name="permissionDefinitionKey" value="CONTENT_PERMISSIONS_DELETE_CHECKBOX" />
			<var name="roleTitle" value="Regrole Name" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMFolder#deletePG">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.Permissions#addDMFolderLoginUserPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
			<var name="pageName" value="Documents and Media Page" />
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolderPermissions">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.Role#removePermissionPG">
			<var name="permissionDefinitionKey" value="CONTENT_PERMISSIONS_DELETE_CHECKBOX" />
			<var name="roleTitle" value="Regrole Name" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<var name="key_dmFolderName" value="DM Folder Name" />

		<execute function="Check" locator1="DocumentsAndMedia#ICON_FOLDER_CHECKBOX" />

		<execute macro="Portal.PermissionsInline#viewButtonInactive">
			<var name="buttonName" value="RECYCLE_BIN" />
		</execute>
	</command>

	<command name="ViewDMFolderGuestInline" priority="4">
		<execute macro="Portal.Page#add">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="pageName" value="Documents and Media Page" />
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.Permissions#addDMFolderLoginUserPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
			<var name="pageName" value="Documents and Media Page" />
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMPortlet#setDescriptiveView" />

		<var name="key_dmFolderName" value="DM Folder Name" />

		<execute function="AssertClick" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="DM Folder Name" />

		<var method="StringUtil#upperCase('DM Folder Name')" name="dmFolderNameUpperCase" />

		<execute function="AssertTextEquals#assertPartialText" locator1="DocumentsAndMedia#BREADCRUMB_FOLDER_NAME" value1="${dmFolderNameUpperCase}" />

		<execute macro="Portal.User#loginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#enableActionsMenuOnPortlet" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolderPermissions">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.Role#removePermissionPG">
			<var name="permissionDefinitionKey" value="CONTENT_PERMISSIONS_VIEW_CHECKBOX" />
			<var name="roleTitle" value="Guest" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMPortlet#viewDefaultPG" />

		<execute macro="Portal.User#loginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolderPermissions">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.Role#definePermissionPG">
			<var name="permissionDefinitionKey" value="CONTENT_PERMISSIONS_VIEW_CHECKBOX" />
			<var name="roleTitle" value="Guest" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMPortlet#setDescriptiveView" />

		<var name="key_dmFolderName" value="DM Folder Name" />

		<execute function="AssertClick" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="DM Folder Name" />

		<var method="StringUtil#upperCase('DM Folder Name')" name="dmFolderNameUpperCase" />

		<execute function="AssertTextEquals#assertPartialText" locator1="DocumentsAndMedia#BREADCRUMB_FOLDER_NAME" value1="${dmFolderNameUpperCase}" />
	</command>
</definition>