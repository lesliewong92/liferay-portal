<definition component-name="portal-user-management-and-portal-configuration">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Roles" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#firstLoginPG" />

				<execute macro="Portal.Role#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddOrganizationRole" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.RoleNavigator#gotoRoleType">
			<var name="roleType" value="Organization" />
		</execute>

		<execute macro="Portal.Role#add">
			<var name="roleTitle" value="Roles Orgrole Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#viewCP">
			<var name="roleTitle" value="Roles Orgrole Name" />
			<var name="roleType" value="Organization" />
		</execute>
	</command>

	<command name="AddRegularRole" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#add">
			<var name="roleTitle" value="Roles Regrole Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#viewCP">
			<var name="roleTitle" value="Roles Regrole Name" />
			<var name="roleType" value="Regular" />
		</execute>
	</command>

	<command name="AddSiteRole" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.RoleNavigator#gotoRoleType">
			<var name="roleType" value="Site" />
		</execute>

		<execute macro="Portal.Role#add">
			<var name="roleTitle" value="Roles Siterole Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#viewCP">
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
		</execute>
	</command>

	<command name="DeleteRegularRole" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#add">
			<var name="roleTitle" value="Roles Regrole Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#deleteCP">
			<var name="roleTitle" value="Roles Regrole Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#viewDefaultCP">
			<var name="roleTitle" value="Roles Regrole Name" />
		</execute>
	</command>
</definition>