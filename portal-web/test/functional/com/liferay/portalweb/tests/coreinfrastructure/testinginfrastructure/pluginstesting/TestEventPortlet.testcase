<definition component-name="portal-test-plugins">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Test Plugins" />
	<property name="portlet.plugins.includes" value="test-event-portlet" />

	<set-up>
		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<execute macro="Portal.Page#tearDownPG" />
	</tear-down>

	<command name="ViewEvent" priority="4">
		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Event Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Event Consumer" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Event Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Event Producer" />
		</execute>

		<execute function="Portal.Click" locator1="TestEventProducer#EVENT_PRODUCER_PORTLET_LINK" />

		<execute function="Portal.AssertTextEquals" locator1="TestEventConsumer#EVENT_CONSUMER_PORTLET_BODY" value1="PASSED" />
	</command>
</definition>