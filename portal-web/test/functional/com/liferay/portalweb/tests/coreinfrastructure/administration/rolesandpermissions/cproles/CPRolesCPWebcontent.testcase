			<var name="pageName" value="Web Content Page" />
			<var name="portletName" value="Web Content" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
			<var name="siteName" value="Site Name" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Permissions#definePermissionCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_WEB_CONTENT_GENERAL_PERMISSIONS_ACCESS_IN_SITE_ADMINISTRATION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Access in Site Administration" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
		</execute>

		<execute macro="Portal.Permissions#definePermissionCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_WEB_CONTENT_RESOURCE_PERMISSIONS_WEB_CONTENT_ADD_FOLDER_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Add Folder" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#addCP">
			<var name="folderDescription" value="WC Folder Description" />
			<var name="folderName" value="WC Folder Name 1" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#addCP">
			<var name="folderDescription" value="WC Folder Description" />
			<var name="folderName" value="WC Folder Name 2" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#addSubfolderCP">
			<var name="folderName" value="WC Folder Name 2" />
			<var name="subfolderDescription" value="WC SubFolder Description" />
			<var name="subfolderName" value="WC SubFolder Name" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#checkSubfolderPermissions">
			<var name="folderName" value="WC Folder Name 1" />
			<var name="subfolder" value="false" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.Permissions#removePermissionCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_PAGES_SITE_PAGES_RESOURCE_PERMISSIONS_SITE_GO_TO_SITE_ADMINISTRATION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Go to Site Administration" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
		</execute>

		<execute macro="Portal.Permissions#removePermissionCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_WEB_CONTENT_RESOURCE_PERMISSIONS_WEB_CONTENT_ADD_FOLDER_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Add Folder" />
			<var name="roleTitle" value="Roles Siterole Name" />
			<var name="roleType" value="Site" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Web Content Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute function="Portal.AssertElementNotPresent" locator1="Button#PLUS" />
	</command>

