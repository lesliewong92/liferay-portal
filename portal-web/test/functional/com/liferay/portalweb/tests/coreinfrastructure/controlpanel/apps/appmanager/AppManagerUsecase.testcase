<definition component-name="portal-plugins-osgi">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="App Manager" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.PortalInstances#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="ViewIndependentModulesIsNotNestedWithinItself" priority="4">
		<property name="test.name.skip.portal.instance" value="AppManagerUsecase#ViewIndependentModulesIsNotNestedWithinItself" />

		<execute macro="Portal.ProductMenu#gotoControlPanelApps">
			<var name="portlet" value="App Manager" />
		</execute>

		<execute macro="Portal.AppManager#selectAppCP">
			<var name="appName" value="Independent Modules" />
		</execute>

		<execute function="Portal.Pause" locator1="3000" />

		<execute macro="Portal.AppManager#viewNoAppCP">
			<var name="appName" value="Independent Modules" />
		</execute>
	</command>
</definition>