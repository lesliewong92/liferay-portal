<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.component.names" value="Site and Page Templates" />
	<property name="testray.main.component.name" value="Site and Page Templates" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Site#tearDownCP" />

				<execute macro="Portal.SiteTemplates#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddSiteTemplate" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateActive" value="Yes" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewCP">
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addSiteTemplateCP">
			<var name="siteName" value="Site Name" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>
	</command>

	<command name="AddSiteTemplateApplySiteTemplateChangesToSite" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addCP">
			<var name="siteName" value="Site Template Site Name" />
			<var name="siteTemplateName" value="Site Template Name" />
			<var name="siteType" value="Site Template" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Template Site Name" />
		</execute>

		<execute macro="Portal.Portlet#viewNoPortletsPresentPG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.LexiconEntry#gotoEntryMenuItem">
			<var name="menuItem" value="Manage" />
			<var name="rowEntry" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSiteViaLink">
			<var name="site" value="Site Template Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Hello World" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Template Site Name" />
		</execute>

		<execute macro="Portal.Portlet#viewPG">
			<var name="portletName" value="Hello World" />
		</execute>
	</command>

	<command name="AddSiteTemplateDisablePageModification" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="disableChanges" value="true" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addCP">
			<var name="siteName" value="Site Template Site Name" />
			<var name="siteTemplateName" value="Site Template Name" />
			<var name="siteType" value="Site Template" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Template Site Name" />
		</execute>

		<execute macro="Portal.Page#viewPageLockCheck" />

		<execute function="AssertElementNotPresent" locator1="ControlMenu#ADD" />
	</command>

	<command name="DeactivateDefaultSiteTemplate" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#editTemplateStatusCP">
			<var name="siteTemplateActiveEdit" value="No" />
			<var name="siteTemplateName" value="Community Site" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewTemplateStatusCP">
			<var name="siteTemplateActiveEdit" value="No" />
			<var name="siteTemplateName" value="Community Site" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewNoTemplatesDisplay">
			<var name="siteTemplateName" value="Community Site" />
		</execute>
	</command>

	<command name="DeleteSiteTemplate" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateActive" value="Yes" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#deleteCP">
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewDefaultCP">
			<var name="siteTemplateNameList" value="Intranet Site,Community Site" />
		</execute>
	</command>

	<command name="DeleteSiteTemplateAssociatedWithASite" priority="4">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateActive" value="Yes" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addSiteTemplateCP">
			<var name="siteName" value="Site Name" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#deleteCP">
			<var name="associatedToSite" value="true" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewCP">
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>
	</command>

	<command name="EditSiteTemplate" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateActive" value="Yes" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewCP">
			<var name="siteTemplateDescription" value="This is a site template description" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#editCP">
			<var name="siteTemplateDescription" value="Site Template Description Edit" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewCP">
			<var name="siteTemplateDescription" value="Site Template Description Edit" />
			<var name="siteTemplateName" value="Site Template Name Edit" />
		</execute>
	</command>

	<command name="EditSiteTemplateStatus" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateActive" value="Yes" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addSiteTemplateCP">
			<var name="siteName" value="Site Name" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#editTemplateStatusCP">
			<var name="siteTemplateActiveEdit" value="No" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewTemplateStatusCP">
			<var name="siteTemplateActiveEdit" value="No" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>
	</command>

	<command name="LocalizeDefaultSiteTemplates" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewDefaultCP">
			<var name="siteTemplateNameList" value="Community Site,Intranet Site" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoUserMyAccount">
			<var name="portlet" value="Account Settings" />
		</execute>

		<execute macro="Portal.MyAccount#changeUserLanguage">
			<var name="languageName" value="español (España)" />
			<var name="saveButton" value="Save" />
			<var name="successMessage" value="Su petición ha terminado con éxito." />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoLocalizedControlPanel">
			<var name="category" value="Sitios web" />
			<var name="portlet" value="Plantillas de sitio web" />
			<var name="tab" value="Panel de control" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewDefaultDataLocalizedCP">
			<var name="siteTemplateDescriptionList" value="Sitio con foro y wiki,Sitio con documentos y noticias" />
			<var name="siteTemplateNameList" value="Sitio de la Comunidad,Sitio de intranet" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoLocalizedUserMyAccount">
			<var name="category" value="Mi cuenta" />
			<var name="portlet" value="Mi cuenta" />
		</execute>

		<execute macro="Portal.MyAccount#changeUserLanguage">
			<var name="languageName" value="English (United States)" />
			<var name="saveButton" value="Guardar" />
			<var name="successMessage" value="Your request completed successfully." />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewDefaultCP">
			<var name="siteTemplateNameList" value="Community Site,Intranet Site" />
		</execute>
	</command>

	<command name="OnlySiteAdminCanModifyPageAssociatedWithSiteTemplate" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addCP">
			<var name="siteName" value="Site Template Site Name" />
			<var name="siteTemplateName" value="Site Template Name" />
			<var name="siteType" value="Site Template" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Template Site Name" />
		</execute>

		<execute function="AssertElementPresent" locator1="ControlMenu#ADD" />

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Template Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesMembers">
			<var name="portlet" value="Site Memberships" />
		</execute>

		<execute macro="Portal.Site#assignUserAsMemberCP">
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.User#logoutUserPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Template Site Name" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="ControlMenu#ADD" />

		<execute macro="Portal.User#logoutUserPG" />

		<execute macro="Portal.User#loginUserPG" />
	</command>

	<command name="ResetPageChanges" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplatesNavigator#gotoSiteTemplatesPage">
			<var name="pageName" value="Home" />
			<var name="siteName" value="${siteName}" />
			<var name="siteTemplateName" value="Community Site" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSiteViaLink">
			<var name="site" value="Community Site" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Categories Navigation" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSiteViaLink">
			<var name="site" value="Community Site" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Tags Navigation" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSiteViaLink">
			<var name="site" value="Community Site" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.Portlet#dragAndDropPortletToColumnPG">
			<var name="columnNumberFrom" value="1" />
			<var name="columnNumberTo" value="2" />
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSiteViaLink">
			<var name="site" value="Community Site" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewResetPageChanges">
			<var name="columnNumberFrom" value="2" />
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.Portlet#dragAndDropPortletToColumnPG">
			<var name="columnNumberFrom" value="2" />
			<var name="columnNumberTo" value="1" />
			<var name="portletName" value="User Statistics" />
		</execute>

		<execute macro="Portal.Portlet#dragAndDropPortletToColumnPG">
			<var name="columnNumberFrom" value="1" />
			<var name="columnNumberTo" value="2" />
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSiteViaLink">
			<var name="site" value="Community Site" />
		</execute>

		<execute macro="Portal.Portlet#dragAndDropPortletToColumnPG">
			<var name="columnNumberFrom" value="1" />
			<var name="columnNumberTo" value="2" />
			<var name="portletName" value="User Statistics" />
		</execute>

		<execute macro="Portal.Portlet#dragAndDropPortletToColumnPG">
			<var name="columnNumberFrom" value="2" />
			<var name="columnNumberTo" value="1" />
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addCommunityCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#dragAndDropPortletToColumnPG">
			<var name="columnNumberFrom" value="2" />
			<var name="columnNumberTo" value="1" />
			<var name="portletName" value="User Statistics" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.SiteTemplates#resetPageChanges">
			<var name="columnNumberTo" value="1" />
			<var name="portletName" value="User Statistics" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewResetPageChanges">
			<var name="columnNumberFrom" value="2" />
			<var name="portletName" value="User Statistics" />
		</execute>
	</command>

	<command name="SiteTemplateXSS" priority="4">
		<description message="This is a use case for LPS-44550" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateActive" value="Yes" />
			<var name="siteTemplateName"><![CDATA[<script>alert(123);</script>]]></var>
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addSiteTemplateCP">
			<var name="siteName" value="Site Name" />
			<var name="siteTemplateName"><![CDATA[<script>alert(123);</script>]]></var>
			<var name="siteType" value="Site Template" />
			<var name="uncheckPropagation" value="true" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesConfiguration">
			<var name="portlet" value="Site Settings" />
		</execute>

		<execute function="AssertAlertNotPresent" />
	</command>
</definition>