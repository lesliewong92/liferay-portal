<definition component-name="portal-util-misc">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.component.names" value="Nested Portlets" />
	<property name="testray.main.component.name" value="Nested Portlets" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
		</if>
	</tear-down>

	<command name="ViewWCDNestedPortlets" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Nested Portlets Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Nested Portlets Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.Portlet#dragAndDropPortletToColumnPG">
			<var name="columnNumberFrom" value="1" />
			<var name="columnNumberTo" value="2" />
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Nested Portlets Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Nested Applications" />
		</execute>

		<execute macro="Portal.NestedPortlets#viewConfigurationDefaultLayoutTemplate">
			<var name="portletName" value="Nested Applications" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Nested Portlets Page" />
		</execute>

		<execute macro="Portal.NestedPortlets#dragAndDropPortletToPortletColumnPG">
			<var name="columnNumberFrom" value="2" />
			<var name="portletColumnNumberTo" value="1" />
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Nested Portlets Page" />
		</execute>

		<execute macro="Portal.NestedPortlets#viewPG">
			<var name="portletColumnNumberTo" value="1" />
			<var name="portletName" value="Web Content Display" />
		</execute>
	</command>
</definition>