<definition component-name="portal-wcd">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Web Content Display" />

	<var name="pageName" value="Web Content Display Page" />
	<var name="portletName" value="Web Content Display" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Site#tearDownCP" />

				<execute macro="Portal.WebContent#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="AddDraftNotApproved" priority="4">
		<property name="testray.component.names" value="Web Content Display" />

		<execute macro="Portal.WebContent#addDraftPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="draft" value="true" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>
	</command>

	<command name="AddNewWebContentViaAddContentPanel" priority="4">
		<property name="testray.component.names" value="Web Content Display" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Web Content Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Page" />
		</execute>

		<execute macro="Portal.Content#addNewPG">
			<var name="assetType" value="Basic Web Content" />
		</execute>

		<execute macro="Portal.IFrame#selectEditAssetFrame" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#publishViaWCD" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Page" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>
	</command>

	<command name="AddPortletWCDSite" priority="4">
		<property name="testray.component.names" value="Web Content Display" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>
	</command>

	<command name="AddWebContent" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Web Content Display" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>
	</command>

	<command name="AddWebContentPortalScopeCurrentPage" priority="3">
		<property name="testray.component.names" value="Web Content Display" />

		<for list="1,2,3" param="i">
			<execute macro="Portal.Page#add">
				<var name="pageName" value="Web Content Display Page${i}" />
			</execute>

			<execute macro="Portal.Portlet#addPG">
				<var name="portletName" value="Web Content Display" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page1" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#configureScopePG">
			<var name="scopeSelection" value="Web Content Display Page1" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page1" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#viewConfigureScopePG">
			<var name="scopeSelection" value="Web Content Display Page1" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page2" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#configureScopePG">
			<var name="scopeSelection" value="Web Content Display Page1" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page2" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#viewConfigureScopePG">
			<var name="scopeSelection" value="Web Content Display Page1" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page3" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#configureScopePG">
			<var name="scopeSelection" value="Web Content Display Page3" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page1" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page2" />
		</execute>

		<execute macro="Portal.WebContent#viewDefaultPGViaWCD" />

		<execute macro="Portal.WebContentDisplayPortlet#selectWebContent">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page2" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page3" />
		</execute>

		<execute macro="Portal.WebContent#viewDefaultPGViaWCD" />

		<execute macro="Portal.WebContent#viewSelectNoPGViaWCD">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>
	</command>

	<command name="AddWebContentViaAddContentPanel" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Web Content Display,Training" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.Content#addPG">
			<var name="assetTitle" value="WC WebContent Title" />
			<var name="pageName" value="Web Content Display Page" />
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>
	</command>

	<command name="AddWithStructure" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Web Content Display,Training" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoManageStructures" />

		<execute macro="Portal.WebContentStructures#addCP">
			<var name="structureName" value="WC Structure Name" />
		</execute>

		<execute macro="Portal.DynamicDataMapping#addField">
			<var name="field" value="Text" />
			<var name="fieldFieldLabel" value="Text" />
			<var name="fieldName" value="Text" />
		</execute>

		<execute macro="Portal.WebContentStructures#saveCP">
			<var name="structureName" value="WC Structure Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoManageTemplates" />

		<execute macro="Portal.WebContentTemplates#addCP">
			<var name="templateFieldNames" value="Text" />
			<var name="templateLanguage" value="ftl" />
			<var name="templateName" value="WC Template Name" />
		</execute>

		<execute macro="Portal.WebContentTemplates#addStructure">
			<var name="structureName" value="WC Structure Name" />
			<var name="templateFieldNames" value="Text" />
			<var name="templateLanguage" value="ftl" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContent#addStructuredPGViaWCD">
			<var name="structureFieldName" value="Text" />
			<var name="structureName" value="WC Structure Name" />
			<var name="webContentText" value="WC WebContent Text" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>
	</command>

	<command name="AssertExpired" priority="4">
		<property name="testray.component.names" value="Web Content Display" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#expireSpecificVersionCP">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="expiredContent" value="true" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>
	</command>

	<command name="ChangeTemplate" priority="4">
		<property name="testray.component.names" value="Web Content Display" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Web Content Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Page" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoManageTemplates" />

		<execute macro="Portal.WebContentTemplates#addCP">
			<var name="templateFieldNames" value="Content,Content,Content" />
			<var name="templateLanguage" value="ftl" />
			<var name="templateName" value="Second Basic Template" />
		</execute>

		<execute macro="Portal.WebContentTemplates#addStructure">
			<var name="structureName" value="Basic Web Content" />
			<var name="templateFieldNames" value="Content,Content,Content" />
			<var name="templateLanguage" value="ftl" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Page" />
		</execute>

		<execute macro="Portal.Content#addNewPG">
			<var name="assetType" value="Basic Web Content" />
		</execute>

		<execute macro="Portal.IFrame#selectEditAssetFrame" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#selectTemplateCP">
			<var name="structureName" value="Basic Web Content" />
			<var name="templateName" value="Second Basic Template" />
		</execute>

		<execute macro="Portal.WebContent#publishViaWCD" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Page" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content WC WebContent Content WC WebContent Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditPGViaWCD">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#selectTemplateCP">
			<var name="structureName" value="Basic Web Content" />
			<var name="templateName" value="Basic Web Content" />
		</execute>

		<execute macro="Portal.WebContent#publishViaWCD" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Page" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>
	</command>

	<command name="EditWebContent" priority="4">
		<property name="testray.component.names" value="Web Content Display" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditPGViaWCD">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#editPGViaWCD">
			<var name="webContentContentEdit" value="WC WebContent Content Edit" />
			<var name="webContentTitleEdit" value="WC WebContent Title Edit" />
		</execute>
	</command>

	<command name="LocalizeWebContent" priority="4">
		<property name="test.name.skip.portal.instance" value="PGWebcontentdisplay#LocalizeWebContent" />
		<property name="testray.component.names" value="Localization,Web Content Display" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Language Selector" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditPGViaWCD">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#addLocale">
			<var name="language" value="Chinese (China)" />
			<var name="locale" value="zh-CN" />
		</execute>

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="世界您好 Content" />
			<var name="webContentTitle" value="世界您好 Title" />
		</execute>

		<execute macro="Portal.Button#clickPublish" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.LanguagePortlet#selectLanguagePG">
			<var name="language" value="Chinese (China)" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="世界您好 Content" />
		</execute>

		<execute macro="Portal.LanguagePortlet#tearDownLanguagePG" />

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>
	</command>

	<command name="RemoveWCDPortletSite" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Web Content Display,Training" />

		<execute macro="Portal.Portlet#deletePG">
			<var name="portletName" value="Web Content Display" />
		</execute>
	</command>

	<command name="SearchWebContent" priority="4">
		<property name="testray.component.names" value="Web Content Display" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#searchWebContent">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#searchWebContentNo">
			<var name="webContentTitle" value="WC2 WebContent2 Title2" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#searchWebContent">
			<var name="webContentSearchValue" value="&quot;WC WebContent Title&quot;" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#searchWebContentNo">
			<var name="webContentSearchValue" value="&quot;WC2 WebContent2 Title2&quot;" />
			<var name="webContentTitle" value="WC2 WebContent2 Title2" />
		</execute>
	</command>

	<command name="SelectWebContent" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Web Content Display,Training" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#selectWebContent">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>
	</command>

	<command name="SelectWebContentScopeGlobal" priority="3">
		<property name="testray.component.names" value="Web Content Display" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Global" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#configureScopePG">
			<var name="scopeSelection" value="Global" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#viewConfigureScopePG">
			<var name="scopeSelection" value="Global" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#selectWebContent">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>
	</command>

	<command name="ViewAllFileTypesEnabled" priority="4">
		<property name="test.name.skip.portal.instance" value="PGWebcontentdisplay#ViewAllFileTypesEnabled" />
		<property name="testray.component.names" value="Web Content Display" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Web Content Display Page" />
		</execute>

