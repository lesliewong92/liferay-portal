<definition component-name="portal-web-forms-and-data-lists">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Forms" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Navigator#openURL" />

				<execute macro="Portal.ProductMenu#gotoSitesContent">
					<var name="portlet" value="Forms" />
				</execute>

				<execute macro="Portal.FormsAdmin#teardownForms" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="ConfigureAutofillRule" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="test.name.skip.portal.instance" value="FormRules#ConfigureAutofillRule" />

		<description message="This is a use case for LPS-70446." />

		<var method="TestPropsUtil#get('portal.url')" name="portalURL" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Forms" />
		</execute>

		<execute macro="Portal.FormsAdminNavigator#gotoDataProviders" />

		<execute macro="Portal.FormsAdminNavigator#gotoAddDataProvider" />

		<execute macro="Portal.FormsAdmin#editDataProvider">
			<var name="name" value="Liferay Countries" />
			<var name="outputParameterLabel" value="Countries Full Name" />
			<var name="outputParameterName" value="Country Name" />
			<var name="outputParameterPath" value="nameCurrentValue" />
			<var name="outputParameterType" value="List" />
			<var name="password" value="test" />
			<var name="url" value="${portalURL}/api/jsonws/country/get-countries" />
			<var name="username" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.FormsAdmin#saveDataProvider" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Forms" />
		</execute>

		<execute macro="Portal.FormsAdminNavigator#gotoAddForm" />

		<execute macro="Portal.Form#editName" />

		<execute macro="Portal.Form#editDescription" />

		<execute macro="Portal.Form#gotoAddField">
			<var name="fieldType" value="Text Field" />
		</execute>

		<execute macro="Portal.Form#editFieldLabel">
			<var name="fieldValue" value="Text Field" />
		</execute>

		<execute macro="Portal.Form#closeSidebar" />

		<execute macro="Portal.Form#gotoAddField">
			<var name="fieldType" value="Select from List" />
		</execute>

		<execute macro="Portal.Form#editFieldLabel">
			<var name="fieldValue" value="Countries" />
		</execute>

		<execute macro="Portal.Form#closeSidebar" />

		<execute macro="Portal.FormsAdminNavigator#gotoRules" />

		<execute macro="Portal.FormRules#addRule" />

		<execute macro="Portal.FormRules#configureConditionOptions">
			<var name="conditionField" value="Text Field" />
			<var name="conditionFieldValue" value="country" />
			<var name="conditionOperator" value="Contains" />
			<var name="conditionRowNumber" value="1" />
			<var name="conditionValueType" value="Value" />
		</execute>

		<execute macro="Portal.FormRules#configureActionOptions">
			<var name="action" value="Autofill" />
			<var name="actionRowNumber" value="1" />
			<var name="actionTarget" value="Liferay Countries" />
		</execute>

		<execute macro="Portal.FormRules#selectAutofillOutput">
			<var name="dataProviderOutput" value="Countries" />
		</execute>

		<execute macro="Portal.FormRules#save" />

		<execute macro="Portal.FormsAdminNavigator#gotoFormBuilder" />

		<execute macro="Portal.Form#save" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Form Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Form Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="pageName" value="Form Page" />
			<var name="portletName" value="Form" />
		</execute>

		<execute macro="Portal.FormPortletNavigator#gotoSelectForm" />

		<execute macro="Portal.FormPortletConfiguration#selectForm" />

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Form Page" />
		</execute>

		<execute macro="Portal.FormFields#viewTextLabel">
			<var name="fieldLabel" value="Text Field" />
			<var name="fieldName" value="TextField" />
		</execute>

		<execute macro="Portal.FormFields#editText">
			<var name="fieldName" value="TextField" />
			<var name="fieldValue" value="test" />
		</execute>

		<execute macro="Portal.FormFields#viewSelectOptionsList">
			<var name="fieldName" value="Countries" />
			<var name="selectOption" value="Option" />
		</execute>

		<execute macro="Portal.FormFields#editText">
			<var name="fieldName" value="TextField" />
			<var name="fieldValue" value="country" />
		</execute>

		<execute macro="Portal.FormFields#viewSelectOptionsList">
			<var name="fieldName" value="Countries" />
			<var name="selectOption" value="Afghanistan" />
		</execute>
	</command>

	<command name="ConfigureCalculateRule" priority="5">
		<property name="portal.acceptance" value="pending" />
		<description message="This is a use case for LPS-71592." />

		<var method="TestPropsUtil#get('portal.url')" name="portalURL" />

