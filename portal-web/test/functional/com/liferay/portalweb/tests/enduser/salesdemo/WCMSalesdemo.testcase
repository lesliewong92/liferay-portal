<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Web Content Display" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#tearDownCP" />

				<execute macro="Portal.Site#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="IFrameDemo" priority="4">
		<property name="testray.component.names" value="IFrame Portlet" />

		<execute macro="Portal.Page#add">
			<var name="columnName" value="1 Column" />
			<var name="pageName" value="IFrame Page" />
			<var name="sitePageType" value="Empty Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="IFrame Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="IFrame" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.IFrame#addCP">
			<var name="sourceURL" value="http://iscaliforniaonfire.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="IFrame Page" />
		</execute>

		<execute function="SelectFrame" locator1="IFrame#IFRAME_PORTLET" />

		<execute function="AssertTextEquals#assertPartialText" locator1="Embedded#EMBEDDED_TEXT_UPDATED" value1="updated" />
	</command>

	<command name="SalesDemo" priority="4">
		<property name="testray.component.names" value="Web Content Administration,Web Content Display" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="DHS Content" />
			<var name="webContentTitle" value="DHS Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.SitePageNavigator#gotoEditPage">
			<var name="page" value="Welcome" />
		</execute>

		<execute macro="Portal.Page#editPageLayoutColumn">
			<var name="columnName" value="2 Columns (50/50)" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Welcome" />
		</execute>

		<execute macro="Portal.Content#addPG">
			<var name="assetTitle" value="DHS Title" />
			<var name="webContentContent" value="DHS Content" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="DHS Content" />
			<var name="webContentTitle" value="DHS Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.WebContent#viewNoEditWCViaWCD" />

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
			<var name="webContentContent" value="DHS Content" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Sales Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Sales Page" />
		</execute>

		<execute macro="Portal.MobileDevice#previewPG">
			<var name="deviceType" value="tablet" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.MobileDevice#previewPG">
			<var name="deviceType" value="smartphone" />
		</execute>
	</command>
</definition>