<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Site Administration" />

	<var name="globalSiteName" value="Global" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#firstLoginPG" />

				<execute macro="Portal.Site#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.WebContent#tearDownCP">
					<var name="siteScopeName" value="Global" />
				</execute>

				<execute macro="Portal.WebContentTemplates#tearDownCP">
					<var name="siteScopeName" value="Global" />
				</execute>

				<execute macro="Portal.WebContentStructures#tearDownCP">
					<var name="siteScopeName" value="Global" />
				</execute>
			</else>
		</if>
	</tear-down>

	<command ignore="true" name="AddChildSiteFromImportedSiteTemplate" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.UsersAndOrganizationsNavigator#gotoOrganizations" />

		<execute macro="Portal.LAR#importPortlet">
			<var name="larFileName" value="organizations-7.0.lar" />
			<var name="portletName" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.Organization#viewCP">
			<var name="orgName" value="Space Program Academy of Continuing Education" />
			<var name="orgType" value="Organization" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.Organization#addSiteCP">
			<var name="orgName" value="College of Agricultural Science" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="College of Agricultural Science" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.LAR#importPortlet">
			<var name="larFileName" value="class-site-template-7.0.lar" />
			<var name="portletName" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#viewCP">
			<var name="siteTemplateName" value="Digital Class Room" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="membershipType" value="Private" />
			<var name="parentSiteName" value="College of Agricultural Science" />
			<var name="siteName" value="Moon Rocks 101" />
			<var name="siteType" value="Blank" />
		</execute>

		<execute macro="Portal.Site#selectPageType">
			<var name="selectPrivatePages" value="true" />
			<var name="siteTemplate" value="Digital Class Room" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="membershipType" value="Private" />
			<var name="parentSiteName" value="College of Agricultural Science" />
			<var name="siteName" value="Moon Rocks 202" />
			<var name="siteType" value="Blank" />
		</execute>

		<execute macro="Portal.Site#selectPageType">
			<var name="checkPrivatePagesPropagation" value="true" />
			<var name="selectPrivatePages" value="true" />
			<var name="siteTemplate" value="Digital Class Room" />
		</execute>

		<execute macro="Portal.Navigator#openPrivateSiteURL">
			<var name="siteName" value="Moon Rocks 101" />
		</execute>

		<for list="Courses,Student Boards,Materials" param="pageName" >
			<execute macro="Portal.Navigator#gotoPrivateSitePage">
				<var name="pageName" value="${pageName}" />
				<var name="siteName" value="Moon Rocks 101" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#openPrivateSiteURL">
			<var name="siteName" value="Moon Rocks 202" />
		</execute>

		<for list="Courses,Student Boards,Materials" param="pageName" >
			<execute macro="Portal.Navigator#gotoPrivateSitePage">
				<var name="pageName" value="${pageName}" />
				<var name="siteName" value="Moon Rocks 202" />
			</execute>
		</for>
	</command>

	<command name="AddPageAndChildPageTranslations" priority="3">
		<property name="test.name.skip.portal.instance" value="SitesUsecase#AddPageAndChildPageTranslations" />
		<property name="testray.component.names" value="Localization,Site Administration,Site Localization,Site Pages Administration" />

		<var method="TestPropsUtil#get('portal.url')" name="portalURL" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Home" />
		</execute>

		<execute macro="Portal.Page#addPageTranslations">
			<var name="page" value="Home" />
			<var name="pageTranslation" value="es_ES" />
			<var name="pageTranslationName" value="Casa" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#viewTranslationsPG">
			<var name="pageLocalizationMessage" value="This page is displayed in Spanish (Spain). Display the page in English (United States). Set Spanish (Spain) as your preferred language." />
			<var name="pageLocalizationPreferredLanguage" value="Set Spanish (Spain) as your preferred language." />
			<var name="pageName" value="Casa" />
			<var name="sitePageURL" value="${portalURL}/es/web/site-name/home" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#localizedPG">
			<var name="pageLocale" value="Display the page in English (United States)" />
		</execute>

		<execute macro="Portal.Page#addChild">
			<var name="page" value="Public Pages" />
			<var name="pageName" value="Home" />
			<var name="siteChildPageName" value="Blog Page" />
			<var name="siteName" value="Site Name" />
			<var name="siteScopeSelected" value="true" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
		</execute>

		<execute macro="Portal.Page#addPageTranslations">
			<var name="page" value="Blog Page" />
			<var name="pageTranslation" value="es_ES" />
			<var name="pageTranslationName" value="Blog Página" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#viewTranslationsPG">
			<var name="childPageName" value="Blog Página" />
			<var name="pageLocalizationMessage" value="This page is displayed in Spanish (Spain). Display the page in English (United States). Set Spanish (Spain) as your preferred language." />
			<var name="pageLocalizationPreferredLanguage" value="Set Spanish (Spain) as your preferred language." />
			<var name="sitePageURL" value="${portalURL}/es/web/site-name/blog-page" />
		</execute>
	</command>

	<command name="SitesTemplatePermissionPersistence" priority="3">
		<property name="testray.component.names" value="Permissions,Site Administration" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addCommunityCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoConfigurationPG" >
			<var name="portletName" value="Polls Display" />
		</execute>

		<execute macro="Portal.PermissionsInline#assertDefaultPG">
			<var name="roleList" value="Guest,Owner,Power User,Site Member,User" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoConfigurationPG" >
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.PermissionsInline#assertDefaultPG">
			<var name="roleList" value="Guest,Owner,Power User,Site Member,User" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#viewTitle">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.SiteTemplates#resetPageChanges">
			<var name="columnNumberTo" value="1" />
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#viewNoSpecificPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoConfigurationPG" >
			<var name="portletName" value="Polls Display" />
		</execute>

		<execute macro="Portal.PermissionsInline#assertDefaultPG">
			<var name="roleList" value="Guest,Owner,Power User,Site Member,User" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Polls#addPollPG">
			<var name="pollsQuestion" value="What is the most important issue for this election?" />
			<var name="pollsQuestionChoiceA" value="The Economy" />
			<var name="pollsQuestionChoiceB" value="The National Debt" />
			<var name="pollsQuestionTitle" value="Election Poll" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Polls#selectPollPG">
			<var name="pollsQuestionTitle" value="Election Poll" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Polls#viewPollPG">
			<var name="pollsQuestion" value="What is the most important issue for this election?" />
			<var name="pollsQuestionChoiceList" value="The Economy,The National Debt" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoConfigurationPG" >
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.PermissionsInline#assertDefaultPG">
			<var name="roleList" value="Guest,Owner,Power User,Site Member,User" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addPG">
			<var name="threadBody" value="This is the message boards thread." />
			<var name="threadSubject" value="Thread" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.MessageboardsThread#gotoPG">
			<var name="lastPostUserName" value="Test Test" />
			<var name="postCount" value="1" />
			<var name="threadBody" value="This is the message boards thread." />
			<var name="threadSubject" value="Thread" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewPG">
			<var name="threadBody" value="This is the message boards thread." />
			<var name="threadSubject" value="Thread" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<var method="TestPropsUtil#get('portal.url')" name="portalURL" />

		<execute function="Portal.Open" locator1="${portalURL}/web/site-name/home" />

		<execute macro="Portal.Portlet#viewTitle">
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#gotoPG">
			<var name="lastPostUserName" value="Test Test" />
			<var name="postCount" value="1" />
			<var name="threadBody" value="This is the message boards thread." />
			<var name="threadSubject" value="Thread" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewPG">
			<var name="threadBody" value="This is the message boards thread." />
			<var name="threadSubject" value="Thread" />
		</execute>

		<execute macro="Portal.Portlet#viewTitle">
			<var name="portletName" value="Polls Display" />
		</execute>

		<execute function="Portal.AssertTextEquals" locator1="Message#INFO" value1="Please sign in to vote." />

		<execute function="Portal.AssertElementPresent" locator1="Search#SEARCH_FIELD" />

		<execute macro="Portal.Portlet#viewTitle">
			<var name="portletName" value="User Statistics" />
		</execute>

		<execute macro="Portal.SignIn#signIn">
			<var name="userEmailAddress" value="test@liferay.com" />
			<var name="userPassword" value="test" />
		</execute>

		<execute function="Portal.Open" locator1="${portalURL}/web/site-name/home" />

		<execute macro="Portal.PermissionsInline#gotoConfigurationPG" >
			<var name="portletName" value="Polls Display" />
		</execute>

		<execute macro="Portal.PermissionsInline#addOrRemoveViewPermissionFromAllRoles">
			<var name="addOrRemoveViewPermission" value="Remove" />
			<var name="roleList" value="Guest,Owner,Power User,Site Member,User" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoConfigurationPG" >
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.PermissionsInline#addOrRemoveViewPermissionFromAllRoles">
			<var name="addOrRemoveViewPermission" value="Remove" />
			<var name="roleList" value="Guest,Owner,Power User,Site Member,User" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute function="Portal.Open" locator1="${portalURL}/web/site-name/home" />

		<execute function="Portal.AssertTextEquals" locator1="Message#ERROR_1_COLUMN_1" value1="You do not have the roles required to access this portlet." />
		<execute function="Portal.AssertTextEquals" locator1="Message#ERROR_1_COLUMN_2" value1="You do not have the roles required to access this portlet." />
	</command>

	<command name="ViewDefaultGlobalScopeLandingPage" priority="4">
		<property name="testray.component.names" value="Site Administration" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Global" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.Site#viewGlobalLandingDefault">
			<var name="portletName" value="Web Content" />
			<var name="siteName" value="Global" />
		</execute>
	</command>
</definition>