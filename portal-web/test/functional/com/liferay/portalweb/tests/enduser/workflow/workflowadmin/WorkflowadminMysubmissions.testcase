			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addWithWorkflowCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Submissions" />
		</execute>

		<execute macro="Portal.Workflow#withdrawTaskByActions">
			<var name="workflowAssetTitle" value="WC WebContent Title" />
			<var name="workflowAssetType" value="Web Content Article" />
			<var name="workflowDefinition" value="Single Approver" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoViewStatus">
			<var name="webContentStatus" value="Draft" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewStatus">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentStatus" value="Draft" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>
	</command>

	<command name="WithdrawTaskAssignedToMyRolesByDetails" priority="3">
		<var name="webContentContent" value="WC WebContent Content" />
		<var name="webContentTitle" value="WC WebContent Title" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addWithWorkflowCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Submissions" />
		</execute>

		<execute macro="Portal.Workflow#withdrawTaskByDetails">
			<var name="workflowAssetContent" value="WC WebContent Content" />
			<var name="workflowAssetTitle" value="WC WebContent Title" />
			<var name="workflowAssetType" value="Web Content Article" />
			<var name="workflowDefinition" value="Single Approver" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
