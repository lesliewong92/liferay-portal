<definition component-name="portal-workflow">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Workflow" />

	<var name="pageName" value="Asset Publisher Page" />
	<var name="portletName" value="Asset Publisher" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesConfiguration">
			<var name="portlet" value="Workflow" />
		</execute>

		<execute macro="Portal.Workflow#configureWorkflow">
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
			<var name="workflowResourceValue" value="Blogs Entry" />
		</execute>

		<execute macro="Portal.Workflow#configureWorkflow">
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
			<var name="workflowResourceValue" value="Message Boards Message" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.Workflow#configureWorkflowViaFolderInfo">
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.MessageboardsThread#tearDownCP" />

				<execute macro="Portal.BlogsEntry#tearDownCP" />

				<execute macro="Portal.WebContent#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.Workflow#tearDownPortalWorkflow" />

				<execute macro="Portal.Workflow#tearDownSiteWorkflow" />
			</else>
		</if>
	</tear-down>

	<command name="ApproveBlogsEntryPG" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.Blogs#addWithWorkflowViaAP">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByActions">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
			<var name="workflowAssetType" value="Blogs Entry" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewWithWorkflowPGViaAP">
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#approveTaskByActions">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
			<var name="workflowAssetType" value="Blogs Entry" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewPGViaAP">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Submissions" />
		</execute>

		<execute macro="Portal.Workflow#gotoViewCompletedAssetViaMySubmissions">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntryAsWorkflowAsset">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>
	</command>

	<command name="ApproveMessageBoardsThreadPG" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addWithWorkflowCP">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByActions">
			<var name="workflowAssetTitle" value="MB Thread Message Subject" />
			<var name="workflowAssetType" value="Message Boards Message" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewWithWorkflowPGViaAP">
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#approveTaskByActions">
			<var name="workflowAssetTitle" value="MB Thread Message Subject" />
			<var name="workflowAssetType" value="Message Boards Message" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewPGViaAP">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>
	</command>

	<command name="ApproveWebContentPG" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.WebContent#addWithWorkflowPGViaAP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByActions">
			<var name="workflowAssetTitle" value="WC WebContent Title" />
			<var name="workflowAssetType" value="Web Content Article" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.WebContent#viewWithWorkflowPGViaAP">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#approveTaskByActions">
			<var name="workflowAssetTitle" value="WC WebContent Title" />
			<var name="workflowAssetType" value="Web Content Article" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaAP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>
	</command>

	<command name="RejectBlogsEntryPG" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.Blogs#addWithWorkflowViaAP">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByActions">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
			<var name="workflowAssetType" value="Blogs Entry" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewWithWorkflowPGViaAP">
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#rejectTaskByActions">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
			<var name="workflowAssetType" value="Blogs Entry" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#viewRejectedTask">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
			<var name="workflowAssetType" value="Blogs Entry" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewWithWorkflowPGViaAP">
			<var name="entryTitle" value="Blogs Entry Title" />
			<var name="webContentTitle" value="Blogs Entry Title" />
		</execute>
	</command>
</definition>