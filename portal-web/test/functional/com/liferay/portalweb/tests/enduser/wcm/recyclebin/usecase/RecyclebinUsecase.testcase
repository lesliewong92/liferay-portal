<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Recycle Bin" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="DisableRecycleBin" priority="3">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesConfiguration">
			<var name="portlet" value="Site Settings" />
		</execute>

		<execute macro="Portal.RecycleBin#disableRecycleBinViaSiteSettings" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="Web Content Content" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#deleteWithDisabledRB">
			<var name="entryTitle" value="Web Content Title" />
		</execute>
	</command>

	<command name="RecycleBinBlogs" priority="3">
		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsEntry#moveToRecycleBinPG">
			<var name="assetType" value="Blogs Entry" />
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="Blogs Entry Title" />
			<var name="assetType" value="Blogs Entry" />
			<var name="deleteUser" value="Test Test" />
		</execute>

		<execute macro="Portal.RecycleBin#restoreCP">
			<var name="assetName" value="Blogs Entry Title" />
			<var name="assetRestoreLocation" value="Blogs" />
			<var name="assetType" value="Blogs Entry" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoPG">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>
	</command>

	<command name="RecycleBinBookmarks" priority="3">
		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Bookmarks" />
		</execute>

		<execute macro="Portal.BookmarksFolder#addPG">
			<var name="folderDescription" value="Folder Description" />
			<var name="folderName" value="Folder Name" />
		</execute>

		<execute macro="Portal.BookmarksFolder#gotoPG">
			<var name="folderName" value="Folder Name" />
		</execute>

		<execute macro="Portal.BookmarksFolder#addSubfolderPG">
			<var name="folderDescription" value="Subfolder Description" />
			<var name="folderName" value="Subfolder Name" />
		</execute>

		<execute macro="Portal.BookmarksFolder#gotoSubfolderPG">
			<var name="folderName" value="Folder Name" />
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
			<var name="subfolderName" value="Subfolder Name" />
		</execute>

		<execute macro="Portal.Bookmark#addPG">
			<var name="bookmarkDescription" value="Bookmark Description" />
			<var name="bookmarkName" value="Bookmark Name" />
			<var name="bookmarkURL" value="https://www.liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BookmarksFolder#gotoPG">
			<var name="folderName" value="Folder Name" />
		</execute>

		<execute macro="Portal.BookmarksFolder#moveSubfolderToRecycleBinPG">
			<var name="subfolderName" value="Subfolder Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="Subfolder Name" />
			<var name="assetType" value="Bookmarks Folder" />
			<var name="deleteUser" value="Test Test" />
		</execute>

		<execute macro="Portal.RecycleBin#restoreCP">
			<var name="assetName" value="Subfolder Name" />
			<var name="assetRestoreLocation" value="Folder Name" />
			<var name="assetType" value="Bookmarks Folder" />
		</execute>

		<execute macro="Portal.BookmarksFolder#gotoSubfolderPG">
			<var name="folderName" value="Folder Name" />
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
			<var name="subfolderName" value="Subfolder Name" />
		</execute>

		<execute macro="Portal.Bookmark#viewBookmark">
			<var name="bookmarkName" value="Bookmark Name" />
			<var name="bookmarkURL" value="https://www.liferay.com" />
		</execute>

		<execute macro="Portal.BookmarksFolder#gotoSubfolderPG">
			<var name="folderName" value="Folder Name" />
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
			<var name="subfolderName" value="Subfolder Name" />
		</execute>

		<execute macro="Portal.Bookmark#moveToRecycleBinPG">
			<var name="bookmarkName" value="Bookmark Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="Bookmark Name" />
			<var name="assetType" value="Bookmarks Entry" />
			<var name="deleteUser" value="Test Test" />
		</execute>

		<execute macro="Portal.RecycleBin#restoreCP">
			<var name="assetName" value="Bookmark Name" />
			<var name="assetRestoreLocation" value="Subfolder Name" />
			<var name="assetType" value="Bookmarks Entry" />
		</execute>

		<execute macro="Portal.BookmarksFolder#gotoSubfolderPG">
			<var name="folderName" value="Folder Name" />
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
			<var name="subfolderName" value="Subfolder Name" />
		</execute>

		<execute macro="Portal.Bookmark#viewBookmark">
			<var name="bookmarkName" value="Bookmark Name" />
			<var name="bookmarkURL" value="https://www.liferay.com" />
		</execute>
	</command>

	<command name="RecycleBinMBAttachment" priority="3">
		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addCPWithAttachment">
			<var name="mbAttachmentFile" value="Document_1.doc" />
			<var name="threadBody" value="MB Body" />
			<var name="threadSubject" value="MB Subject" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#gotoCP">
			<var name="threadSubject" value="MB Subject" />
		</execute>

		<execute macro="Portal.MessageboardsThread#editCP">
			<var name="mbAttachmentFile" value="Document_1.doc" />
			<var name="threadAttachmentRemove" value="true" />
			<var name="threadBodyEdit" value="MB Body Edit" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewCP">
			<var name="mbAttachmentFile" value="Recently Removed Attachment" />
			<var name="postsNumber" value="1" />
			<var name="threadBody" value="MB Body Edit" />
			<var name="threadSubject" value="MB Subject" />
			<var name="userName" value="Test Test" />
		</execute>

		<execute macro="Portal.ProductMenuHelper#closeProductMenu" />

		<execute macro="Portal.MessageboardsThread#restoreMBAttachmentCP">
			<var name="mbAttachmentFile" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewCP">
			<var name="mbAttachmentFile" value="Document_1.doc" />
			<var name="postsNumber" value="1" />
			<var name="threadBody" value="MB Body Edit" />
			<var name="threadSubject" value="MB Subject" />
			<var name="userName" value="Test Test" />
		</execute>
	</command>

	<command name="RecycleBinScheduledCleanup" priority="3">
		<property name="custom.properties" value="trash.entry.check.interval=1${line.separator}trash.entries.max.age=1" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsEntry#moveToRecycleBinPG">
			<var name="assetType" value="Blogs Entry" />
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="Blogs Entry Title" />
			<var name="assetType" value="Blogs Entry" />
			<var name="customMaxAgeMsg" value="Entries that have been in the Recycle Bin for more than 1 minute are automatically deleted." />
			<var name="deleteUser" value="Test Test" />
		</execute>

		<execute function="Pause" locator1="120000" />

		<execute function="Refresh" />

		<execute macro="Portal.RecycleBin#viewDefaultCP">
			<var name="assetName" value="Blogs Entry Title" />
		</execute>
	</command>

	<command name="RecycleBinSearchBlogsEntries" priority="3">
		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content 1" />
			<var name="entryTitle" value="Blogs Entry Title 1" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content 2" />
			<var name="entryTitle" value="Blogs Entry Title 2" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content 3" />
			<var name="entryTitle" value="Blogs Entry Title 3" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsEntry#moveToRecycleBinPG">
			<var name="assetType" value="Blogs Entry" />
			<var name="entryContent" value="Blogs Entry Content 3" />
			<var name="entryTitle" value="Blogs Entry Title 3" />
		</execute>

		<execute macro="Portal.BlogsEntry#moveToRecycleBinPG">
			<var name="assetType" value="Blogs Entry" />
			<var name="entryContent" value="Blogs Entry Content 2" />
			<var name="entryTitle" value="Blogs Entry Title 2" />
		</execute>

		<execute macro="Portal.BlogsEntry#moveToRecycleBinPG">
			<var name="assetType" value="Blogs Entry" />
			<var name="entryContent" value="Blogs Entry Content 1" />
			<var name="entryTitle" value="Blogs Entry Title 1" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#searchCP">
			<var name="assetName" value="1" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="Blogs Entry Title 1" />
			<var name="assetType" value="Blogs Entry" />
			<var name="deleteUser" value="Test Test" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#searchCP">
			<var name="assetName" value="2" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="Blogs Entry Title 2" />
			<var name="assetType" value="Blogs Entry" />
			<var name="deleteUser" value="Test Test" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#searchCP">
			<var name="assetName" value="3" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="Blogs Entry Title 3" />
			<var name="assetType" value="Blogs Entry" />
			<var name="deleteUser" value="Test Test" />
		</execute>
	</command>

	<command name="RecycleBinSearchDMEntriesInFolder" priority="3">
		<property name="custom.properties" value="default.layout.template.id=1_column" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#enableActionsMenuOnPortlet" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMPortlet#setDescriptiveView" />

		<execute macro="Portal.DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description 1" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="DM Document Title 1" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description 2" />
			<var name="dmDocumentFile" value="Document_2.doc" />
			<var name="dmDocumentTitle" value="DM Document Title 2" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMFolder#deletePG">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#searchCP">
			<var name="assetName" value="1" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="DM Document Title 1" />
			<var name="assetType" value="Document" />
			<var name="deleteUser" value="test test" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#searchCP">
			<var name="assetName" value="2" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="DM Document Title 2" />
			<var name="assetType" value="Document" />
			<var name="deleteUser" value="test test" />
		</execute>
	</command>

	<command name="RecycleBinStaging" priority="3">
		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaWCD">
			<var name="webContentContent" value="WC Content" />
			<var name="webContentTitle" value="WC Title" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC Content" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="siteName" value="Site Name" />
			<var name="uncheckContent" value="Web Content" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#moveToRecycleBinCP">
			<var name="assetType" value="Web Content Article" />
			<var name="webContentTitle" value="WC Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsEntry#moveToRecycleBinPG">
			<var name="assetType" value="Blogs Entry" />
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

