<definition component-name="portal-collaboration">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="custom.properties" value="default.layout.template.id=1_column" />
	<property name="testray.main.component.name" value="Notifications" />

	<var name="pageName" value="Message Boards Page" />
	<var name="portletName" value="Message Boards" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="password" value="password" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#assignRegularRoleCP">
			<var name="roleTitle" value="Administrator" />
			<var name="userScreenName" value="usersn" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.MessageboardsCategory#tearDownCP" />

				<execute macro="Portal.MessageboardsThread#tearDownCP" />

				<execute macro="Portal.Notifications#tearDownUnreadNotifications" />

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.NotificationsPortlet#tearDownUserDeliveries" />

				<execute macro="Portal.User#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="FilterByReadAndUnread" priority="5">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsPortlet#subscribePG" />

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addPG">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject1" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addPG">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject2" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="activePanel" value="Notifications" />
			<var name="notificationCount" value="2" />
		</execute>

		<execute macro="Portal.Notifications#gotoNotifications" />

		<execute macro="Portal.Notifications#goToReadFilter" />

		<execute macro="Portal.Notifications#viewDefaultContent" />

		<execute macro="Portal.Notifications#goToUnreadFilter" />

		<execute macro="Portal.Notifications#viewNewContent">
			<var name="assetType" value="message boards message" />
			<var name="contentBody" value="MB Thread Message Subject1" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#viewNewContent">
			<var name="assetType" value="message boards message" />
			<var name="contentBody" value="MB Thread Message Subject2" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute function="Check#checkAll" locator1="Checkbox#SELECT_ALL" />

		<execute function="Click" locator1="Icon#MARK_AS_READ" />

		<execute macro="Portal.Notifications#viewDefaultContent" />

		<execute macro="Portal.Notifications#viewNoNotifications">
			<var name="activePanel" value="Notifications" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="Notifications" />
		</execute>

		<execute function="Check#checkAll" locator1="Checkbox#SELECT_ALL" />

		<execute function="Click" locator1="Icon#MARK_AS_UNREAD" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="2" />
		</execute>
	</command>

	<command name="ViewNoWebsiteNotificationForNewThreadInCategory" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.NotificationsPortlet#gotoNotificationDelivery" />

		<execute macro="Portal.IFrame#selectConfigurationFrame" />

		<execute macro="Portal.NotificationsPortlet#disableUserDeliveries">
			<var name="actionType" value="Adds" />
			<var name="contentType" value="Message Boards" />
			<var name="notificationType" value="Website" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#addPG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#subscribePG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#gotoPG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addPG">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>
	</command>

	<command name="ViewNoWebsiteNotificationForUpdatedThreadInCategory" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.NotificationsPortlet#gotoNotificationDelivery" />

		<execute macro="Portal.IFrame#selectConfigurationFrame" />

		<execute macro="Portal.NotificationsPortlet#disableUserDeliveries">
			<var name="actionType" value="Updates" />
			<var name="contentType" value="Message Boards" />
			<var name="notificationType" value="Website" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#addPG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#subscribePG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#gotoPG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addPG">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#gotoPG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsThread#gotoPG">
			<var name="lastPostUserName" value="Test Test" />
			<var name="postCount" value="1" />
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.MessageboardsThread#editPG">
			<var name="threadBodyEdit" value="MB Thread Message Body Edit" />
			<var name="threadSubjectEdit" value="MB Thread Message Subject Edit" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>
	</command>

	<command name="ViewWebsiteNotificationForNewThreadInCategory" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#addPG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#subscribePG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#gotoPG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addPG">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="1" />
		</execute>

		<execute macro="Portal.Notifications#gotoNotifications" />

		<execute macro="Portal.Notifications#viewNewContent">
			<var name="assetType" value="message boards message" />
			<var name="contentBody" value="MB Thread Message Subject" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#navigateToContent">
			<var name="contentBody" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewPG">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
			<var name="userName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>
	</command>

	<command name="ViewWebsiteNotificationForUpdatedThreadInCategory" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#addPG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#subscribePG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#gotoPG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addPG">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#gotoPG">
			<var name="categoryName" value="MB Category Name" />
		</execute>

		<execute macro="Portal.MessageboardsThread#gotoPG">
			<var name="lastPostUserName" value="Test Test" />
			<var name="postCount" value="1" />
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.MessageboardsThread#editPG">
			<var name="threadBodyEdit" value="MB Thread Message Body Edit" />
			<var name="threadSubjectEdit" value="MB Thread Message Subject Edit" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="1" />
		</execute>

		<execute macro="Portal.Notifications#gotoNotifications" />

		<execute macro="Portal.Notifications#viewUpdatedContent">
			<var name="assetType" value="message boards message" />
			<var name="contentBody" value="MB Thread Message Subject Edit" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#navigateToContent">
			<var name="contentBody" value="MB Thread Message Subject Edit" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewPG">
			<var name="threadBody" value="MB Thread Message Body Edit" />
			<var name="threadSubject" value="MB Thread Message Subject Edit" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>
	</command>
</definition>