<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.component.names" value="Recycle Bin,Web Content Administration" />
	<property name="testray.main.component.name" value="Recycle Bin" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.WebContent#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="DeleteWebcontent" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#moveToRecycleBinCP">
			<var name="assetType" value="Web Content Article" />
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#deleteCP">
			<var name="assetName" value="WC WebContent Title" />
			<var name="assetType" value="Web Content Article" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewDefaultCP">
			<var name="assetName" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#viewDefaultCP">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>
	</command>

	<command name="MoveFolderWithWebContentToRecycleBin" priority="3">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#addCP">
			<var name="folderDescription" value="WC Folder Description" />
			<var name="folderName" value="WC Folder Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#gotoCP">
			<var name="folderName" value="WC Folder Name" />
			<var name="webContentTitle" value="WC Folder Name" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC Web Content Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#moveToRecycleBinCP">
			<var name="assetType" value="Web Content Folder" />
			<var name="folderName" value="WC Folder Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#viewDefaultCP">
			<var name="webContentTitle" value="WC Folder Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="WC Folder Name" />
			<var name="assetType" value="Web Content Folder" />
			<var name="deleteUser" value="Test Test" />
		</execute>
	</command>

	<command name="RecycleWebContentViaDeleteIcon" priority="3">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC Web Content Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#moveToRecycleBinViaDeleteIconCP" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#viewDefaultCP">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="WC WebContent Title" />
			<var name="assetType" value="Web Content Article" />
			<var name="deleteUser" value="Test Test" />
		</execute>
	</command>

	<command name="RestoreWebcontent" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#moveToRecycleBinCP">
			<var name="assetType" value="Web Content Article" />
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#restoreCP">
			<var name="assetName" value="WC WebContent Title" />
			<var name="assetRestoreLocation" value="Home" />
			<var name="assetType" value="Web Content Article" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewDefaultCP">
			<var name="assetName" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditCP">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>
	</command>

	<command name="UndoMoveToRecycleBin" priority="3">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC Web Content Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#moveToRecycleBinCP">
			<var name="assetType" value="Web Content Article" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.RecycleBin#undoMoveToRecycleBin" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewDefaultCP">
			<var name="assetName" value="WC WebContent Title" />
		</execute>
	</command>

	<command name="ViewDuplicateAssetNamesInRecycleBin" priority="3">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC Web Content Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#moveToRecycleBinViaDeleteIconCP" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="WC WebContent Title" />
			<var name="assetType" value="Web Content Article" />
			<var name="deleteUser" value="Test Test" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC Web Content Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#moveToRecycleBinViaDeleteIconCP" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewDuplicateNames">
			<var name="assetName" value="WC WebContent Title" />
		</execute>
	</command>

	<command name="ViewDuplicateFolderNamesInRecycleBin" priority="4">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#addCP">
			<var name="folderDescription" value="WC Folder Description" />
			<var name="folderName" value="WC Folder Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#moveToRecycleBinCP">
			<var name="assetType" value="Web Content Folder" />
			<var name="folderName" value="WC Folder Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="WC Folder Name" />
			<var name="assetType" value="Web Content Folder" />
			<var name="deleteUser" value="Test Test" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#addCP">
			<var name="folderDescription" value="WC Folder Description" />
			<var name="folderName" value="WC Folder Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#moveToRecycleBinCP">
			<var name="assetType" value="Web Content Folder" />
			<var name="folderName" value="WC Folder Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewDuplicateNames">
			<var name="assetName" value="WC Folder Name" />
		</execute>
	</command>

	<command name="ViewRecycleBinEntryViaSuccessMessageLink" priority="3">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC Web Content Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#moveToRecycleBinCP">
			<var name="assetType" value="Web Content Article" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.RecycleBin#gotoEntryViaSuccessMessage">
			<var name="assetName" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.RecycleBin#viewEntry">
			<var name="assetName" value="WC WebContent Title" />
		</execute>
	</command>
</definition>