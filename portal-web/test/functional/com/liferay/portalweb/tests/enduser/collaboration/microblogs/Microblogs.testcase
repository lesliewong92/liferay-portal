<definition component-name="portal-collaboration">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="custom.properties" value="default.layout.template.id=1_column" />
	<property name="testray.main.component.name" value="Microblogs" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Microblogs Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Microblogs Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Microblogs" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Microblogs Page" />
		</execute>

		<execute function="Portal.AssertTextEquals" locator1="Portlet#H2_HEADER" value1="Microblogs" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
		</if>
	</tear-down>

	<command name="AddEntry" priority="4">
		<execute macro="Portal.Microblogs#updateStatus">
			<var name="entryContent" value="Microblog Entry Content" />
		</execute>

		<execute macro="Portal.Microblogs#gotoTimelineTab" />

		<execute macro="Portal.Microblogs#viewEntry">
			<var name="entryContent" value="Microblog Entry Content" />
			<var name="userName" value="Test Test" />
		</execute>
	</command>

	<command name="DeleteEntry" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Microblogs#updateStatus">
			<var name="entryContent" value="Microblog Entry Content" />
		</execute>

		<execute macro="Portal.Microblogs#gotoTimelineTab" />

		<execute macro="Portal.Microblogs#deleteStatus">
			<var name="entryContent" value="Microblog Entry Content" />
		</execute>

		<execute macro="Portal.Microblogs#gotoTimelineTab" />

		<execute function="Portal.AssertTextEquals" locator1="Message#INFO" value1="There are no microblog entries." />
	</command>

	<command name="EditEntry" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Microblogs#updateStatus">
			<var name="entryContent" value="Microblog Entry Content" />
		</execute>

		<execute macro="Portal.Microblogs#gotoTimelineTab" />

		<execute macro="Portal.Microblogs#editStatus">
			<var name="entryContent" value="Microblog Entry Content" />
			<var name="entryContentEdit" value="Edited Microblogs Content" />
		</execute>

		<execute macro="Portal.Microblogs#gotoTimelineTab" />

		<execute macro="Portal.Microblogs#viewEntry">
			<var name="entryContent" value="Edited Microblogs Content" />
			<var name="userName" value="Test Test" />
		</execute>
	</command>
</definition>