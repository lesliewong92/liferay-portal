<definition component-name="portal-staging">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Export/Import Framework" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#logoutAndLoginPG">
					<var name="userLoginEmailAddress" value="test@liferay.com" />
					<var name="userLoginFullName" value="Test Test" />
				</execute>

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="EditExportTemplate" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="Web Content Content" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Export" />
		</execute>

		<execute macro="Portal.LAR#addExportTemplateCP">
			<var name="exportTemplateDescription" value="Export Template Description" />
			<var name="exportTemplateName" value="Export Template Name" />
		</execute>

		<execute macro="Portal.LAR#configureExportOptions">
			<var name="checkContentNameList" value="Web Content" />
			<var name="uncheckContentNameList" value="Blogs" />
		</execute>

		<execute macro="Portal.LAR#saveExportTemplateCP">
			<var name="exportTemplateDescription" value="Export Template Description" />
			<var name="exportTemplateName" value="Export Template Name" />
		</execute>

		<execute macro="Portal.LAR#exportExportTemplateCP">
			<var name="exportTemplateDescription" value="Export Template Description" />
			<var name="exportTemplateName" value="Export Template Name" />
			<var name="larFileName" value="Export.Template" />
		</execute>

		<execute function="Portal.Pause" locator1="3000" />

		<execute macro="Portal.LAR#downloadLar" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.LAR#importSiteCP">
			<var name="larFileName" value="Export.Template" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditCP">
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.WebContent#viewCP">
			<var name="webContentContent" value="Web Content Content" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Export" />
		</execute>

		<execute macro="Portal.LAR#gotoExportTemplateCP" />

		<execute macro="Portal.LAR#editExportTemplateCP">
			<var name="exportTemplateDescriptionEdit" value="Export Template Description Edit" />
			<var name="exportTemplateName" value="Export Template Name" />
			<var name="exportTemplateNameEdit" value="Export Template Name Edit" />
		</execute>

		<execute macro="Portal.LAR#configureExportOptions">
			<var name="checkContentNameList" value="Blogs" />
		</execute>

		<execute macro="Portal.LAR#saveExportTemplateCP">
			<var name="exportTemplateDescription" value="Export Template Description Edit" />
			<var name="exportTemplateName" value="Export Template Name Edit" />
		</execute>

		<execute macro="Portal.LAR#exportExportTemplateCP">
			<var name="exportTemplateDescription" value="Export Template Description Edit" />
			<var name="exportTemplateName" value="Export Template Name Edit" />
			<var name="larFileName" value="Edited Export Template Name" />
		</execute>

		<var method="RegexUtil#replace('Edited Export Template Name', '([a-zA-z0-9_.-]*)[(0-9KB)]*', '1')" name="larFile" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="SitePagesExport#CURRENT_AND_PREVIOUS_STATUS" value1="Successful" />

		<execute macro="Portal.LAR#downloadLar" />

		<execute function="Portal.Pause" locator1="5000" />

		<execute macro="Portal.LAR#importSiteCP">
			<var name="larFileName" value="${larFile}" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryCP">
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>
	</command>

	<command name="ExportImportDDLViaGlobal" priority="5">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Global" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Dynamic Data Lists" />
		</execute>

		<execute macro="Portal.DDLDataDefinition#addCP">
			<var name="ddlDataDefinitionDescription" value="DDL Definition Description" />
			<var name="ddlDataDefinitionName" value="DDL Definition" />
		</execute>

		<execute macro="Portal.DynamicDataMapping#addField">
			<var name="field" value="Text" />
			<var name="fieldFieldLabel" value="Text Label" />
			<var name="fieldName" value="TextName" />
		</execute>

		<execute macro="Portal.DDLDataDefinition#save" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Global" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Dynamic Data Lists" />
		</execute>

		<execute macro="Portal.DDLList#addCP">
			<var name="ddlListDescription" value="DDL List Description" />
			<var name="ddlListName" value="DDL List" />
		</execute>

		<execute macro="Portal.DDLDataDefinition#selectCP">
			<var name="ddlDataDefinitionName" value="DDL Definition" />
		</execute>

		<execute macro="Portal.DDLList#save" />

		<execute macro="Portal.DDLRecord#addCP">
			<var name="ddlDataDefinitionName" value="DDL Definition" />
			<var name="ddlListName" value="DDL List" />
		</execute>

		<execute macro="Portal.DDLRecord#populateFieldText">
			<var name="ddlRecordFieldData" value="DDL Definition Record" />
			<var name="field" value="Text" />
			<var name="fieldFieldLabel" value="Text Label" />
			<var name="fieldName" value="TextName" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Global" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Dynamic Data Lists" />
		</execute>

		<execute macro="Portal.LAR#exportPortlet">
			<var name="larFileName" value="DDL.portlet.lar" />
			<var name="siteScopeName" value="Global" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Dynamic Data Lists" />
		</execute>

		<execute macro="Portal.LAR#importPortlet">
			<var name="larFileName" value="DDL.portlet.lar" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Dynamic Data Lists" />
		</execute>

		<execute macro="Portal.DDLNavigator#gotoListRecords">
			<var name="ddlListName" value="DDL List" />
		</execute>

		<execute macro="Portal.DDLRecord#viewFirstFieldCP">
			<var name="ddlRecordFieldData" value="DDL Definition Record" />
			<var name="field" value="Text" />
			<var name="fieldFieldLabel" value="Text Label" />
		</execute>
	</command>

	<command name="ExportImportPortletWithADT" priority="3">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesConfiguration">
			<var name="portlet" value="Application Display Templates" />
		</execute>

		<execute macro="Portal.ApplicationDisplayTemplates#addCP">
			<var name="adtFile" value="adt_blogs_basic.ftl" />
			<var name="adtType" value="Blogs" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Page Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Page Name" />
		</execute>

		<execute macro="Portal.ApplicationDisplayTemplates#selectPortletADT">
			<var name="adtType" value="Blogs" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Page Name" />
		</execute>

		<var name="key_entryTitle" value="Blogs Entry Title" />

		<execute function="Portal.AssertElementNotPresent" locator1="Link#EDIT" value1="Edit" />
		<execute function="Portal.AssertElementNotPresent" locator1="Link#MOVE_TO_THE_RECYCLING_BIN" value1="Move to the Recycle Bin" />

		<execute macro="Portal.LAR#configureExportSiteCP" />

		<execute function="Portal.AssertClick" locator1="SitePagesExport#EXPORT_BUTTON" value1="Export" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="SitePagesExport#CURRENT_AND_PREVIOUS_STATUS" value1="Successful" />

		<var method="selenium#getText('//ul/li/div/h5')" name="valueName" />

		<echo message="value name ${valueName}" />

		<var method="RegexUtil#replace('${valueName}', '([a-zA-z0-9_.-]*)[(0-9KB)]*', '1')" name="larFileName" />

		<echo message="file name ${larFileName}" />

		<execute macro="Portal.LAR#downloadLar" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.LAR#importSiteCP">
			<var name="larFileName" value="${larFileName}" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<var name="key_entryTitle" value="Blogs Entry Title" />

		<execute function="Portal.AssertElementNotPresent" locator1="Link#EDIT" value1="Edit" />
		<execute function="Portal.AssertElementNotPresent" locator1="Link#MOVE_TO_THE_RECYCLING_BIN" value1="Move to the Recycle Bin" />
	</command>

	<command name="ExportImportPrivatePage" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Private Page" />
			<var name="sitePagePrivacy" value="Private" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Export" />
		</execute>

		<execute macro="Portal.LAR#exportSiteCP">
			<var name="larFileName" value="ExportPrivatePage" />
			<var name="privateLayout" value="true" />
		</execute>

		<var name="key_larFileName" value="${larFileName}" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="SitePagesExport#CURRENT_AND_PREVIOUS_STATUS" value1="Successful" />

		<var method="selenium#getText('//ul/li/div/h5')" name="valueName" />

		<echo message="value name ${valueName}" />

		<var method="RegexUtil#replace('${valueName}', '([a-zA-z0-9_.-]*)[(0-9k)]*', '1')" name="larFileName" />

		<echo message="lar file name ${larFileName}" />

		<execute macro="Portal.LAR#downloadLar" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.LAR#importSiteCP">
			<var name="larFileName" value="${larFileName}" />
			<var name="privateLayout" value="true" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Private Page" />
			<var name="sitePagePrivacy" value="true" />
		</execute>
	</command>

	<command name="ExportImportSampleLARPortlet" priority="5">
		<property name="portal.acceptance" value="quarantine" />
		<property name="portlet.plugins.includes" value="sample-lar-portlet" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Page Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Page Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Sample LAR" />
		</execute>

		<execute macro="Portal.SampleLARPortlet#addSampleBooking" />

		<var method="selenium#getText('//tbody[@class=\'table-data\']/tr/td[2]')" name="bookingNumber" />

		<echo message="Booking Number ${bookingNumber}" />

		<execute macro="Portal.SampleLARPortlet#viewSampleBookingNumber">
			<var name="${bookingNumber}" value="${bookingNumber}" />
			<var name="bookingNumber" value="${bookingNumber}" />
		</execute>

		<execute macro="Portal.LAR#exportPortlet">
			<var name="larFileName" value="SampleLARPortlet.lar" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Site Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Site Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Sample LAR" />
		</execute>

		<execute macro="Portal.LAR#importPortlet">
			<var name="larFileName" value="SampleLARPortlet.lar" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Site Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.SampleLARPortlet#viewSampleBookingNumber">
			<var name="${bookingNumber}" value="${bookingNumber}" />
			<var name="bookingNumber" value="${bookingNumber}" />
		</execute>
	</command>

	<command name="ExportImportSmoke" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.LAR#configureExportSiteCP" />

		<execute function="Portal.AssertClick" locator1="SitePagesExport#EXPORT_BUTTON" value1="Export" />

		<var name="key_larFileName" value="${larFileName}" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="SitePagesExport#CURRENT_AND_PREVIOUS_STATUS" value1="Successful" />

		<var method="selenium#getText('//ul/li/div/h5')" name="valueName" />

		<echo message="value name ${valueName}" />

		<var method="RegexUtil#replace('${valueName}', '([a-zA-z0-9_.-]*)[(0-9KB)]*', '1')" name="larFileName" />

		<echo message="lar file name ${larFileName}" />

		<execute macro="Portal.LAR#downloadLar" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.LAR#importSiteCP">
			<var name="larFileName" value="${larFileName}" />
			<var name="siteName" value="Site Name" />
		</execute>
	</command>

	<command name="ExportImportThemeSettings" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#changeCurrentTheme">
			<var name="page" value="Public Pages" />
			<var name="themeName" value="London" />
		</execute>

		<execute macro="Portal.LAR#configureExportSiteCP">
			<var name="uncheckLogo" value="true" />
			<var name="uncheckSitePagesSettings" value="true" />
			<var name="uncheckSiteTemplateSettings" value="true" />
		</execute>

		<execute function="Portal.AssertClick" locator1="SitePagesExport#EXPORT_BUTTON" value1="Export" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="SitePagesExport#CURRENT_AND_PREVIOUS_STATUS" value1="Successful" />

		<var method="selenium#getText('//ul/li/div/h5')" name="valueName" />

		<echo message="value name ${valueName}" />

		<var method="RegexUtil#replace('${valueName}', '([a-zA-z0-9_.-]*)[(0-9KB)]*', '1')" name="larFileName" />

		<echo message="file name ${larFileName}" />

		<execute macro="Portal.LAR#downloadLar" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name 2" />
		</execute>

		<execute macro="Portal.LAR#importSiteCP">
			<var name="larFileName" value="${larFileName}" />
			<var name="siteName" value="Site Name 2" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Test Page" />
			<var name="siteName" value="Site Name 2" />
		</execute>

		<execute macro="Portal.Page#viewCurrentTheme">
			<var name="page" value="Public Pages" />
			<var name="themeName" value="London" />
		</execute>
	</command>

	<command name="ExportImportValidation" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="test.name.skip.portal.instance" value="ExportImport#ExportImportValidation" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#addCP">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.jpg" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEditCP">
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute function="Portal.Click#pauseClickAt" locator1="AlloyEditor#CONTENT_FIELD" />

		<execute function="Portal.Click" locator1="AlloyEditor#CONTENT_ADD_BUTTON" />

		<execute function="Portal.Click" locator1="AlloyEditor#CONTENT_ADD_MENUBAR_IMAGE" />

		<execute macro="Portal.ItemSelector#selectDMImage">
			<var name="imageFileName" value="DM Document Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.LAR#configureExportSiteCP">
			<var name="checkContentNameList" value="Blogs" />
			<var name="mainContent" value="Blogs" />
			<var name="uncheckContentNameList" value="Documents and Media" />
			<var name="uncheckSubContent" value="Referenced Content" />
		</execute>

		<execute function="Portal.AssertClick" locator1="SitePagesExport#EXPORT_BUTTON" value1="Export" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="SitePagesExport#CURRENT_AND_PREVIOUS_STATUS" value1="Successful" />

		<var method="selenium#getText('//ul/li/div/h5')" name="valueName" />

		<echo message="value name ${valueName}" />

		<var method="RegexUtil#replace('${valueName}', '([a-zA-z0-9_.-]*)[(0-9KB)]*', '1')" name="larFileName" />

		<echo message="file name ${larFileName}" />

		<execute macro="Portal.LAR#downloadLar" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#deleteCP">
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.LAR#importSiteCP">
			<var name="importValidationMissingItem" value="DM Document Title" />
			<var name="larFileName" value="${larFileName}" />
			<var name="siteName" value="Site Name" />
		</execute>
	</command>

	<command name="ExportImportWithExportTemplate" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Export" />
		</execute>

		<execute macro="Portal.LAR#addExportTemplateCP">
			<var name="exportTemplateDescription" value="Export Template Description" />
			<var name="exportTemplateName" value="Export Template Name" />
		</execute>

		<execute macro="Portal.LAR#saveExportTemplateCP">
			<var name="exportTemplateDescription" value="Export Template Description" />
			<var name="exportTemplateName" value="Export Template Name" />
		</execute>

		<execute macro="Portal.LAR#viewExportTemplateCP">
			<var name="exportTemplateDescription" value="Export Template Description" />
			<var name="exportTemplateName" value="Export Template Name" />
		</execute>

		<execute macro="Portal.LAR#exportExportTemplateCP">
			<var name="exportTemplateDescription" value="Export Template Description" />
			<var name="exportTemplateName" value="Export Template Name" />
		</execute>

		<var method="selenium#getAttribute('//ul/li/div/h5//a@href')" name="valueName" />

		<echo message="value name ${valueName}" />

		<var method="RegexUtil#replace('${valueName}', 'http://localhost:8080/documents/portlet_file_entry/[0-9]*/([a-zA-z0-9_.-]*)[(0-9KB)]*', '1')" name="larFileName" />

		<echo message="file name ${larFileName}" />

		<execute macro="Portal.LAR#downloadLar" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.LAR#importSiteCP">
			<var name="larFileName" value="${larFileName}" />
			<var name="siteName" value="Site Name" />
		</execute>
	</command>

