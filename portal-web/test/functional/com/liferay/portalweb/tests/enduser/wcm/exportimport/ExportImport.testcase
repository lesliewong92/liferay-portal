	<command name="ImportCorruptedFile" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Bookmarks" />
		</execute>

		<execute function="Portal.AssertTextEquals" locator1="Portlet#HEADER" value1="Bookmarks" />

		<execute macro="Portal.LAR#importPortlet">
			<var name="cannotImport" value="true" />
			<var name="larFileName" value="bookmarks-corrupted.portlet.lar" />
			<var name="uploadFrom" value="dependencies" />
		</execute>
	</command>
</definition>