<definition component-name="portal-collaboration">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="custom.properties" value="default.layout.template.id=1_column" />
	<property name="testray.main.component.name" value="Message Boards" />

	<var name="pageName" value="Message Boards Page" />
	<var name="portletName" value="Message Boards" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.MessageboardsPortlet#tearDownConfigurationEmailCP" />

				<execute macro="Portal.MessageboardsCategory#tearDownCP" />

				<execute macro="Portal.MessageboardsThread#tearDownCP" />

				<execute macro="Portal.Site#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="CopyAndPasteTextInAlloyEditor" priority="4">
		<execute macro="Portal.Page#add">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoEditPage">
			<var name="page" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.Page#editPageLayoutColumn">
			<var name="columnName" value="1 Column" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute function="Portal.AssertClick" locator1="Button#POST_NEW_THREAD" value1="Post New Thread" />

		<execute function="Portal.AssertElementPresent" locator1="TextInput#SUBJECT" />

		<execute function="Portal.Type" locator1="TextInput#SUBJECT" value1="Message Boards Subject" />
		<execute function="Portal.Type#typeEditor" locator1="AlloyEditor#CONTENT_FIELD" value1="Message Boards Body" />

		<execute function="Portal.Copy" locator1="TextInput#SUBJECT" />

		<execute function="Portal.Paste" locator1="AlloyEditor#CONTENT_FIELD" />

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsThread#gotoPG">
			<var name="lastPostUserName" value="Test Test" />
			<var name="postCount" value="1" />
			<var name="threadBody" value="Message Boards Subject" />
			<var name="threadSubject" value="Message Boards Subject" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewPG">
			<var name="threadBody" value="Message Boards Subject" />
			<var name="threadSubject" value="Message Boards Subject" />
			<var name="userName" value="Test Test" />
		</execute>
	</command>

	<command name="DeleteMessageboardsThread" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addCP">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#moveToRecycleBinCP">
			<var name="assetName" value="MB Thread Message Subject" />
			<var name="assetType" value="Message Boards Thread" />
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#deleteCP">
			<var name="assetName" value="MB Thread Message Subject" />
			<var name="assetType" value="Message Boards Thread" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewDefaultCP">
			<var name="assetName" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewDefaultCP">
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>
	</command>

	<command ignore="true" name="ImportLAR" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.LAR#importPortlet">
			<var name="larFileName" value="space-message-boards.lar" />
			<var name="uploadFrom" value="dependencies" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#viewCP">
			<var name="categoryName" value="General Discussion" />
			<var name="subcategoriesNumber" value="0" />
			<var name="threadsNumber" value="1" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewReplyWithUpvote">
			<var name="postCount" value="5" />
			<var name="threadBody" value="Super embarrassing, but does anybody know what to do when the Anti-Gravity Chamber door gets stuck and maintenance has gone for the day? Yesterday was the second time I’ve been in there all night, and I have to say, not liking the ambience." />
			<var name="threadReplyBodyList" value="Couldn’t you just call somebody?,lol Jonny never has his cell,dude seriously creepy,As the Anti-Gravity Chamber handbook" />
			<var name="threadSubject" value="Stuck in the Anti-Gravity Chamber" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsCategory#viewCP">
			<var name="categoryName" value="Homework Discussion" />
			<var name="subcategoriesNumber" value="0" />
			<var name="threadsNumber" value="1" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewReplyWithUpvote">
			<var name="postCount" value="4" />
			<var name="threadBody" value="I’m writing a paper called Mars on a Budget, and I’d be curious to hear from other departments about their thoughts on reducing overall costs of missions and how that can happen at every level without compromising safety or efficiency. After the economic downturn of 2062, budgetary restrictions remain an important concern. Thanks!" />
			<var name="threadReplyBodyList" value="dr novola has some thoughts,one barrier is the inflated cost of materials combined with worker compensation,Are you factoring in environmental impact?" />
			<var name="threadSubject" value="Cost Reduction for Mars" />
		</execute>
	</command>

	<command name="RestoreMessageboardsThread" priority="5">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addCP">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#moveToRecycleBinCP">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#restoreCP">
			<var name="assetName" value="MB Thread Message Subject" />
			<var name="assetRestoreLocation" value="Home" />
			<var name="assetType" value="Message Boards Thread" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewDefaultCP">
			<var name="assetName" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Message Boards" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewCP">
			<var name="postsNumber" value="1" />
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>
	</command>

	<command name="SearchMessageBoardsAttachment" priority="3">
		<execute macro="Portal.Page#add">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoEditPage">
			<var name="page" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.Page#editPageLayoutColumn">
			<var name="columnName" value="1 Column" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addPGWithAttachment">
			<var name="mbThreadAttachment" value="Document_1.docx" />
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsPortlet#searchPG">
			<var name="searchTerm" value="This is a *.docx file." />
		</execute>

		<execute macro="Portal.MessageboardsPortlet#viewSearchResultPG">
			<var name="mbThreadAttachment" value="Document_1.docx" />
			<var name="searchTerm" value="This is a *.doc x file." />
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
			<var name="userName" value="Test Test" />
		</execute>
	</command>

	<command name="SplitMBThread" priority="3">
		<execute macro="Portal.Page#add">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoEditPage">
			<var name="page" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.Page#editPageLayoutColumn">
			<var name="columnName" value="1 Column" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsThread#addPG">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsThread#replyPG">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadReplyBody" value="MB Thread Reply Body" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsThread#gotoPG">
			<var name="lastPostUserName" value="Test Test" />
			<var name="postCount" value="2" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.MessageboardsThread#splitThreadPG">
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadReplyBody" value="MB Thread Reply Body" />
			<var name="threadSplitReplyBody" value="Split Reply Thread Body" />
			<var name="threadSplitReplySubject" value="Split Reply Thread Subject" />
			<var name="threadSplitSubject" value="MB Thread Split Subject" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Message Boards Page" />
		</execute>

		<execute macro="Portal.MessageboardsThread#viewSplitThreadPG">
			<var name="pageName" value="Message Boards Page" />
			<var name="threadBody" value="MB Thread Message Body" />
			<var name="threadReplyBody" value="MB Thread Reply Body" />
			<var name="threadSplitReplyBody" value="Split Reply Thread Body" />
			<var name="threadSplitReplySubject" value="Split Reply Thread Subject" />
			<var name="threadSplitSubject" value="MB Thread Split Subject" />
			<var name="threadSubject" value="MB Thread Message Subject" />
		</execute>
	</command>

