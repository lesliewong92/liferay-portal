<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.component.names" value="Site and Page Templates" />
	<property name="testray.main.component.name" value="Site and Page Templates" />

	<var name="siteTemplateName" value="Site Template Name" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Navigator#openURL" />

				<execute macro="Portal.User#logoutAndLoginPG">
					<var name="password" value="test" />
					<var name="userLoginEmailAddress" value="test@liferay.com" />
					<var name="userLoginFullName" value="Test Test" />
				</execute>

				<execute macro="Portal.User#tearDownCP" />

				<execute macro="Portal.UserGroup#tearDownCP" />

				<execute macro="Portal.Site#tearDownCP" />

				<execute macro="Portal.SiteTemplates#tearDownCP" />

				<execute macro="Portal.DMDocument#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AdminCanNotAddASubpageOfAChildPageLinkedToSiteTemplatePage" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateActive" value="Yes" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addSitePageViaSiteTemplateCP">
			<var name="pageName" value="Site Page Name" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addChildPageViaSiteTemplateCP">
			<var name="childSitepageName" value="true" />
			<var name="pageName" value="Site Page Name" />
			<var name="siteChildPageName" value="Site Child Page Name" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addSiteTemplateCP">
			<var name="siteName" value="Site Name" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#viewNoDeletePagesAssociatedWithSiteTemplate">
			<var name="page" value="Site Child Page Name" />
		</execute>
	</command>

	<command name="EditSiteTemplateGuestPermissions" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateName" value="${siteTemplateName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addSiteTemplateCP">
			<var name="siteName" value="Site Name" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoSiteTemplateCP">
			<var name="page" value="home" />
		</execute>

		<execute macro="Portal.Role#removePermissionPG">
			<var name="permissionDefinitionKey" value="CONTENT_PERMISSIONS_VIEW_CHECKBOX" />
			<var name="roleTitle" value="Guest" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="home" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoSiteTemplateCP">
			<var name="page" value="home" />
		</execute>

		<execute macro="Portal.Role#definePermissionPG">
			<var name="permissionDefinitionKey" value="CONTENT_PERMISSIONS_VIEW_CHECKBOX" />
			<var name="roleTitle" value="Guest" />
		</execute>
	</command>

	<command name="PortletPreferencesPersistWithSiteTemplateWhenSamePortletAddedOnSecondPage" priority="4">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.Page#addPageToSiteTemplates">
			<var name="pageName" value="Page1 Name" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplatesNavigator#gotoSiteTemplatesPage">
			<var name="pageName" value="Page1 Name" />
			<var name="siteName" value="${siteName}" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="defaultURL" value="false" />
			<var name="portletName" value="Hello World" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.Page#addPageToSiteTemplates">
			<var name="pageName" value="Page2 Name" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addSiteTemplateCP">
			<var name="siteName" value="Site Name" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page1 Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoConfigurationPG">
			<var name="portletName" value="Hello World" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.Role#removePermissionPG">
			<var name="permissionDefinitionKey" value="CONTENT_PERMISSIONS_VIEW_CHECKBOX" />
			<var name="roleTitle" value="Guest" />
		</execute>

		<execute function="Refresh" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#gotoViewPages">
			<var name="siteName" value="${siteName}" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute function="AssertClick" locator1="Home#PAGE_TEMPLATE_3" value1="Page2 Name" />

		<execute macro="Portal.Portlet#addPG">
			<var name="defaultURL" value="false" />
			<var name="portletName" value="Hello World" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page1 Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoConfigurationPG">
			<var name="portletName" value="Hello World" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.Role#viewPermissionPG">
			<var name="permissionDefinitionKey" value="CONTENT_PERMISSIONS_VIEW_CHECKBOX" />
			<var name="permissionFlagged" value="false" />
			<var name="roleTitle" value="Guest" />
		</execute>
	</command>

	<command name="SiteAdminCannotDeletePagesThatWereCreatedBySiteTemplates" priority="3">
		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="User Groups" />
		</execute>

		<execute macro="Portal.UserGroup#addCP">
			<var name="selectSiteTemplate" value="true" />
			<var name="siteTemplateName" value="Community Site" />
			<var name="userGroupName" value="UG UserGroup Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="User Groups" />
		</execute>

		<execute macro="Portal.UserGroup#gotoManagePages">
			<var name="userGroupName" value="UG UserGroup Name" />
		</execute>

		<for list="Home,Wiki" param="page">
			<execute macro="Portal.ProductMenu#gotoSiteViaLink">
				<var name="site" value="UG UserGroup Name" />
			</execute>

			<execute macro="Portal.Page#viewNoDeletePagesAssociatedWithSiteTemplate">
				<var name="page" value="${page}" />
			</execute>
		</for>
	</command>

	<command name="SitesDynamicTemplateInheritance" priority="4">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#gotoManageSitesTemplatesViaAddDropdown" />

		<execute macro="Portal.SiteTemplates#viewDefaultCP">
			<var name="siteTemplateNameList" value="Intranet Site,Community Site" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#gotoViewPages">
			<var name="siteName" value="${siteName}" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editUserSiteCP">
			<var name="siteName" value="${siteName}" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#assignRegularRoleCP">
			<var name="roleTitle" value="Administrator" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="User Groups" />
		</execute>

		<execute macro="Portal.UserGroup#addCP">
			<var name="selectSiteTemplate" value="true" />
			<var name="siteTemplateName" value="Site Template Name" />
			<var name="userGroupName" value="UG UserGroup Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="User Groups" />
		</execute>

		<execute macro="Portal.UserGroup#viewPG">
			<var name="pageName" value="home" />
			<var name="portletName" value="Message Boards" />
			<var name="siteName" value="${siteName}" />
			<var name="userGroupName" value="UG UserGroup Name" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>
	</command>

	<command name="SitesTemplateResourceInheritance" priority="3">
		<property name="portlet.plugins.includes" value="tasks-portlet" />

		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#gotoViewPages">
			<var name="siteName" value="${siteName}" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#gotoViewPages">
			<var name="siteName" value="${siteName}" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.png" />
			<var name="dmDocumentTitle" value="Document_1.png" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Tasks" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addPersonalSiteCP">
			<var name="siteTemplateName" value="Site Template Name" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.UserBar#gotoDashboard" />

		<execute macro="Portal.DMDocument#viewPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.png" />
			<var name="dmDocumentTitle" value="Document_1.png" />
		</execute>

		<execute macro="Portal.Tasks#addTask">
			<var name="dueDate" value="true" />
			<var name="taskAssignee" value="userfn userln" />
			<var name="taskDescription" value="Review Tests" />
			<var name="taskReporter" value="userfn userln" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>
	</command>

	<command name="ViewInlineGuestPermissionsInSiteTemplatesViaWCD" priority="3">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#addCP">
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#gotoViewPages">
			<var name="siteName" value="${siteName}" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="defaultURL" value="false" />
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Site Templates" />
		</execute>

		<execute macro="Portal.SiteTemplates#gotoViewPages">
			<var name="siteName" value="${siteName}" />
			<var name="siteTemplateName" value="Site Template Name" />
		</execute>

		<execute macro="Portal.PermissionsInline#gotoConfigurationPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.Role#viewPermissionPG">
			<var name="permissionDefinitionKey" value="CONTENT_PERMISSIONS_VIEW_CHECKBOX" />
			<var name="permissionFlagged" value="true" />
			<var name="roleTitle" value="Guest" />
		</execute>
	</command>

	<command name="ViewNoAddPageTabViaPageTemplatesCP" priority="3">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#gotoPageTemplateViaEdit">
			<var name="pageTemplateName" value="Wiki" />
		</execute>

		<execute function="SelectWindow" locator1="title=Wiki - ${siteName}" />

		<execute macro="Portal.Dockbar#viewAddTabsWithNoAddPagePermission" />
	</command>
</definition>