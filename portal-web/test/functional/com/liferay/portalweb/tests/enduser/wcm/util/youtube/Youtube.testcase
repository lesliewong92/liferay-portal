<definition component-name="portal-wcm">
	<property name="portal.release" value="false" />
	<property name="portal.upstream" value="true" />
	<property name="testray.component.names" value="YouTube" />
	<property name="testray.main.component.name" value="YouTube" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Page Name" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="AddYoutubeVideo" priority="4">
		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="YouTube" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Page Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="YouTube" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.YoutubePortlet#addVideoId">
			<var name="videoId" value="PiObSymqSdo" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Page Name" />
		</execute>

		<execute macro="Portal.YoutubePortlet#assertVideoTitle">
			<var name="videoTitle" value="The Gospel in 6 Minutes - John Piper" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="YouTube" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.YoutubePortlet#viewPortletConfiguration">
			<var name="videoId" value="PiObSymqSdo" />
		</execute>

		<execute macro="Portal.IFrame#closeFrame" />
	</command>

	<command name="YoutubePortletSmoke" priority="4">
		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="YouTube" />
		</execute>

		<execute macro="Portal.Portlet#viewPG">
			<var name="portletBody" value="Please configure this portlet to make it visible to all users." />
			<var name="portletName" value="YouTube" />
		</execute>
	</command>
</definition>