<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.component.names" value="Personalization and Customization,Site Pages Administration" />
	<property name="testray.main.component.name" value="Site Pages Administration" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#logoutAndLoginPG">
					<var name="password" value="test" />
					<var name="userLoginEmailAddress" value="test@liferay.com" />
					<var name="userLoginFullName" value="Test Test" />
				</execute>

				<execute macro="Portal.User#tearDownCP" />

				<execute macro="Portal.Site#tearDownCP" />

				<execute macro="Portal.Role#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddPortletAsUserWithCustomizePermission" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoEditPage">
			<var name="page" value="Site Page Name" />
		</execute>

		<execute macro="Portal.PageCustomizations#gotoCustomizationSettingsPG" />

		<execute macro="Portal.PageCustomizations#enableSectionCustomizablePG">
			<var name="columnId" value="1" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#add">
			<var name="roleTitle" value="Roles Regrole Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#definePermissionCmdCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_PAGES_SITE_PAGES_RESOURCE_PERMISSIONS_PAGE_CUSTOMIZE_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Customize" />
			<var name="roleTitle" value="Roles Regrole Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#assignRegularRoleCP">
			<var name="roleTitle" value="Roles Regrole Name" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="password" value="test" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Navigation Menu" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Navigation Menu" />
		</execute>
	</command>

	<command name="PortletConfigurationChangesWithinCustomizableColumnShouldNotAffectAllUsers" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoEditPage">
			<var name="page" value="Site Page Name" />
		</execute>

		<execute macro="Portal.PageCustomizations#gotoCustomizationSettingsPG" />

		<execute macro="Portal.PageCustomizations#enableSectionCustomizablePG">
			<var name="columnId" value="1" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.PageCustomizations#viewCustomizablePagePG" />

		<execute function="Portal.AssertClick" locator1="Home#PAGE_CUSTOMIZATION_VIEW_DEFAULT_PAGE" value1="View Page without my customizations" />

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Wiki" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Wiki" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editUserSiteCP">
			<var name="siteName" value="Site Name" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="Wiki" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.WikiPortlet#configureSharingAllowUsersToAddWikiToAnyWebsite">
			<var name="enabled" value="true" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="Wiki" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.WikiPortlet#viewConfigureSharingAllowUsersToAddWikiToAnyWebsite">
			<var name="enabled" value="false" />
		</execute>
	</command>

	<command name="SiteMembershouldAddAndRemovePortletFromHisCustomizableView" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoEditPage">
			<var name="page" value="Site Page Name" />
		</execute>

		<execute macro="Portal.PageCustomizations#gotoCustomizationSettingsPG" />

		<execute macro="Portal.PageCustomizations#enableSectionCustomizablePG">
			<var name="columnId" value="1" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editUserSiteCP">
			<var name="siteName" value="Site Name" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.PageCustomizations#gotoCustomizedPageInfo">
			<var name="viewDefaultPage" value="true" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute function="Portal.Refresh" />

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Language Selector" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute function="Portal.Refresh" />

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.Portlet#deletePG">
			<var name="portletName" value="Language Selector" />
		</execute>

		<execute macro="Portal.Portlet#viewNoSpecificPG">
			<var name="portletName" value="Language Selector" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Language Selector" />
		</execute>

		<execute function="Portal.Refresh" />

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Language Selector" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>
	</command>

	<command name="SiteMemberWithCustomizablePagePermissionsWillOnlySeePortletsInCustomizableView" priority="4">
		<property name="test.name.skip.portal.instance" value="PageCustomizations#SiteMemberWithCustomizablePagePermissionsWillOnlySeePortletsInCustomizableView" />

		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="Server Administration" />
		</execute>

		<execute macro="Portal.ServerAdministration#executeServerResourcesActions">
			<var name="actionsDescription" value="Clean up permissions" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.RoleNavigator#gotoRoleType" />

		<execute macro="Portal.Role#add">
			<var name="roleTitle" value="Roles Regrole Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#definePermissionCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_PAGES_SITE_PAGES_RESOURCE_PERMISSIONS_PAGE_CUSTOMIZE_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Customize" />
			<var name="roleTitle" value="Roles Regrole Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#assignRegularRoleCP">
			<var name="roleTitle" value="Roles Regrole Name" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.Site#assignUserSitesCP">
			<var name="siteName" value="${siteName}" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page Name" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
		</execute>

		<execute macro="Portal.PageCustomizations#enableSectionCustomizableCP">
			<var name="columnId" value="1" />
			<var name="pageName" value="Site Page Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Site Page Name" />
		</execute>

		<execute macro="Portal.PageCustomizations#gotoCustomizedPageInfo">
			<var name="viewDefaultPage" value="true" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute function="Portal.Refresh" />

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Language Selector" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Site Page Name" />
		</execute>

		<execute macro="Portal.PageCustomizations#gotoCustomizedPageInfo">
			<var name="viewDefaultPage" value="true" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Language Selector" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.PageCustomizations#gotoViewMyCustomizedPage" />

		<execute macro="Portal.PageCustomizations#gotoCustomizedPageInfo" />

		<execute macro="Portal.Portlet#viewNoSpecificPG">
			<var name="portletName" value="Language Selector" />
		</execute>

		<execute macro="Portal.Portlet#viewNoSpecificPG">
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#definePermissionCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_APPLICATIONS_MESSAGE_BOARDS_APPLICATION_PERMISSIONS_ADD_TO_PAGE_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Add to Page" />
			<var name="roleTitle" value="Roles Regrole Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#definePermissionCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_APPLICATIONS_LANGUAGE_APPLICATION_PERMISSIONS_ADD_TO_PAGE_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Add to Page" />
			<var name="roleTitle" value="Roles Regrole Name" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Site Page Name" />
		</execute>

		<execute macro="Portal.PageCustomizations#gotoCustomizedPageInfo">
			<var name="viewDefaultPage" value="true" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Language Selector" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Message Boards" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>
	</command>
</definition>