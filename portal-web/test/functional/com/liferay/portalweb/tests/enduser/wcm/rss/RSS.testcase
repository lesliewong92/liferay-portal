<definition component-name="portal-rss">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="RSS" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page Name" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Page#tearDownPG">
					<var name="site" value="Liferay" />
				</execute>

				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddFeedBetweenFeeds" priority="3">
		<property name="testray.component.names" value="RSS" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Technology" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="Technology.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="buttonRowIndexNumber" value="1" />
			<var name="feedRowIndexNumber" value="2" />
			<var name="feedTitle" value="Latimes > Technology News" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="rss2.0.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="buttonRowIndexNumber" value="1" />
			<var name="feedRowIndexNumber" value="3" />
			<var name="feedTitle" value="Reuters > Sports News" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="reuters_sports_news.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<for list="Technology,Reuters > Sports News,Latimes > Technology News" param="feedTitle" >
			<execute macro="Portal.RSS#viewDisplayFeedTitle">
				<var name="feedTitle" value="${feedTitle}" />
			</execute>
		</for>
	</command>

	<command name="AddFeedWithWrongUrl" priority="4">
		<property name="testray.component.names" value="RSS" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="General Announcement" />
			<var name="feedUrlLink" value="www.theverge.com/rss/index.xml" />
		</execute>

		<execute macro="Portal.RSS#viewWarningMessageDisplay">
			<var name="errorMessage" value="The following are invalid URLs: www.theverge.com/rss/index.xml." />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.RSS#viewDeleteFeed">
			<var name="feedTitle" value="General Announcement" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="General Announcement" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="theverge.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.RSS#viewDisplayFeedTitle">
			<var name="feedTitle" value="General Announcement" />
		</execute>
	</command>

	<command name="AddRSSFeed" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="RSS" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.RSS#viewPortletConfigurationInfo" />

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Latimes > Technology News" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="rss2.0.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.RSS#viewDisplayFeedTitle">
			<var name="feedTitle" value="Latimes > Technology News" />
		</execute>
	</command>

	<command name="AddWebContentFeed" priority="3">
		<property name="test.name.skip.portal.instance" value="RSS#AddWebContentFeed" />
		<property name="testray.component.names" value="Asset Publisher,RSS" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="Web Content Content" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddFeed" />

		<execute macro="Portal.WebContent#addFeed">
			<var name="description" value="WC Feed Description" />
			<var name="feedContent" value="Content(ddm-text-html)" />
			<var name="feedTitle" value="WC Feed Title" />
			<var name="feedType" value="RSS 2.0" />
			<var name="structureName" value="Basic Web Content" />
			<var name="targetFriendlyUrl" value="/web/guest/home" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditFeed">
			<var name="feedName" value="WC Feed Title" />
		</execute>

		<var attribute="value" locator="//input[contains(@id,'JournalPortlet_url') and contains(@value,'journal/rss')]" name="rssFeedUrl" />
		<var method="StringUtil#replace('${rssFeedUrl}', 'localhost', '127.0.0.1')" name="rssFeedUrl" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Web Content Feed Title" />
			<var name="feedUrlLink" value="${rssFeedUrl}" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.RSS#viewDisplayFeedTitle">
			<var name="feedTitle" value="Web Content Feed Title" />
		</execute>

		<execute macro="Portal.RSS#viewFeedContent">
			<var name="feedEntryContent" value="Web Content Content" />
			<var name="feedEntryTitle" value="Web Content Title" />
		</execute>
	</command>

	<command name="ChangeDefaultToNavigationDisplay" priority="3">
		<property name="testray.component.names" value="RSS" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Technology" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="Technology.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#configureFeedDisplayStyle">
			<var name="feedDisplayStyle" value="Navigation" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.RSS#viewNavigationDisplayFeedTitle">
			<var name="feedTitle" value="Technology" />
		</execute>
	</command>

	<command name="ChangeOrderOfRSSFeeds" priority="3">
		<property name="testray.component.names" value="RSS" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Technology" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="Technology.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="buttonRowIndexNumber" value="1" />
			<var name="feedRowIndexNumber" value="2" />
			<var name="feedTitle" value="NBA" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="nba.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#viewPG">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Technology" />
			<var name="rowIndexNumber" value="1" />
		</execute>

		<execute macro="Portal.RSS#viewPG">
			<var name="feedRowIndexNumber" value="1" />
			<var name="feedTitle" value="NBA" />
			<var name="rowIndexNumber" value="2" />
		</execute>

		<execute macro="Portal.RSS#changeFeedsOrder">
			<var name="fromRowNumber" value="1" />
			<var name="rowLocation" value="Title" />
			<var name="toRowNumber" value="2" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#viewPG">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="NBA" />
			<var name="rowIndexNumber" value="1" />
		</execute>

		<execute macro="Portal.RSS#viewPG">
			<var name="feedRowIndexNumber" value="1" />
			<var name="feedTitle" value="Technology" />
			<var name="rowIndexNumber" value="2" />
		</execute>
	</command>

	<command name="DeleteFeedFromRSS" priority="4">
		<property name="testray.component.names" value="RSS" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Welcome" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Latimes > Technology News" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="rss2.0.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Page Name" />
		</execute>

		<execute macro="Portal.RSS#viewDisplayFeedTitle">
			<var name="feedTitle" value="Latimes > Technology News" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#deleteFeed">
			<var name="buttonRowIndexNumber" value="1" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Page Name" />
		</execute>

		<execute macro="Portal.RSS#viewDeleteFeed">
			<var name="feedTitle" value="Latimes > Technology News" />
		</execute>
	</command>

	<command name="DisabledFeedTitle" priority="3">
		<property name="testray.component.names" value="RSS" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Technology" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="Technology.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.RSS#viewDisplayFeedTitle">
			<var name="feedTitle" value="Technology" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#disableShowFeedTitle" />

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.RSS#viewNoFeedTitle">
			<var name="feedTitle" value="Technology" />
		</execute>
	</command>

	<command name="EnableRSSFeedFromAssetpublisher" priority="3">
		<property name="test.name.skip.portal.instance" value="RSS#EnableRSSFeedFromAssetpublisher" />
		<property name="testray.component.names" value="Asset Publisher,RSS" />

		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page Name 2" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name 2" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaAP">
			<var name="webContentContent" value="This is the web content test for rss feed" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="Asset Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#enableRSSSubscription" />

		<execute macro="Portal.Button#clickSave" />

		<execute macro="Portal.IFrame#selectTopFrame" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name 2" />
			<var name="siteName" value="Site Name" />
		</execute>

		<var attribute="href" locator="//div[@class='subscribe-action']/span/a[contains(@href,'asset_publisher')]" name="rssFeedUrl" />
		<var method="StringUtil#replace('${rssFeedUrl}', 'localhost', '127.0.0.1')" name="rssFeedUrl" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Web Asset Publisher" />
			<var name="feedUrlLink" value="${rssFeedUrl}" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.RSS#viewDisplayFeedTitle">
			<var name="feedTitle" value="Web Asset Publisher" />
		</execute>

		<execute macro="Portal.RSS#openFeed">
			<var name="feedTitle" value="Asset Publisher" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewAssetPG">
			<var name="assetContent" value="This is the web content test for rss feed" />
			<var name="assetTitle" value="Web Content Title" />
		</execute>
	</command>

	<command name="RemoveRSSPortlet" priority="4">
		<property name="testray.component.names" value="RSS" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Welcome" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.RSS#viewPortletConfigurationInfo" />

		<execute macro="Portal.Portlet#deletePG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Page Name" />
		</execute>

		<execute macro="Portal.Portlet#viewNoSpecificPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>
	</command>

	<command name="UpdateRSSFeedViaAssetpublisher" priority="4">
		<property name="test.name.skip.portal.instance" value="RSS#UpdateRSSFeedViaAssetpublisher" />
		<property name="testray.component.names" value="Asset Publisher,RSS" />

		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="System Settings" />
		</execute>

		<execute macro="Portal.SystemSettings#gotoCategory">
			<var name="category" value="Web Experience" />
		</execute>

		<execute macro="Portal.SystemSettings#editConfiguration">
			<var name="configurationName" value="RSS Cache" />
		</execute>

		<execute macro="Portal.RSS#updateFeedTime">
			<var name="feedTime" value="1" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Asset Publisher Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaAP">
			<var name="webContentContent" value="This is the web content test for rss feed" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="Asset Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#enableRSSSubscription" />

		<execute macro="Portal.Button#clickSave" />

		<execute macro="Portal.IFrame#selectTopFrame" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Asset Publisher Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<var attribute="href" locator="//div[@class='subscribe-action']/span/a[contains(@href,'asset_publisher')]" name="rssFeedUrl" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Web Asset Publisher" />
			<var name="feedUrlLink" value="${rssFeedUrl}" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.RSS#viewDisplayFeedTitle">
			<var name="feedTitle" value="Web Asset Publisher" />
		</execute>

		<execute macro="Portal.RSS#viewUpdateFeedTitle">
			<var name="feedHeading" value="Web Content Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Asset Publisher Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#gotoEditAssetPG">
			<var name="assetTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="This is the updated version of web content test for rss feed" />
			<var name="webContentTitle" value="Web Content Title Updated Feed" />
		</execute>

		<execute macro="Portal.Button#clickPublish" />

		<execute macro="Portal.RSS#viewUpdateFeedTitle">
			<var name="feedHeading" value="Web Content Title Updated Feed" />
			<var name="pageName" value="Site Page Name" />
			<var name="updateFeed" value="true" />
		</execute>

		<execute macro="Portal.RSS#viewDisplayFeedTitle">
			<var name="feedTitle" value="Web Asset Publisher" />
		</execute>
	</command>
</definition>