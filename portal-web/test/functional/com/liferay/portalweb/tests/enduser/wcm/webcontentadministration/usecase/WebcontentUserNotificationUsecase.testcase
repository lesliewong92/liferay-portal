<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Web Content Administration" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="password" value="password" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#assignRegularRoleCP">
			<var name="roleTitle" value="Administrator" />
			<var name="userScreenName" value="usersn" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#firstLoginPG" />

				<execute macro="Portal.WebContent#tearDownCP" />

				<execute macro="Portal.WebContentTemplates#tearDownCP" />

				<execute macro="Portal.WebContentStructures#tearDownCP" />

				<execute macro="Portal.WebContentStructures#tearDownCP">
					<var name="siteScopeName" value="${globalSiteName}" />
				</execute>

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="ViewArticleEmailNotification" priority="4">
		<property name="test.smtp.server.enabled" value="true" />
		<property name="testray.component.names" value="Web Content Administration" />

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#subscribeToCurrentFolderCP" />

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.MockMock#viewMail">
			<var name="asset" value="Web Content" />
			<var name="content" value="WC WebContent Content" />
			<var name="recipient" value="userfn userln" />
			<var name="sender" value="Joe Bloggs" />
			<var name="subject" value="WC WebContent Title" />
		</execute>
	</command>

	<command name="ViewEditArticleEmailNotification" priority="4">
		<property name="test.smtp.server.enabled" value="true" />
		<property name="testray.component.names" value="Web Content Administration" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#subscribeToSpecificArticle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditCP">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#editCP">
			<var name="webContentTitle" value="WC WebContent Title" />
			<var name="webContentTitleEdit" value="WC WebContent Title Edit" />
		</execute>

		<execute macro="Portal.MockMock#viewMail">
			<var name="asset" value="Web Content" />
			<var name="content" value="WC WebContent Content" />
			<var name="recipient" value="userfn userln" />
			<var name="sender" value="Joe Bloggs" />
			<var name="subject" value="WC WebContent Title Edit" />
		</execute>
	</command>

	<command name="ViewMoveArticleEmailNotification" priority="4">
		<property name="test.smtp.server.enabled" value="true" />
		<property name="testray.component.names" value="Web Content Administration" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#subscribeToSpecificArticle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentFolder#addCP">
			<var name="folderDescription" value="WC Folder Description" />
			<var name="folderName" value="WC Folder Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#moveToFolderCP">
			<var name="folderName" value="WC Folder Name" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.MockMock#viewMail">
			<var name="asset" value="Web Content" />
			<var name="content" value="WC WebContent Content" />
			<var name="recipient" value="userfn userln" />
			<var name="sender" value="Joe Bloggs" />
			<var name="subject" value="WC WebContent Title was moved" />
		</execute>
	</command>
</definition>