<definition component-name="portal-workflow">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Workflow" />

	<var name="workflowAssetType" value="Web Content Article" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.WebContent#tearDownCP" />

				<execute macro="Portal.Workflow#tearDownPortalWorkflow" />

				<execute macro="Portal.Workflow#tearDownSiteWorkflow" />
			</else>
		</if>
	</tear-down>

	<command name="ConfigureFolderWorkflow" priority="4">
		<execute macro="Portal.Workflow#configureWorkflowViaFolderInfo">
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
		</execute>

		<execute macro="Portal.WebContentFolder#addCP">
			<var name="folderDescription" value="WC Folder Description" />
			<var name="folderName" value="WC Folder Name" />
		</execute>

		<execute macro="Portal.WebContentFolder#configureWorkflowCP">
			<var name="folderName" value="WC Folder Name" />
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
			<var name="workflowRestriction" value="Default Workflow" />
		</execute>

		<execute macro="Portal.WebContentFolder#configureWorkflowCP">
			<var name="folderName" value="WC Folder Name" />
			<var name="workflowRestriction" value="Parent Folder" />
		</execute>

		<execute macro="Portal.WebContentFolder#configureWorkflowCP">
			<var name="folderName" value="WC Folder Name" />
			<var name="structureName" value="Basic Web Content" />
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
			<var name="workflowRestriction" value="Specific Restrictions" />
		</execute>

		<execute macro="Portal.WebContentFolder#configureWorkflowCP">
			<var name="folderName" value="WC Folder Name" />
			<var name="workflowDefinition" value="No Workflow" />
			<var name="workflowRestriction" value="Default Workflow" />
		</execute>
	</command>

	<command name="EditWebContentInReviewProcess" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.WebContentNavigator#gotoManageStructures" />

		<execute macro="Portal.WebContentStructures#addCP">
			<var name="structureDescription" value="WC Structure Description" />
			<var name="structureName" value="WC Structure Name" />
		</execute>

		<execute macro="Portal.DynamicDataMapping#addField">
			<var name="field" value="Image" />
			<var name="fieldFieldLabel" value="Image" />
			<var name="fieldName" value="Image" />
		</execute>

		<execute macro="Portal.WebContentStructures#saveCP">
			<var name="structureName" value="WC Structure Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoManageTemplates" />

		<execute macro="Portal.WebContentTemplates#addCP">
			<var name="templateDescription" value="WC Template Description" />
			<var name="templateName" value="WC Template Name" />
		</execute>

		<execute macro="Portal.WebContentTemplates#addStructure">
			<var name="structureName" value="WC Structure Name" />
			<var name="templateFieldNames" value="Image" />
			<var name="templateLanguage" value="ftl" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.Workflow#configureWorkflowViaFolderInfo">
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddWithStructureCP">
			<var name="structureName" value="WC Structure Name" />
		</execute>

		<execute macro="Portal.WebContent#addWithStructureAndWorkflowCP">
			<var name="structureName" value="WC Structure Name" />
			<var name="templateName" value="WC Template Name" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewStructureWithWorkflowCP">
			<var name="webContentTitle" value="WC WebContent Title" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByActions">
			<var name="workflowAssetTitle" value="WC WebContent Title" />
			<var name="workflowAssetType" value="Web Content Article" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#gotoTaskDetails">
			<var name="workflowAssetTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Workflow#gotoPreviewEdit" />

		<execute macro="Portal.WebContent#editInReview">
			<var name="webContentImage" value="Document_2.jpeg" />
			<var name="webContentTitleEdit" value="WC WebContent Title Edit" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#approveTaskByActions">
			<var name="workflowAssetTitle" value="WC WebContent Title Edit" />
			<var name="workflowAssetType" value="Web Content Article" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#viewApprovedStatus">
			<var name="webContentTitle" value="WC WebContent Title Edit" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditCP">
			<var name="webContentTitle" value="WC WebContent Title Edit" />
		</execute>

		<execute macro="Portal.WebContent#viewCPWithoutContentField">
			<var name="field" value="Image" />
			<var name="webContentImage" value="Document_2.jpeg" />
			<var name="webContentTitle" value="WC WebContent Title Edit" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#selectWebContent">
			<var name="webContentTitle" value="WC WebContent Title Edit" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Test Page" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#viewImageFieldViaWCD" />
	</command>
</definition>