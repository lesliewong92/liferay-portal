<definition component-name="portal-web-forms-and-data-lists">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Dynamic Data Lists" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoManageStructures" />

		<execute macro="Portal.WebContentStructures#addCP">
			<var name="structureDescription" value="WC Structure Description" />
			<var name="structureName" value="WC Structure Name" />
		</execute>

		<execute macro="Portal.DynamicDataMapping#addField">
			<var name="field" value="Image" />
			<var name="fieldFieldLabel" value="Image" />
			<var name="fieldName" value="image" />
		</execute>

		<execute macro="Portal.WebContentStructures#saveCP">
			<var name="structureName" value="WC Structure Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoManageTemplates" />

		<execute macro="Portal.WebContentTemplates#addCP">
			<var name="templateDescription" value="WC Template Description" />
			<var name="templateLanguage" value="ftl" />
			<var name="templateName" value="WC Template Name" />
		</execute>

		<execute macro="Portal.WebContentTemplates#addStructure">
			<var name="structureName" value="WC Structure Name" />
			<var name="templateFieldNames" value="Image" />
			<var name="templateLanguage" value="ftl" />
		</execute>

		<execute macro="Portal.WebContentTemplates#save" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#logoutAndLoginPG">
					<var name="userLoginEmailAddress" value="test@liferay.com" />
					<var name="userLoginFullName" value="Test Test" />
				</execute>

				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="ViewFieldTranslations" priority="4">
		<description message="This is a use case for LPS-69593." />

		<property name="test.name.skip.portal.instance" value="DDMStructureWithImageField#ViewFieldTranslations" />

		<execute macro="Portal.WebContentNavigator#gotoAddWithStructureCP">
			<var name="structureName" value="WC Structure Name" />
		</execute>

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentTitle" value="English (United States) Title" />
		</execute>

		<execute macro="Portal.ItemSelector#gotoItemSelectorViaSelectButton" />

		<execute macro="Portal.ItemSelector#uploadFile">
			<var name="navTab" value="Documents and Media" />
			<var name="uploadFileName" value="Document_3.png" />
		</execute>

		<execute macro="Portal.FormFields#editTextAlt">
			<var name="fieldName" value="image" />
			<var name="fieldValue" value="English (United States) Image Description" />
		</execute>

		<execute macro="Portal.WebContent#addLocale">
			<var name="language" value="Spanish (Spain)" />
			<var name="locale" value="es-ES" />
		</execute>

		<execute macro="Portal.FormFields#editText">
			<var name="fieldName" value="title" />
			<var name="fieldValue" value="Spanish (Spain) Title" />
		</execute>

		<execute macro="Portal.FormFields#editTextAlt">
			<var name="fieldName" value="image" />
			<var name="fieldValue" value="Spanish (Spain) Image Description" />
		</execute>

		<execute macro="Portal.WebContent#addLocale">
			<var name="language" value="Portuguese (Brazil)" />
			<var name="locale" value="pt-BR" />
		</execute>

		<execute macro="Portal.FormFields#editText">
			<var name="fieldName" value="title" />
			<var name="fieldValue" value="Portuguese (Brazil) Title" />
		</execute>

		<execute macro="Portal.FormFields#editTextAlt">
			<var name="fieldName" value="image" />
			<var name="fieldValue" value="Portuguese (Brazil) Image Description" />
		</execute>

		<execute macro="Portal.WebContent#selectLocale">
			<var name="locale" value="en-US" />
		</execute>

		<execute macro="Portal.FormFields#viewTextValue">
			<var name="fieldName" value="title" />
			<var name="fieldValue" value="English (United States) Title" />
		</execute>

		<execute macro="Portal.FormFields#viewTextValueAlt">
			<var name="fieldName" value="image" />
			<var name="fieldValue" value="English (United States) Image Description" />
		</execute>

		<execute macro="Portal.WebContent#selectLocale">
			<var name="locale" value="es-ES" />
		</execute>

		<execute macro="Portal.FormFields#viewTextValue">
			<var name="fieldName" value="title" />
			<var name="fieldValue" value="Spanish (Spain) Title" />
		</execute>

		<execute macro="Portal.FormFields#viewTextValueAlt">
			<var name="fieldName" value="image" />
			<var name="fieldValue" value="Spanish (Spain) Image Description" />
		</execute>

		<execute macro="Portal.WebContent#selectLocale">
			<var name="locale" value="pt-BR" />
		</execute>

		<execute macro="Portal.FormFields#viewTextValue">
			<var name="fieldName" value="title" />
			<var name="fieldValue" value="Portuguese (Brazil) Title" />
		</execute>

		<execute macro="Portal.FormFields#viewTextValueAlt">
			<var name="fieldName" value="image" />
			<var name="fieldValue" value="Portuguese (Brazil) Image Description" />
		</execute>
	</command>
</definition>