<definition component-name="portal-staging">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Staging" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#logoutAndLoginPG">
					<var name="userLoginEmailAddress" value="test@liferay.com" />
					<var name="userLoginFullName" value="Test Test" />
				</execute>

				<execute macro="Portal.Organization#tearDownCP" />

				<execute macro="Portal.User#deactivateCP">
					<var name="userFirstName" value="userfn" />
				</execute>

				<execute macro="Portal.User#deleteCP" />
			</else>
		</if>
	</tear-down>

	<command name="StagingOrganizations" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.Organization#addCP">
			<var name="orgName" value="Organization Name" />
			<var name="orgType" value="Organization" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.UsersAndOrganizationsNavigator#gotoOrganizations" />

		<execute macro="Portal.Organization#addSiteCP">
			<var name="organizationSite" value="Community Site" />
			<var name="orgName" value="Organization Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="allowManualMembershipManagement" value="true" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#assignRegularRoleCP">
			<var name="roleTitle" value="Administrator" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.UsersAndOrganizationsNavigator#gotoOrganizations" />

		<execute macro="Portal.Organization#addMemberCP">
			<var name="orgName" value="Organization Name" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userName" value="userfn userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Organization Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="pageVersioningEnabled" value="true" />
			<var name="siteName" value="Organization Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Home" />
			<var name="siteName" value="Organization Name" />
		</execute>

		<execute macro="Portal.Staging#addSitePagesVariationPG">
			<var name="copySitePagesVariationName" value="All Site Pages Variations" />
			<var name="sitePagesVariationName" value="Site Pages Variation Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Home" />
			<var name="siteName" value="Organization Name" />
		</execute>

		<execute macro="Portal.Staging#viewSitePagesVariationPG">
			<var name="sitePagesVariationName" value="Site Pages Variation Name" />
		</execute>

		<execute macro="Portal.Staging#addPageVariationPG">
			<var name="pageVariationName" value="Page Variation Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Home" />
			<var name="siteName" value="Organization Name" />
		</execute>

		<execute macro="Portal.Staging#viewPageVariationPG">
			<var name="pageVariationName" value="Page Variation Name" />
		</execute>
	</command>
</definition>