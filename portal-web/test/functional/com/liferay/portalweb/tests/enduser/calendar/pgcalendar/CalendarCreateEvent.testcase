<definition component-name="portal-calendar">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="custom.properties" value="default.layout.template.id=1_column${line.separator}company.default.time.zone=America/Los_Angeles" />
	<property name="testray.main.component.name" value="Calendar" />

	<var name="pageName" value="Calendar Page" />
	<var name="portletName" value="Calendar" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="pageName" value="Calendar Page" />
			<var name="portletName" value="Calendar" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Navigator#gotoPage">
					<var name="pageName" value="Calendar Page" />
				</execute>

				<if>
					<condition function="IsElementPresent" locator1="Calendar#SCHEDULER_EVENT_GENERIC" />
					<then>
						<execute macro="Portal.CalendarEvent#tearDown" />
					</then>
				</if>

				<execute macro="Portal.Calendar#tearDown" />

				<execute macro="Portal.Calendar#tearDownColor" />

				<execute macro="Portal.CalendarResource#tearDown" />

				<execute macro="Portal.CalendarConfiguration#tearDown" />

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.User#tearDownCP" />

				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddAfterClosingModal" priority="3">
		<description message="This is a use case for LPS-64945." />

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#editTitle">
			<var name="eventTitle" value="Calendar Event Title" />
		</execute>

		<execute macro="Portal.CalendarNavigator#closeModal">
			<var name="modalTitle" value="New Event" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#editTitle">
			<var name="eventTitle" value="Calendar Event Title" />
		</execute>

		<execute macro="Portal.CalendarEvent#publish" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarEvent#view">
			<var name="eventTitle" value="Calendar Event Title" />
		</execute>
	</command>

	<command name="AddAllDay" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#add">
			<var name="eventTitle" value="Calendar Event All Day Title" />
			<var name="eventType" value="All Day" />
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewAllDay">
			<var name="eventTitle" value="Calendar Event All Day Title" />
		</execute>
	</command>

	<command name="AddAllDayRSVPYes" priority="3">
		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#add">
			<var name="eventTitle" value="Calendar Event All Day Title" />
			<var name="eventType" value="All Day" />
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewApprovedRSVP">
			<var name="eventTitle" value="Calendar Event All Day Title" />
			<var name="rsvp" value="Yes" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewAllDay">
			<var name="eventTitle" value="Calendar Event All Day Title" />
		</execute>
	</command>

	<command name="AddAllDayWithRemindersEnabled" priority="3">
		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#add">
			<var name="duration1" value="Minutes" />
			<var name="duration2" value="Minutes" />
			<var name="eventTitle" value="Calendar Event All Day Title" />
			<var name="eventType" value="All Day" />
			<var name="number1" value="5" />
			<var name="number2" value="10" />
			<var name="pageName" value="Calendar Page" />
			<var name="reminders" value="true" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewAllDay">
			<var name="eventTitle" value="Calendar Event All Day Title" />
		</execute>
	</command>

	<command name="AddAllDayWithTag" priority="3">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#add">
			<var name="eventTitle" value="Calendar Event All Day Title" />
			<var name="eventType" value="All Day" />
			<var name="optionSet" value="true" />
			<var name="optionSetValue" value="tag" />
			<var name="pageName" value="Calendar Page" />
			<var name="specificOptionSetValue" value="tag1" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewDetails">
			<var name="calendarName" value="${siteName}" />
			<var name="eventTitle" value="Calendar Event All Day Title" />
			<var name="eventType" value="All Day" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewDetailsTags">
			<var name="tagText" value="tag1" />
		</execute>
	</command>

	<command name="AddAllDayWithUserInviteAccept" priority="3">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesMembers">
			<var name="portlet" value="Site Memberships" />
		</execute>

		<execute macro="Portal.Site#assignUserAsMemberCP">
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.Calendar#add">
			<var name="calendarName" value="userfn userln" />
			<var name="calendarType" value="Other Calendars" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#add">
			<var name="eventTitle" value="Calendar Event All Day Title" />
			<var name="eventType" value="All Day" />
			<var name="optionSet" value="true" />
			<var name="optionSetValue" value="inviteResource" />
			<var name="pageName" value="Calendar Page" />
			<var name="specificOptionSetValue" value="userfn userln" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarEvent#addRSVP">
			<var name="eventTitle" value="Calendar Event All Day Title" />
			<var name="rsvp" value="Yes" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewAllDay">
			<var name="eventTitle" value="Calendar Event All Day Title" />
		</execute>
	</command>

	<command name="AddAsPowerUserWhenSiteMemberNoViewPermissions" priority="4">
		<description message="This is a use case for LPS-55163." />

		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesMembers">
			<var name="portlet" value="Site Memberships" />
		</execute>

		<execute macro="Portal.Site#assignUserAsMemberCP">
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.Calendar#removeViewPermissions">
			<var name="calendarName" value="${siteName}" />
			<var name="calendarType" value="Current Site Calendars" />
			<var name="roleTitle" value="Site Member" />
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#editTitle">
			<var name="eventTitle" value="Calendar Event" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewAvailableCalendars">
			<var name="availableCalendarList" value="userfn userln" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewUnavailableCalendarsNotPresent">
			<var name="unavailableCalendarList" value="Test Test,Liferay" />
		</execute>

		<execute macro="Portal.CalendarEvent#publish" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarEvent#view">
			<var name="eventTitle" value="Calendar Event" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>
	</command>

	<command name="AddEventWithLargeDateRange" priority="5">
		<description message="This is a use case for LPS-61427." />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#editTitle">
			<var name="eventTitle" value="Calendar Event Title" />
		</execute>

		<execute macro="Portal.CalendarEvent#setEndDate">
			<var name="endDate" value="01/01/200000" />
		</execute>

		<execute macro="Portal.CalendarEvent#publish" />

		<var name="refreshCount" value="0" />

		<while>
			<not>
				<equals arg1="${refreshCount}" arg2="5" />
			</not>
			<then>
				<execute macro="Portal.Navigator#gotoPage">
					<var name="pageName" value="Calendar Page" />
				</execute>

				<execute macro="Portal.CalendarEvent#view">
					<var name="eventTitle" value="Calendar Event Title" />
				</execute>

				<execute function="Pause" locator1="1000" />

				<execute function="AssertConsoleTextNotPresent" value1="OutOfMemoryError" />

				<var method="MathUtil#sum('${refreshCount}', '1')" name="refreshCount" />
			</then>
		</while>
	</command>

