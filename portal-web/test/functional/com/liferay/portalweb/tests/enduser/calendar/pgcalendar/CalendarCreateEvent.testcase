		</execute>

		<execute macro="Portal.CalendarEvent#viewRSVPAccepted">
			<var name="resourceName" value="userfn3 userln3" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewRSVPDeclined">
			<var name="resourceName" value="userfn2 userln2" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewRSVPMaybe">
			<var name="resourceName" value="userfn1 userln1" />
		</execute>
	</command>
</definition>