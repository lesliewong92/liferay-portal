<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.component.names" value="Site and Page Templates" />
	<property name="testray.main.component.name" value="Site and Page Templates" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Site#tearDownCP" />
				<execute macro="Portal.PageTemplate#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddPageTemplate" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#addCP">
			<var name="pageTemplateActive" value="Yes" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>
	</command>

	<command name="AddSitePageTemplate" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#addCP">
			<var name="pageTemplateActive" value="Yes" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page" />
			<var name="pageTemplateName" value="Page Template Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#viewPageTemplate" >
			<var name="page" value="Site Page" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#gotoPageTemplateViaEdit">
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute function="Portal.SelectWindow" locator1="title=Page Template Name - ${siteName}" />

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute function="Portal.Close#closeWindow" locator1="title=Page Template Name - ${siteName}" />

		<execute function="Portal.SelectWindow" locator1="title=Page Templates - Control Panel - ${siteName}" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#viewPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoEditPage">
			<var name="page" value="Site Page" />
		</execute>

		<execute macro="Portal.Page#togglePageTemplateInheritChanges">
			<var name="toggleValue" value="disable" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#gotoPageTemplateViaEdit">
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute function="Portal.SelectWindow" locator1="title=Page Template Name - ${siteName}" />

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute function="Portal.Close#closeWindow" locator1="title=Page Template Name - ${siteName}" />

		<execute function="Portal.SelectWindow" locator1="title=Page Templates - Control Panel - ${siteName}" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#viewNoSpecificPG">
			<var name="portletName" value="Web Content Display" />
		</execute>
	</command>

	<command name="DeactivateAndActivatePageTemplate" priority="4">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#addCP">
			<var name="pageTemplateActive" value="Yes" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#deactivateAndActivate">
			<var name="pageTemplateName" value="Page Template Name" />
			<var name="pageTemplateStatus" value="No" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#viewStatus">
			<var name="pageTemplateName" value="Page Template Name" />
			<var name="pageTemplateStatus" value="No" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoAddPage" />

		<execute macro="Portal.Page#viewPageTemplateTypeNotPresent">
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#deactivateAndActivate">
			<var name="pageTemplateName" value="Page Template Name" />
			<var name="pageTemplateStatus" value="Yes" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#viewStatus">
			<var name="pageTemplateName" value="Page Template Name" />
			<var name="pageTemplateStatus" value="Yes" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoAddPage" />

		<execute macro="Portal.Page#viewPageTemplateTypePresent">
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>
	</command>

	<command name="DeletePageTemplate" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#addCP">
			<var name="pageTemplateActive" value="Yes" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#deleteCP">
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#viewDefaultCP">
			<var name="pageTemplateNameList" value="Blog,Content Display Page,Wiki" />
		</execute>
	</command>

	<command name="EditPageTemplate" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#addCP">
			<var name="pageTemplateActive" value="Yes" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.PageTemplate#editCP">
			<var name="pageTemplateActive" value="No" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>
	</command>

	<command name="EditPageTemplateDescription" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#addCP">
			<var name="pageTemplateActive" value="Yes" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#editDescription">
			<var name="pageTemplateDescription" value="This is a page template description" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#viewDescription">
			<var name="pageTemplateDescription" value="This is a page template description edit" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>
	</command>

	<command ignore="true" name="ImportLAR" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.LAR#importPortlet">
			<var name="larFileName" value="college-and-department-page-templates.lar" />
			<var name="uploadFrom" value="dependencies" />
		</execute>

		<execute macro="Portal.PageTemplate#viewCP">
			<var name="pageTemplateName" value="College Landing Page" />
		</execute>

		<execute macro="Portal.PageTemplate#viewCP">
			<var name="pageTemplateName" value="Department Landing Page" />
		</execute>

		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.PageTemplate#viewPG">
			<var name="pageTemplateName" value="College Landing Page" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Media Gallery" />
		</execute>

		<execute macro="Portal.Portlet#viewDuplicatePG">
			<var name="portletName" value="Web Content Display" />
			<var name="totalPortletCount" value="3" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute function="Portal.Close#closeWindow" locator1="title=College Landing Page - ${siteName}" />

		<execute function="Portal.SelectWindow" locator1="title=Page Templates - Control Panel - ${siteName}" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#viewPG">
			<var name="pageTemplateName" value="Department Landing Page" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Media Gallery" />
		</execute>

		<execute macro="Portal.Portlet#viewDuplicatePG">
			<var name="portletName" value="Web Content Display" />
			<var name="totalPortletCount" value="2" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Members" />
		</execute>

		<execute macro="Portal.Portlet#viewSpecificPG">
			<var name="portletName" value="Navigation Menu" />
		</execute>
	</command>

	<command name="LocalizeDefaultPageTemplates" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#viewDefaultCP">
			<var name="pageTemplateNameList" value="Blog,Content Display Page,Wiki" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoUserMyAccount">
			<var name="portlet" value="Account Settings" />
		</execute>

		<execute macro="Portal.MyAccount#changeUserLanguage">
			<var name="languageName" value="español (España)" />
			<var name="saveButton" value="Save" />
			<var name="successMessage" value="Su petición ha terminado con éxito." />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoLocalizedControlPanel">
			<var name="category" value="Sitios web" />
			<var name="portlet" value="Plantillas de página" />
			<var name="tab" value="Panel de control" />
		</execute>

		<execute macro="Portal.PageTemplate#viewDefaultLocalizedCP">
			<var name="pageTemplateDescriptionList" value="edite y vea blogs desde esta página. Explore los temas usando etiquetas y conecte con otros miembros del blog.,edite y explore contenidos web de esta página. Busque contenido adicional, explore contenido relacionado con etiquetas y hojee las categorías del contenido.,Colabora con los miembros a través de la wiki en esta página. Descubre el contenido relacionado a través de etiquetas y navega rápida y fácilmente por las categorías." />
			<var name="pageTemplateNameList" value="Blog,Seleccione una página de visualización,Wiki" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoLocalizedUserMyAccount">
			<var name="category" value="Mi cuenta" />
			<var name="portlet" value="Mi cuenta" />
		</execute>

		<execute macro="Portal.MyAccount#changeUserLanguage">
			<var name="languageName" value="English (United States)" />
			<var name="saveButton" value="Guardar" />
			<var name="successMessage" value="Your request completed successfully." />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#viewDefaultCP">
			<var name="pageTemplateNameList" value="Blog,Content Display Page,Wiki" />
		</execute>
	</command>

	<command name="ViewEditedPageTemplatePageName" priority="4">
		<property name="testray.component.names" value="Site and Page Templates" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#addCP">
			<var name="pageTemplateActive" value="Yes" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.PageTemplate#viewPG">
			<var name="pageTemplateName" value="Page Template Name" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Page Templates" />
		</execute>

		<execute macro="Portal.PageTemplate#editCP">
			<var name="pageTemplateActive" value="Yes" />
			<var name="pageTemplateName" value="Page Template Name" />
		</execute>

		<execute macro="Portal.PageTemplate#viewPG">
			<var name="pageTemplateName" value="Page Template Name Edit" />
			<var name="siteName" value="${siteName}" />
		</execute>
	</command>
</definition>