<definition component-name="portal-staging">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Staging" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="siteName" value="Site Name" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="DeleteLivePage" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Delete Live Page" />
			<var name="pageStaging" value="true" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Delete Live Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#deletePG">
			<var name="pageName" value="Delete Live Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#viewNoPG">
			<var name="pageName" value="Delete Live Page" />
		</execute>
	</command>

	<command name="EditPublishTemplate" priority="4">
		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page Name 2" />
			<var name="pageStaging" value="true" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Page Name 2" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#addPublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>

		<execute macro="Portal.Staging#configurePublishToLive">
			<var name="checkPageName" value="Staging Test Page" />
			<var name="uncheckContentNameList" value="Blogs" />
		</execute>

		<execute macro="Portal.Staging#savePublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#publishToLivePublishTemplate">
			<var name="publishTemplateName" value="Publish Template Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#viewSpecificPG">
			<var name="pageNameList" value="Staging Test Page" />
		</execute>

		<execute macro="Portal.Page#viewNoPG">
			<var name="pageName" value="Page Name 2" />
		</execute>

		<execute macro="Portal.Portlet#viewPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewNoPG">
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Portlet#viewNoSpecificPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#viewPublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>

		<execute macro="Portal.Staging#editPublishTemplate">
			<var name="publishTemplateDescriptionEdit" value="Publish Template Description Edit" />
			<var name="publishTemplateName" value="Publish Template Name" />
			<var name="publishTemplateNameEdit" value="Publish Template Name Edit" />
		</execute>

		<execute macro="Portal.Staging#configurePublishToLive">
			<var name="checkAllContent" value="true" />
			<var name="checkPageName" value="Public Pages" />
		</execute>

		<execute macro="Portal.Staging#savePublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description Edit" />
			<var name="publishTemplateName" value="Publish Template Name Edit" />
		</execute>

		<execute macro="Portal.Staging#publishToLivePublishTemplate">
			<var name="publishTemplateName" value="Publish Template Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#viewSpecificPG">
			<var name="pageNameList" value="Staging Test Page" />
		</execute>

		<execute macro="Portal.Portlet#viewPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewPG">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Page#viewSpecificPG">
			<var name="pageNameList" value="Page Name 2" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name 2" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>
	</command>

	<command name="MoveToTheRecycleBinAndRestorePublishTemplate" priority="4">
		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute function="Pause" locator1="30000" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#addPublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>

		<execute macro="Portal.Staging#savePublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#viewPublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#moveToTheRecycleBinPublishTemplate">
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Recycle Bin" />
		</execute>

		<execute macro="Portal.RecycleBin#viewCP">
			<var name="assetName" value="Publish Template Name" />
			<var name="assetType" value="Export Import Template" />
			<var name="deleteUser" value="Test Test" />
		</execute>

		<execute macro="Portal.RecycleBin#restoreCP">
			<var name="assetName" value="Publish Template Name" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#viewPublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>
	</command>

	<command name="PublishPortlet" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="Web Content Content" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.Staging#publishToLiveNowViaPortletCP" />
	</command>

	<command name="PublishSiteTeams" priority="3">
		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesMembers">
			<var name="portlet" value="Site Teams" />
		</execute>

		<execute macro="Portal.Team#addCP">
			<var name="teamDescription" value="Site Team Description" />
			<var name="teamName" value="Site Team Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesMembers">
			<var name="portlet" value="Site Teams" />
		</execute>

		<execute macro="Portal.Staging#publishToLiveNowViaPortletCP" />

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesMembers">
			<var name="portlet" value="Site Teams" />
		</execute>

		<execute macro="Portal.Team#viewCP">
			<var name="teamDescription" value="Site Team Description" />
			<var name="teamName" value="Site Team Name" />
		</execute>
	</command>

	<command name="SearchPublishTemplate" priority="4">
		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#addPublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="First Template" />
		</execute>

		<execute macro="Portal.Staging#savePublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="First Template" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#addPublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description 2" />
			<var name="publishTemplateName" value="Second Template" />
		</execute>

		<execute macro="Portal.Staging#savePublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description 2" />
			<var name="publishTemplateName" value="Second Template" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#searchPublishTemplate">
			<var name="searchTerm" value="Second" />
		</execute>
	</command>

	<command name="StagingLocalLiveLock" priority="4">
		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsEntry#editNoPermissionPG">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#editStagingConfiguration">
			<var name="isNotEditable" value="Blogs" />
		</execute>
	</command>

	<command name="StagingPublishChildSiteWithReference" priority="4">
		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="Web Content Content" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="parentSiteName" value="Site Name" />
			<var name="siteName" value="Child Site" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#searchInputCP">
			<var name="siteName" value="Child Site" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page 1" />
			<var name="siteName" value="Child Site" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page 1" />
			<var name="siteName" value="Child Site" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#selectParentSiteWebContent">
			<var name="parentSiteName" value="Site Name" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="siteName" value="Child Site" />
		</execute>
	</command>

	<command name="StagingPublishOnlySelectedPage" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page 1" />
			<var name="pageStaging" value="true" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page 2" />
			<var name="pageStaging" value="true" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page 3" />
			<var name="pageStaging" value="true" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#configurePublishToLive">
			<var name="checkPageName" value="Page 2" />
		</execute>

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#viewSpecificPG">
			<var name="pageNameList" value="Page 2" />
		</execute>

		<execute macro="Portal.Page#viewNoPG">
			<var name="pageName" value="Page 1" />
		</execute>

		<execute macro="Portal.Page#viewNoPG">
			<var name="pageName" value="Page 3" />
		</execute>
	</command>

	<command name="StagingWithPublishTemplateSmoke" priority="4">
		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaWCD">
			<var name="webContentContent" value="Web Content Content" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="Web Content Content" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#addPublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>

		<execute macro="Portal.Staging#savePublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
