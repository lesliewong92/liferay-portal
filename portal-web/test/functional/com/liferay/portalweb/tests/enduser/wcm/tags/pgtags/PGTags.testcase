<definition component-name="portal-tags">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Tags" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Tag#tearDownCP" />

				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddAutoAssertionTagViaBlogs" priority="4">
		<property name="testray.component.names" value="Blogs,Tags" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<for list="tag name 1,tag name 2,tag name 3" param="tagName">
			<execute macro="Portal.Navigator#openSiteURL">
				<var name="siteName" value="Site Name" />
			</execute>

			<execute macro="Portal.ProductMenu#gotoSitesContent">
				<var name="portlet" value="Tags" />
			</execute>

			<execute macro="Portal.Tag#addCP">
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Tag#addAutoAssertionTagViaBlogsPG">
			<var name="entryContent" value="Entry Content" />
			<var name="entryTitle" value="Entry Title" />
			<var name="tagName" value="tag name 3" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Entry Content" />
			<var name="entryTitle" value="Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewTagPG">
			<var name="entryContent" value="Entry Content" />
			<var name="entryTitle" value="Entry Title" />
			<var name="tagName" value="tag name 3" />
		</execute>
	</command>

	<command name="AddFrontPageTag" priority="4">
		<property name="testray.component.names" value="Tags,Wiki" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Wiki" />
		</execute>

		<execute macro="Portal.WikiPage#addFrontPagePG">
			<var name="pageAddTag" value="true" />
			<var name="tagName" value="wiki tag name" />
			<var name="wikiPageContent" value="Wiki FrontPage Content" />
		</execute>
	</command>

	<command name="AddMultipleTagsViaBlogs" priority="4">
		<property name="testray.component.names" value="Blogs,Tags" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntryWithTags">
			<var name="entryContent" value="Entry Content" />
			<var name="entryTitle" value="Entry Title" />
			<var name="tagNameList" value="tag name 1,tag name 2,tag name 3" />
		</execute>

		<for list="tag name 1,tag name 2,tag name 3" param="tagName">
			<execute macro="Portal.Navigator#gotoSitePage">
				<var name="pageName" value="Page Name" />
				<var name="siteName" value="Site Name" />
			</execute>

			<execute macro="Portal.BlogsNavigator#gotoEntryPG">
				<var name="entryContent" value="Entry Content" />
				<var name="entryTitle" value="Entry Title" />
			</execute>

			<execute macro="Portal.BlogsEntry#viewTagPG">
				<var name="entryContent" value="Entry Content" />
				<var name="entryTitle" value="Entry Title" />
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>
	</command>

	<command name="AddSelectTagViaBlogs" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Blogs,Tags" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<for list="tag1,tag2,tag3" param="tagName">
			<execute macro="Portal.Navigator#openSiteURL">
				<var name="siteName" value="Site Name" />
			</execute>

			<execute macro="Portal.ProductMenu#gotoSitesContent">
				<var name="portlet" value="Tags" />
			</execute>

			<execute macro="Portal.Tag#addCP">
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Blogs#addEntryWithTags">
			<var name="entryContent" value="Entry Content" />
			<var name="entryTitle" value="Entry Title" />
			<var name="tagNameList" value="tag1,tag3" />
		</execute>

		<for list="tag1,tag3" param="tagName">
			<execute macro="Portal.Navigator#gotoSitePage">
				<var name="pageName" value="Page Name" />
				<var name="siteName" value="Site Name" />
			</execute>

			<var name="key_entryTitle" value="Entry Title" />

			<execute function="AssertClick" locator1="BlogsEntry#TITLE_LINK" value1="Entry Title" />

			<execute macro="Portal.BlogsEntry#viewTagPG">
				<var name="entryTitle" value="Entry Title" />
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>
	</command>

	<command name="AddTagViaBlogs" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Blogs,Tags" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute function="Refresh" />

		<execute macro="Portal.Blogs#addEntryWithTag">
			<var name="entryContent" value="Entry Content" />
			<var name="entryTitle" value="Entry Title" />
			<var name="tagName" value="tag name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Entry Content" />
			<var name="entryTitle" value="Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewTagPG">
			<var name="entryTitle" value="Entry Title" />
			<var name="tagName" value="tag name" />
		</execute>
	</command>

	<command name="DisplayTagCloud" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Tags" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Tags Navigation" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#configureFlaggableSettingsPG">
			<var name="showAssetCount" value="true" />
			<var name="showUnusedTags" value="true" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#configureDisplayStylePG">
			<var name="displayTemplate" value="Cloud" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<for list="first tag,second tag,third tag" param="tagName">
			<execute macro="Portal.Navigator#openURL" />

			<execute macro="Portal.ProductMenu#gotoSitesContent">
				<var name="portlet" value="Tags" />
			</execute>

			<execute macro="Portal.Tag#addCP">
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addWithTagCP">
			<var name="tagNameList" value="first tag,second tag" />
			<var name="webContentContent" value="Web Content Content" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#addCP">
			<var name="dmDocumentFile" value="Document_1.txt" />
			<var name="dmDocumentSize" value="0KB" />
			<var name="dmDocumentTitle" value="DM Document Title" />
			<var name="tagNameList" value="first tag" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#viewTagCloud">
			<var name="tagName" value="first tag (2)" />
			<var name="tagPopularityLevel" value="6" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#viewTagCloud">
			<var name="tagName" value="second tag (1)" />
			<var name="tagPopularityLevel" value="3" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#viewTagCloud">
			<var name="tagName" value="third tag (0)" />
			<var name="tagPopularityLevel" value="1" />
		</execute>
	</command>

	<command name="DisplayTagUsageStatistics" priority="3">
		<property name="testray.component.names" value="Tags" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Tags Navigation" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#configureDisplayStylePG">
			<var name="displayTemplate" value="Number" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#configureFlaggableSettingsPG">
			<var name="showAssetCount" value="true" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<for list="first tag,second tag,third tag" param="tagName">
			<execute macro="Portal.Navigator#openURL" />

			<execute macro="Portal.ProductMenu#gotoSitesContent">
				<var name="portlet" value="Tags" />
			</execute>

			<execute macro="Portal.Tag#addCP">
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addWithTagCP">
			<var name="tagNameList" value="first tag,second tag" />
			<var name="webContentContent" value="Web Content Content" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#addCP">
			<var name="dmDocumentFile" value="Document_1.txt" />
			<var name="dmDocumentSize" value="0KB" />
			<var name="dmDocumentTitle" value="DM Document Title" />
			<var name="tagNameList" value="first tag" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#clickTagView">
			<var name="tagAssetCount" value="first tag (2)" />
			<var name="tagName" value="first tag" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#clickTagView">
			<var name="tagAssetCount" value="second tag (1)" />
			<var name="tagName" value="second tag" />
		</execute>
	</command>

	<command name="DisplayUnusedTags" priority="3">
		<property name="testray.component.names" value="Tags" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Tags Navigation" />
		</execute>

		<for list="tag name 1,tag name 2,tag name 3" param="tagName">
			<execute macro="Portal.Navigator#openURL" />

			<execute macro="Portal.ProductMenu#gotoSitesContent">
				<var name="portlet" value="Tags" />
			</execute>

			<execute macro="Portal.Tag#addCP">
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#configureFlaggableSettingsPG">
			<var name="showUnusedTags" value="true" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#viewDefaultPG">
			<var name="tagNameList" value="tag name 1,tag name 2,tag name 3" />
		</execute>
	</command>

	<command name="RemoveSelectTagViaBlogs" priority="3">
		<property name="testray.component.names" value="Blogs,Tags" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntryWithTags">
			<var name="entryContent" value="Entry Content" />
			<var name="entryTitle" value="Entry Title" />
			<var name="tagNameList" value="tag name 1,tag name 2,tag name 3" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<for list="tag name 1,tag name 2,tag name 3" param="tagName">
			<execute macro="Portal.Navigator#gotoSitePage">
				<var name="pageName" value="Page Name" />
				<var name="siteName" value="Site Name" />
			</execute>

			<execute macro="Portal.BlogsNavigator#gotoEntryPG">
				<var name="entryContent" value="Entry Content" />
				<var name="entryTitle" value="Entry Title" />
			</execute>

			<execute macro="Portal.BlogsEntry#viewTagPG">
				<var name="entryContent" value="Entry Content" />
				<var name="entryTitle" value="Entry Title" />
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEditPG">
			<var name="entryTitle" value="Entry Title" />
		</execute>

		<execute macro="Portal.Panel#expandPanel">
			<var name="panelHeading" value="Categorization" />
		</execute>

		<for list="tag name 1,tag name 3" param="tagName">
			<execute macro="Portal.AssetCategorization#removeTag">
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Entry Content" />
			<var name="entryTitle" value="Entry Title" />
		</execute>

		<execute function="AssertTextNotPresent" value1="tag name 1" />
		<execute function="AssertTextNotPresent" value1="tag name 3" />
	</command>

	<command name="RemoveTagViaBlogs" priority="5">
		<property name="portal.acceptance" value="quarantine" />
		<property name="testray.component.names" value="Blogs,Tags" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntryWithTags">
			<var name="entryContent" value="Entry Content" />
			<var name="entryTitle" value="Entry Title" />
			<var name="tagNameList" value="tag name 1,tag name 2,tag name 3" />
		</execute>

		<for list="tag name 1,tag name 2,tag name 3" param="tagName">
			<execute macro="Portal.Navigator#gotoSitePage">
				<var name="pageName" value="Page Name" />
				<var name="siteName" value="Site Name" />
			</execute>

			<execute macro="Portal.BlogsNavigator#gotoEntryPG">
				<var name="entryContent" value="Entry Content" />
				<var name="entryTitle" value="Entry Title" />
			</execute>

			<execute macro="Portal.BlogsEntry#viewTagPG">
				<var name="entryContent" value="Entry Content" />
				<var name="entryTitle" value="Entry Title" />
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEditPG">
			<var name="entryTitle" value="Entry Title" />
		</execute>

		<execute macro="Portal.Panel#expandPanel">
			<var name="panelHeading" value="Categorization" />
		</execute>

		<execute macro="Portal.AssetCategorization#removeTag">
			<var name="tagName" value="tag name 1" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Entry Content" />
			<var name="entryTitle" value="Entry Title" />
		</execute>

		<execute function="AssertTextNotPresent" value1="tag name 1" />
	</command>

	<command name="SearchMultipleTagsViaBlogs" priority="3">
		<property name="testray.component.names" value="Blogs,Tags" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Blogs#addEntryWithTag">
			<var name="entryContent" value="Entry Content 1" />
			<var name="entryTitle" value="Entry Title 1" />
			<var name="tagName" value="blue" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Blogs#addEntryWithTag">
			<var name="entryContent" value="Entry Content 2" />
			<var name="entryTitle" value="Entry Title 2" />
			<var name="tagName" value="blue green" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Blogs#addEntryWithTag">
			<var name="entryContent" value="Entry Content 3" />
			<var name="entryTitle" value="Entry Title 3" />
			<var name="tagName" value="yellow" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Search#searchPG">
			<var name="searchTerm" value="blue" />
		</execute>

		<execute macro="Portal.Search#viewSearchAssetTitle">
			<var name="searchAssetSummary" value="Entry Content 1" />
			<var name="searchAssetTitle" value="Entry Title 1" />
		</execute>

		<execute macro="Portal.Search#searchPG">
			<var name="searchTerm" value="yellow" />
		</execute>

		<execute macro="Portal.Search#viewSearchAssetTitle">
			<var name="searchAssetSummary" value="Entry Content 3" />
			<var name="searchAssetTitle" value="Entry Title 3" />
		</execute>
	</command>

	<command name="ViewDuplicateTagWarningMessage" priority="3">
		<property name="testray.component.names" value="Tags" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC Content" />
			<var name="webContentTitle" value="WC Title" />
		</execute>

		<execute macro="Portal.Panel#expandPanel">
			<var name="panelHeading" value="Metadata" />
		</execute>

		<execute macro="Portal.AssetCategorization#addTag">
			<var name="tagName" value="tagname" />
		</execute>

		<execute macro="Portal.AssetCategorization#addDuplicateTag">
			<var name="tagName" value="tagname" />
		</execute>
	</command>

	<command name="ViewTagCloudDisplayConfiguration" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Tags" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Tag Cloud Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tag Cloud Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Tag Cloud" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tag Cloud Page" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#viewTagCloudConfiguration">
			<var name="displayTemplate" value="Cloud" />
		</execute>
	</command>

	<command name="ViewTagCloudIncrease" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Tags" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Tags Navigation" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#configureFlaggableSettingsPG">
			<var name="showAssetCount" value="true" />
			<var name="showUnusedTags" value="true" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#configureDisplayStylePG">
			<var name="displayTemplate" value="Cloud" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<for list="first tag,second tag,third tag" param="tagName">
			<execute macro="Portal.Navigator#openURL" />

			<execute macro="Portal.ProductMenu#gotoSitesContent">
				<var name="portlet" value="Tags" />
			</execute>

			<execute macro="Portal.Tag#addCP">
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addWithTagCP">
			<var name="tagNameList" value="first tag,second tag" />
			<var name="webContentContent" value="Web Content Content" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#addCP">
			<var name="dmDocumentFile" value="Document_1.txt" />
			<var name="dmDocumentSize" value="0KB" />
			<var name="dmDocumentTitle" value="DM Document Title" />
			<var name="tagNameList" value="first tag" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#viewTagCloud">
			<var name="tagName" value="first tag (2)" />
			<var name="tagPopularityLevel" value="6" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#viewTagCloud">
			<var name="tagName" value="second tag (1)" />
			<var name="tagPopularityLevel" value="3" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addWithTagCP">
			<var name="tagNameList" value="first tag,second tag" />
			<var name="webContentContent" value="Web Content2 Content" />
			<var name="webContentTitle" value="Web Content2 Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Tags Navigation Page" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#viewTagCloud">
			<var name="tagName" value="first tag (3)" />
			<var name="tagPopularityLevel" value="6" />
		</execute>

		<execute macro="Portal.TagsNavigationPortlet#viewTagCloud">
			<var name="tagName" value="second tag (2)" />
			<var name="tagPopularityLevel" value="4" />
		</execute>
	</command>
</definition>