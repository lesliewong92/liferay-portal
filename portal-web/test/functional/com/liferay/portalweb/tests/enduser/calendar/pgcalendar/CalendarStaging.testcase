<definition component-name="portal-calendar">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="custom.properties" value="default.layout.template.id=1_column${line.separator}company.default.time.zone=America/Los_Angeles" />
	<property name="testray.main.component.name" value="Calendar" />

	<var name="pageName" value="Calendar Page" />
	<var name="portletName" value="Calendar" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="pageName" value="Staging Test Page" />
			<var name="portletName" value="Calendar" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Navigator#gotoPage">
					<var name="pageName" value="Calendar Page" />
				</execute>

				<if>
					<condition function="Portal.IsElementPresent" locator1="Calendar#SCHEDULER_EVENT_GENERIC" />
					<then>
						<execute macro="Portal.CalendarEvent#tearDown" />
					</then>
				</if>

				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddEvent" priority="3">
		<description message="This is a use case for LPS-52083." />

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#editTitle">
			<var name="eventTitle" value="Calendar Event Title" />
		</execute>

		<execute macro="Portal.CalendarEvent#publish" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="page" value="Staging Test Page" />
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.CalendarEvent#view">
			<var name="eventTitle" value="Calendar Event Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.CalendarNavigator#gotoEditEvent">
			<var name="eventTitle" value="Calendar Event Title" />
		</execute>

		<execute macro="Portal.CalendarEvent#editTitle">
			<var name="eventTitle" value="Calendar Event Title - Staged Edit" />
		</execute>

		<execute macro="Portal.CalendarEvent#publish" />

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.CalendarEvent#view">
			<var name="eventTitle" value="Calendar Event Title - Staged Edit" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.CalendarScheduler#selectSpecificEvent">
			<var name="eventTitle" value="Calendar Event Title - Staged Edit" />
		</execute>

		<execute macro="Portal.CalendarEvent#assertEventNotEditable" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#viewUnavailableCalendarsNotPresent">
			<var name="unavailableCalendarList" value="Site Name" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewAvailableCalendars">
			<var name="availableCalendarList" value="Test Test" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoView">
			<var name="viewType" value="Day" />
		</execute>

		<execute macro="Portal.CalendarScheduler#gotoAddViaDayView" />

		<execute macro="Portal.CalendarEvent#viewUnavailableCalendarsNotPresent">
			<var name="unavailableCalendarList" value="Site Name" />
		</execute>

		<execute macro="Portal.CalendarEvent#viewAvailableCalendars">
			<var name="availableCalendarList" value="Test Test" />
		</execute>
	</command>

	<command name="SchedulePublishToLiveWithEventAndResource" priority="4">
		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#add">
			<var name="calendarName" value="Site Name" />
			<var name="eventTitle" value="Site Name Staged Event" />
			<var name="eventType" value="Regular" />
			<var name="pageName" value="Staging Test Page" />
			<var name="pageStaging" value="true" />
			<var name="siteName" value="Site Name" />
			<var name="siteURL" value="true" />
		</execute>

		<execute macro="Portal.CalendarEvent#view">
			<var name="eventTitle" value="Site Name Staged Event" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#add">
			<var name="calendarName" value="Test Test" />
			<var name="eventTitle" value="Test Test Live Event" />
			<var name="eventType" value="Regular" />
			<var name="pageName" value="Staging Test Page" />
			<var name="pageStaging" value="true" />
			<var name="siteName" value="Site Name" />
			<var name="siteURL" value="true" />
		</execute>

		<execute macro="Portal.CalendarEvent#view">
			<var name="eventTitle" value="Test Test Live Event" />
		</execute>

		<execute macro="Portal.CalendarResource#add">
			<var name="calendarResourceName" value="Calendar Resource Name" />
			<var name="calendarType" value="Other Calendars" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Calendar#add">
			<var name="calendarName" value="Calendar Resource Name" />
			<var name="calendarType" value="Other Calendars" />
		</execute>

		<execute macro="Portal.Calendar#view">
			<var name="calendarName" value="Calendar Resource Name" />
			<var name="calendarType" value="Other Calendars" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.CalendarScheduler#viewSpecificEventNotPresent">
			<var name="eventTitle" value="Site Name Staged Event" />
		</execute>

		<execute macro="Portal.CalendarResource#viewResourceNameNotPresent">
			<var name="calendarResourceName" value="Calendar Resource Name" />
		</execute>

		<execute macro="Portal.CalendarEvent#view">
			<var name="eventTitle" value="Test Test Live Event" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#schedulePublishToLivePG">
			<var name="scheduleTitleName" value="Staging Schedule Title" />
		</execute>

		<execute function="Portal.Pause" locator1="120000" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.CalendarEvent#view">
			<var name="eventTitle" value="Site Name Staged Event" />
		</execute>

		<execute macro="Portal.CalendarEvent#view">
			<var name="eventTitle" value="Test Test Live Event" />
		</execute>

		<execute macro="Portal.Calendar#view">
			<var name="calendarName" value="Calendar Resource Name" />
			<var name="calendarType" value="Other Calendars" />
		</execute>
	</command>
</definition>