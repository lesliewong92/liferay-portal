<definition component-name="portal-user-interface">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="User Interface" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
		</if>
	</tear-down>

	<command name="AddThemeSite" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="test.name.skip.portal.instance" value="PorygonTheme#AddThemeSite" />
		<property name="theme.file.name" value="porygon-theme.war" />

		<var method="TestPropsUtil#get('theme.contains.resources')" name="themeContainsResources" />

		<if>
			<equals arg1="${themeContainsResources}" arg2="true" />
			<then>
				<execute macro="Portal.ProductMenu#gotoControlPanelSites">
					<var name="portlet" value="Sites" />
				</execute>

				<execute macro="Portal.Site#addSiteTemplateCP">
					<var name="siteName" value="Porygon Theme Site" />
					<var name="siteTemplateName" value="Porygon Theme" />
				</execute>

				<execute macro="Portal.ProductMenu#gotoSite">
					<var name="site" value="Porygon Theme Site" />
				</execute>

				<execute function="Portal.AssertClick" locator1="Home#PAGE" value1="HOME">
					<var name="key_pageName" value="home" />
				</execute>

				<execute function="Portal.AssertTextEquals" locator1="Header#H2_TITLE" value1="The Earth is all we have in common">
					<var name="key_title" value="The Earth is all we have in common" />
				</execute>
			</then>
			<else>
				<var name="appName" value="porygon-theme" />

				<execute macro="Portal.ProductMenu#gotoControlPanelApps">
					<var name="portlet" value="App Manager" />
				</execute>

				<execute function="Portal.Type" locator1="TextInput#SEARCH" value1="${appName}" />

				<execute function="Portal.Click" locator1="Icon#BASIC_SEARCH" />

				<execute function="Portal.AssertVisible" locator1="ListGroupItem#ITEM_NAME_LINK">
					<var name="key_itemName" value="porygon-theme" />
				</execute>
			</else>
		</if>
	</command>
</definition>