	<command name="AddFolderImages" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Image Description 1" />
			<var name="dmDocumentFile" value="Document_1.jpg" />
			<var name="dmDocumentTitle" value="DM Image 1 Title" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Image Description 2" />
			<var name="dmDocumentFile" value="Document_2.jpg" />
			<var name="dmDocumentTitle" value="DM Image 2 Title" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Image Description 3" />
			<var name="dmDocumentFile" value="Document_3.jpg" />
			<var name="dmDocumentTitle" value="DM Image 3 Title" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Image Description 1" />
			<var name="dmDocumentTitle" value="DM Image 1 Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Image Description 2" />
			<var name="dmDocumentTitle" value="DM Image 2 Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Image Description 3" />
			<var name="dmDocumentTitle" value="DM Image 3 Title" />
		</execute>
	</command>

	<command name="AddFolderNameSymbol" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMFolder#addPG">
			<var name="dmFolder" value="Invalid" />
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name?" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMPortlet#viewDefaultPG" />
	</command>

	<command name="AddSubFolderImageAndDocument" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMFolder#addSubfolderPG">
			<var name="dmSubFolderDescription" value="DM SubFolder Description" />
			<var name="dmSubFolderName" value="DM SubFolder Name" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM SubFolder Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Image Description" />
			<var name="dmDocumentFile" value="Document_1.jpg" />
			<var name="dmDocumentTitle" value="DM Image Title" />
		</execute>

		<execute macro="Portal.DMDocument#viewPG">
			<var name="dmDocumentDescription" value="DM Image Description" />
			<var name="dmDocumentTitle" value="DM Image Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM SubFolder Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>
	</command>

	<command name="AddSubFolderNameDocumentNameDuplicate" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMFolder#addSubfolderPG">
			<var name="dmSubFolder" value="Duplicate" />
			<var name="dmSubFolderDescription" value="DM Document Description" />
			<var name="dmSubFolderName" value="DM Document Title" />
		</execute>
	</command>

	<command name="AddSubFolders" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="Folder Name" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="Folder Name" />
		</execute>

		<execute macro="Portal.DMFolder#viewPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="Folder Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="Folder Name" />
		</execute>

		<execute macro="Portal.DMFolder#addSubfolderPG">
			<var name="dmSubFolderDescription" value="DM Subfolder1 Description" />
			<var name="dmSubFolderName" value="Subfolder1 Name" />
