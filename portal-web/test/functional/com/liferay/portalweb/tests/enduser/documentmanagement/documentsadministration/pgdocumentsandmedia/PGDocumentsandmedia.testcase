<definition component-name="portal-document-management">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="custom.properties" value="default.layout.template.id=1_column" />
	<property name="testray.main.component.name" value="Documents Management" />

	<var name="pageName" value="Documents and Media Page" />
	<var name="portletName" value="Documents and Media" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#enableActionsMenuOnPortlet" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMPortlet#setDescriptiveView" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.DMDocument#tearDownCP" />

				<execute macro="Portal.DMFolder#tearDownCP" />

				<execute macro="Portal.DMDocumentType#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="AddDocument" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.docx" />
			<var name="dmDocumentTitle" value="Document_1.docx" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="Document_1.docx" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.jpeg" />
			<var name="dmDocumentTitle" value="Document_1.jpeg" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="Document_1.jpeg" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.jpg" />
			<var name="dmDocumentTitle" value="Document_1.jpg" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="Document_1.jpg" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_2.mp3" />
			<var name="dmDocumentTitle" value="Document_2.mp3" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="Document_2.mp3" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.odt" />
			<var name="dmDocumentTitle" value="Document_1.odt" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="Document_1.odt" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.pdf" />
			<var name="dmDocumentTitle" value="Document_1.pdf" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="Document_1.pdf" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.png" />
			<var name="dmDocumentTitle" value="Document_1.png" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="Document_1.png" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.xls" />
			<var name="dmDocumentTitle" value="Document_1.xls" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="Document_1.xls" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.xlsx" />
			<var name="dmDocumentTitle" value="Document_1.xlsx" />
		</execute>

		<execute macro="Portal.DMDocument#viewAllPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="Document_1.xlsx" />
		</execute>
	</command>

	<command name="AddDocuments" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<for list="1,2,3" param="entryCount" >
			<execute macro="Portal.DMDocument#addPG">
				<var name="dmDocumentDescription" value="DM Document Description" />
				<var name="dmDocumentFile" value="Document_${entryCount}.doc" />
				<var name="dmDocumentTitle" value="Document_${entryCount}.doc" />
			</execute>
		</for>

		<for list="1,2,3" param="entryCount" >
			<execute macro="Portal.Navigator#gotoPage">
				<var name="pageName" value="Documents and Media Page" />
			</execute>

			<execute macro="Portal.DMDocument#viewPG">
				<var name="dmDocumentDescription" value="DM Document Description" />
				<var name="dmDocumentSize" value="22KB" />
				<var name="dmDocumentTitle" value="Document_${entryCount}.doc" />
			</execute>
		</for>
	</command>

	<command name="AddDocumentTypes" priority="4">
		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentType" />

		<execute macro="Portal.DMDocumentType#add">
			<var name="dmDocumentTypeDescription" value="DM Document Type 1 Description" />
			<var name="dmDocumentTypeFieldNames" value="Text Box" />
			<var name="dmDocumentTypeName" value="DM Document Type 1 Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocumentType#viewMenulistOption">
			<var name="dmDocumentTypeName" value="DM Document Type 1 Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentType" />

		<execute macro="Portal.DMDocumentType#add">
			<var name="dmDocumentTypeDescription" value="DM Document Type 2 Description" />
			<var name="dmDocumentTypeFieldNames" value="Text Box" />
			<var name="dmDocumentTypeName" value="DM Document Type 2 Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocumentType#viewMenulistOption">
			<var name="dmDocumentTypeName" value="DM Document Type 2 Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentType" />

		<execute macro="Portal.DMDocumentType#add">
			<var name="dmDocumentTypeDescription" value="DM Document Type 3 Description" />
			<var name="dmDocumentTypeFieldNames" value="Text Box" />
			<var name="dmDocumentTypeName" value="DM Document Type 3 Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocumentType#viewMenulistOption">
			<var name="dmDocumentTypeName" value="DM Document Type 3 Name" />
		</execute>
	</command>

	<command name="AddFolderDocumentDuplicate" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocument" value="Duplicate" />
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>
	</command>

	<command name="AddFolderDocuments" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentFile" value="Document_2.doc" />
			<var name="dmDocumentTitle" value="Document_2.doc" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentFile" value="Document_3.doc" />
			<var name="dmDocumentTitle" value="Document_3.doc" />
		</execute>

		<execute macro="Portal.DMDocument#viewPG">
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#viewPG">
			<var name="dmDocumentTitle" value="Document_2.doc" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#viewPG">
			<var name="dmDocumentTitle" value="Document_3.doc" />
		</execute>
	</command>

	<command name="AddFolderImage" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Image Description" />
			<var name="dmDocumentFile" value="Document_1.jpg" />
			<var name="dmDocumentTitle" value="DM Image Title" />
		</execute>

		<execute macro="Portal.DMDocument#viewPG">
			<var name="dmDocumentDescription" value="DM Image Description" />
			<var name="dmDocumentTitle" value="DM Image Title" />
		</execute>
	</command>

	<command name="AddFolderImageDuplicate" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Image Description" />
			<var name="dmDocumentFile" value="Document_1.jpg" />
