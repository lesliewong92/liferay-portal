<definition component-name="portal-integrations" ignore="true">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="portlet.plugins.includes" value="akismet-portlet" />
	<property name="testray.main.component.name" value="Akismet" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.WikiNode#addMainCP" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.WikiNode#tearDownCP" />

				<execute macro="Portal.WikiPage#tearDownCP" />

				<execute macro="Portal.User#tearDownCP" />

				<execute macro="Portal.AkismetPortlet#tearDownConfiguration" />
			</else>
		</if>
	</tear-down>

	<command name="MarkAsNotSpamWikiPage" priority="4">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelApps">
			<var name="portlet" value="Akismet" />
		</execute>

		<execute macro="Portal.AkismetPortlet#configure">
			<var name="enableSpamModerationFor" value="Wiki" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editUserSiteCP">
			<var name="siteName" value="${siteName}" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#definePermissionCmdCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_WIKI_GENERAL_PERMISSIONS_ACCESS_IN_SITE_ADMINISTRATION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Access in Site Administration" />
			<var name="roleTitle" value="Authenticated" />
			<var name="roleUser" value="User" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Wiki" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoNode">
			<var name="wikiNodeName" value="Main" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoAllPagesCP" />

		<execute macro="Portal.WikiPage#addCP">
			<var name="wikiPageContent" value="Wiki Page Content" />
			<var name="wikiPageTitle" value="Wiki Page Title" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Wiki" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoNode">
			<var name="wikiNodeName" value="Main" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoCP">
			<var name="wikiPageRevision" value="1.0" />
			<var name="wikiPageTitle" value="Wiki Page Title" />
			<var name="wikiPageUsername" value="userfn userln" />
		</execute>

		<execute macro="Portal.WikiPage#markAsSpamCP">
			<var name="wikiPageRevision" value="1.0" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Spam Moderation" />
		</execute>

		<execute macro="Portal.SpamModerationPortlet#navigateToWikis" />

		<execute macro="Portal.SpamModerationPortlet#MarkAsNotSpam">
			<var name="assetType" value="wikiPage" />
			<var name="wikiPageRevision" value="1.0" />
			<var name="wikiPageTitle" value="Wiki Page Title" />
			<var name="wikiPageUsername" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Spam Moderation" />
		</execute>

		<execute macro="Portal.SpamModerationPortlet#viewDefault">
			<var name="assetType" value="wikiPage" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Wiki" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoNode">
			<var name="wikiNodeName" value="Main" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoCP">
			<var name="wikiPageRevision" value="1.0" />
			<var name="wikiPageTitle" value="Wiki Page Title" />
			<var name="wikiPageUsername" value="userfn userln" />
		</execute>

		<execute macro="Portal.WikiPage#viewCP">
			<var name="akismetEnabled" value="true" />
			<var name="wikiPageRevision" value="1.0" />
		</execute>
	</command>

	<command name="MarkAsSpamWikiPage" priority="4">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelApps">
			<var name="portlet" value="Akismet" />
		</execute>

		<execute macro="Portal.AkismetPortlet#configure">
			<var name="enableSpamModerationFor" value="Wiki" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editUserSiteCP">
			<var name="siteName" value="${siteName}" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#definePermissionCmdCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_CONTENT_WIKI_GENERAL_PERMISSIONS_ACCESS_IN_SITE_ADMINISTRATION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Access in Site Administration" />
			<var name="roleTitle" value="Authenticated" />
			<var name="roleUser" value="User" />
		</execute>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Wiki" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoNode">
			<var name="wikiNodeName" value="Main" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoAllPagesCP" />

		<execute macro="Portal.WikiPage#addCP">
			<var name="wikiPageContent" value="Wiki Page Content" />
			<var name="wikiPageTitle" value="Wiki Page Title" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Wiki" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoNode">
			<var name="wikiNodeName" value="Main" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoCP">
			<var name="wikiPageRevision" value="1.0" />
			<var name="wikiPageTitle" value="Wiki Page Title" />
			<var name="wikiPageUsername" value="userfn userln" />
		</execute>

		<execute macro="Portal.WikiPage#markAsSpamCP">
			<var name="wikiPageRevision" value="1.0" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Spam Moderation" />
		</execute>

		<execute macro="Portal.SpamModerationPortlet#navigateToWikis" />

		<execute macro="Portal.SpamModerationPortlet#viewMarkedAsSpam">
			<var name="assetType" value="wikiPage" />
			<var name="wikiPageRevision" value="1.0" />
			<var name="wikiPageTitle" value="Wiki Page Title" />
			<var name="wikiPageUsername" value="userfn userln" />
		</execute>
	</command>
</definition>