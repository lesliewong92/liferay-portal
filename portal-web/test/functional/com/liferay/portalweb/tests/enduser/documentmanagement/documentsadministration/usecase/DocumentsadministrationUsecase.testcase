<definition component-name="portal-document-management">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="custom.properties" value="default.layout.template.id=1_column" />
	<property name="testray.main.component.name" value="Documents Management" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#firstLoginPG" />

				<execute macro="Portal.DMDocument#tearDownCP" />

				<execute macro="Portal.DMFolder#tearDownCP" />

				<execute macro="Portal.DMDocumentType#tearDownCP" />

				<execute macro="Portal.DMMetadataSet#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.User#tearDownCP" />

				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddAndRemoveMetadataSets" priority="4">
		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoMetadataSets" />

		<execute macro="Portal.DMMetadataSet#add">
			<var name="dmMetadataSetFieldNames" value="Text Box" />
			<var name="metadataSetName" value="DM Metadata Set Name" />
		</execute>

		<execute macro="Portal.DMMetadataSet#save" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentType" />

		<execute macro="Portal.DMDocumentType#add">
			<var name="dmDocumentTypeDescription" value="DM Document Type Description" />
			<var name="dmDocumentTypeFieldNames" value="Text Box" />
			<var name="dmDocumentTypeName" value="DM Document Type Name" />
			<var name="metadataSetName" value="DM Metadata Set Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentType" />

		<execute macro="Portal.DMDocumentType#edit">
			<var name="dmDocumentTypeName" value="DM Document Type Name" />
			<var name="metadataSetName" value="DM Metadata Set Name" />
			<var name="removeMetadataSet" value="true" />
		</execute>
	</command>

	<command name="AddDocumentTypeAndMetadata" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoMetadataSets" />

		<execute macro="Portal.DMMetadataSet#add">
			<var name="dmMetadataSetFieldNames" value="Boolean" />
			<var name="metadataSetName" value="Document Metadata Set Name" />
		</execute>

		<execute macro="Portal.DMMetadataSet#save" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentType" />

		<execute macro="Portal.DMDocumentType#add">
			<var name="dmDocumentTypeDescription" value="DM Document Type Description" />
			<var name="dmDocumentTypeFieldNames" value="Boolean" />
			<var name="dmDocumentTypeName" value="DM Document Type Name" />
			<var name="metadataSetName" value="Document Metadata Set Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#addCP">
			<var name="dmDocumentDescription" value="DM Document Type Contract Description" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="DM Document Type Contract Title" />
			<var name="dmDocumentTypeName" value="DM Document Type Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMPortlet#setDescriptiveView" />

		<execute macro="Portal.DMNavigator#gotoDocumentCP">
			<var name="dmDocumentTitle" value="DM Document Type Contract Title" />
		</execute>

		<execute macro="Portal.DMDocument#viewCP">
			<var name="dmDocumentTitle" value="DM Document Type Contract Title" />
		</execute>
	</command>

	<command name="AllowMultiplePortletConfigurationsPerSite" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page 1" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page 2" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page 1" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page 2" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page 1" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMPortlet#configureDisplaySettingsPG">
			<var name="enableDisplaySettingsRelatedAssets" value="false" />
			<var name="enableDisplaySettingsShowSearch" value="false" />
			<var name="entriesToDisplayCount" value="75" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page 2" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMPortlet#viewDefaultConfigurationDisplaySettingsPG" />
	</command>

	<command name="AssertFileSizeValidation">
		<description message="This is a use case for LPS-50760." />

		<property name="test.name.skip.portal.instance" value="DocumentsadministrationUsecase#AssertFileSizeValidation" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#addCP">
			<var name="dmDocumentDescription" value="DM Document Description1" />
			<var name="dmDocumentFile" value="Document_1.mp3" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentCP">
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.DMDocument#viewCP">
			<var name="dmDocumentSize" value="4.3MB" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.LAR#exportPortlet">
			<var name="larFileName" value="DM.portlet.lar" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="Server Administration" />
		</execute>

		<execute function="AssertClick" locator1="NavBar#FILE_UPLOADS" value1="File Uploads" />

		<execute function="Type" locator1="ServerAdministrationFileUploads#DOCS_AND_MEDIA_MAX_FILE_SIZE_FIELD" value1="300000" />

		<execute function="ScrollWebElementIntoView" locator1="Button#SAVE" />

		<execute function="AssertClick" locator1="Button#SAVE" value1="Save" />

		<execute function="AssertElementPresent" locator1="Message#SUCCESS" value1="Your request completed successfully." />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoAddDocumentType">
			<var name="dmDocumentTypeName" value="${dmDocumentTypeName}" />
		</execute>

		<execute function="AssertTextEquals" locator1="Message#INFO" value1="Upload documents no larger than 293KB." />

		<execute macro="Portal.DMDocument#editCmd">
			<var name="dmDocumentFileEdit" value="Document_1.mp4" />
			<var name="dmDocumentTitle" value="Document_1.mp4" />
		</execute>

		<execute macro="Portal.Button#clickPublish" />

		<execute macro="Portal.Alert#viewRequestFailedToComplete" />

		<execute function="AssertTextEquals#assertPartialText" locator1="Message#ERROR_2" value1="Please enter a file with a valid file size no larger than 293KB." />

		<execute macro="Portal.Button#clickCancel" />

		<execute macro="Portal.LAR#_gotoExportImport" />

		<execute function="AssertElementPresent" locator1="IFrame#DIALOG" />

		<execute macro="Portal.LAR#_export">
			<var name="exportPermissions" value="${exportPermissions}" />
			<var name="larFileName" value="DM.portlet.lar" />
		</execute>

		<execute function="SelectFrame" value1="relative=top" />
	</command>

	<command name="CheckoutAndCheckin" priority="5">
		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#assignRegRoleCP">
			<var name="roleTitle" value="Administrator" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesMembers">
			<var name="portlet" value="Site Memberships" />
		</execute>

		<execute macro="Portal.Site#assignUserAsMemberCP">
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="pageName" value="Documents and Media Page" />
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute function="Click" locator1="Icon#DISPLAY_STYLE_DESCRIPTIVE" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute function="Click" locator1="Icon#DISPLAY_STYLE_DESCRIPTIVE" />

		<execute macro="Portal.DMDocument#viewDocumentToolbarCmdAsGuestPG">
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute function="Click" locator1="Icon#DISPLAY_STYLE_DESCRIPTIVE" />

		<execute macro="Portal.DMDocument#enableActionsMenuOnPortlet" />

		<execute macro="Portal.DMDocument#checkoutPG">
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.DMDocument#viewDocumentVersionNumberCmdPG">
			<var name="dmDocumentVersionNumber" value="PWC" />
		</execute>

		<execute function="AssertTextEquals" locator1="DocumentsAndMediaDocument#DOCUMENT_INFO_WORKFLOW_STATUS" value1="Draft" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<for list="1,2" param="tagCount" >
			<execute macro="Portal.DMDocument#editCmdPG">
				<var name="dmDocumentTagName" value="tag${tagCount}" />
				<var name="dmDocumentTitle" value="Document_1.doc" />
			</execute>

			<execute function="AssertClick" locator1="Button#SAVE" value1="Save" />

			<execute function="Pause" locator1="10000" />

			<execute macro="Portal.Navigator#gotoPage">
				<var name="pageName" value="Documents and Media Page" />
			</execute>
		</for>

		<execute macro="Portal.DMDocument#editSavePG">
			<var name="dmDocumentTitle" value="Document_1.doc" />
			<var name="dmDocumentTitleEdit" value="Document1" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="Test Test" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#editCmdPG">
			<var name="checkedOut" value="true" />
			<var name="dmDocumentTitle" value="Document_1.doc" />
			<var name="userName" value="userfn userln" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoCheckedOutDocument">
			<var name="dmCheckedOutDocumentTitle" value="Document1" />
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="Portal.DMDocument#viewDocumentVersionNumberCmdPG">
			<var name="dmDocumentVersionNumber" value="PWC" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#saveAndCheckinEditedDocumentPG">
			<var name="dmDocumentTitle" value="Document1" />
			<var name="revision" value="Minor" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentPG">
			<var name="dmDocumentTitle" value="Document1" />
		</execute>

		<execute macro="Portal.DMDocument#viewDocumentVersionNumberCmdPG">
			<var name="dmDocumentVersionNumber" value="1.1" />
		</execute>

		<execute function="AssertTextEquals" locator1="DocumentsAndMediaDocument#DOCUMENT_INFO_WORKFLOW_STATUS" value1="Approved" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#checkoutPG">
			<var name="dmDocumentTitle" value="Document1" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute function="AssertClick" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_TITLE" value1="Document1">
			<var name="key_dmDocumentTitle" value="Document1" />
		</execute>

		<execute function="AssertClick#assertTextClick" locator1="Button#EDIT" value1="Edit" />

		<while>
			<condition function="IsElementPresent" locator1="AssetCategorization#TAGS_REMOVE_ICON_GENERIC" />
			<then>
				<execute function="Click" locator1="AssetCategorization#TAGS_REMOVE_ICON_GENERIC" />
			</then>
		</while>

		<execute function="AssertClick" locator1="Button#SAVE" value1="Save" />

		<execute macro="Portal.DMDocument#viewDocumentVersionNumberCmdPG">
			<var name="dmDocumentVersionNumber" value="PWC" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#checkinPG">
			<var name="dmDocumentTitle" value="Document1" />
			<var name="revision" value="Minor" />
		</execute>

		<execute macro="Portal.DMDocument#viewDocumentVersionNumberCmdPG">
			<var name="dmDocumentVersionNumber" value="1.1" />
		</execute>

		<execute function="AssertTextEquals" locator1="DocumentsAndMediaDocument#DOCUMENT_INFO_WORKFLOW_STATUS" value1="Approved" />
	</command>

	<command name="Comments" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMFolder#addCP">
			<var name="dmFolderName" value="Folder1" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMFolder#addCP">
			<var name="dmFolderDescription" value="Description of Folder2" />
			<var name="dmFolderName" value="Folder2" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMFolder#gotoCP">
			<var name="dmFolderName" value="Folder1" />
		</execute>

		<execute macro="Portal.DMDocument#addCP">
			<var name="dmDocumentDescription" value="This is a file with zero bytes" />
			<var name="dmDocumentTitle" value="Zero Document File" />
			<var name="nullFile" value="true" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMFolder#gotoCP">
			<var name="dmFolderName" value="Folder1" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentCP">
			<var name="dmDocumentTitle" value="Zero Document File" />
		</execute>

		<execute macro="Portal.DMDocument#viewCP">
			<var name="dmDocumentSize" value="0KB" />
			<var name="dmDocumentTitle" value="Zero Document File" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute function="Click" locator1="Icon#DISPLAY_STYLE_DESCRIPTIVE" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Activities" />
		</execute>

		<execute function="AssertTextEquals" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_FOLDER_TITLE" value1="Folder1">
			<var name="key_dmFolderName" value="Folder1" />
		</execute>

		<execute function="AssertClick" locator1="Activities#ACTIVITY_TITLE_ASSET_NAME" value1="Zero Document File">
			<var name="key_assetName" value="Zero Document File" />
		</execute>

		<execute macro="Portal.DMDocument#viewDocumentTitleCmdPG">
			<var name="dmDocumentTitle" value="Zero Document File" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="Folder1" />
		</execute>

		<execute macro="Portal.DMDocumentComment#addPG">
			<var name="commentBody" value="This is the first comment" />
			<var name="dmDocumentTitle" value="Zero Document File" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="Folder1" />
		</execute>

		<execute macro="Portal.DMDocumentComment#addPG">
			<var name="commentBody" value="This is comment #2" />
			<var name="dmDocumentTitle" value="Zero Document File" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="Folder1" />
		</execute>

		<execute macro="Portal.DMDocumentComment#viewPG">
			<var name="commentBody" value="This is the first comment" />
			<var name="dmDocumentTitle" value="Zero Document File" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoFolder">
			<var name="dmFolderName" value="Folder1" />
		</execute>

		<execute macro="Portal.DMDocumentComment#viewPG">
			<var name="commentBody" value="This is comment #2" />
			<var name="dmDocumentTitle" value="Zero Document File" />
		</execute>
	</command>

	<command name="ConfigureXugglerVideoPreviewSizePG" priority="3">
		<property name="custom.properties" value="xuggler.enabled=true${line.separator}dl.file.entry.preview.video.width=0${line.separator}dl.file.entry.preview.video.height=0" />
		<property name="test.name.skip.portal.instance" value="DocumentsadministrationUsecase#ConfigureXugglerVideoPreviewSizePG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="Server Administration" />
		</execute>

		<execute macro="Portal.ServerAdministration#configureExternalServices">
			<var name="enableXuggler" value="true" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute function="Click" locator1="Icon#DISPLAY_STYLE_DESCRIPTIVE" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.mp4" />
			<var name="dmDocumentTitle" value="Document_1.mp4" />
		</execute>

		<execute function="Pause" locator1="180000" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentPG">
			<var name="dmDocumentTitle" value="Document_1.mp4" />
		</execute>

		<execute function="Pause" locator1="30000" />

		<var name="videoGenerationTimeCounter" value="0" />
		<var name="videoGenerationTimeMaxWaitTime" value="6" />

		<while>
			<and>
				<not>
					<equals arg1="${videoGenerationTimeCounter}" arg2="${videoGenerationTimeMaxWaitTime}" />
				</not>
				<condition function="IsElementPresent" locator1="Message#INFO" />
			</and>
			<then>
				<var method="MathUtil#sum('${videoGenerationTimeCounter}', '1')" name="videoGenerationTimeCounter" />

				<execute function="Pause" locator1="30000" />

				<execute macro="Portal.Navigator#gotoPage">
					<var name="pageName" value="Documents and Media Page" />
				</execute>

				<execute macro="Portal.DMNavigator#gotoDocumentPG">
					<var name="dmDocumentTitle" value="Document_1.mp4" />
				</execute>
			</then>
		</while>

		<var attribute="poster" locator="//video" name="videoPreviewThumbnailLink" />

		<execute function="Open" locator1="${videoPreviewThumbnailLink}" />
		<execute function="Pause" locator1="1000" />

		<execute function="AssertElementNotPresent" locator1="DocumentsAndMediaDocument#VIDEO_GENERATION_THUMBNAIL_RESOLUTION">
			<var name="key_videoGenerationThumbnailResolution" value="640" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="DocumentsAndMediaDocument#VIDEO_GENERATION_THUMBNAIL_RESOLUTION">
			<var name="key_videoGenerationThumbnailResolution" value="360" />
		</execute>

		<execute function="AssertElementPresent#assertElementPresent" locator1="DocumentsAndMediaDocument#VIDEO_GENERATION_THUMBNAIL_RESOLUTION">
			<var name="key_videoGenerationThumbnailResolution" value="1280" />
		</execute>

		<execute function="AssertElementPresent#assertElementPresent" locator1="DocumentsAndMediaDocument#VIDEO_GENERATION_THUMBNAIL_RESOLUTION">
			<var name="key_videoGenerationThumbnailResolution" value="720" />
		</execute>
	</command>

