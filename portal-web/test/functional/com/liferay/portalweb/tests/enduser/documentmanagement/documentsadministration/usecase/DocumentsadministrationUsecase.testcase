	<command name="ViewFileCategoryAndTags" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>

		<execute macro="Portal.Category#addCP">
			<var name="categoryDescription" value="Category Description" />
			<var name="categoryName" value="Category Name" />
			<var name="vocabularyName" value="Topic" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Tags" />
		</execute>

		<var name="tagNameList" value="tag1,tag2" />

		<for list="${tagNameList}" param="tagName">
			<execute macro="Portal.Tag#addCP">
				<var name="tagName" value="${tagName}" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#enableActionsMenuOnPortlet" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute function="Click" locator1="Icon#DISPLAY_STYLE_DESCRIPTIVE" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="categoryName" value="Category Name" />
			<var name="dmDocumentDescription" value="Document Description" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="Document Title" />
			<var name="tagNameList" value="tag1,tag2" />
			<var name="vocabularyName" value="Topic" />
		</execute>

		<execute function="Click" locator1="DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_VERTICAL_ELLIPSIS">
			<var name="key_dmDocumentTitle" value="Document Title" />
		</execute>

		<execute function="AssertClick" locator1="MenuItem#ANY_MENU_ITEM" value1="Edit">
			<var name="key_menuItem" value="Edit" />
		</execute>

		<execute macro="Portal.Panel#expandPanel">
			<var name="panelHeading" value="Categorization" />
		</execute>

		<execute function="AssertTextEquals" locator1="AssetCategorization#CATEGORY" value1="Category Name">
			<var name="key_categoryName" value="Category Name" />
		</execute>

		<for list="${tagNameList}" param="tagName">
			<var name="key_tagName" value="${tagName}" />

			<execute function="AssertTextEquals" locator1="AssetCategorization#TAG" value1="${tagName}" />
		</for>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#viewPG">
			<var name="categoryName" value="Category Name" />
			<var name="dmDocumentDescription" value="Document Description" />
			<var name="dmDocumentTitle" value="Document Title" />
			<var name="tagNameList" value="tag1,tag2" />
		</execute>
	</command>

	<command name="ViewPortletAfterRenamingDocumentWithDuplicateTitlePG" priority="4">
		<execute macro="Portal.Page#add">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute function="Click" locator1="Icon#DISPLAY_STYLE_DESCRIPTIVE" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocument" value="Duplicate" />
			<var name="dmDocumentDescription" value="DM Document 2 Description" />
			<var name="dmDocumentFile" value="Document_2.doc" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute function="Type" locator1="DocumentsAndMediaEditDocument#TITLE_FIELD" value1="DM Document 2 Title" />

		<execute macro="Portal.PortletEntry#publish" />

		<execute function="Pause" locator1="1000" />

		<execute function="AssertTextNotPresent" value1="Documents and Media is temporarily unavailable." />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Documents and Media Page" />
		</execute>

		<execute function="Pause" locator1="1000" />

		<execute function="AssertTextNotPresent" value1="Documents and Media is temporarily unavailable." />

		<execute macro="Portal.DMDocument#viewPG">
			<var name="dmDocumentDescription" value="DM Document 2 Description" />
			<var name="dmDocumentTitle" value="DM Document 2 Title" />
		</execute>
	</command>

	<command name="ViewSingleDocumentSelectionDoesNotCheckAllFileSelectionCP" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#addCP">
			<var name="dmDocumentDescription" value="DM Document1 Description" />
			<var name="dmDocumentFile" value="Document_1.jpg" />
			<var name="dmDocumentTitle" value="DM Document1 Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#addCP">
			<var name="dmDocumentDescription" value="DM Document2 Description" />
			<var name="dmDocumentFile" value="Document_1.jpg" />
			<var name="dmDocumentTitle" value="DM Document2 Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#checkDocumentCheckboxCP">
			<var name="dmDocumentTitle" value="DM Document1 Title" />
		</execute>

		<execute function="AssertElementPresent" locator1="Checkbox#SELECT_ALL_CHECKBOX_TICK" />

		<execute macro="Portal.DMDocument#uncheckDocumentCheckboxCP">
			<var name="dmDocumentTitle" value="DM Document1 Title" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="Checkbox#SELECT_ALL_CHECKBOX_TICK" />

		<execute macro="Portal.DMDocument#checkDocumentCheckboxCP">
			<var name="dmDocumentTitle" value="DM Document1 Title" />
		</execute>

		<execute macro="Portal.DMDocument#checkDocumentCheckboxCP">
			<var name="dmDocumentTitle" value="DM Document2 Title" />
		</execute>

		<execute function="AssertChecked" locator1="DocumentsAndMedia#TOOLBAR_SELECT_ALL_CHECKBOX" />
	</command>
</definition>