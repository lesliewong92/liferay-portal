			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#approveTaskByActions">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
			<var name="workflowAssetType" value="Blogs Entry" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#gotoCompletedFilter" />

		<execute macro="Portal.Workflow#gotoAssetViaTableTitle">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.WorkflowComment#add">
			<var name="workflowComment" value="Workflow Comment" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#gotoCompletedFilter" />

		<execute macro="Portal.Workflow#gotoAssetViaTableTitle">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.WorkflowComment#view">
			<var name="workflowComment" value="Workflow Comment" />
		</execute>
	</command>

