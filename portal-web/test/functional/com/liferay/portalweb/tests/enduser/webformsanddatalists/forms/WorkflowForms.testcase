<definition component-name="portal-workflow">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.component.names" value="Dynamic Data Lists,Workflow,Forms" />
	<property name="testray.main.component.name" value="Workflow" />

	<set-up>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.SignIn#signInPortalInstanceSetUp" />
			</then>
		</if>

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Navigator#openURL" />

				<execute macro="Portal.ProductMenu#gotoSitesContent">
					<var name="portlet" value="Forms" />
				</execute>

				<execute macro="Portal.FormsAdmin#teardownForms" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="SubmitPublishedFormWithTextField" priority="3">
		<description message="This is a use case for LPS-62371" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Forms" />
		</execute>

		<execute macro="Portal.FormsAdminNavigator#gotoAddForm" />

		<execute macro="Portal.Form#editName" />

		<execute macro="Portal.Form#editDescription" />

		<execute macro="Portal.Form#gotoAddField">
			<var name="fieldType" value="Text Field" />
		</execute>

		<execute macro="Portal.Form#editFieldLabel">
			<var name="fieldValue" value="Text Field" />
		</execute>

		<execute macro="Portal.Form#closeSidebar" />

		<execute macro="Portal.FormsAdminNavigator#gotoSettings" />

		<execute macro="Portal.Form#configureWorkflow">
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
		</execute>

		<execute macro="Portal.Form#save" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Forms" />
		</execute>

		<execute macro="Portal.FormsAdminNavigator#gotoEditFormByName" />

		<execute macro="Portal.Form#publishForm" />

		<execute macro="Portal.FormsAdminNavigator#openPublishURL">
			<var name="publishFormURL" value="${publishedFormPublicURL}" />
		</execute>

		<execute macro="Portal.FormFields#editText">
			<var name="fieldName" value="TextField" />
			<var name="fieldValue" value="Text Field Value" />
		</execute>

		<execute macro="Portal.Button#clickSubmitForPublication" />

		<execute macro="Portal.Alert#viewSuccessMessage" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Forms" />
		</execute>

		<execute macro="Portal.FormsAdminNavigator#gotoViewEntries" />

		<execute macro="Portal.WorkflowAsset#viewFormEntryTable">
			<var name="fieldLabel" value="Text Field" />
			<var name="fieldValue" value="Text Field Value" />
			<var name="workflowStatus" value="Pending" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByDetails">
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowAssetType" value="Form Record" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#viewTaskAssignedToMe">
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowAssetType" value="Form Record" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#viewTaskAssignedToMeDetails">
			<var name="workflowAssetContent" value="Text" />
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#approveTaskByActions">
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowAssetType" value="Form Record" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#viewCompletedTask">
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowAssetType" value="Form Record" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Forms" />
		</execute>

		<execute macro="Portal.FormsAdminNavigator#gotoViewEntries" />

		<execute macro="Portal.WorkflowAsset#viewFormEntryTable">
			<var name="fieldLabel" value="Text Field" />
			<var name="fieldValue" value="Text Field Value" />
			<var name="workflowStatus" value="Approved" />
		</execute>
	</command>

	<command name="ViewDateAssetDetails" priority="5">
		<description message="This is a use case LPS-61197." />
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Forms" />
		</execute>

		<execute macro="Portal.FormsAdminNavigator#gotoAddForm" />

		<execute macro="Portal.Form#editName" />

		<execute macro="Portal.Form#editDescription" />

		<execute macro="Portal.Form#gotoAddField">
			<var name="fieldType" value="Date" />
		</execute>

		<execute macro="Portal.Form#editFieldLabel">
			<var name="fieldValue" value="Date" />
		</execute>

		<execute macro="Portal.Form#closeSidebar" />

		<execute macro="Portal.Form#save" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Forms" />
		</execute>

		<execute macro="Portal.FormsAdminNavigator#gotoEdit" />

		<execute macro="Portal.FormsAdminNavigator#gotoSettings" />

		<execute macro="Portal.Form#configureWorkflow">
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
		</execute>

		<execute macro="Portal.Form#save" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Form Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Form Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="pageName" value="Form Page" />
			<var name="portletName" value="Form" />
		</execute>

		<execute macro="Portal.FormPortletNavigator#gotoSelectForm" />

		<execute macro="Portal.FormPortletConfiguration#selectForm" />

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Form Page" />
		</execute>

		<execute macro="Portal.FormFields#viewDateLabel">
			<var name="fieldLabel" value="Date" />
			<var name="fieldName" value="Date" />
		</execute>

		<execute macro="Portal.FormFields#editDate">
			<var name="fieldName" value="Date" />
			<var name="fieldValue" value="02/01/2016" />
		</execute>

		<execute macro="Portal.Button#clickSubmitForPublication" />

		<execute macro="Portal.Alert#viewSuccessMessage" />

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByDetails">
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowAssetType" value="Form Record" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#viewTaskAssignedToMe">
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowAssetType" value="Form Record" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#viewTaskAssignedToMeDetails">
			<var name="workflowAssetContent" value="Date" />
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#gotoPreviewView" />

		<execute macro="Portal.FormFields#viewDateField">
			<var name="fieldLabel" value="Date" />
			<var name="fieldName" value="Date" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#approveTaskByActions">
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowAssetType" value="Form Record" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#viewCompletedTask">
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowAssetType" value="Form Record" />
			<var name="workflowTask" value="Review" />
		</execute>
	</command>

	<command name="ViewEntryWithConditionalVisibilityFromSelectAndRadio" priority="5">
		<description message="This is a use case for LPS-65270." />
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Forms" />
		</execute>

		<execute macro="Portal.FormsAdminNavigator#gotoAddForm" />

		<execute macro="Portal.Form#editName" />

		<execute macro="Portal.Form#editDescription" />

		<execute macro="Portal.Form#gotoAddField">
			<var name="fieldType" value="Select from List" />
		</execute>

		<execute macro="Portal.Form#editFieldLabel">
			<var name="fieldValue" value="Select" />
		</execute>

		<execute macro="Portal.FormFields#editOptionsRow">
			<var name="optionName" value="Select1" />
			<var name="optionValue" value="Select 1" />
		</execute>

		<execute macro="Portal.Form#closeSidebar" />

		<execute macro="Portal.Form#gotoAddField">
			<var name="fieldType" value="Text Field" />
		</execute>

		<execute macro="Portal.Form#editFieldLabel">
			<var name="fieldValue" value="Text One" />
		</execute>

		<execute macro="Portal.Form#closeSidebar" />

		<execute macro="Portal.Form#gotoAddField">
			<var name="fieldType" value="Single Selection" />
		</execute>

		<execute macro="Portal.Form#editFieldLabel">
			<var name="fieldValue" value="Radio" />
		</execute>

		<execute macro="Portal.FormFields#editOptionsRow">
			<var name="optionName" value="Option1" />
			<var name="optionValue" value="Option 1" />
		</execute>

		<execute macro="Portal.Form#closeSidebar" />

		<execute macro="Portal.Form#gotoAddField">
			<var name="fieldType" value="Text Field" />
		</execute>

		<execute macro="Portal.Form#editFieldLabel">
			<var name="fieldValue" value="Text Two" />
		</execute>

		<execute macro="Portal.Form#closeSidebar" />

		<execute macro="Portal.FormsAdminNavigator#gotoRules" />

		<execute macro="Portal.FormRules#addRule" />

		<execute macro="Portal.FormRules#configureConditionOptions">
			<var name="conditionField" value="Select" />
			<var name="conditionOperator" value="Is equal to" />
			<var name="conditionRowNumber" value="1" />
			<var name="conditionValueField" value="Select 1" />
			<var name="conditionValueType" value="Value" />
		</execute>

		<execute macro="Portal.FormRules#configureActionOptions">
			<var name="action" value="Show" />
			<var name="actionRowNumber" value="1" />
			<var name="actionTarget" value="Text One" />
		</execute>

		<execute macro="Portal.FormRules#save" />

		<execute macro="Portal.FormRules#addRule" />

		<execute macro="Portal.FormRules#configureConditionOptions">
			<var name="conditionField" value="Radio" />
			<var name="conditionOperator" value="Is equal to" />
			<var name="conditionRowNumber" value="1" />
			<var name="conditionValueField" value="Option 1" />
			<var name="conditionValueType" value="Value" />
		</execute>

		<execute macro="Portal.FormRules#configureActionOptions">
			<var name="action" value="Show" />
			<var name="actionRowNumber" value="1" />
			<var name="actionTarget" value="Text Two" />
		</execute>

		<execute macro="Portal.FormRules#save" />

		<execute macro="Portal.FormsAdminNavigator#gotoFormBuilder" />

		<execute macro="Portal.FormsAdminNavigator#gotoSettings" />

		<execute macro="Portal.Form#configureWorkflow">
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
		</execute>

		<execute macro="Portal.Form#save" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Form Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Form Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="pageName" value="Form Page" />
			<var name="portletName" value="Form" />
		</execute>

		<execute macro="Portal.FormPortletNavigator#gotoSelectForm" />

		<execute macro="Portal.FormPortletConfiguration#selectForm" />

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Form Page" />
		</execute>

		<execute macro="Portal.FormFields#viewTextFieldNotVisible">
			<var name="fieldLabel" value="Text One" />
			<var name="fieldName" value="TextOne" />
			<var name="fieldValue" value="Text One Input" />
		</execute>

		<execute macro="Portal.FormFields#selectSelectOption">
			<var name="fieldName" value="Select" />
			<var name="selectOption" value="Select 1" />
		</execute>

		<execute macro="Portal.FormFields#editText">
			<var name="fieldName" value="TextOne" />
			<var name="fieldValue" value="Text One Input" />
		</execute>

		<execute macro="Portal.FormFields#viewTextFieldNotVisible">
			<var name="fieldLabel" value="Text Two" />
			<var name="fieldName" value="TextTwo" />
			<var name="fieldValue" value="Text Two Input" />
		</execute>

		<execute macro="Portal.FormFields#selectRadioOption">
			<var name="fieldName" value="Radio" />
			<var name="radioOption" value="Option 1" />
		</execute>

		<execute macro="Portal.FormFields#editText">
			<var name="fieldName" value="TextTwo" />
			<var name="fieldValue" value="Text Two Input" />
		</execute>

		<execute macro="Portal.Button#clickSubmitForPublication" />

		<execute macro="Portal.Alert#viewSuccessMessage" />

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByDetails">
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowAssetType" value="Form Record" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#viewTaskAssignedToMe">
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowAssetType" value="Form Record" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#viewTaskAssignedToMeDetails">
			<var name="workflowAssetContent" value="Text Two" />
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#gotoPreviewView" />

		<execute macro="Portal.FormsAdmin#viewSelectEntry">
			<var name="fieldLabel" value="Select" />
			<var name="fieldName" value="Select" />
			<var name="selectOption" value="Select 1" />
		</execute>

		<execute macro="Portal.FormsAdmin#viewTextEntry">
			<var name="fieldLabel" value="Text One" />
			<var name="fieldName" value="TextOne" />
			<var name="fieldValue" value="Text One Input" />
		</execute>

		<execute macro="Portal.FormsAdmin#viewRadioEntry">
			<var name="fieldLabel" value="Radio" />
			<var name="fieldName" value="Radio" />
			<var name="fieldValue" value="Option 1" />
		</execute>

		<execute macro="Portal.FormsAdmin#viewTextEntry">
			<var name="fieldLabel" value="Text Two" />
			<var name="fieldName" value="TextTwo" />
			<var name="fieldValue" value="Text Two Input" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#approveTaskByActions">
			<var name="workflowAssetTitle" value="Created Form Name" />
			<var name="workflowAssetType" value="Form Record" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Forms" />
		</execute>

		<execute macro="Portal.FormsAdminNavigator#gotoViewEntries" />

		<execute macro="Portal.FormsAdmin#viewFormTableEntry">
			<var name="fieldLabel" value="Select" />
			<var name="fieldValue" value="Select 1" />
		</execute>

		<execute macro="Portal.FormsAdmin#viewFormTableEntry">
			<var name="fieldLabel" value="Text One" />
			<var name="fieldValue" value="Text One Input" />
		</execute>

		<execute macro="Portal.FormsAdmin#viewFormTableEntry">
			<var name="fieldLabel" value="Radio" />
			<var name="fieldValue" value="Option 1" />
		</execute>

		<execute macro="Portal.FormsAdmin#viewFormTableEntry">
			<var name="fieldLabel" value="Text Two" />
			<var name="fieldValue" value="Text Two Input" />
		</execute>

		<execute macro="Portal.FormsAdminNavigator#gotoView" />

		<execute macro="Portal.FormsAdmin#viewSelectEntry">
			<var name="fieldLabel" value="Select" />
			<var name="fieldName" value="Select" />
			<var name="selectOption" value="Select 1" />
		</execute>

		<execute macro="Portal.FormsAdmin#viewTextEntry">
			<var name="fieldLabel" value="Text One" />
			<var name="fieldName" value="TextOne" />
			<var name="fieldValue" value="Text One Input" />
		</execute>

		<execute macro="Portal.FormsAdmin#viewRadioEntry">
			<var name="fieldLabel" value="Radio" />
			<var name="fieldName" value="Radio" />
			<var name="fieldValue" value="Option 1" />
		</execute>

		<execute macro="Portal.FormsAdmin#viewTextEntry">
			<var name="fieldLabel" value="Text Two" />
			<var name="fieldName" value="TextTwo" />
			<var name="fieldValue" value="Text Two Input" />
		</execute>
	</command>
</definition>