<definition component-name="portal-workflow">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Workflow" />

	<var name="workflowAssetType" value="Blogs Entry" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesConfiguration">
			<var name="portlet" value="Workflow" />
		</execute>

		<execute macro="Portal.Workflow#configureWorkflow">
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
			<var name="workflowResourceValue" value="Blogs Entry" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.BlogsEntry#tearDownCP" />

				<execute macro="Portal.Workflow#tearDownPortalWorkflow" />

				<execute macro="Portal.Workflow#tearDownSiteWorkflow" />

				<execute macro="Portal.Workflow#tearDownSpecificWorkflowDefinition">
					<var name="workflowDefinitionTitle" value="Join Xor" />
				</execute>
			</else>
		</if>
	</tear-down>

	<command name="ApproveBlogsEntryCP" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addWithWorkflow">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entrySubtitle" value="Subtitle" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewWithWorkflowCP">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByActions">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
			<var name="workflowAssetType" value="Blogs Entry" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewWithWorkflowCP">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#approveTaskByActions">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
			<var name="workflowAssetType" value="Blogs Entry" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntryTable">
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Portlet#changeDisplayStyle">
			<var name="displayStyle" value="Icon" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryCP">
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Submissions" />
		</execute>

		<execute macro="Portal.Workflow#gotoViewCompletedAssetViaMySubmissions">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntryAsWorkflowAsset">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>
	</command>

	<command name="RejectBlogsEntryCP" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addWithWorkflow">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entrySubtitle" value="Subtitle" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByActions">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
			<var name="workflowAssetType" value="Blogs Entry" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#rejectTaskByActions">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
			<var name="workflowAssetType" value="Blogs Entry" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#viewRejectedTask">
			<var name="workflowAssetTitle" value="Blogs Entry Title" />
			<var name="workflowAssetType" value="Blogs Entry" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewWithWorkflowCP">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>
	</command>
</definition>