	<command name="CancelAddKBArticle" priority="3">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#cancelAddKBArticle">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute macro="Portal.KBArticle#viewDefaultCP" />
	</command>

	<command name="CancelEditKBArticle" priority="3">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#editCP">
			<var name="cancel" value="true" />
			<var name="kbArticleContentEdit" value="Knowledge Base Article Content Edit" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
			<var name="kbArticleTitleEdit" value="Knowledge Base Article Title Edit" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#viewCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>
	</command>

	<command name="CannotAddDuplicateKBFolder" priority="3">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBFolder#addCP">
			<var name="kbFolderDescription" value="KB Folder 1 Description" />
			<var name="kbFolderName" value="KB Folder 1" />
		</execute>

		<execute macro="Portal.KBFolder#addCP">
			<var name="kbAddDuplicate" value="true" />
			<var name="kbFolderDescription" value="KB Folder 1 Description" />
			<var name="kbFolderName" value="KB Folder 1" />
		</execute>
	</command>

	<command name="DeleteKBArticleViaKBAdmin" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#selectArticleCP">
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute macro="Portal.KBArticle#deleteCP" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#viewDefaultCP" />
	</command>

	<command name="DeleteKBFolder" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBFolder#addCP">
			<var name="kbFolderDescription" value="KB Folder 1 Description" />
			<var name="kbFolderName" value="KB Folder 1" />
		</execute>

		<execute macro="Portal.KBFolder#gotoCP">
			<var name="kbFolderName" value="KB Folder 1" />
		</execute>

		<execute macro="Portal.KBArticle#viewDefaultCP" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBFolder#viewFolderNameCP">
			<var name="kbFolderName" value="KB Folder 1" />
		</execute>

		<execute macro="Portal.KBFolder#deleteCP">
			<var name="kbFolderName" value="KB Folder 1" />
		</execute>
	</command>

	<command name="EditKBArticleAndAddAttachmentViaKBAdmin" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#editCP">
			<var name="kbArticleAttachment" value="Document_1.txt" />
			<var name="kbArticleContentEdit" value="Knowledge Base Article Content Edit" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
			<var name="kbArticleTitleEdit" value="Knowledge Base Article Title Edit" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#viewKBArticleWithAttachmentCP">
			<var name="kbArticleAttachment" value="Document_1.txt (0KB) Delete" />
			<var name="kbArticleContent" value="Knowledge Base Article Content Edit" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title Edit" />
		</execute>
	</command>

	<command name="EditKBArticleViaKBAdmin" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
