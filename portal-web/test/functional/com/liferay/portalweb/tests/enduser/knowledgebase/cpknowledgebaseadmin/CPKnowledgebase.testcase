<definition component-name="portal-knowledge-base">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Knowledge Base" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Workflow#tearDownSiteWorkflow" />

				<execute macro="Portal.BlogsEntry#tearDownCP" />

				<execute macro="Portal.Vocabulary#tearDownCP" />

				<execute macro="Portal.KBFolder#tearDownCP" />

				<execute macro="Portal.KBTemplate#tearDownCP" />

				<execute macro="Portal.KBArticle#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="AddChildArticleToKBArticleViaKBAdmin" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute macro="Portal.KBArticle#addChildArticleViaKBAdmin">
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
			<var name="kbChildArticleContent" value="Knowledge Base Child Article Content" />
			<var name="kbChildArticleTitle" value="Knowledge Base Child Article Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#gotoViaKBAdminCP">
			<var name="hasChildArticle" value="true" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute macro="Portal.KBArticle#viewChildArticleCP">
			<var name="kbChildArticleContent" value="Knowledge Base Child Article Content" />
			<var name="kbChildArticleTitle" value="Knowledge Base Child Article Title" />
		</execute>
	</command>

	<command name="AddKBArticleAsDraft" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
			<var name="saveAsDraft" value="true" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#viewCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
			<var name="kbStatus" value="Draft" />
		</execute>
	</command>

	<command name="AddKBArticlesViaKBAdmin" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<for list="1,2,3" param="kbCount">
			<execute macro="Portal.KBArticle#addCP">
				<var name="kbArticleContent" value="Knowledge Base Article Content ${kbCount}" />
				<var name="kbArticleTitle" value="Knowledge Base Article Title ${kbCount}" />
			</execute>
		</for>

		<for list="1,2,3" param="kbCount">
			<execute macro="Portal.Navigator#openURL" />

			<execute macro="Portal.ProductMenu#gotoSitesContent">
				<var name="portlet" value="Knowledge Base" />
			</execute>

			<execute macro="Portal.KBArticle#viewCP">
				<var name="kbArticleContent" value="Knowledge Base Article Content ${kbCount}" />
				<var name="kbArticleTitle" value="Knowledge Base Article Title ${kbCount}" />
			</execute>
		</for>
	</command>

	<command name="AddKBArticleViaKBAdmin" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#viewCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>
	</command>

	<command name="AddKBArticleViaTemplateCP" priority="3">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBTemplate#addCP">
			<var name="kbTemplateContent" value="Knowledge Base Template Content" />
			<var name="kbTemplateTitle" value="Knowledge Base Template Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
			<var name="kbTemplateTitle" value="Knowledge Base Template Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#viewCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>
	</command>

	<command name="AddKBArticleWithAttachmentViaKBAdmin" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleAttachment" value="Document_1.txt" />
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#viewKBArticleWithAttachmentCP">
			<var name="kbArticleAttachment" value="Document_1.txt (0KB) Delete" />
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>
	</command>

	<command name="AddKBArticleWithBlogsEntryRelatedAssetViaKBAdmin" priority="3">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleRelatedAssetTitle" value="Blogs Entry Title" />
			<var name="kbArticleRelatedAssetType" value="Blogs Entry" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#viewCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleRelatedAssetTitle" value="Blogs Entry Title" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<var name="kbArticleRelatedAssetTitle" value="Blogs Entry Title" />

		<var name="key_kbArticleRelatedAssetTitle" value="${kbArticleRelatedAssetTitle}" />

		<execute function="AssertClick" locator1="AssetRelatedAssets#KB_RELATED_ASSETS_LINKS" value1="${kbArticleRelatedAssetTitle}" />

		<execute macro="Portal.KBArticle#viewBlogsEntryRelatedAsset" />
	</command>

	<command name="AddKBArticleWithCategory" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>

		<execute macro="Portal.Vocabulary#addWithAssociatedAssetTypeCP">
			<var name="assetType" value="Knowledge Base Article" />
			<var name="requiredCheckbox" value="true" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>

		<execute macro="Portal.Category#addCP">
			<var name="categoryName" value="Category Name" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="categoryName" value="Category Name" />
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.KBArticle#viewCP">
			<var name="categoryName" value="Category Name" />
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>
	</command>

	<command name="AddKBArticleWithHTMLViaKBAdmin" priority="4">
		<var name="kbArticleContentSource">
			<![CDATA[<b>Knowledge Base&rsquo;s Article Content</b>]]>
		</var>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleAddViaSource" value="true" />
			<var name="kbArticleContentSource" value="${kbArticleContentSource}" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute function="Pause" value1="5000" />

		<execute macro="Portal.KBArticle#viewCPWithHTML">
			<var name="kbArticleContent" value="Knowledge Base’s Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="KnowledgeBaseArticle#CONTENT" value1="${kbArticleContentSource}" />
	</command>

	<command name="AddKBArticleWithInvalidAttachmentSize" priority="3">
		<property name="test.name.skip.portal.instance" value="CPKnowledgebase#AddKBArticleWithInvalidAttachmentSize" />

		<execute macro="Portal.ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="Server Administration" />
		</execute>

		<execute macro="Portal.ServerAdministration#configureFileUploadOverallMaximumFileSize">
			<var name="maxFileSize" value="2048" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCPWithInvalidAttachmentSize">
			<var name="kbArticleAttachment" value="Document_1.png" />
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
			<var name="maxFileSize" value="2048" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#viewCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
			<var name="noAttachment" value="true" />
		</execute>
	</command>

	<command name="AddKBArticleWithoutRequiredCategory" priority="3">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>

		<execute macro="Portal.Vocabulary#addWithAssociatedAssetTypeCP">
			<var name="assetType" value="Knowledge Base Article" />
			<var name="required" value="true" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>

		<execute macro="Portal.Category#addCP">
			<var name="categoryName" value="Category Name" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBArticle#addCP">
			<var name="kbArticleContent" value="Knowledge Base Article Content" />
			<var name="kbArticleTitle" value="Knowledge Base Article Title" />
			<var name="kbMissingRequiredCategory" value="true" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>
	</command>

	<command name="AddKBFolder" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBFolder#addCP">
			<var name="kbFolderDescription" value="KB Folder 1 Description" />
			<var name="kbFolderName" value="KB Folder 1" />
		</execute>

		<execute macro="Portal.KBFolder#gotoCP">
			<var name="kbFolderName" value="KB Folder 1" />
		</execute>

		<execute macro="Portal.KBArticle#viewDefaultCP" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBFolder#viewFolderNameCP">
			<var name="kbFolderName" value="KB Folder 1" />
		</execute>

		<execute macro="Portal.KBFolder#addCP">
			<var name="kbFolderDescription" value="KB Folder 2 Description" />
			<var name="kbFolderName" value="KB Folder 2" />
		</execute>

		<execute macro="Portal.KBFolder#gotoCP">
			<var name="kbFolderName" value="KB Folder 2" />
		</execute>

		<execute macro="Portal.KBArticle#viewDefaultCP" />
	</command>

	<command name="AddTemplateCP" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Knowledge Base" />
		</execute>

		<execute macro="Portal.KBTemplate#addCP">
