<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.component.names" value="Site Pages Administration" />
	<property name="testray.main.component.name" value="Site Pages Administration" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.WebContent#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="AddPageFromExistingPage" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Site Page" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page Name" />
			<var name="pageTemplateName" value="Content Display Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Site Page Name" />
		</execute>

		<for list="Tags Navigation,Categories Navigation,Asset Publisher" param="portletName">
			<execute macro="Portal.Portlet#viewSpecificPG">
				<var name="portletName" value="${portletName}" />
			</execute>
		</for>
	</command>

	<command name="DeletePages" priority="5">
		<property name="portal.acceptance" value="true" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page1" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Page2" />
		</execute>

		<execute macro="Portal.Page#deletePG">
			<var name="pageName" value="Page1" />
		</execute>

		<execute macro="Portal.Page#viewDeletedPage">
			<var name="pageName" value="Page1" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Page#deleteViaX">
			<var name="pageName" value="Page2" />
		</execute>

		<execute macro="Portal.Page#viewDeletedPage">
			<var name="pageName" value="Page2" />
		</execute>
	</command>

	<command name="EditPageViaControlMenu" priority="5">
		<description message="This is a use case for LPS-71160" />

		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoEditPageViaControlMenu" >
			<var name="pageName" value="Site Page" />
		</execute>

		<execute macro="Portal.Page#editName">
			<var name="pageNameEdit" value="Site Page Edit" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Site Page Edit" />
		</execute>

		<execute macro="Portal.Page#view">
			<var name="pageName" value="Site Page Edit" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Site Page Edit" />
		</execute>

		<execute macro="Portal.Navigator#gotoEditPageViaControlMenu" >
			<var name="pageName" value="Site Page Edit" />
		</execute>

		<execute macro="Portal.Navigator#gotoSEOPanel" />

		<execute macro="Portal.Page#editPageMetadata">
			<var name="HTMLTitle" value="S.P.A.C.E.Home" />
			<var name="metaTagsDescription" value="Welcome to S.P.A.C.E., a graduate-level school for those passionate about expanding their horizons through science, research, and space travel" />
			<var name="metaTagsKeywords" value="space, education, space travel, graduateschool" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Site Page Edit" />
		</execute>

		<execute macro="Portal.Navigator#gotoEditPageViaControlMenu" >
			<var name="pageName" value="Site Page Edit" />
		</execute>

		<execute macro="Portal.Navigator#gotoSEOPanel" />

		<execute macro="Portal.Page#viewPageMetadata">
			<var name="HTMLTitle" value="S.P.A.C.E.Home" />
			<var name="metaTagsDescription" value="Welcome to S.P.A.C.E., a graduate-level school for those passionate about expanding their horizons through science, research, and space travel" />
			<var name="metaTagsKeywords" value="space, education, space travel, graduateschool" />
		</execute>
	</command>

	<command name="EditSitePage" priority="4">
		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoEditPage">
			<var name="page" value="Site Page" />
		</execute>

		<execute macro="Portal.Page#editName">
			<var name="pageNameEdit" value="Site Page Edit" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Site Page Edit" />
		</execute>

		<execute macro="Portal.Page#view">
			<var name="pageName" value="Site Page Edit" />
		</execute>
	</command>
</definition>