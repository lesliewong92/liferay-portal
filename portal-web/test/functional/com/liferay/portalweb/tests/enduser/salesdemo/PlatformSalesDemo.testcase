<definition component-name="portal-portal-services" ignore="true">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="portlet.plugins.includes" value="sample-drools-portlet" />
	<property name="testray.main.component.name" value="Development Tools" />
	<property name="web.plugins.includes" value="drools-web" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#logoutAndLoginPG">
					<var name="userLoginEmailAddress" value="test@liferay.com" />
					<var name="userLoginFullName" value="Test Test" />
				</execute>

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.User#tearDownCP" />

				<execute macro="Portal.WebContent#tearDownCP" />

				<execute macro="Portal.WebContentTemplates#tearDownCP" />

				<execute macro="Portal.WebContentStructures#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="SampleDroolsDemo" priority="4">
		<var name="structureDescription" value="WC Structure Description" />
		<var name="structureFieldNames" value="Text,Image" />
		<var name="structureName" value="WC Structure Name" />
		<var name="templateDescription" value="WC Template Description" />
		<var name="templateName" value="WC Template Name" />
		<var name="webContentImage" value="Document_2.jpeg" />
		<var name="webContentText" value="WC WebContent Text" />
		<var name="webContentTitle" value="WC WebContent Title" />

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="Addresses" />
		</execute>

		<execute macro="Portal.User#addAddressViaMyAccount">
			<var name="userAddressCountry" value="United States" />
			<var name="userAddressPostalCode" value="91789" />
			<var name="userAddressRegion" value="California" />
			<var name="userAddressStreet1" value="1220 Brea Canyon Rd" />
			<var name="userAddressType" value="Business" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoManageStructures" />

		<execute macro="Portal.WebContentStructures#addCP">
			<var name="structureDescription" value="WC Structure Description" />
			<var name="structureName" value="WC Structure Name" />
		</execute>

		<for list="Text,Image" param="structureFieldName">
			<execute macro="Portal.DynamicDataMapping#addField">
				<var name="field" value="${structureFieldName}" />
				<var name="fieldFieldLabel" value="${structureFieldName}" />
				<var method="StringUtil#replace('${structureFieldName}', ' ', '')" name="fieldName" />
			</execute>
		</for>

		<execute macro="Portal.WebContentStructures#saveCP">
			<var name="structureName" value="WC Structure Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoManageTemplates" />

		<execute macro="Portal.WebContentTemplates#addCP">
			<var name="templateDescription" value="${templateDescription}" />
			<var name="templateLanguage" value="ftl" />
			<var name="templateName" value="${templateName}" />
		</execute>

		<execute macro="Portal.WebContentTemplates#addStructure">
			<var name="structureName" value="${structureName}" />
			<var name="templateFieldNames" value="${structureFieldNames}" />
			<var name="templateLanguage" value="ftl" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#addWithStructureCP">
			<var name="structureName" value="${structureName}" />
			<var name="templateName" value="${templateName}" />
			<var name="webContentImage" value="${webContentImage}" />
			<var name="webContentText" value="${webContentText}" />
			<var name="webContentTitle" value="${webContentTitle}" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="${webContentTitle}" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="WC Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="pageName" value="WC Page" />
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.WebContentDisplayPortlet#selectWebContent">
			<var name="webContentTitle" value="${webContentTitle}" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditPGViaWCD">
			<var name="webContentTitle" value="${webContentTitle}" />
		</execute>

		<execute macro="Portal.WebContent#addTagPGViaWCD">
			<var name="tagName" value="european" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Drools Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="pageName" value="Drools Page" />
			<var name="portletName" value="Sample Drools" />
		</execute>

		<execute macro="Portal.Drools#viewDefaultPG">
			<var name="welcomeMessage" value="Welcome Test Test!" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="password" value="password" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesMembers">
			<var name="portlet" value="Site Memberships" />
		</execute>

		<execute macro="Portal.Site#assignUserAsMemberCP">
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#assignSiteRoleCP">
			<var name="siteRoleName" value="Site Administrator" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="Addresses" />
		</execute>

		<execute macro="Portal.User#addAddressViaMyAccount">
			<var name="userAddressCountry" value="Germany" />
			<var name="userAddressPostalCode" value="91789" />
			<var name="userAddressRegion" value="Berlin" />
			<var name="userAddressStreet1" value="1220 Brea Canyon Rd" />
			<var name="userAddressType" value="Business" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Drools Page" />
		</execute>

		<execute macro="Portal.Drools#viewContentPG">
			<var name="droolsContent" value="${webContentText}" />
			<var name="screenshotFileName" value="web_content_image_field.png" />
			<var name="welcomeMessage" value="Welcome userfn userln!" />
		</execute>
	</command>
</definition>