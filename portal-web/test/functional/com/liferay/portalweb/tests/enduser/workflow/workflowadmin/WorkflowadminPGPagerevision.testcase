<definition component-name="portal-workflow">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Workflow" />

	<var name="page" value="Public Pages" />
	<var name="pageName" value="Site Page Name" />
	<var name="siteName" value="Site Name" />
	<var name="workflowAssetType" value="Page Revision" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addCP">
			<var name="siteName" value="Site Name" />
			<var name="siteType" value="Blank" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
			<var name="sitePagePrivacy" value="Public" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="pageVersioningEnabled" value="true" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesConfiguration">
			<var name="portlet" value="Workflow" />
		</execute>

		<execute macro="Portal.Workflow#configureWorkflow">
			<var name="workflowDefinition" value="Single Approver (Version 1)" />
			<var name="workflowResourceValue" value="Page Revision" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Site#tearDownCP" />

				<execute macro="Portal.Workflow#tearDownPortalWorkflow" />

				<execute macro="Portal.Workflow#tearDownSiteWorkflow" />
			</else>
		</if>
	</tear-down>

	<command name="RejectPageRevisionPG" priority="4">
		<var name="pageName" value="Page Revision Page" />

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="${pageName}" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Staging#submitForPublicationPageRevision" />

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="${pageName}" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Page#viewWithWorkflowPG">
			<var name="pageName" value="${pageName}" />
			<var name="workflowStatus" value="Pending (Review)" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByActions">
			<var name="workflowAssetTitle" value="${pageName}" />
			<var name="workflowAssetType" value="${workflowAssetType}" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="${pageName}" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Page#viewWithWorkflowPG">
			<var name="pageName" value="${pageName}" />
			<var name="workflowStatus" value="Pending (Review)" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#rejectTaskByActions">
			<var name="workflowAssetTitle" value="${pageName}" />
			<var name="workflowAssetType" value="${workflowAssetType}" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#viewRejectedTask">
			<var name="workflowAssetTitle" value="${pageName}" />
			<var name="workflowAssetType" value="${workflowAssetType}" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="${pageName}" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Page#viewWithWorkflowPG">
			<var name="pageName" value="${pageName}" />
			<var name="workflowStatus" value="Pending (Update)" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="${pageName}" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="${pageName}" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Page#viewWithWorkflowPG">
			<var name="pageName" value="${pageName}" />
			<var name="workflowStatus" value="Pending (Update)" />
		</execute>
	</command>

	<command name="ViewApprovedPageAfterStagingDeactivated" priority="5">
		<description message="This is a use case for LPS-65319." />
		<property name="portal.acceptance" value="true" />

		<var name="pageName" value="New Site Page Name" />

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="${pageName}" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Staging#submitForPublicationPageRevision" />

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="${pageName}" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Page#viewWithWorkflowPG">
			<var name="pageName" value="${pageName}" />
			<var name="workflowStatus" value="Pending (Review)" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByActions">
			<var name="workflowAssetTitle" value="${pageName}" />
			<var name="workflowAssetType" value="${workflowAssetType}" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#approveTaskByActions">
			<var name="workflowAssetTitle" value="${pageName}" />
			<var name="workflowAssetType" value="${workflowAssetType}" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="${pageName}" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Page#viewWithWorkflowPG">
			<var name="pageName" value="${pageName}" />
			<var name="workflowStatus" value="Ready for Publication" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="${pageName}" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.ProductMenu#gotoStagingSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#deactivateStagingCP">
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Navigator#gotoNavTab">
			<var name="navTab" value="Assigned to Me" />
		</execute>

		<execute macro="Portal.Workflow#viewCompletedTasksTaskNotPresentCP">
			<var name="workflowAssetTitle" value="${pageName}" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="${pageName}" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.Page#deletePG">
			<var name="pageName" value="${pageName}" />
		</execute>
	</command>

	<command name="WithdrawWorkflowSubmissionFromRemovedUser" priority="2">
		<description message="This is a use case for LPS-58754" />

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="user@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="user@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editUserSiteCP">
			<var name="siteName" value="Site Name" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#assignSiteRoleCP">
			<var name="siteRoleName" value="Site Administrator" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="user@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.Staging#submitForPublicationPageRevision" />

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userScreenName" value="Test Test" />
		</execute>

		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="My Workflow Tasks" />
		</execute>

		<execute macro="Portal.Workflow#assignToMeTaskByActions">
			<var name="workflowAssetTitle" value="Site Page Name" />
			<var name="workflowAssetType" value="Page Revision" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.Workflow#rejectTaskByActions">
			<var name="workflowAssetTitle" value="Site Page Name" />
			<var name="workflowAssetType" value="Page Revision" />
			<var name="workflowTask" value="Review" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesConfiguration">
			<var name="portlet" value="Workflow" />
		</execute>

		<execute macro="Portal.Workflow#configureWorkflow">
			<var name="workflowDefinition" value="No Workflow" />
			<var name="workflowResourceValue" value="Page Revision" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#deactivateCP">
			<var name="userFirstName" value="userfn" />
		</execute>

		<execute macro="Portal.User#deleteCP" />

		<execute macro="Portal.ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="Workflow" />
		</execute>

		<execute macro="Portal.Navigator#gotoNavItem">
			<var name="navItem" value="Monitoring" />
		</execute>

		<execute macro="Portal.Workflow#withdrawTaskByActions">
			<var name="workflowAssetTitle" value="Site Page Name" />
			<var name="workflowAssetType" value="Page Revision" />
			<var name="workflowDefinition" value="Single Approver" />
			<var name="workflowTask" value="Update" />
		</execute>

		<execute macro="Portal.Workflow#viewDefaultWorkflowSubmissions" />
	</command>
</definition>