<definition component-name="portal-util-misc">
	<property name="osgi.app.includes" value="password-generator" />
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Util" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Password Generator Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Password Generator Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Password Generator" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
		</if>
	</tear-down>

	<command name="GeneratePassword" priority="2">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Password Generator Page" />
		</execute>

		<execute macro="Portal.PasswordGenerator#generatePasswordWithAllOptions">
			<var name="passwordLength" value="6" />
		</execute>
	</command>
</definition>