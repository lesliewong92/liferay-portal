<definition component-name="portal-collaboration">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="custom.properties" value="default.layout.template.id=1_column" />
	<property name="testray.main.component.name" value="Mentions" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Wiki Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Wiki" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Wiki Page" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var method="TestPropsUtil#get('email.address.4')" name="userEmailAddress" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="password" value="password" />
			<var method="TestPropsUtil#get('email.address.4')" name="userEmailAddress" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#assignRegularRoleCP">
			<var name="roleTitle" value="Administrator" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="Server Administration" />
		</execute>

		<execute macro="Portal.ServerAdministration#configureMailServerSettings">
			<var method="TestPropsUtil#get('email.address.1')" name="userName" />
			<var method="TestPropsUtil#get('email.password.1')" name="userPassword" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Wiki Page" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="Virtual Instances" />
		</execute>

		<execute macro="Portal.PortalInstances#editCP">
			<var name="mailDomain" value="gmail.com" />
			<var name="virtualHost" value="localhost" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Wiki Page" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.WikiPage#tearDownCP" />

				<execute macro="Portal.User#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="ViewWikiCommentMentionedUser" priority="5">
		<property name="test.name.skip.portal.instance" value="MentionsWiki#ViewWikiCommentMentionedUser" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Wiki" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoNode">
			<var name="wikiNodeName" value="Main" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoAllPagesCP" />

		<execute function="Portal.Click" locator1="Button#PLUS" />

		<execute macro="Portal.WikiEntry#addPageTitle">
			<var name="wikiPageTitle" value="Wiki Page Title" />
		</execute>

		<execute macro="Portal.WikiEntry#addPageContent">
			<var name="wikiPageContent" value="Wiki Page Content" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Wiki Page" />
		</execute>

		<execute macro="Portal.WikiNavigator#gotoAllPagesPG" />

		<execute macro="Portal.WikiNavigator#gotoEntryViaPGTable">
			<var name="wikiPageTitle" value="Wiki Page Title" />
		</execute>

		<execute function="Portal.Pause" locator1="30000" />

		<execute macro="Portal.Mentions#addMentionViaComments">
			<var name="entryComment" value="Comment mentioning" />
			<var name="mentionsUserFullName" value="userfn userln" />
			<var name="mentionsUserScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Mentions#viewCommentMentionTagLink">
			<var name="mentionsUserFullName" value="userfn userln" />
			<var name="mentionsUserScreenName" value="usersn" />
		</execute>
	</command>
</definition>