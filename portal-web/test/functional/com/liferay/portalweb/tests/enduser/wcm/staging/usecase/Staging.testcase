	</command>

	<command name="StagingRemoteLiveWebContent" priority="4">
		<property name="custom.properties" value="tunneling.servlet.shared.secret=1234567890123456${line.separator}auth.verifier.TunnelAuthVerifier.hosts.allowed=" />
		<property name="test.name.skip.portal.instance" value="Staging#StagingRemoteLiveWebContent" />

		<execute macro="Portal.Staging#remoteStagingSetUp">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoManageStructures" />

		<execute macro="Portal.WebContentStructures#addCP">
			<var name="structureDescription" value="Structure Description" />
			<var name="structureName" value="Structure Name" />
		</execute>

		<for list="Text,Text Box" param="structureFieldName">
			<execute macro="Portal.DynamicDataMapping#addField">
				<var name="field" value="${structureFieldName}" />
				<var name="fieldFieldLabel" value="${structureFieldName}" />
				<var method="StringUtil#replace('${structureFieldName}', ' ', '')" name="fieldName" />
			</execute>
		</for>

		<execute macro="Portal.WebContentStructures#saveCP">
			<var name="structureName" value="Structure Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoManageTemplates" />

		<execute macro="Portal.WebContentTemplates#addCP">
			<var name="templateDescription" value="Template Description" />
			<var name="templateName" value="Template Name" />
		</execute>

		<execute macro="Portal.WebContentTemplates#addStructure">
			<var name="structureName" value="Structure Name" />
			<var name="templateFieldNames" value="Text,Text Box" />
			<var name="templateLanguage" value="ftl" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddWithStructureCP">
			<var name="structureName" value="Structure Name" />
		</execute>

		<execute macro="Portal.WebContent#addWithStructureCP">
			<var name="structureName" value="Structure Name" />
			<var name="templateName" value="Template Name" />
			<var name="webContentText" value="Staging Web Content Text" />
			<var name="webContentTextBox" value="Staging Web Content Body" />
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContent#viewTitle">
			<var name="webContentTitle" value="Web Content Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<var name="dateRangeEndDate"><![CDATA[1/2]]></var>
		<var name="dateRangeStartDate"><![CDATA[1/1]]></var>

		<execute macro="Portal.Staging#setContentDateRange">
			<var name="dateRangeEndDate" value="${dateRangeEndDate}" />
			<var name="dateRangeStartDate" value="${dateRangeStartDate}" />
		</execute>

		<var name="key_contentName" value="Web Content" />

		<execute function="Portal.AssertElementNotPresent" locator1="PagesConfiguration#CONTENT_CHOOSE_CONTENT_CONTENT_CHECKBOX" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoStagingSite" />

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#configurePublishToLive">
			<var name="contentDateRange" value="All" />
		</execute>

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Remote Site" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<var name="key_webContentTitle" value="Web Content Title" />

		<execute function="Portal.AssertTextEquals#assertPartialText" locator1="WC#ENTRY_DESCRIPTIVE_TITLE_ON_LIVE" value1="Web Content Title" />

		<execute macro="Portal.WebContentNavigator#gotoManageStructures" />

		<execute macro="Portal.WebContentStructures#viewCP">
			<var name="structureDescription" value="Structure Description" />
			<var name="structureName" value="Structure Name" />
		</execute>
	</command>

