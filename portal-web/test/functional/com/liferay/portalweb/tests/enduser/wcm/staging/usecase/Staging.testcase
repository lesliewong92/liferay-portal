		<execute macro="Portal.User#deleteCP" />

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Test Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#changePageVariationInHistory">
			<var name="pageVariationName" value="Main Variation" />
			<var name="pageVariationNameMenulistName" value="Test Page Variation Name" />
		</execute>

		<execute macro="Portal.Staging#viewHistoryVersionPG" >
