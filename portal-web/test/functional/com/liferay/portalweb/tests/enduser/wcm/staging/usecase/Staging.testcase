			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#addPageVariationPG">
			<var name="pageVariationName" value="Test Page Variation Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Test Page Name" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute function="Portal.Click" locator1="Icon#HISTORY_VERTICAL_ELLIPSIS" />

		<execute function="Portal.Click" locator1="Staging#HISTORY_BUTTON" />

		<execute function="Portal.SelectFrame" locator1="IFrame#METADATA_SETS_IFRAME" />

		<var locator="Staging#HISTORY_VERSION" name="historyVersion" />

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="test@liferay.com" />
			<var name="userLoginFullName" value="test test" />
