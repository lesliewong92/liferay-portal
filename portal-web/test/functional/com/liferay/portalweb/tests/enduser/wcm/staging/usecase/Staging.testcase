<definition component-name="portal-staging">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Staging" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="ActivateStagingPageVersioningWithCustomDefaultLanguage" priority="5">
		<property name="test.name.skip.portal.instance" value="Staging#ActivateStagingPageVersioningWithCustomDefaultLanguage" />

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Private Staging Page" />
			<var name="sitePagePrivacy" value="Private" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesConfiguration">
			<var name="portlet" value="Site Settings" />
		</execute>

		<execute macro="Portal.Site#configureCurrentLanguagesCP">
			<var name="currentSiteLanguages" value="English (United States)" />
			<var name="defaultSiteLanguage" value="English (United States)" />
			<var name="displaySettings" value="Display Settings" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="pageVersioningEnabled" value="true" />
			<var name="siteName" value="Site Name" />
		</execute>
	</command>

	<command name="DeletePublishTemplate" priority="4">
		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesConfiguration">
			<var name="portlet" value="Site Settings" />
		</execute>

		<execute macro="Portal.Site#disableRecycleBinCP" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#addPublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>

		<execute macro="Portal.Staging#savePublishTemplate">
			<var name="publishTemplateDescription" value="Publish Template Description" />
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#deletePublishTemplate">
			<var name="publishTemplateName" value="Publish Template Name" />
		</execute>
	</command>

	<command name="ModifyInitalPageVariationSetup" priority="3">
		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#modifyVariation">
			<var name="enableOnPublicPages" value="true" />
		</execute>
	</command>

	<command name="PublishRenamedTags" priority="4">
		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaWCD">
			<var name="webContentContent" value="WebContent Content" />
			<var name="webContentTitle" value="WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WebContent Content" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditPGViaWCD">
			<var name="webContentTitle" value="WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#addTagPGViaWCD">
			<var name="tagName" value="tag name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Tags" />
		</execute>

		<execute macro="Portal.Tag#viewCP">
			<var name="tagName" value="tag name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Tags" />
		</execute>

		<execute macro="Portal.LexiconEntry#gotoEntryMenuItem">
			<var name="menuItem" value="Edit" />
			<var name="rowEntry" value="tag name" />
		</execute>

		<execute macro="Portal.PortletEntry#inputName">
			<var name="name" value="tag name edit" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Tags" />
		</execute>

		<execute macro="Portal.Tag#viewCP">
			<var name="tagName" value="tag name edit" />
		</execute>
	</command>

	<command name="StagingAssetPublisher" priority="3">
		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addCommunityCP">
			<var name="siteName" value="Community Site Name" />
			<var name="uncheckPropagation" value="true" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Home" />
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="pageVersioningEnabled" value="true" />
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Home" />
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="Asset Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewAssetTypeNotAvailable">
			<var name="assetType" value="Page Revision" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute function="Portal.Pause" locator1="30000" />

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#deactivateStagingCP">
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Home" />
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="Asset Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewAssetTypeNotAvailable">
			<var name="assetType" value="Page Revision" />
		</execute>
	</command>

	<command name="StagingBlogs" priority="3">
		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Blogs Page 1" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Blogs Page 1" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs Aggregator" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Blogs Page 1" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Recent Bloggers" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Blogs Page 2" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Blogs Page 1" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content 1" />
			<var name="entryTitle" value="Blogs Entry Title 1" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Blogs Page 1" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.RecentBloggers#viewPG">
			<var name="entryAuthor" value="Test Test" />
			<var name="postCount" value="1" />
		</execute>

		<execute macro="Portal.BlogsAggregatorPortlet#viewBlogsEntryViaBAPortletPG">
			<var name="viewEntryTitle" value="Blogs Entry Title 1" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewPG">
			<var name="entryContent" value="Blogs Entry Content 1" />
			<var name="entryTitle" value="Blogs Entry Title 1" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#configurePublishToLive">
			<var name="checkPageName" value="Blogs Page 1" />
		</execute>

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Blogs Page 1" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.RecentBloggers#viewPG">
			<var name="entryAuthor" value="Test Test" />
			<var name="postCount" value="1" />
		</execute>

		<execute macro="Portal.BlogsAggregatorPortlet#viewBlogsEntryViaBAPortletPG">
			<var name="viewEntryTitle" value="Blogs Entry Title 1" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Blogs Entry Content 1" />
			<var name="entryTitle" value="Blogs Entry Title 1" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewPG">
			<var name="entryContent" value="Blogs Entry Content 1" />
			<var name="entryTitle" value="Blogs Entry Title 1" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Blogs Page 2" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsConfiguration#configureScopePG">
			<var name="scopeSelection" value="Blogs Page 2 (Create New)" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Blogs Page 2" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content 2" />
			<var name="entryTitle" value="Blogs Entry Title 2" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Blogs Page 1" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsAggregatorPortlet#viewBlogsEntryViaBAPortletPG">
			<var name="viewEntryTitle" value="Blogs Entry Title 1,Blogs Entry Title 2" />
		</execute>

		<execute macro="Portal.BlogsAggregatorPortlet#configureSelectionMethod">
			<var name="selectionMethod" value="Scope" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Blogs Page 1" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsAggregatorPortlet#viewBlogsEntryViaBAPortletPG">
			<var name="viewEntryTitle" value="Blogs Entry Title 1" />
			<var name="viewNoEntryTitle" value="Blogs Entry Title 2" />
		</execute>

		<execute macro="Portal.SitePageNavigator#gotoPages">
			<var name="page" value="Public Pages" />
			<var name="site" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#configurePublishToLive">
			<var name="checkPageName" value="Blogs Page 2" />
			<var name="contentDateRange" value="All" />
		</execute>

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Blogs Page 2" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Blogs Entry Content 2" />
			<var name="entryTitle" value="Blogs Entry Title 2" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewPG">
			<var name="entryContent" value="Blogs Entry Content 2" />
			<var name="entryTitle" value="Blogs Entry Title 2" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Blogs Page 1" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsAggregatorPortlet#viewBlogsEntryViaBAPortletPG">
			<var name="viewEntryTitle" value="Blogs Entry Title 1" />
			<var name="viewNoEntryTitle" value="Blogs Entry Title 2" />
		</execute>
	</command>

	<command name="StagingCopyFromLive" priority="4">
		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="pageVersioningEnabled" value="true" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#viewSitePagesVariationPG">
			<var name="sitePagesVariationName" value="Main Variation" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Blogs" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoAddEntry" />

		<execute macro="Portal.BlogsEntry#addEntryContent">
			<var name="entryContent" value="Bodzavirágból, bodzavirágból hullik a, hullik a sárga virágpor." />
			<var name="entrySubtitle" value="Nemes Nagy Ágnes" />
			<var name="entryTitle" value="Tavaszi felhők" />
		</execute>

		<execute function="Portal.Pause" locator1="1000" />

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#markAsReadyForPublication" />

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.ProductMenu#gotoLiveSite" />

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Blogs#editEntryPG">
			<var name="entryContent" value="Bodzavirágból, bodzavirágból hullik a, hullik a sárga virágpor." />
			<var name="entryContentEdit" value="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua." />
			<var name="entrySubtitle" value="Nemes Nagy Ágnes" />
			<var name="entrySubtitleEdit" value="Nemes Nagy Ágnes" />
			<var name="entryTitle" value="Tavaszi felhők" />
			<var name="entryTitleEdit" value="Tavaszi felhők" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#copyFromLive">
			<var name="portletName" value="Blogs" />
			<var name="portletOption" value="Staging" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntry">
			<var name="entryContent" value="Bodzavirágból, bodzavirágból hullik a, hullik a sárga virágpor." />
			<var name="entryTitle" value="Tavaszi felhők" />
		</execute>
	</command>

	<command name="StagingDemoDocumentsAndMedia" priority="5">
		<property name="custom.properties" value="default.layout.template.id=1_column" />
		<property name="portal.acceptance" value="pending" />
		<property name="test.name.skip.portal.instance" value="Staging#StagingDemoDocumentsAndMedia" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="Server Administration" />
		</execute>

		<execute function="Portal.AssertClick" locator1="NavBar#FILE_UPLOADS" value1="File Uploads" />

		<execute function="Portal.Type" locator1="ServerAdministrationFileUploads#DOCS_AND_MEDIA_MAX_FILE_SIZE_FIELD" value1="30000000" />
		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMPortlet#setDescriptiveView" />

		<execute macro="Portal.DMDocument#enableActionsMenuOnPortlet" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Folder Description" />
			<var name="dmFolderName" value="DM Folder Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoMetadataSets" />

		<execute macro="Portal.DMMetadataSet#add">
			<var name="dmMetadataSetFieldNames" value="Text,Number" />
			<var name="metadataSetName" value="DM Metadata Set Name" />
