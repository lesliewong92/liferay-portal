		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="pageVersioningEnabled" value="true" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Test Page Name" />
			<var name="pageStaging" value="true" />
			<var name="siteScopeSelected" value="true" />
