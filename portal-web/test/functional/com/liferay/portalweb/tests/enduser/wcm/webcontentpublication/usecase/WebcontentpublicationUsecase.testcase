<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Asset Publisher" />

	<var name="globalSiteName" value="Global" />
	<var name="pageName" value="Asset Publisher Page" />
	<var name="portletName" value="Asset Publisher" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#logoutAndLoginPG">
					<var name="userLoginEmailAddress" value="test@liferay.com" />
					<var name="userLoginFullName" value="Test Test" />
				</execute>

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.WebContent#tearDownCP" />

				<execute macro="Portal.WebContent#tearDownCP">
					<var name="siteScopeName" value="Global" />
				</execute>

				<execute macro="Portal.DMDocumentType#tearDownCP" />

				<execute macro="Portal.BlogsEntry#tearDownCP" />

				<execute macro="Portal.Vocabulary#tearDownCP" />

				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddAndEditAssetsViaVirtualHostOrganizations" priority="4">
		<property name="custom.properties" value="virtual.hosts.valid.hosts=localhost,127.0.0.1,www.able.com,www.baker.com" />
		<property name="test.name.skip.portal.instance" value="WebcontentpublicationUsecase#AddAndEditAssetsViaVirtualHostOrganizations" />

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.Organization#addCP">
			<var name="orgName" value="Organization Name" />
			<var name="orgType" value="Organization" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.UsersAndOrganizationsNavigator#gotoOrganizations" />

		<execute macro="Portal.Organization#addSiteCP">
			<var name="organizationSite" value="Community Site" />
			<var name="orgName" value="Organization Name" />
			<var name="page" value="Public Pages" />
		</execute>

		<for list="Home,Documents and Media,News" param="sitePageName">
			<execute macro="Portal.Page#add">
				<var name="pageName" value="${sitePageName}" />
				<var name="siteName" value="Organization Name" />
				<var name="sitePagePrivacy" value="Private" />
			</execute>
		</for>

		<execute macro="Portal.ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="Server Administration" />
		</execute>

		<execute macro="Portal.ServerAdministration#executeServerResourcesActions">
			<var name="actionsDescription" value="Reindex all search indexes." />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.UsersAndOrganizationsNavigator#gotoOrganizations" />

		<execute macro="Portal.Organization#addMemberCP">
			<var name="orgName" value="Organization Name" />
			<var name="userFirstName" value="Test" />
			<var name="userLastName" value="Test" />
			<var name="userName" value="Test Test" />
			<var name="userScreenName" value="test" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Organization Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesConfiguration">
			<var name="portlet" value="Site Settings" />
		</execute>

		<execute macro="Portal.Site#addVirtualHostsURLCP">
			<var name="publicPageVirtualHostURL" value="www.able.com" />
			<var name="publicVirtualHosts" value="true" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Organization Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesConfiguration">
			<var name="portlet" value="Site Settings" />
		</execute>

		<execute macro="Portal.Site#addVirtualHostsURLCP">
			<var name="privatePageVirtualHostURL" value="www.baker.com" />
			<var name="privateVirtualHosts" value="true" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="samlEnabled" value="true" />
			<var name="userEmailAddress" value="test@liferay.com" />
			<var name="virtualHostsURL" value="http://www.baker.com:8080" />
		</execute>

		<for list="Home,Documents and Media,News" param="sitePageName">
			<execute function="AssertElementPresent" locator1="Home#PAGE" value1="${sitePageName}">
				<var name="key_pageName" value="${sitePageName}" />
			</execute>
		</for>

		<execute macro="Portal.Navigator#openSpecificURL">
			<var name="url" value="http://www.able.com:8080" />
		</execute>

		<for list="Documents and Media,News" param="sitePageName">
			<execute function="AssertElementNotPresent" locator1="Home#PAGE" value1="${sitePageName}">
				<var name="key_pageName" value="${sitePageName}" />
			</execute>
		</for>

		<execute macro="Portal.User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
			<var name="virtualHostsURL" value="http://www.able.com:8080" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Web Content Page" />
			<var name="virtualHostsURL" value="http://www.able.com:8080" />
		</execute>

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Web Content Page" />
			<var name="url" value="http://www.able.com:8080" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Web Content Display" />
		</execute>

		<execute function="Refresh" />

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Web Content Page" />
			<var name="url" value="http://www.able.com:8080" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Web Content Page" />
			<var name="url" value="http://www.able.com:8080" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaAP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Web Content Page" />
			<var name="url" value="http://www.able.com:8080" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaWCD">
			<var name="webContentContent" value="WC WebContent Content" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#gotoEditAssetPG">
			<var name="assetTitle" value="WC WebContent Title" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="SignIn#PORTLET_TITLE" value1="Sign" />

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Web Content Page" />
			<var name="url" value="http://www.able.com:8080" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#gotoEditAssetPG">
			<var name="assetTitle" value="WC WebContent Title" />
		</execute>

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="WC WebContent Content Edit" />
			<var name="webContentTitle" value="WC WebContent Title Edit" />
		</execute>

		<execute macro="Portal.Button#clickPublish" />

		<execute macro="Portal.Navigator#gotoSpecificURLPage">
			<var name="pageName" value="Web Content Page" />
			<var name="url" value="http://www.able.com:8080" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaAP">
			<var name="webContentContent" value="WC WebContent Content Edit" />
			<var name="webContentTitle" value="WC WebContent Title Edit" />
		</execute>

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Web Content Page" />
			<var name="siteName" value="Organization Name" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaAP">
			<var name="webContentContent" value="WC WebContent Content Edit" />
			<var name="webContentTitle" value="WC WebContent Title Edit" />
		</execute>
	</command>

	<command name="AssertAssetListScopeViaAssetPublisher" priority="4">
		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Global" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentType" />

		<execute macro="Portal.DMDocumentType#add">
			<var name="dmDocumentTypeDescription" value="Global Document Type Description" />
			<var name="dmDocumentTypeFieldNames" value="Text" />
			<var name="dmDocumentTypeName" value="Global Document Type Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentType" />

		<execute macro="Portal.DMDocumentType#add">
			<var name="dmDocumentTypeDescription" value="Local Document Type Description" />
			<var name="dmDocumentTypeFieldNames" value="Text" />
			<var name="dmDocumentTypeName" value="Local Document Type Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#configureManualAssetSelectionPG" />

		<execute macro="Portal.AssetPublisherPortlet#viewManualAssetTypesPG">
			<var name="assetEntryTypes" value="Global Document Type Name,Local Document Type Name" />
		</execute>
	</command>

	<command name="AssertGuestRefreshNoConsoleErrors" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaAP">
			<var name="webContentContent" value="WC WebContent Content" />
			<var name="webContentTitle" value="WC Webcontent Title" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute function="Refresh" />

		<execute function="AssertConsoleTextNotPresent" value1="NoSuchResourceActionException" />
	</command>

	<command name="AssetPublisherCategoriesLocalization" priority="3">
		<property name="test.name.skip.portal.instance" value="WebcontentpublicationUsecase#AssetPublisherCategoriesLocalization" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>

		<execute macro="Portal.Vocabulary#addCP">
			<var name="localization2Name" value="Nom Vocabulaire" />
			<var name="localization2NameKey" value="fr_FR" />
			<var name="localizationName" value="Vokabular Namen" />
			<var name="localizationNameKey" value="de_DE" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>

		<execute macro="Portal.Category#addCategoryLocalizationCP">
			<var name="categoryName" value="Vocabulary1 Category" />
			<var name="localization2Name" value="Nom de la Catégorie" />
			<var name="localization2NameKey" value="fr_FR" />
			<var name="localizationName" value="Kategorienamen" />
			<var name="localizationNameKey" value="de_DE" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>

		<execute macro="Portal.Category#viewCategoryToVocabularyCP">
			<var name="categoryName" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Language Selector" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaAP">
			<var name="webContentContent" value="Web Content1 Content" />
			<var name="webContentTitle" value="Web Content1 Title" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditCP">
			<var name="webContentTitle" value="Web Content1 Title" />
		</execute>

		<execute macro="Portal.WebContent#selectCategory">
			<var name="categoryName" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.WebContentNavigator#gotoEditCP">
			<var name="webContentTitle" value="Web Content1 Title" />
		</execute>

		<execute macro="Portal.WebContent#addLocale">
			<var name="language" value="German (Germany)" />
			<var name="locale" value="de-DE" />
		</execute>

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="Netz Content1 Inhalt" />
			<var name="webContentTitle" value="Netz Content1 Titel" />
		</execute>

		<execute macro="Portal.WebContent#addLocale">
			<var name="language" value="French (France)" />
			<var name="locale" value="fr-FR" />
		</execute>

		<execute macro="Portal.WebContent#addCP">
			<var name="webContentContent" value="Contenu de Contenu Web1" />
			<var name="webContentTitle" value="Titre de Contenu Web1" />
		</execute>

		<execute macro="Portal.PortletEntry#publish" />

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.WebContent#viewPGViaAP">
			<var name="webContentContent" value="Web Content1 Content" />
			<var name="webContentTitle" value="Web Content1 Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#configureShowMetadataFieldsPG">
			<var name="addMetadata" value="true" />
			<var name="metadataFieldList" value="Categories" />
			<var name="portletName" value="Asset Publisher" />
			<var name="webContentContent" value="Web Content1 Content" />
			<var name="webContentTitle" value="Web Content1 Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewAssetPG">
			<var name="assetContent" value="Web Content1 Content" />
			<var name="assetTitle" value="Web Content1 Title" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewAssetMetadataPG">
			<var name="addMetadata" value="true" />
			<var name="categoryName" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.LanguagePortlet#selectLanguagePG">
			<var name="language" value="German (Germany)" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewAssetPG">
			<var name="assetContent" value="Netz Content1 Inhalt" />
			<var name="assetTitle" value="Netz Content1 Titel" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewAssetMetadataPG">
			<var name="addMetadata" value="true" />
			<var name="categoryName" value="Kategorienamen" />
			<var name="vocabularyName" value="Vokabular Namen" />
		</execute>

		<execute macro="Portal.LanguagePortlet#selectLanguagePG">
			<var name="language" value="French (France)" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewAssetPG">
			<var name="assetContent" value="Contenu de Contenu Web1" />
			<var name="assetTitle" value="Titre de Contenu Web1" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewAssetMetadataPG">
			<var name="addMetadata" value="true" />
			<var name="categoryName" value="Nom de la Catégorie" />
			<var name="vocabularyName" value="Nom Vocabulaire" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Asset Publisher Page" />
		</execute>

		<execute macro="Portal.LanguagePortlet#selectLanguagePG">
			<var name="language" value="English (United States)" />
		</execute>
	</command>

	<command name="AssetPublisherCategoriesNavigation" priority="5">
		<property name="portal.acceptance" value="pending" />
		<property name="testray.component.names" value="Training" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>

		<execute macro="Portal.Vocabulary#addCP">
			<var name="vocabularyDescription" value="This is the Vocabulary1 description" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>

		<execute macro="Portal.Category#addCP">
			<var name="categoryDescription" value="This is the Vocabulary1 Category description" />
			<var name="categoryName" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>

		<execute macro="Portal.Category#viewCP">
			<var name="categoryName" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addWithCategoryCP">
			<var name="categoryName" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
			<var name="webContentContent" value="WC WebContent1 Content" />
			<var name="webContentTitle" value="WC WebContent1 Title" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditCP">
			<var name="webContentTitle" value="WC WebContent1 Title" />
		</execute>

		<execute macro="Portal.WebContent#viewCategorizationCategoryCP">
			<var name="categoryNameList" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addWithCategoryCP">
			<var name="categoryName" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
			<var name="webContentContent" value="WC WebContent2 Content" />
			<var name="webContentTitle" value="WC WebContent2 Title" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditCP">
			<var name="webContentTitle" value="WC WebContent2 Title" />
		</execute>

		<execute macro="Portal.WebContent#viewCategorizationCategoryCP">
			<var name="categoryNameList" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addWithCategoryCP">
			<var name="categoryName" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
			<var name="webContentContent" value="WC WebContent3 Content" />
			<var name="webContentTitle" value="WC WebContent3 Title" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditCP">
			<var name="webContentTitle" value="WC WebContent3 Title" />
		</execute>

		<execute macro="Portal.WebContent#viewCategorizationCategoryCP">
			<var name="categoryNameList" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoAddCP" />

		<execute macro="Portal.WebContent#addWithCategoryCP">
			<var name="categoryName" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
			<var name="webContentContent" value="WC WebContent4 Content" />
			<var name="webContentTitle" value="WC WebContent4 Title" />
		</execute>

		<execute macro="Portal.WebContentNavigator#gotoEditCP">
			<var name="webContentTitle" value="WC WebContent4 Title" />
		</execute>

		<execute macro="Portal.WebContent#viewCategorizationCategoryCP">
			<var name="categoryNameList" value="Vocabulary1 Category" />
			<var name="vocabularyName" value="Vocabulary Name" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
