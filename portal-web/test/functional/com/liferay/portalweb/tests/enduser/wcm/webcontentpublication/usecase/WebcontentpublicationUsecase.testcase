	<command name="AssetPublisherSiteAndGlobalScopeAccessibility" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="test.name.skip.portal.instance" value="WebcontentpublicationUsecase#AssetPublisherSiteAndGlobalScopeAccessibility" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<for list="${siteName},Site Name,Global" param="siteName">
			<execute macro="Portal.ProductMenu#gotoSite">
				<var name="site" value="${siteName}" />
			</execute>

			<execute macro="Portal.ProductMenu#gotoSitesContent">
				<var name="portlet" value="Web Content" />
			</execute>

			<execute macro="Portal.WebContentNavigator#gotoAddCP" />

			<execute macro="Portal.WebContent#addCP">
				<var name="webContentContent" value="${siteName} WC Content" />
				<var name="webContentTitle" value="${siteName} WC Title" />
			</execute>

			<execute macro="Portal.PortletEntry#publish" />
		</for>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewAssetPG">
			<var name="assetContent" value="Site Name WC Content" />
			<var name="assetTitle" value="Site Name WC Title" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#configureAddSiteScopes">
			<var name="globalSite" value="Global" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Site Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<for list="${siteName},Site Name,Global" param="siteName">
			<execute macro="Portal.AssetPublisherPortlet#viewAssetPG">
				<var name="assetContent" value="${siteName} WC Content" />
				<var name="assetTitle" value="${siteName} WC Title" />
			</execute>
		</for>

		<execute macro="Portal.AssetPublisherPortlet#viewAssetNotPresentPG">
			<var name="assetContent" value="Liferay WC Content" />
			<var name="assetTitle" value="Liferay WC Title" />
		</execute>
	</command>

	<command name="AssetPublisherTogglingBetweenSites" priority="4">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Site Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<for list="${siteName},Site Name,Global" param="siteName1">
			<execute macro="Portal.ProductMenu#gotoSite">
