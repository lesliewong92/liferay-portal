<definition component-name="portal-wcm">
	<property name="custom.properties" value="default.layout.template.id=1_column" />
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Content and Application Templates" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#logoutAndLoginPG">
					<var name="userLoginEmailAddress" value="test@liferay.com" />
					<var name="userLoginFullName" value="Test Test" />
				</execute>

				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddRSSADTViaPortletConfiguration" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Content and Application Templates,RSS" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Latimes > Technology News" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="rss2.0.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.ApplicationDisplayTemplates#addManualViaRSS">
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.RSS#waitForRSSLoad" />

		<execute macro="Portal.ApplicationDisplayTemplates#selectPortletADT">
			<var name="adtType" value="RSS" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.RSS#waitForRSSLoad" />

		<execute macro="Portal.RSS#viewCustomADT">
			<var name="feedContentTitle" value="Technology" />
		</execute>
	</command>

	<command name="AddRSSADTWithCorruptScript" priority="3">
		<property name="testray.component.names" value="Content and Application Templates,RSS" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Latimes > Technology News" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="rss2.0.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.ApplicationDisplayTemplates#addPG">
			<var name="adtFile" value="adt_rss_navigation_corrupt.ftl" />
			<var name="adtType" value="RSS" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.ApplicationDisplayTemplates#selectPortletADT">
			<var name="adtType" value="RSS" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.RSS#viewCorruptScript" />
	</command>

	<command name="AddRSSADTWithScript" priority="3">
		<property name="testray.component.names" value="Content and Application Templates,RSS" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="RSS Publisher" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="RSS Publisher" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.RSS#addFeed">
			<var name="feedRowIndexNumber" value="0" />
			<var name="feedTitle" value="Technology" />
			<var name="feedType" value="file" />
			<var name="feedUrlLink" value="Technology.xml" />
		</execute>

		<execute macro="Portal.PortletEntry#save" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.ApplicationDisplayTemplates#addPG">
			<var name="adtFile" value="adt_rss_navigation.ftl" />
			<var name="adtType" value="RSS" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.ApplicationDisplayTemplates#selectPortletADT">
			<var name="adtType" value="RSS" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.RSS#viewNavigationDisplayFeedTitle">
			<var name="feedTitle" value="Technology" />
			<var name="navigationNullADT" value="true" />
		</execute>
	</command>

	<command name="ADTAssetPublisher" priority="3">
		<property name="testray.component.names" value="Asset Publisher,Content and Application Templates" />

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.WebContent#addPGViaAP">
			<var name="webContentContent" value="WC Content" />
			<var name="webContentTitle" value="WC Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.ApplicationDisplayTemplates#addPG">
			<var name="adtFile" value="adt_asset_publisher_rich_summary.ftl" />
			<var name="adtType" value="Asset Publisher" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#configureDisplaySettings">
			<var name="displaySettings" value="Comments,Comment Ratings,Enable Social Bookmarks,Flags,Print,Ratings,Related Assets" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewDefaultWithAllDisplaySettingsCheckboxesPG">
			<var name="assetDescription" value="WC Content" />
			<var name="assetTitle" value="WC Title" />
		</execute>

		<execute macro="Portal.ApplicationDisplayTemplates#selectPortletADT">
			<var name="adtType" value="Asset Publisher" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.AssetPublisherPortlet#viewCustomADTRichSummaryPG">
			<var name="assetDescription" value="WC Content" />
			<var name="assetTitle" value="WC Title" />
		</execute>
	</command>

	<command name="ADTBreadcrumb" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="testray.component.names" value="Breadcrumb,Content and Application Templates" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Breadcrumb" />
		</execute>

		<execute macro="Portal.Breadcrumb#viewADTApplied">
			<var name="breadcrumbADTType" value="horizontal" />
		</execute>

		<execute macro="Portal.Portlet#gotoPortletOptions">
			<var name="portletName" value="Breadcrumb" />
			<var name="portletOption" value="Configuration" />
		</execute>

		<execute macro="Portal.Breadcrumb#configureBreadcrumb">
			<var name="selectADTType" value="Arrows" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="ADT Test Page" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Portal.Breadcrumb#viewADTApplied">
			<var name="breadcrumbADTType" value="arrows" />
		</execute>
	</command>

