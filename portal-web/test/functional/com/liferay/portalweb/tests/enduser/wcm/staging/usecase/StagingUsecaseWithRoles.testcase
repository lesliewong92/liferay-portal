<definition component-name="portal-staging">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Staging" />

	<var name="siteName" value="Site Name" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#logoutAndLoginPG">
					<var name="userLoginEmailAddress" value="test@liferay.com" />
					<var name="userLoginFullName" value="Test Test" />
				</execute>

				<execute macro="Portal.User#deactivateCP">
					<var name="userFirstName" value="userfn" />
				</execute>

				<execute macro="Portal.User#deleteCP" />

				<execute macro="Portal.Role#tearDownCP" />

				<execute macro="Portal.Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="StagingDemoLocalLive1" priority="4">
		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesPublishing">
			<var name="portlet" value="Staging" />
		</execute>

		<execute macro="Portal.Staging#activateStagingCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#addStagingAdminRole" />

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Roles" />
		</execute>

		<execute macro="Portal.Role#definePermissionCmdCP">
			<var name="permissionDefinitionKey" value="SITE_ADMIN_APPLICATIONS_DOCUMENTS_AND_MEDIA_RESOURCE_PERMISSIONS_DOCUMENT_ACTION_CHECKBOX" />
			<var name="permissionDefinitionValue" value="Action" />
			<var name="permissionNavigationKey" value="SITE_ADMIN_CONTENT_DOCUMENTS_AND_MEDIA" />
			<var name="permissionNavigationValue" value="Documents and Media" />
			<var name="roleTitle" value="Staging Admin" />
			<var name="roleType" value="Site" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="password" value="password" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesMembers">
			<var name="portlet" value="Site Memberships" />
		</execute>

		<execute macro="Portal.Site#assignUserAsMemberCP">
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#openSiteURL">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesMembers">
			<var name="portlet" value="Site Memberships" />
		</execute>

		<execute macro="Portal.Site#assignSiteRoleCP">
			<var name="resourceName" value="userfn userln" />
			<var name="roleTitle" value="Staging Admin" />
		</execute>

		<execute macro="Portal.User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#configurePublishToLive">
			<var name="uncheckContentNameList" value="Documents and Media" />
		</execute>

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMPortlet#viewDefaultPG" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#configurePublishToLive">
			<var name="checkContentNameList" value="Documents and Media" />
			<var name="contentDateRange" value="All" />
		</execute>

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Staging Test Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.DMDocument#viewPG">
			<var name="dmDocumentDescription" value="DM Document Description" />
			<var name="dmDocumentTitle" value="DM Document Title" />
		</execute>
	</command>

	<command name="StagingDemoLocalLive2" priority="4">
