			<var name="pageName" value="Wiki" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoStagedView" />

		<execute macro="Portal.Staging#gotoPublishToLive" />

		<execute macro="Portal.Staging#configurePublishToLive">
			<var name="checkPageName" value="Home" />
		</execute>

		<execute macro="Portal.Staging#publishToLive" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Home" />
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Portlet#viewPG">
			<var name="portletName" value="Navigation Menu" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Wiki" />
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Portlet#viewPG">
			<var name="portletName" value="Wiki" />
		</execute>
	</command>
</definition>