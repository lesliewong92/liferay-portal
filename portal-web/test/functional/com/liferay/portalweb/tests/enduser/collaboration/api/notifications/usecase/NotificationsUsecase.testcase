<definition component-name="portal-collaboration">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="custom.properties" value="default.layout.template.id=1_column" />
	<property name="testray.main.component.name" value="Notifications" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Site#tearDownCP" />

				<execute macro="Portal.BlogsEntry#tearDownCP" />

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.User#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="MarkNotificationAsReadAndAcceptRequest" priority="4">
		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="password" value="password" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#assignRegularRoleCP">
			<var name="roleTitle" value="Administrator" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addCP">
			<var name="siteName" value="Community Site Name" />
			<var name="siteType" value="Community" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Home" />
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Blank Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Home" />
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Invite Members Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Invite Members Page" />
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Invite Members" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Invite Members Page" />
			<var name="siteName" value="Community Site Name" />
		</execute>

		<execute macro="Portal.InviteMembers#inviteMembers">
			<var name="inviteUserFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#subscribePG" />

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="2" />
		</execute>

		<execute macro="Portal.Notifications#gotoNotifications" />

		<execute macro="Portal.Notifications#viewNewContent">
			<var name="assetType" value="Blogs Entry" />
			<var name="contentBody" value="Blogs Entry Title" />
			<var name="user" value="Test Test" />
		</execute>

		<execute macro="Portal.Notifications#viewRequest">
			<var name="requestsTitle" value="Test Test invited you to join Community Site Name." />
		</execute>

		<execute macro="Portal.Notifications#acceptRequest" >
			<var name="requestsTitle" value="Test Test invited you to join Community Site Name." />
		</execute>

		<execute function="Refresh" />

		<execute macro="Portal.Notifications#viewNoRequest" />

		<execute macro="Portal.Notifications#viewNoNotifications" />

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>
	</command>

	<command name="ViewDefaultNotificationsPortletDeliveryOptions" priority="3">
		<execute macro="Portal.Page#gotoMyAccount">
			<var name="portletName" value="Notifications" />
		</execute>

		<execute macro="Portal.NotificationsPortlet#gotoNotificationDelivery" />

		<execute macro="Portal.IFrame#selectConfigurationFrame" />

		<execute macro="Portal.NotificationsPortlet#viewDefaultNotificationDeliveries" />
	</command>

	<command name="ViewNoNotification" priority="5">
		<execute macro="Portal.Notifications#viewNoNotifications">
			<var name="activePanel" value="Profile" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoUserMyAccount">
			<var name="portlet" value="Notifications" />
		</execute>

		<execute macro="Portal.Notifications#viewNoRequest" />

		<execute macro="Portal.Notifications#viewNoNotificationEntry" />
	</command>
</definition>