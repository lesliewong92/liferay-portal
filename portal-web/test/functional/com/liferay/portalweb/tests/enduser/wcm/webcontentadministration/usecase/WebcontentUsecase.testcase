		<execute function="Portal.AssertClickNoError" locator1="Button#SAVE_AS_DRAFT" value1="Save as Draft" />

		<execute macro="Portal.WebContentStructures#viewTemplateValidation" />

		<execute function="Portal.AssertClickNoError" locator1="Button#PUBLISH" value1="Publish" />

		<execute macro="Portal.WebContentStructures#viewTemplateValidation" />
	</command>
</definition>