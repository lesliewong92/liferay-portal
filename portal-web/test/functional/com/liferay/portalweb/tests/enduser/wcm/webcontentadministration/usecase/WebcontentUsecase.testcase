	<command name="ExpireMultipleWebContent" priority="4">
		<property name="testray.component.names" value="Web Content Administration" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<for list="1,2,3" param="i">
			<execute macro="Portal.ProductMenu#gotoSitesContent">
				<var name="portlet" value="Web Content" />
			</execute>

			<execute macro="Portal.WebContentNavigator#gotoAddCP" />

			<execute macro="Portal.WebContent#addCP">
				<var name="webContentContent" value="WC WebContent Content" />
				<var name="webContentTitle" value="WC WebContent Title ${i}" />
			</execute>

			<execute macro="Portal.PortletEntry#publish" />
		</for>

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>

		<execute macro="Portal.WebContent#expireCP">
			<var name="webContentTitleList" value="WC WebContent Title 1,WC WebContent Title 2,WC WebContent Title 3," />
		</execute>

		<for list="1,2,3" param="i">
			<execute macro="Portal.ProductMenu#gotoSitesContent">
				<var name="portlet" value="Web Content" />
			</execute>

			<execute macro="Portal.WebContentNavigator#gotoEditCP">
				<var name="webContentTitle" value="WC WebContent Title ${i}" />
			</execute>

			<execute macro="Portal.WebContent#viewStatus">
				<var name="webContentContent" value="WC WebContent Content" />
				<var name="webContentStatus" value="Expired" />
				<var name="webContentTitle" value="WC WebContent Title ${i}" />
			</execute>
		</for>
	</command>

