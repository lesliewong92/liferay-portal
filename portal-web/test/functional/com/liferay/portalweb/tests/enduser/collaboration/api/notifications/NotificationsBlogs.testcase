<definition component-name="portal-collaboration">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="custom.properties" value="default.layout.template.id=1_column" />
	<property name="testray.main.component.name" value="Notifications" />

	<var name="pageName" value="Blogs Page" />
	<var name="portletName" value="Blogs" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Blogs" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="password" value="password" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#assignRegularRoleCP">
			<var name="roleTitle" value="Administrator" />
			<var name="userScreenName" value="usersn" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Blogs#tearDownSubscribePG" />

				<execute macro="Portal.Blogs#tearDownCP" />

				<execute macro="Portal.NotificationsPortlet#tearDownUserDeliveries" />

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.User#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="DeleteNotifications" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#subscribePG" />

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<for list="1,2" param="entryCount" >
			<execute macro="Portal.Blogs#addEntry">
				<var name="entryContent" value="Blogs Entry${entryCount} Content" />
				<var name="entryTitle" value="Blogs Entry${entryCount} Title" />
			</execute>
		</for>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="activePanel" value="Notifications" />
			<var name="notificationCount" value="2" />
		</execute>

		<execute macro="Portal.Notifications#gotoNotifications" />

		<execute macro="Portal.Notifications#viewNewContent">
			<var name="assetType" value="Blogs Entry" />
			<var name="contentBody" value="Blogs Entry1 Title" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#viewNewContent">
			<var name="assetType" value="Blogs Entry" />
			<var name="contentBody" value="Blogs Entry2 Title" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#deleteNotification">
			<var name="contentBody" value="Blogs Entry1 Title" />
		</execute>

		<execute macro="Portal.Notifications#deleteNotification">
			<var name="contentBody" value="Blogs Entry2 Title" />
		</execute>

		<execute macro="Portal.Notifications#viewDefaultContent" />

		<execute macro="Portal.Notifications#viewNoNotifications">
			<var name="activePanel" value="Notifications" />
		</execute>
	</command>

	<command name="MarkAllNotificationsAsRead" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#subscribePG" />

		<execute macro="Portal.Notifications#viewNoNotifications">
			<var name="activePanel" value="Profile" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<for list="1,2,3" param="entryCount" >
			<execute macro="Portal.Blogs#addEntry">
				<var name="entryContent" value="Blogs Entry${entryCount} Content" />
				<var name="entryTitle" value="Blogs Entry${entryCount} Title" />
			</execute>
		</for>

		<execute macro="Portal.Notifications#viewNoNotifications">
			<var name="activePanel" value="Profile" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="activePanel" value="Notifications" />
			<var name="notificationCount" value="3" />
		</execute>

		<execute macro="Portal.Notifications#gotoNotifications" />

		<execute macro="Portal.Notifications#markAllAsRead" />

		<execute macro="Portal.Notifications#viewNoNotifications">
			<var name="activePanel" value="Notifications" />
		</execute>
	</command>

	<command name="ViewMultipleNotifications" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#subscribePG" />

		<execute macro="Portal.Notifications#viewNoNotifications">
			<var name="activePanel" value="Profile" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<for list="1,2,3" param="entryCount" >
			<execute macro="Portal.Blogs#addEntry">
				<var name="entryContent" value="Blogs Entry${entryCount} Content" />
				<var name="entryTitle" value="Blogs Entry${entryCount} Title" />
			</execute>
		</for>

		<execute macro="Portal.Notifications#viewNoNotifications">
			<var name="activePanel" value="Profile" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="activePanel" value="Notifications" />
			<var name="notificationCount" value="3" />
		</execute>

		<execute macro="Portal.Notifications#gotoNotifications" />

		<execute macro="Portal.Notifications#viewNewContent">
			<var name="assetType" value="Blogs Entry" />
			<var name="contentBody" value="Blogs Entry1 Title" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#navigateToContent">
			<var name="contentBody" value="Blogs Entry1 Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewPG">
			<var name="entryContent" value="Blogs Entry1 Content" />
			<var name="entryTitle" value="Blogs Entry1 Title" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="activePanel" value="Notifications" />
			<var name="notificationCount" value="2" />
		</execute>

		<execute macro="Portal.Notifications#gotoNotifications" />

		<execute macro="Portal.Notifications#viewNewContent">
			<var name="assetType" value="Blogs Entry" />
			<var name="contentBody" value="Blogs Entry2 Title" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#navigateToContent">
			<var name="contentBody" value="Blogs Entry2 Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewPG">
			<var name="entryContent" value="Blogs Entry2 Content" />
			<var name="entryTitle" value="Blogs Entry2 Title" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="activePanel" value="Notifications" />
			<var name="notificationCount" value="1" />
		</execute>

		<execute macro="Portal.Notifications#gotoNotifications" />

		<execute macro="Portal.Notifications#viewNewContent">
			<var name="assetType" value="Blogs Entry" />
			<var name="contentBody" value="Blogs Entry3 Title" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#navigateToContent">
			<var name="contentBody" value="Blogs Entry3 Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewPG">
			<var name="entryContent" value="Blogs Entry3 Content" />
			<var name="entryTitle" value="Blogs Entry3 Title" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="activePanel" value="Notifications" />
			<var name="notificationCount" value="0" />
		</execute>
	</command>

	<command name="ViewNoWebsiteNotificationForNewBlogsEntry" priority="4">
		<execute macro="Portal.NotificationsPortlet#gotoNotificationDelivery" />

		<execute function="AssertElementPresent" locator1="IFrame#DIALOG" />

		<execute macro="Portal.IFrame#selectConfigurationFrame" />

		<execute macro="Portal.NotificationsPortlet#disableUserDeliveries">
			<var name="actionType" value="Add" />
			<var name="contentType" value="Blogs" />
			<var name="notificationType" value="Website" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#subscribePG" />

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>
	</command>

	<command name="ViewNoWebsiteNotificationForUpdatedBlogsEntry" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#subscribePG" />

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#editEntryPG">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryContentEdit" value="Blogs Entry Content Edit" />
			<var name="entryTitle" value="Blogs Entry Title" />
			<var name="entryTitleEdit" value="Blogs Entry Title Edit" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntry">
			<var name="entryContent" value="Blogs Entry Content Edit" />
			<var name="entryTitle" value="Blogs Entry Title Edit" />
		</execute>
	</command>

	<command name="ViewWebsiteNotificationForNewBlogsEntry" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#subscribePG" />

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="1" />
		</execute>

		<execute macro="Portal.Notifications#gotoNotifications" />

		<execute macro="Portal.Notifications#viewNewContent">
			<var name="assetType" value="blogs entry" />
			<var name="contentBody" value="Blogs Entry Title" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#navigateToContent">
			<var name="contentBody" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntry#viewEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>
	</command>

	<command name="ViewWebsiteNotificationForNewCommentViaBlogs" priority="4">
		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.Blogs#addEntry">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntryComment#subscribePG">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="userea@liferay.com" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Blogs Page" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntryComment#add">
			<var name="entryComment" value="Blogs Entry Comment" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>

		<execute macro="Portal.User#logoutPG" />

		<execute macro="Portal.User#loginUserPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="1" />
		</execute>

		<execute macro="Portal.Notifications#gotoNotifications" />

		<execute macro="Portal.Notifications#viewNewComment">
			<var name="assetType" value="comment" />
			<var name="content" value="Blogs Entry Title" />
			<var name="contentBody" value="Blogs Entry Comment" />
			<var name="user" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#navigateToContent">
			<var name="contentBody" value="Blogs Entry Comment" />
		</execute>

		<execute macro="Portal.BlogsNavigator#gotoEntryPG">
			<var name="entryContent" value="Blogs Entry Content" />
			<var name="entryTitle" value="Blogs Entry Title" />
		</execute>

		<execute macro="Portal.BlogsEntryComment#viewPG">
			<var name="commentCount" value="1" />
			<var name="entryComment" value="Blogs Entry Comment" />
			<var name="userFullName" value="userfn userln" />
		</execute>

		<execute macro="Portal.Notifications#viewBadgeCount">
			<var name="notificationCount" value="0" />
		</execute>
	</command>
</definition>