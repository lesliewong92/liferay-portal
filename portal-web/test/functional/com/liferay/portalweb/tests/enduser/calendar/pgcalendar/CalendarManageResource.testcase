<definition component-name="portal-calendar">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="custom.properties" value="default.layout.template.id=1_column${line.separator}company.default.time.zone=America/Los_Angeles" />
	<property name="testray.main.component.name" value="Calendar" />

	<var name="pageName" value="Calendar Page" />
	<var name="portletName" value="Calendar" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="pageName" value="Calendar Page" />
			<var name="portletName" value="Calendar" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.Navigator#gotoPage">
					<var name="pageName" value="Calendar Page" />
				</execute>

				<if>
					<condition function="IsElementPresent" locator1="Calendar#SCHEDULER_EVENT_GENERIC" />
					<then>
						<execute macro="Portal.CalendarEvent#tearDown" />
					</then>
				</if>

				<execute macro="Portal.Calendar#tearDown" />

				<execute macro="Portal.CalendarConfiguration#tearDown" />

				<execute macro="Portal.Page#tearDownPG" />
			</else>
		</if>
	</tear-down>

	<command name="Delete" priority="4">
		<var name="calendarResourceName" value="Calendar Resource Name" />

		<execute macro="Portal.CalendarResource#add">
			<var name="calendarResourceName" value="${calendarResourceName}" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarResource#delete">
			<var name="calendarResourceName" value="${calendarResourceName}" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarResource#viewDefault">
			<var name="calendarResourceName" value="${calendarResourceName}" />
		</execute>
	</command>

	<command name="Search" priority="3">
		<description message="This is a use case for LPS-59743." />

		<execute macro="Portal.CalendarResource#add">
			<var name="calendarResourceName" value="Room 1" />
		</execute>

		<execute macro="Portal.CalendarResource#add">
			<var name="calendarResourceName" value="Car1" />
		</execute>

		<execute macro="Portal.CalendarResource#add">
			<var name="calendarResourceName" value="Truck" />
		</execute>

		<execute macro="Portal.CalendarResource#search">
			<var name="calendarResourceName" value="Room Car " />
		</execute>

		<execute macro="Portal.CalendarResource#viewResourceName">
			<var name="calendarResourceName" value="Room 1" />
		</execute>

		<execute macro="Portal.CalendarResource#viewResourceName">
			<var name="calendarResourceName" value="Car1" />
		</execute>

		<execute macro="Portal.CalendarResource#viewResourceNameNotPresent">
			<var name="calendarResourceName" value="Truck" />
		</execute>

		<execute macro="Portal.CalendarResource#search">
			<var name="calendarResourceName" value="Room" />
		</execute>

		<execute macro="Portal.CalendarResource#viewResourceName">
			<var name="calendarResourceName" value="Room 1" />
		</execute>

		<execute macro="Portal.CalendarResource#viewResourceNameNotPresent">
			<var name="calendarResourceName" value="Car1" />
		</execute>

		<execute macro="Portal.CalendarResource#viewResourceNameNotPresent">
			<var name="calendarResourceName" value="Truck" />
		</execute>
	</command>

	<command name="ViewEventDateAndTimeInResourcesAvailability" priority="4">
		<description message="This is a use case for LPS-62410." />

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#gotoConfigureInvitations" />

		<execute macro="Portal.CalendarEvent#viewResourcesAvailability" />

		<execute macro="Portal.CalendarEvent#compareEventDateAndTimeToResourcesAvailabilityDateAndTime" />

		<execute macro="Portal.CalendarEvent#selectTimes" >
			<var name="endDateTime" value="11:00 AM" />
			<var name="startDateTime" value="08:00 AM" />
		</execute>

		<execute macro="Portal.CalendarEvent#compareEventDateAndTimeToResourcesAvailabilityDateAndTime" />

		<execute macro="Portal.CalendarEvent#setEndDateTomorrow" />

		<execute macro="Portal.CalendarEvent#selectTimes" >
			<var name="endDateTime" value="07:00 AM" />
			<var name="startDateTime" value="08:00 AM" />
		</execute>

		<execute macro="Portal.CalendarEvent#compareEventDateAndTimeToResourcesAvailabilityDateAndTime" />

		<execute macro="Portal.CalendarEvent#publish" />
	</command>

	<command name="ViewInactive" priority="2">
		<description message="This is a use case for LPS-55171." />

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Site#addBlankCP">
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelSites">
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Portal.Page#add">
			<var name="pageName" value="Calendar Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Calendar Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Portlet#addPG">
			<var name="portletName" value="Calendar" />
		</execute>

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Calendar Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoAddResource" />

		<execute macro="Portal.CalendarResource#editResourceName">
			<var name="calendarResourceName" value="Calendar Resource" />
		</execute>

		<execute macro="Portal.CalendarResource#deactivate" />

		<execute macro="Portal.CalendarResource#save" />

		<execute macro="Portal.CalendarResource#viewDefault" />

		<execute macro="Portal.Navigator#gotoSitePage">
			<var name="pageName" value="Calendar Page" />
			<var name="siteName" value="Site Name" />
		</execute>

		<execute macro="Portal.Calendar#searchOtherCalendars">
			<var name="searchValue" value="resource" />
		</execute>

		<execute macro="Portal.Calendar#viewOtherCalendarsSearchResultNotPresent">
			<var name="calendarName" value="Calendar Resource" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#viewInvitationResourceNotPresent">
			<var name="resourceNameList" value="Calendar Resource" />
		</execute>
	</command>

	<command name="ViewInvitedResourceAvailability" priority="3">
		<execute macro="Portal.TestCase#getSiteName">
			<return from="siteName" name="siteName" />
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#addCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="Users and Organizations" />
		</execute>

		<execute macro="Portal.User#editPasswordCP">
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSite">
			<var name="site" value="${siteName}" />
		</execute>

		<execute macro="Portal.ProductMenu#gotoSitesMembers">
			<var name="portlet" value="Site Memberships" />
		</execute>

		<execute macro="Portal.Site#assignUserAsMemberCP">
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.Calendar#add">
			<var name="calendarName" value="userfn userln" />
			<var name="calendarType" value="Other Calendars" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarResource#add">
			<var name="calendarResourceName" value="Calendar Resource Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarResource#view">
			<var name="calendarResourceName" value="Calendar Resource Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.Calendar#add">
			<var name="calendarName" value="Calendar Resource Name" />
			<var name="calendarType" value="Other Calendars" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarNavigator#gotoAddEvent" />

		<execute macro="Portal.CalendarEvent#add">
			<var name="calendarName" value="userfn userln" />
			<var name="eventTitle" value="Calendar Event All Day Title" />
			<var name="eventType" value="Regular" />
			<var name="optionSet" value="true" />
			<var name="optionSetValue" value="inviteResource" />
			<var name="pageName" value="Calendar Page" />
			<var name="resourcesAvailability" value="true" />
			<var name="specificOptionSetValue" value="Test Test,Calendar Resource Name" />
		</execute>

		<execute macro="Portal.Navigator#gotoPage">
			<var name="pageName" value="Calendar Page" />
		</execute>

		<execute macro="Portal.CalendarEvent#view">
			<var name="eventNumber" value="2" />
			<var name="eventTitle" value="Calendar Event All Day Title" />
		</execute>
	</command>
</definition>