	</command>

	<command ignore="true" name="ViewEditedCheckedoutDocument" priority="5">
		<property name="test.name.skip.portal.instance" value="CPDocumentum#ViewEditedCheckedoutDocument" />

		<execute macro="Portal.DMRepository#gotoCP">
			<var name="dmRepositoryName" value="Documentum Repository Name" />
		</execute>

		<execute macro="Portal.DMDocument#addCP">
			<var name="dmDocumentFile" value="Document_1.xls" />
			<var name="dmDocumentTitle" value="Document_1.xls" />
		</execute>

		<execute macro="Portal.DMDocument#checkoutCP">
			<var name="dmDocumentTitle" value="Document_1.xls" />
			<var name="dmRepositoryName" value="true" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMRepository#gotoCP">
			<var name="dmRepositoryName" value="Documentum Repository Name" />
		</execute>

		<execute macro="Portal.DMDocument#editCP">
			<var name="checkedOut" value="true" />
			<var name="dmDocumentTitle" value="Document_1.xls" />
			<var name="dmDocumentTitleEdit" value="Document_1_Edit.jpg" />
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Documents and Media" />
		</execute>

		<execute macro="Portal.DMRepository#gotoCP">
			<var name="dmRepositoryName" value="Documentum Repository Name" />
		</execute>

		<execute macro="Portal.DMDocument#viewIconLockedCP">
			<var name="dmDocumentTitle" value="Document_1_Edit.jpg" />
		</execute>

		<execute macro="Portal.DMNavigator#gotoDocumentCP">
			<var name="dmDocumentTitle" value="Document_1_Edit.jpg" />
		</execute>

		<execute macro="Portal.DMDocument#viewCheckedoutCP" >
			<var name="dmRepositoryName" value="true" />
		</execute>

		<execute macro="Portal.DMDocument#cancelCheckoutCP">
			<var name="dmRepositoryName" value="true" />
		</execute>
	</command>

	<command name="ViewRepository" priority="5">
		<property name="test.name.skip.portal.instance" value="CPDocumentum#ViewRepository" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
