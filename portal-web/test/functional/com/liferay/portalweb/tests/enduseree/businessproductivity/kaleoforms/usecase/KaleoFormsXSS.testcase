<definition component-name="portal-business-productivity-ee">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="test.run.environment" value="EE" />
	<property name="testray.main.component.name" value="Kaleo Forms Admin" />

	<set-up>
		<execute macro="Portal.TestCase#setUpPortalInstance" />

		<execute macro="Portal.User#firstLoginPG" />

		<execute macro="Portal.ProductMenu#gotoControlPanelConfiguration">
			<var name="portlet" value="Workflow" />
		</execute>

		<execute macro="Portal.Workflow#uploadDefinition">
			<var name="workflowDefinitionFile" value="workflow_definition_xss.xml" />
			<var name="workflowDefinitionTitle"><![CDATA['alert(0)'"alert(0)"><img src=x onerror=alert(0)><script>alert(0)</script>]]></var>
		</execute>

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.Navigator#openURL" />

		<execute macro="Portal.ProductMenu#gotoSitesContent">
			<var name="portlet" value="Kaleo Forms Admin" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="Portal.PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Portal.User#firstLoginPG" />

				<execute macro="Portal.KaleoFormsAdmin#tearDownProcess" />

				<execute macro="Portal.KaleoFormsAdmin#deleteFieldSet" />

				<execute macro="Portal.Page#tearDownPG" />

				<execute macro="Portal.Workflow#tearDownWorkflowDefinitionsViaWorkflowCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddProcess" priority="4">
		<execute macro="Portal.KaleoFormsAdmin#addProcess" />

		<execute macro="Portal.KaleoFormsAdmin#addProcessDetails">
			<var name="kfProcessDescription" value="Kaleo Forms Process Description" />
			<var name="kfProcessName" value="Kaleo Forms Process" />
		</execute>

		<execute macro="Portal.KaleoFormsAdmin#next" />

		<execute macro="Portal.KaleoFormsAdmin#addFieldSet">
			<var name="kfFieldSetName" value="New Kaleo Field Set" />
			<var name="kfProcessName" value="Kaleo Forms Process" />
		</execute>

		<execute macro="Portal.DynamicDataMapping#addField">
			<var name="field" value="Text" />
			<var name="fieldFieldLabel" value="Text" />
			<var name="fieldName" value="Text" />
		</execute>

		<execute macro="Portal.KaleoFormsAdmin#saveFieldSet" />

		<execute macro="Portal.KaleoFormsAdmin#chooseFieldSet">
			<var name="kfFieldSetName" value="New Kaleo Field Set" />
			<var name="kfProcessName" value="Kaleo Forms Process" />
		</execute>

		<execute macro="Portal.KaleoFormsAdmin#next" />

		<var name="key_rowEntry" value="alert" />

		<execute function="Portal.Click" locator1="Icon#ROW_VERTICAL_ELLIPSIS" />

		<execute function="Portal.AssertClick" locator1="MenuItem#ANY_MENU_ITEM" value1="Choose">
			<var name="key_menuItem" value="Choose" />
		</execute>

		<execute macro="Portal.KaleoFormsAdmin#next" />

		<execute macro="Portal.KaleoFormsAdmin#assignForm">
			<var name="kfProcessName" value="Kaleo Forms Process" />
			<var name="workflowTask" value="StartNode" />
		</execute>

		<execute macro="Portal.KaleoFormsAdmin#addForm">
			<var name="kfFormName" value="Created Task Form" />
		</execute>

		<execute macro="Portal.KaleoFormsAdmin#saveForm" />

		<execute macro="Portal.KaleoFormsAdmin#chooseForm">
			<var name="kfFormName" value="Created Task Form" />
		</execute>

		<execute macro="Portal.KaleoFormsAdmin#saveProcess">
			<var name="kfProcessName" value="Kaleo Forms Process" />
		</execute>
	</command>
</definition>