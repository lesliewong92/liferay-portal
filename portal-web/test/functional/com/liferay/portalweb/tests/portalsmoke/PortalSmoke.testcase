<definition component-name="portal-smoke">
	<property name="portal.release" value="true" />
	<property name="testray.main.component.name" value="Smoke" />

	<command description="Ensure that the super admin can add pages, add portlets, navigate to the product menu, use the WYSIWYG editor, and view alert messages." name="Smoke" priority="5">
		<execute class="com.liferay.poshi.runner.util.oauth.OAuthUtil" method="createRequest10a">
			<arg value="http://lcs-qa.liferay.com:80/c/portal/oauth/access_token" />
			<arg value="c28d17d0e3f6060c39f2e8c119b2cec9" />
			<arg value="4f2e2d6e9634168c3ef4e32544303dc7" />
			<arg value="e2a653a6-f36c-4416-81f3-df41dcecf07b" />
			<arg value="fc075c03b57de24ca93d98ff69da3346" />
			<arg value="http://lcs-qa.liferay.com:80/c/portal/oauth/authorize?oauth_token={0}" />
			<arg value="http://lcs-qa.liferay.com:80/c/portal/oauth/request_token" />
			<arg value="http://lcs-qa.liferay.com/api/jsonws/osb-lcs-portlet.lcsproject/get-user-lcs-projects" />
			<return name="response" />
		</execute>

		<echo>${response}</echo>
	</command>
</definition>