<definition component-name="portal-smoke">
	<property name="testray.main.component.name" value="Smoke" />

	<command description="Ensure that the super admin can add pages, add portlets, navigate to the product menu, use the WYSIWYG editor, and view alert messages." name="Smoke" priority="5">
		<var name="phrase" value="Hello World" />
		<!-- <var method="StringUtil#replace('${phrase}','World','Mundo')" name="word" /> -->

		<!-- <execute class="com.liferay.poshi.runner.util.StringUtil" method="replace">
			<arg value="${phrase}" />
			<arg value="World" />
			<arg value="Mundo" />
			<return name="word" />
		</execute> -->

		<var method="MathUtil#quotient('4', '1')" name="four" />
		<var method="MathUtil#quotient('24', '3')" name="eight" />

		<!-- <execute class="com.liferay.poshi.runner.util.MathUtil" method="quotient">
			<arg value="${eight}" />
			<arg value="${four}" />
			<return name="word" />
		</execute> -->

		<echo>${word}</echo>
	</command>
</definition>